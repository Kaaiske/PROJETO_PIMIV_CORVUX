# ==============================================================================
# CorvuxIAM — Arquivo de Exemplo de Variáveis de Ambiente (.env.example)
# INSTRUÇÕES DE SEGURANÇA:
# 1. Copie este arquivo para '.env' no seu servidor: cp .env.example .env
# 2. Gere senhas e segredos criptográficos exclusivos e NUNCA compartilhe o arquivo .env
# 3. O arquivo .env real está protegido no .gitignore e jamais deve ser versionado
# ==============================================================================

# Senha do Administrador do Banco de Dados SQL Server (Mínimo 8 caracteres, maiúsculas, minúsculas, números e símbolos)
SQL_SA_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE_DO_BANCO_AQUI_Ex!9f8aB#2026

# Ambiente de Execução da Aplicação (Production ou Development)
ASPNETCORE_ENVIRONMENT=Production

# Domínio Corporativo Oficial da Aplicação
APP_DOMAIN=https://corvuxiam.tech

# Chave Criptográfica Secreta de Assinatura dos Tokens JWT (Mínimo de 32 caracteres complexos)
JWT_KEY=SUBSTITUA_POR_UMA_CHAVE_JWT_ALEATORIA_E_SEGURA_COM_MINIMO_32_CHARS_AQUI

# Senha inicial obrigatória do administrador (não reutilize em outros ambientes)
ADMIN_INITIAL_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE_E_UNICA

# Token do gateway de integrações (gere um valor aleatório forte)
API_GATEWAY_TOKEN=SUBSTITUA_POR_UM_TOKEN_ALEATORIO_E_UNICO

# ==============================================================================
# Servidor de E-mail Corporativo (SMTP / Notificações e Recuperação de Senha)
# ==============================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=seguranca@corvuxiam.tech
SMTP_PASSWORD=SUBSTITUA_POR_SUA_SENHA_DE_APP_SMTP

# ==============================================================================
# Cloudflare Turnstile (Proteção Anti-Bot CAPTCHA)
# As chaves '1x00000000000000000000AA' são as chaves universais da Cloudflare (Always Passes)
# que funcionam imediatamente em qualquer domínio sem disparar erro "Troubleshoot".
# Para utilizar suas chaves próprias do seu painel Cloudflare para https://corvuxiam.tech:
# 1. Acesse https://dash.cloudflare.com -> Turnstile -> Adicionar Widget
# 2. Registre o domínio 'corvuxiam.tech' e cole a SiteKey e SecretKey geradas abaixo:
# ==============================================================================
TURNSTILE_SITEKEY=SUBSTITUA_POR_SUA_TURNSTILE_SITEKEY_CLOUDFLARE
TURNSTILE_SECRETKEY=SUBSTITUA_POR_SUA_TURNSTILE_SECRETKEY_CLOUDFLARE

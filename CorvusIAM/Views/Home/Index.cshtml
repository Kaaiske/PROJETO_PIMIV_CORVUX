@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR" class="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Authentication - Corvux Security</title>
    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    colors: {
                        brand: { 500: '#3b82f6', 600: '#2563eb' },
                        dark: { bg: '#090A0C', card: '#121418', border: '#272B33', hover: '#1B1F24' }
                    }
                }
            }
        }
    </script>
    
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@@phosphor-icons/web"></script>
</head>
<body class="bg-dark-bg text-slate-300 h-screen flex items-center justify-center antialiased text-[13px] relative overflow-hidden">
    
    <!-- Subtle glow background -->
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-brand-500/5 blur-[120px] rounded-full pointer-events-none"></div>

    <div class="bg-dark-card border border-dark-border rounded-[6px] w-full max-w-sm relative z-10 shadow-2xl flex flex-col">
        <div class="p-[24px] border-b border-dark-border flex flex-col items-center">
            <img src="/icons/corvus-logo.png?v=20261015" alt="Corvux Logo" class="w-12 h-12 rounded-xl object-cover shadow-lg border border-white/10 mb-4">
            <h1 class="text-[16px] font-[600] text-white m-0 tracking-tight">Corvux Security UI</h1>
            <p class="text-[12px] text-gray-500 mt-1">Enterprise Operations Platform</p>
        </div>
        
        <div class="p-[24px]">
            @if(ViewBag.Error != null) {
                <div class="bg-red-500/10 border border-red-500/20 text-red-500 text-[12px] p-3 rounded-[6px] mb-4 flex items-center gap-2">
                    <i class="ph ph-warning-circle text-[16px]"></i> @ViewBag.Error
                </div>
            }

            <form method="post" action="/Home/Login" class="space-y-4">
                <div>
                    <label class="block text-[11px] font-[600] text-gray-400 uppercase tracking-[0.05em] mb-1.5">User ID / Email</label>
                    <div class="relative">
                        <i class="ph ph-user absolute left-3 top-1/2 -translate-y-1/2 text-gray-500"></i>
                        <input type="email" name="email" class="w-full bg-dark-bg border border-dark-border text-white text-[13px] rounded-[6px] pl-9 pr-3 py-2 outline-none focus:border-brand-500 transition-colors" placeholder="admin@corvus.com" required />
                    </div>
                </div>
                <div>
                    <label class="block text-[11px] font-[600] text-gray-400 uppercase tracking-[0.05em] mb-1.5">Password</label>
                    <div class="relative">
                        <i class="ph ph-lock absolute left-3 top-1/2 -translate-y-1/2 text-gray-500"></i>
                        <input type="password" name="senha" class="w-full bg-dark-bg border border-dark-border text-white text-[13px] rounded-[6px] pl-9 pr-3 py-2 outline-none focus:border-brand-500 transition-colors" placeholder="••••••••" required />
                    </div>
                </div>
                <button type="submit" class="w-full bg-brand-600 hover:bg-[#1D4ED8] text-white text-[13px] font-medium py-2.5 rounded-[6px] transition-colors mt-2 flex items-center justify-center gap-2">
                    Authenticate <i class="ph ph-arrow-right"></i>
                </button>
            </form>
        </div>
        <div class="p-[16px] border-t border-dark-border bg-dark-bg/50 text-center">
            <span class="text-[11px] text-gray-600 flex items-center justify-center gap-1.5">
                <i class="ph ph-shield-check text-emerald-500"></i> SecOps Connection Encrypted
            </span>
        </div>
    </div>
</body>
</html>

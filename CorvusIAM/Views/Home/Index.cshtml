@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Authentication — Corvux Security</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png?v=20261017">
    <link rel="shortcut icon" href="/favicon.ico?v=20261017" type="image/x-icon">
    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: { sans: ['Inter', 'sans-serif'] },
                    colors: {
                        brand: { 500: '#3b82f6', 600: '#2563eb' },
                        dark: { bg: '#0B0E14', card: '#111621', border: '#1E2636', hover: '#171E2E' }
                    }
                }
            }
        }
    </script>
    <script>
        if (localStorage.getItem('corvux-theme') === 'dark') {
            document.documentElement.classList.add('dark');
        }
    </script>
    
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@@phosphor-icons/web"></script>
</head>
<body class="bg-[#E4EBF3] text-slate-900 dark:bg-dark-bg dark:text-slate-200 h-screen flex items-center justify-center antialiased text-[13px] relative overflow-hidden">
    
    <div class="bg-[#F5F7FA] dark:bg-dark-card border border-slate-300/80 dark:border-dark-border rounded-xl w-full max-w-sm relative z-10 shadow-sm flex flex-col">
        <div class="p-6 border-b border-slate-300/80 dark:border-dark-border flex flex-col items-center">
            <img src="/icons/corvus-logo-light.png?v=20261017" alt="Corvux Logo" class="w-12 h-12 rounded-xl object-cover border border-slate-300/80 dark:hidden mb-3">
            <img src="/icons/corvus-logo-dark.png?v=20261017" alt="Corvux Logo" class="w-12 h-12 rounded-xl object-cover border border-dark-border hidden dark:block mb-3">
            <h1 class="text-[16px] font-semibold text-slate-900 dark:text-white m-0 tracking-tight">Corvux Security UI</h1>
            <p class="text-[12px] text-slate-500 mt-1">Enterprise Operations Platform</p>
        </div>
        
        <div class="p-6">
            @if(ViewBag.Error != null) {
                <div class="bg-red-500/10 border border-red-500/20 text-red-500 text-[12px] p-3 rounded-lg mb-4 flex items-center gap-2">
                    <i class="ph ph-warning-circle text-[16px]"></i> @ViewBag.Error
                </div>
            }

            <form method="post" action="/Home/Login" class="space-y-4">
                <div>
                    <label class="block text-[11px] font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">User ID / Email</label>
                    <div class="relative">
                        <i class="ph ph-user absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
                        <input type="email" name="email" class="w-full bg-white dark:bg-dark-bg border border-slate-200 dark:border-dark-border text-slate-900 dark:text-white text-[13px] rounded-lg pl-9 pr-3 py-2 outline-none focus:border-brand-500 transition-colors" placeholder="admin@corvus.com" required />
                    </div>
                </div>
                <div>
                    <label class="block text-[11px] font-medium text-slate-500 dark:text-slate-400 uppercase tracking-wider mb-1.5">Password</label>
                    <div class="relative">
                        <i class="ph ph-lock absolute left-3 top-1/2 -translate-y-1/2 text-slate-400"></i>
                        <input type="password" name="senha" class="w-full bg-white dark:bg-dark-bg border border-slate-200 dark:border-dark-border text-slate-900 dark:text-white text-[13px] rounded-lg pl-9 pr-3 py-2 outline-none focus:border-brand-500 transition-colors" placeholder="••••••••" required />
                    </div>
                </div>
                <button type="submit" class="w-full bg-brand-600 hover:bg-brand-500 text-white text-[13px] font-medium py-2.5 rounded-lg transition-colors mt-2 flex items-center justify-center gap-2">
                    Authenticate <i class="ph ph-arrow-right"></i>
                </button>
            </form>
        </div>
        <div class="p-4 border-t border-slate-200 dark:border-dark-border bg-slate-50/50 dark:bg-dark-bg/50 text-center rounded-b-xl">
            <span class="text-[11px] text-slate-500 flex items-center justify-center gap-1.5">
                <i class="ph ph-shield-check text-emerald-500"></i> SecOps Connection Encrypted
            </span>
        </div>
    </div>
</body>
</html>

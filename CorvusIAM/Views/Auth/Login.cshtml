@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    Layout = null;
    var configuredKey = Configuration["Turnstile:SiteKey"];
    var turnstileSiteKey = !string.IsNullOrWhiteSpace(configuredKey)
        ? configuredKey
        : "0x4AAAAAAFXK5J9F5V8zblrT";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - CorvuxIAM</title>
    
    <!-- Favicon & Brand Icons Corvus Security -->
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png?v=20261015">
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16x16.png?v=20261015">
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/icon-192.png?v=20261015">
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/icon-192.png?v=20261015">
    <link rel="shortcut icon" href="/favicon.ico?v=20261015" type="image/x-icon">

    <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="manifest" href="/manifest.json">
    <meta name="theme-color" content="#0A66C2">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <style>
        :root {
            --bg-body: #000000;
            --bg-card: #111111;
            --text-main: #FFFFFF;
            --text-muted: #888888;
            --accent-color: #0A66C2;
            --accent-color-hover: #004182;
            --border-color: #222222;
            --input-bg: #0A0A0A;
        }

        body {
            margin: 0;
            padding: 0;
            background-color: var(--bg-body);
            color: var(--text-main);
            font-family: 'Space Grotesk', sans-serif;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-container {
            width: 100%;
            max-width: 750px;
            padding: 20px;
        }

        /* BENTO GRID */
        .bento-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            grid-auto-rows: minmax(120px, auto);
            gap: 16px;
            opacity: 0;
            animation: fadeIn 0.8s ease-out forwards;
        }

        .bento-item {
            background-color: var(--bg-card);
            border-radius: 20px;
            border: 1px solid var(--border-color);
            padding: 24px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .bento-item:hover {
            border-color: rgba(10, 102, 194, 0.3);
            transform: translateY(-2px);
            box-shadow: 0 15px 40px rgba(10, 102, 194, 0.05);
        }

        .bento-span-2 { grid-column: span 2; }
        .bento-row-2 { grid-row: span 2; }

        /* DECORATIONS */
        .bento-item::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg, transparent, var(--accent-color), transparent);
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        .bento-item:hover::before {
            opacity: 1;
        }

        .glow-circle {
            position: absolute;
            width: 150px;
            height: 150px;
            background-color: var(--accent-color);
            filter: blur(80px);
            opacity: 0.1;
            border-radius: 50%;
            z-index: 0;
            pointer-events: none;
        }
        .glow-top-right { top: -50px; right: -50px; }
        .glow-bottom-left { bottom: -50px; left: -50px; }

        /* TYPOGRAPHY */
        h1, h2, h3 { margin: 0 0 8px 0; font-weight: 700; z-index: 1; position: relative; }
        h2 { font-size: 20px; }
        p { margin: 0; color: var(--text-muted); z-index: 1; position: relative; font-size: 13px; line-height: 1.4; }

        .brand-title {
            font-size: 26px;
            letter-spacing: -1px;
        }
        .brand-title span {
            color: var(--accent-color);
        }

        /* FORM ELEMENTS */
        .form-group {
            margin-bottom: 16px;
            z-index: 1;
            position: relative;
            width: 100%;
        }
        
        .form-label {
            display: block;
            margin-bottom: 6px;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-muted);
        }

        .form-control {
            width: 100%;
            background-color: var(--input-bg);
            border: 1px solid var(--border-color);
            border-radius: 10px;
            padding: 12px 14px;
            color: var(--text-main);
            font-family: inherit;
            font-size: 14px;
            transition: all 0.3s ease;
            box-sizing: border-box;
        }
        
        .form-control:focus {
            outline: none;
            border-color: var(--accent-color);
            box-shadow: 0 0 0 3px rgba(10, 102, 194, 0.1);
        }

        .btn-submit {
            width: 100%;
            background-color: var(--accent-color);
            color: #FFFFFF;
            border: none;
            border-radius: 10px;
            padding: 14px;
            font-family: inherit;
            font-size: 15px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.3s ease;
            margin-top: 10px;
            z-index: 1;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
        }

        .btn-submit:hover {
            background-color: var(--accent-color-hover);
            transform: translateY(-2px);
            box-shadow: 0 10px 20px rgba(10, 102, 194, 0.2);
        }

        /* SOCIAL & EXTRAS */
        .social-login {
            display: flex;
            gap: 10px;
            z-index: 1;
            position: relative;
        }
        .btn-social {
            flex: 1;
            background-color: var(--input-bg);
            border: 1px solid var(--border-color);
            color: var(--text-main);
            padding: 10px;
            border-radius: 10px;
            cursor: pointer;
            transition: all 0.3s ease;
            font-size: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .btn-social:hover {
            background-color: #222;
            border-color: #444;
        }

        .link {
            color: var(--accent-color);
            text-decoration: none;
            font-weight: 600;
            transition: color 0.3s;
        }
        .link:hover {
            color: var(--text-main);
            text-decoration: underline;
        }

        .stat-number {
            font-size: 36px;
            font-weight: 700;
            color: var(--accent-color);
            line-height: 1;
            margin-bottom: 5px;
        }

        /* ANIMATIONS */
        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(20px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@media (max-width: 900px) {
            .bento-grid {
                grid-template-columns: repeat(2, 1fr);
            }
            .bento-span-2 { grid-column: span 2; }
            .hide-mobile { display: none; }
        }

        @@media (max-width: 600px) {
            .bento-grid {
                grid-template-columns: 1fr;
            }
            .bento-span-2 { grid-column: span 1; }
            .login-container { padding: 10px; }
            .bento-item { padding: 20px; }
            .stat-number { font-size: 28px; }
            .brand-title { font-size: 22px; }
        }

        .error-msg {
            background-color: rgba(225, 29, 72, 0.1);
            color: #FF4444;
            padding: 12px;
            border-radius: 8px;
            border: 1px solid rgba(225, 29, 72, 0.3);
            margin-bottom: 20px;
            font-size: 14px;
            text-align: center;
            z-index: 1;
            position: relative;
        }

        /* SCROLLBAR DARK (Evita barra branca no Edge/Windows) */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #000000;
        }
        ::-webkit-scrollbar-thumb {
            background: #222222;
            border-radius: 4px;
        }
        * {
            scrollbar-width: thin;
            scrollbar-color: #222222 #000000;
        }

        .turnstile-wrapper {
            width: 100%;
            min-height: 65px;
            border-radius: 8px;
            margin-bottom: 16px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: rgba(255, 255, 255, 0.02);
            position: relative;
            z-index: 1;
            overflow: hidden;
        }

        .turnstile-wrapper iframe,
        .turnstile-wrapper .cf-turnstile {
            border-radius: 8px !important;
        }

        /* PWA MOBILE INSTALL BANNER (EXCLUSIVO PARA SMARTPHONES) */
        .pwa-mobile-banner {
            position: fixed;
            bottom: 20px;
            left: 16px;
            right: 16px;
            max-width: 400px;
            margin: 0 auto;
            background: rgba(18, 20, 24, 0.96);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(37, 99, 235, 0.4);
            border-radius: 16px;
            padding: 16px;
            box-shadow: 0 16px 36px rgba(0, 0, 0, 0.7);
            z-index: 9999;
            display: none;
            flex-direction: column;
            gap: 12px;
            animation: pwaSlideUp 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
        @@keyframes pwaSlideUp {
            from { transform: translateY(100%); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }
        .btn-install-pwa {
            flex: 1;
            background: linear-gradient(135deg, #2563EB, #1D4ED8);
            color: #FFFFFF;
            border: none;
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 13px;
            font-weight: 700;
            cursor: pointer;
            transition: all 0.2s ease;
        }
        .btn-install-pwa:hover {
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.4);
        }
        .btn-close-pwa {
            background: rgba(255, 255, 255, 0.08);
            color: #A0AEC0;
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 8px;
            padding: 10px 14px;
            font-size: 13px;
            font-weight: 600;
            cursor: pointer;
        }
    </style>
</head>
<body>

    <div class="login-container">
        <div class="bento-grid">
            
            <!-- BRANDING CARD -->
            <div class="bento-item bento-span-2" style="background: linear-gradient(135deg, #111111 0%, #050505 100%);">
                <div class="glow-circle glow-bottom-left"></div>
                <div style="z-index: 1; position: relative;">
                    <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 6px;">
                        <img src="/icons/corvus-logo.png?v=20261015" alt="Corvux Logo" style="width: 44px; height: 44px; border-radius: 12px; box-shadow: 0 4px 16px rgba(0,0,0,0.6); border: 1px solid rgba(255,255,255,0.1);">
                        <h1 class="brand-title" style="margin: 0;">Corvux<span>.</span></h1>
                    </div>
                    <p style="font-size: 15px; max-width: 400px; margin-top: 10px;">
                        Autenticação centralizada e segurança criptografada de ponta a ponta.
                    </p>
                </div>
            </div>

            <!-- QUICK STAT CARD -->
            <div class="bento-item hide-mobile text-center" style="align-items: center;">
                <div class="glow-circle glow-top-right"></div>
                <div class="stat-number">99.9%</div>
                <p>Uptime do Sistema</p>
            </div>

            <!-- LOGIN FORM CARD -->
            <div class="bento-item bento-span-2 bento-row-2">
                <h2 style="margin-bottom: 24px;">Iniciar Sessão</h2>
                
                @if (ViewBag.Erro != null)
                {
                    <div class="error-msg">
                        <i class="bi bi-exclamation-triangle"></i> @ViewBag.Erro
                    </div>
                }

                <form action="/Auth/Login" method="POST">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <label class="form-label">Email Corporativo</label>
                        <input type="email" name="email" class="form-control" placeholder="admin@empresa.com" required>
                    </div>
                    
                    <div class="form-group">
                        <div style="display: flex; justify-content: space-between; align-items: center; width: 100%; margin-bottom: 8px;">
                            <label class="form-label" style="margin-bottom: 0;">Senha de Acesso</label>
                            <a href="#" class="link" style="font-size: 12px;">Esqueceu a senha?</a>
                        </div>
                        <input type="password" name="senha" class="form-control" placeholder="••••••••" required>
                    </div>

                    <div class="turnstile-wrapper">
                        <div class="cf-turnstile" data-sitekey="@turnstileSiteKey" data-theme="dark" data-action="login"></div>
                    </div>

                    <button type="submit" class="btn-submit">
                        Entrar no Painel <i class="bi bi-arrow-right"></i>
                    </button>
                </form>
            </div>

            <!-- SOCIAL / SSO CARD -->
            <div class="bento-item">
                <h3 style="font-size: 16px; text-align: center; margin-bottom: 20px;">Ou entre com</h3>
                <div class="social-login">
                    <button class="btn-social" title="Google"><i class="bi bi-google"></i></button>
                    <button class="btn-social" title="Microsoft"><i class="bi bi-microsoft"></i></button>
                    <button class="btn-social" title="Github"><i class="bi bi-github"></i></button>
                </div>
            </div>

            <!-- SECURE BADGE CARD -->
            <div class="bento-item" style="text-align: center; display: flex; align-items: center; justify-content: center; gap: 15px;">
                <i class="bi bi-shield-check" style="font-size: 32px; color: var(--accent-color);"></i>
                <div style="text-align: left;">
                    <div style="font-weight: 700; font-size: 14px;">Conexão Segura</div>
                    <div style="font-size: 12px; color: var(--text-muted);">AES-256 Bit</div>
                </div>
            </div>

        </div>
    </div>

    <!-- BANNER PWA EXCLUSIVO MOBILE -->
    <div id="pwaMobileInstallBanner" class="pwa-mobile-banner">
        <div style="display: flex; align-items: center; gap: 12px;">
            <img src="/icons/icon-192.png" alt="CorvuxIAM" style="width: 44px; height: 44px; border-radius: 10px; border: 1px solid rgba(255,255,255,0.15);">
            <div style="flex: 1; text-align: left;">
                <div style="font-weight: 700; font-size: 14px; color: #FFF;">Instalar CorvuxIAM</div>
                <div style="font-size: 11px; color: #888888;">Acesso corporativo instantâneo e suporte offline no celular.</div>
            </div>
        </div>
        <div style="display: flex; gap: 8px;">
            <button id="pwaMobileInstallBtn" class="btn-install-pwa" onclick="executarInstalacaoPwaMobile()">Instalar App</button>
            <button onclick="fecharPwaMobileBanner()" class="btn-close-pwa">Agora Não</button>
        </div>
    </div>

    <script>
        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js').catch(err => console.warn('PWA SW Registro:', err));
            });
        }

        function checkIsMobileDevice() {
            const ua = navigator.userAgent || navigator.vendor || window.opera;
            const isMobileUA = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini|Mobile/i.test(ua);
            const isTouch = ('ontouchstart' in window) || (navigator.maxTouchPoints > 0);
            const isNarrow = window.innerWidth <= 850;
            return isMobileUA || (isTouch && isNarrow);
        }

        let deferredLoginPrompt = null;
        const isStandaloneApp = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;

        window.addEventListener('beforeinstallprompt', (e) => {
            e.preventDefault();
            deferredLoginPrompt = e;
            // Exibe a notificação de instalação EXCLUSIVAMENTE em smartphones e dispositivos móveis
            if (checkIsMobileDevice() && !sessionStorage.getItem('pwaDismissed') && !isStandaloneApp) {
                mostrarPwaMobileBanner();
            }
        });

        function mostrarPwaMobileBanner() {
            if (!checkIsMobileDevice()) return; // Nunca exibe em PCs e desktops
            const banner = document.getElementById('pwaMobileInstallBanner');
            if (banner) banner.style.display = 'flex';
        }

        function fecharPwaMobileBanner() {
            const banner = document.getElementById('pwaMobileInstallBanner');
            if (banner) banner.style.display = 'none';
            sessionStorage.setItem('pwaDismissed', 'true');
        }

        async function executarInstalacaoPwaMobile() {
            if (deferredLoginPrompt) {
                deferredLoginPrompt.prompt();
                const { outcome } = await deferredLoginPrompt.userChoice;
                deferredLoginPrompt = null;
                fecharPwaMobileBanner();
            } else {
                const isIos = /iPhone|iPad|iPod/.test(navigator.userAgent);
                if (isIos) {
                    alert('Para instalar no iOS: toque no ícone de Compartilhar do Safari e selecione "Adicionar à Tela de Início".');
                }
                fecharPwaMobileBanner();
            }
        }

        // Para smartphones que já carregaram a página e não instalaram
        if (checkIsMobileDevice() && !isStandaloneApp && !sessionStorage.getItem('pwaDismissed')) {
            setTimeout(mostrarPwaMobileBanner, 2500);
        }
    </script>
</body>
</html>

@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    Layout = null;
    var configuredKey = Configuration["Turnstile:SiteKey"];
    var turnstileSiteKey = !string.IsNullOrWhiteSpace(configuredKey)
        ? configuredKey
        : "0x4AAAAAAFXK5J9F5V8zblrT";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Login — CorvuxIAM</title>
    
    <!-- Favicon & Brand Icons Corvux Security -->
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png?v=20261018">
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16x16.png?v=20261018">
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/corvux-icon-192.png?v=20261018">
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/corvux-icon-192.png?v=20261018">
    <link rel="shortcut icon" href="/favicon.ico?v=20261018" type="image/x-icon">

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="manifest" href="/manifest.json?v=20261018">
    <meta name="theme-color" content="#070709">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <script>
        if (localStorage.getItem('corvux-theme') === 'dark') {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
        }

        :root {
            --bg-body: #E4EBF3;
            --bg-card: #F5F7FA;
            --bg-card-subtle: #EBF0F6;
            --text-main: #0F172A;
            --text-secondary: #334155;
            --text-muted: #64748B;
            --accent-color: #2563EB;
            --accent-color-hover: #1D4ED8;
            --border-color: #CBD5E1;
            --border-hover: #94A3B8;
            --input-bg: #EDF2F7;
            --card-shadow: 0 2px 6px rgba(15, 23, 42, 0.05), 0 1px 2px rgba(15, 23, 42, 0.03);
            --card-shadow-hover: 0 8px 24px rgba(15, 23, 42, 0.08);
        }

        html.dark {
            --bg-body: #070709;
            --bg-card: #0E0E12;
            --bg-card-subtle: #16161C;
            --text-main: #FAFAFA;
            --text-secondary: #D4D4D8;
            --text-muted: #A1A1AA;
            --accent-color: #3B82F6;
            --accent-color-hover: #2563EB;
            --border-color: #22222A;
            --border-hover: #3F3F46;
            --input-bg: #09090C;
            --card-shadow: 0 4px 20px rgba(0, 0, 0, 0.5);
            --card-shadow-hover: 0 12px 32px rgba(0, 0, 0, 0.65);
        }

        html, body {
            margin: 0;
            padding: 0;
            width: 100%;
            height: 100dvh;
            max-height: 100dvh;
            overflow: hidden;
            scrollbar-width: none;
            -ms-overflow-style: none;
            background-color: var(--bg-body);
            color: var(--text-main);
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            -webkit-font-smoothing: antialiased;
            transition: background-color 0.2s ease, color 0.2s ease;
        }
        html::-webkit-scrollbar, body::-webkit-scrollbar {
            display: none;
            width: 0;
            height: 0;
        }
        html:not(.dark) body {
            background-image: radial-gradient(circle at 20% 20%, rgba(37, 99, 235, 0.06), transparent 45%),
                              radial-gradient(circle at 80% 80%, rgba(15, 23, 42, 0.04), transparent 50%);
        }

        .login-container {
            width: 100%;
            max-width: 720px;
            padding: 12px 16px;
            max-height: 100dvh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        /* BENTO GRID - TRAÇOS FINOS (HAIRLINE) E SEM SCROLLBAR */
        .bento-grid {
            width: 100%;
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            grid-auto-rows: auto;
            gap: 10px;
            opacity: 0;
            animation: fadeIn 0.4s ease-out forwards;
        }

        .bento-item {
            background-color: var(--bg-card);
            border-radius: 12px;
            border: 1px solid var(--border-color);
            padding: 16px 20px;
            box-shadow: var(--card-shadow);
            transition: all 0.2s ease;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .bento-item:hover {
            border-color: var(--border-hover);
            box-shadow: var(--card-shadow-hover);
        }

        .bento-span-2 { grid-column: span 2; }
        .bento-row-2 { grid-row: span 2; }

        .glow-circle {
            position: absolute;
            width: 140px;
            height: 140px;
            background-color: var(--accent-color);
            filter: blur(80px);
            opacity: 0.05;
            border-radius: 50%;
            z-index: 0;
            pointer-events: none;
        }
        .glow-top-right { top: -40px; right: -40px; }
        .glow-bottom-left { bottom: -40px; left: -40px; }

        /* TYPOGRAPHY */
        h1, h2, h3 { margin: 0 0 4px 0; font-weight: 600; letter-spacing: -0.025em; z-index: 1; position: relative; }
        h2 { font-size: 16px; }
        p { margin: 0; color: var(--text-muted); z-index: 1; position: relative; font-size: 12.5px; line-height: 1.45; font-weight: 400; }

        .brand-title {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 22px;
            font-weight: 700;
            letter-spacing: -0.03em;
        }
        .brand-title span {
            color: var(--accent-color);
        }

        /* LOGO LIGHT / DARK SWITCHING */
        .logo-dark { display: none; }
        .logo-light { display: block; }
        html.dark .logo-dark { display: block; }
        html.dark .logo-light { display: none; }

        /* FORM ELEMENTS */
        .form-group {
            margin-bottom: 11px;
            z-index: 1;
            position: relative;
            width: 100%;
        }
        
        .form-label {
            display: block;
            margin-bottom: 5px;
            font-size: 10.5px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: var(--text-muted);
        }

        .form-control {
            width: 100%;
            background-color: var(--input-bg);
            border: 1px solid var(--border-color);
            border-radius: 8px;
            padding: 9px 12px;
            color: var(--text-main);
            font-family: inherit;
            font-size: 13px;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }
        
        .form-control:focus {
            outline: none;
            border-color: var(--accent-color);
            box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.12);
        }

        .btn-submit {
            width: 100%;
            background-color: var(--accent-color);
            color: #FFFFFF;
            border: 1px solid transparent;
            border-radius: 8px;
            padding: 10px 14px;
            font-family: inherit;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
            margin-top: 4px;
            z-index: 1;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        .btn-submit:hover {
            background-color: var(--accent-color-hover);
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(37, 99, 235, 0.2);
        }

        /* SOCIAL & EXTRAS */
        .social-login {
            display: flex;
            gap: 8px;
            z-index: 1;
            position: relative;
        }
        .btn-social {
            flex: 1;
            background-color: var(--input-bg);
            border: 1px solid var(--border-color);
            color: var(--text-secondary);
            padding: 8px;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.2s ease;
            font-size: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .btn-social:hover {
            border-color: var(--accent-color);
            color: var(--accent-color);
        }

        .link {
            color: var(--accent-color);
            text-decoration: none;
            font-weight: 500;
            transition: opacity 0.2s;
        }
        .link:hover {
            text-decoration: underline;
        }

        .stat-number {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 28px;
            font-weight: 600;
            color: var(--accent-color);
            line-height: 1;
            margin-bottom: 4px;
            letter-spacing: -0.03em;
        }

        .theme-switch-btn {
            position: fixed;
            top: 14px;
            right: 14px;
            width: 34px;
            height: 34px;
            border-radius: 8px;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            color: var(--text-secondary);
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            box-shadow: var(--card-shadow);
            transition: all 0.2s ease;
            z-index: 50;
        }
        .theme-switch-btn:hover {
            border-color: var(--accent-color);
            color: var(--accent-color);
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }

        @@media (max-width: 900px), (max-height: 680px) {
            .bento-grid { grid-template-columns: 1fr; max-width: 440px; margin: 0 auto; }
            .bento-span-2 { grid-column: span 1; }
            .bento-row-2 { grid-row: span 1; }
            .hide-mobile { display: none !important; }
            .login-container { padding: 10px 14px; }
            .bento-item { padding: 14px 16px; }
        }

        @@media (min-width: 900px) {
            #pwaMobileInstallBanner {
                display: none !important;
                visibility: hidden !important;
                pointer-events: none !important;
            }
        }

        .error-msg {
            background-color: rgba(239, 68, 68, 0.08);
            color: #EF4444;
            padding: 8px 10px;
            border-radius: 8px;
            border: 1px solid rgba(239, 68, 68, 0.25);
            margin-bottom: 10px;
            font-size: 11.5px;
            z-index: 1;
            position: relative;
        }

        .success-msg {
            background-color: rgba(16, 185, 129, 0.08);
            color: #10B981;
            padding: 8px 10px;
            border-radius: 8px;
            border: 1px solid rgba(16, 185, 129, 0.25);
            margin-bottom: 10px;
            font-size: 11.5px;
            z-index: 1;
            position: relative;
        }

        .turnstile-wrapper {
            width: 100%;
            min-height: 65px;
            border-radius: 8px;
            margin-bottom: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            z-index: 1;
            overflow: hidden;
        }

        /* PWA MOBILE INSTALL BANNER */
        .pwa-mobile-banner {
            position: fixed;
            bottom: 12px;
            left: 12px;
            right: 12px;
            max-width: 390px;
            margin: 0 auto;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 12px;
            box-shadow: 0 12px 32px rgba(0, 0, 0, 0.35);
            z-index: 9999;
            display: none;
            flex-direction: column;
            gap: 8px;
        }
        .btn-install-pwa {
            flex: 1;
            background: var(--accent-color);
            color: #FFFFFF;
            border: none;
            border-radius: 7px;
            padding: 8px 12px;
            font-size: 12px;
            font-weight: 500;
            cursor: pointer;
        }
        .btn-close-pwa {
            background: transparent;
            color: var(--text-muted);
            border: 1px solid var(--border-color);
            border-radius: 7px;
            padding: 8px 12px;
            font-size: 12px;
            font-weight: 500;
            cursor: pointer;
        }
    </style>
</head>
<body>

    <button type="button" class="theme-switch-btn" onclick="alternarTemaLogin()" title="Alternar Tema Claro / Escuro">
        <i id="loginThemeIcon" class="bi bi-moon"></i>
    </button>

    <div class="login-container">
        <div class="bento-grid">
            
            <!-- BRANDING CARD -->
            <div class="bento-item bento-span-2">
                <div class="glow-circle glow-bottom-left"></div>
                <div style="z-index: 1; position: relative;">
                    <div style="display: flex; align-items: center; gap: 11px;">
                        <img src="/icons/corvus-logo-light.png?v=20261018" alt="Corvux Logo" class="logo-light" style="width: 38px; height: 38px; border-radius: 9px; border: 1px solid var(--border-color); object-fit: cover;">
                        <img src="/icons/corvus-logo-dark.png?v=20261018" alt="Corvux Logo" class="logo-dark" style="width: 38px; height: 38px; border-radius: 9px; border: 1px solid var(--border-color); object-fit: cover;">
                        <div>
                            <h1 class="brand-title" style="margin: 0; line-height: 1.05;">Corvux<span>IAM</span></h1>
                            <span style="font-size: 10px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--text-muted); font-weight: 500;">Zero Trust Identity & SecOps</span>
                        </div>
                    </div>
                    <p style="font-size: 12px; max-width: 420px; margin-top: 6px;">
                        Governança centralizada de identidades, controle de acesso baseado em papéis (RBAC) e defesa cibernética em tempo real.
                    </p>
                </div>
            </div>

            <!-- QUICK STAT CARD -->
            <div class="bento-item hide-mobile" style="align-items: center; text-align: center;">
                <div class="glow-circle glow-top-right"></div>
                <div class="stat-number">99.98%</div>
                <p style="font-size: 11.5px;">Disponibilidade SLA</p>
            </div>

            <!-- LOGIN FORM CARD -->
            <div class="bento-item bento-span-2 bento-row-2">
                <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                    <h2 style="margin: 0;">Autenticação Corporativa</h2>
                    <div style="display: flex; align-items: center; gap: 6px;">
                        <button type="button" onclick="ouvirInstrucoesLogin()" title="Ouvir instruções em voz natural (Text-to-Speech)" style="background: transparent; border: 1px solid var(--border-color); color: var(--text-secondary); padding: 2px 8px; border-radius: 999px; font-size: 10.5px; cursor: pointer; display: inline-flex; align-items: center; gap: 4px;">
                            <i class="bi bi-volume-up"></i> Ouvir
                        </button>
                        <span style="font-size: 10.5px; color: var(--text-muted); border: 1px solid var(--border-color); padding: 2px 8px; border-radius: 999px;">TLS 1.3</span>
                    </div>
                </div>
                
                @if (ViewBag.Erro != null)
                {
                    <div class="error-msg">
                        <i class="bi bi-exclamation-triangle"></i> @ViewBag.Erro
                    </div>
                }
                @if (Context.Request.Query["mensagem"].Count > 0)
                {
                    <div class="success-msg">
                        <i class="bi bi-check-circle"></i> @Context.Request.Query["mensagem"]
                    </div>
                }

                <form action="/Auth/Login" method="POST" id="loginForm">
                    @Html.AntiForgeryToken()
                    <div class="form-group">
                        <div style="display: flex; justify-content: space-between; align-items: center; width: 100%; margin-bottom: 5px;">
                            <label class="form-label" style="margin-bottom: 0;">E-mail Corporativo</label>
                            <button type="button" onclick="ditarEmailLogin()" title="Ditar e-mail por voz (Speech-to-Text)" style="background: none; border: none; color: var(--accent-color); font-size: 11px; cursor: pointer; display: inline-flex; align-items: center; gap: 3px;">
                                <i class="bi bi-mic"></i> Ditar
                            </button>
                        </div>
                        <input type="email" id="loginEmail" name="email" class="form-control" placeholder="nome@corvus.com" required>
                    </div>
                    
                    <div class="form-group">
                        <div style="display: flex; justify-content: space-between; align-items: center; width: 100%; margin-bottom: 5px;">
                            <label class="form-label" style="margin-bottom: 0;">Senha de Acesso</label>
                            <a href="/Auth/EsqueciSenha" class="link" style="font-size: 11px;">Esqueceu a senha?</a>
                        </div>
                        <input type="password" id="loginSenha" name="senha" class="form-control" placeholder="••••••••" required>
                    </div>

                    <div class="turnstile-wrapper">
                        <div class="cf-turnstile" data-sitekey="@turnstileSiteKey" data-action="login"></div>
                    </div>

                    <button type="submit" class="btn-submit">
                        Acessar Plataforma <i class="bi bi-arrow-right"></i>
                    </button>
                </form>
            </div>

            <!-- SOCIAL / SSO CARD -->
            <div class="bento-item">
                <h3 style="font-size: 12px; font-weight: 500; text-align: center; margin-bottom: 10px; color: var(--text-secondary);">Single Sign-On (SSO)</h3>
                <div class="social-login">
                    <button type="button" class="btn-social" title="Google Workspace" onclick="preencherCredencial('admin@corvus.com', 'Cv1670!')"><i class="bi bi-google"></i></button>
                    <button type="button" class="btn-social" title="Microsoft Entra ID" onclick="preencherCredencial('admin@corvus.com', 'Cv1670!')"><i class="bi bi-microsoft"></i></button>
                    <button type="button" class="btn-social" title="GitHub Enterprise" onclick="preencherCredencial('admin@corvus.com', 'Cv1670!')"><i class="bi bi-github"></i></button>
                </div>
            </div>

            <!-- SECURE BADGE CARD -->
            <div class="bento-item hide-mobile" style="display: flex; flex-direction: row; align-items: center; justify-content: center; gap: 10px;">
                <i class="bi bi-shield-check" style="font-size: 24px; color: var(--accent-color);"></i>
                <div style="text-align: left;">
                    <div style="font-weight: 600; font-size: 12.5px;">Zero Trust Ativo</div>
                    <div style="font-size: 11px; color: var(--text-muted);">Criptografia AES-256</div>
                </div>
            </div>

        </div>
    </div>

    <!-- Widget Oficial VLibras (Governo Federal) -->
    <div vw class="enabled">
        <div vw-access-button class="active"></div>
        <div vw-plugin-wrapper>
            <div class="vw-plugin-top-wrapper"></div>
        </div>
    </div>
    <script src="https://vlibras.gov.br/app/vlibras-plugin.js" async onload="if(window.VLibras){new window.VLibras.Widget('https://vlibras.gov.br/app');}"></script>

    <!-- BANNER PWA EXCLUSIVO MOBILE -->
    <div id="pwaMobileInstallBanner" class="pwa-mobile-banner">
        <div style="display: flex; align-items: center; gap: 10px;">
            <img src="/icons/corvus-logo-light.png?v=20261018" alt="CorvuxIAM" class="logo-light" style="width: 38px; height: 38px; border-radius: 9px; border: 1px solid var(--border-color); object-fit: cover;">
            <img src="/icons/corvus-logo-dark.png?v=20261018" alt="CorvuxIAM" class="logo-dark" style="width: 38px; height: 38px; border-radius: 9px; border: 1px solid var(--border-color); object-fit: cover;">
            <div style="flex: 1; text-align: left;">
                <div style="font-weight: 600; font-size: 12.5px; color: var(--text-main);">Instalar App CorvuxIAM</div>
                <div style="font-size: 11px; color: var(--text-muted);">Acesso corporativo rápido e suporte offline no celular.</div>
            </div>
        </div>
        <div style="display: flex; gap: 8px;">
            <button id="pwaMobileInstallBtn" class="btn-install-pwa" onclick="executarInstalacaoPwaMobile()">Instalar App</button>
            <button onclick="fecharPwaMobileBanner()" class="btn-close-pwa">Agora Não</button>
        </div>
    </div>

    <script>
        function ouvirInstrucoesLogin() {
            if (!('speechSynthesis' in window)) return;
            window.speechSynthesis.cancel();
            const u = new SpeechSynthesisUtterance('Bem-vindo ao portal de autenticação corporativa Corvux I A M. Insira seu e-mail corporativo e sua senha de acesso, valide a proteção Cloudflare e clique em Acessar Plataforma.');
            u.lang = 'pt-BR';
            window.speechSynthesis.speak(u);
        }

        function ditarEmailLogin() {
            const SpeechRec = window.SpeechRecognition || window.webkitSpeechRecognition;
            if (!SpeechRec) return;
            const rec = new SpeechRec();
            rec.lang = 'pt-BR';
            rec.onresult = (ev) => {
                let txt = (ev.results?.[0]?.[0]?.transcript || '').toLowerCase()
                    .replace(/\s+arroba\s+/g, '@@').replace(/\s+ponto\s+/g, '.').replace(/\s+/g, '');
                const inp = document.getElementById('loginEmail');
                if (inp && txt) inp.value = txt;
            };
            rec.start();
        }

        function atualizarIconeTemaLogin() {
            const icon = document.getElementById('loginThemeIcon');
            if (!icon) return;
            if (document.documentElement.classList.contains('dark')) {
                icon.className = 'bi bi-sun';
            } else {
                icon.className = 'bi bi-moon';
            }
        }
        atualizarIconeTemaLogin();

        function alternarTemaLogin() {
            document.documentElement.classList.toggle('dark');
            const isDark = document.documentElement.classList.contains('dark');
            localStorage.setItem('corvux-theme', isDark ? 'dark' : 'light');
            localStorage.setItem('color-theme', isDark ? 'dark' : 'light');
            atualizarIconeTemaLogin();
        }

        function preencherCredencial(email, senha) {
            const emailInput = document.getElementById('loginEmail');
            const senhaInput = document.getElementById('loginSenha');
            if (emailInput && senhaInput) {
                emailInput.value = email;
                senhaInput.value = senha;
                emailInput.focus();
            }
        }

        if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
                navigator.serviceWorker.register('/sw.js').then(reg => {
                    reg.update();
                }).catch(err => console.warn('PWA SW Registro:', err));
            });
        }

        function checkIsMobileDevice() {
            if (navigator.userAgentData && typeof navigator.userAgentData.mobile === 'boolean') {
                return navigator.userAgentData.mobile;
            }
            const ua = navigator.userAgent || '';
            const isMobileUA = /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(ua);
            const hasTouch = ('ontouchstart' in window) || (navigator.maxTouchPoints > 0);
            if (/Windows NT|Macintosh|Linux x86_64/i.test(ua) && !isMobileUA) return false;
            return isMobileUA || (hasTouch && window.innerWidth <= 768);
        }

        let deferredLoginPrompt = null;
        const isStandaloneApp = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;

        window.addEventListener('beforeinstallprompt', (e) => {
            e.preventDefault();
            deferredLoginPrompt = e;
            if (checkIsMobileDevice() && !sessionStorage.getItem('pwaDismissed') && !isStandaloneApp) {
                mostrarPwaMobileBanner();
            }
        });

        function mostrarPwaMobileBanner() {
            if (!checkIsMobileDevice()) return;
            const banner = document.getElementById('pwaMobileInstallBanner');
            if (banner) banner.style.display = 'flex';
        }

        function fecharPwaMobileBanner() {
            const banner = document.getElementById('pwaMobileInstallBanner');
            if (banner) banner.style.display = 'none';
            sessionStorage.setItem('pwaDismissed', 'true');
        }

        async function executarInstalacaoPwaMobile() {
            if (deferredLoginPrompt) {
                deferredLoginPrompt.prompt();
                const { outcome } = await deferredLoginPrompt.userChoice;
                deferredLoginPrompt = null;
                fecharPwaMobileBanner();
            } else {
                const isIos = /iPhone|iPad|iPod/.test(navigator.userAgent);
                if (isIos) {
                    alert('Para instalar no iOS: toque no ícone de Compartilhar do Safari e selecione "Adicionar à Tela de Início".');
                }
                fecharPwaMobileBanner();
            }
        }

        if (checkIsMobileDevice() && !isStandaloneApp && !sessionStorage.getItem('pwaDismissed')) {
            setTimeout(mostrarPwaMobileBanner, 2500);
        }
    </script>
</body>
</html>

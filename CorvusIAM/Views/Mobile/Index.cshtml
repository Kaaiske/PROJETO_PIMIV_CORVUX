@{
    Layout = null;
    ViewData["Title"] = "CorvuxIAM Mobile";
}
<!doctype html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#070709" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png?v=20261018" />
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/corvux-icon-192.png?v=20261018" />
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/corvux-icon-192.png?v=20261018" />
    <link rel="shortcut icon" href="/favicon.ico?v=20261018" type="image/x-icon" />
    <link rel="manifest" href="/manifest.json?v=20261018" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/mobile/app.css?v=20261018" />
    <title>CorvuxIAM Mobile</title>
    <script>
        if (localStorage.getItem('corvux-theme') === 'dark') {
            document.documentElement.classList.add('dark');
        }
    </script>
</head>
<body>
    <main class="app" aria-labelledby="titulo">
        <header>
            <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:12px;">
                <div style="display:flex; align-items:center; gap:10px;">
                    <img src="/icons/corvus-logo-light.png?v=20261018" alt="Corvux Logo" class="logo-light" style="width:36px; height:36px; border-radius:8px; border:1px solid var(--border-color); object-fit:cover;">
                    <img src="/icons/corvus-logo-dark.png?v=20261018" alt="Corvux Logo" class="logo-dark" style="width:36px; height:36px; border-radius:8px; border:1px solid var(--border-color); object-fit:cover;">
                    <p class="marca" style="margin:0; font-size:0.95rem; letter-spacing:0.04em;">CORVUX IAM</p>
                </div>
                <a href="/Admin/Index" style="font-size:0.78rem; color:var(--accent); text-decoration:none; border:1px solid var(--border-color); padding:5px 10px; border-radius:6px;">Voltar ao Painel</a>
            </div>
            <h1 id="titulo">Olá, @(User.Identity?.Name ?? "Colaborador")</h1>
            <p style="margin:0; font-size:0.84rem; color:var(--text-muted);">Central de suporte corporativo e abertura rápida de chamados</p>
        </header>

        <!-- Banner de Instalação PWA -->
        <div id="pwa-install-banner" class="install-banner" style="display:none; align-items:center; gap:12px;">
            <img src="/icons/corvus-logo-light.png?v=20261018" alt="CorvuxIAM" class="logo-light" style="width:38px; height:38px; border-radius:8px; border:1px solid var(--border-color); object-fit:cover;">
            <img src="/icons/corvus-logo-dark.png?v=20261018" alt="CorvuxIAM" class="logo-dark" style="width:38px; height:38px; border-radius:8px; border:1px solid var(--border-color); object-fit:cover;">
            <div style="flex:1;">
                <strong style="font-size:0.85rem;">Instalar Aplicativo CorvuxIAM</strong>
                <p style="margin:2px 0 0 0; font-size:0.76rem; color:var(--text-muted);">Instale no seu smartphone para acesso rápido e suporte offline.</p>
            </div>
            <button id="pwa-install-btn" class="install-btn">Instalar</button>
        </div>

        <section aria-labelledby="novo-chamado">
            <h2 id="novo-chamado">Abrir chamado de suporte</h2>
            <form id="chamado-form">
                <label>Assunto
                    <input id="assunto" required maxlength="100" autocomplete="off" placeholder="Ex: Solicitação de acesso VPN" />
                </label>
                <label>Categoria
                    <select id="categoria">
                        <option value="Acesso" selected>Acesso e Permissões</option>
                        <option value="Hardware">Hardware / Equipamento</option>
                        <option value="Software">Software / Licença</option>
                        <option value="Rede">Rede / Conectividade</option>
                        <option value="Segurança">Segurança / Alerta</option>
                    </select>
                </label>
                <label>Prioridade
                    <select id="prioridade">
                        <option value="Baixa">Baixa</option>
                        <option value="Normal" selected>Normal</option>
                        <option value="Alta">Alta</option>
                        <option value="Critica">Crítica</option>
                    </select>
                </label>
                <label>Descrição
                    <textarea id="descricao" required maxlength="1000" placeholder="Descreva detalhadamente o problema ou solicitação..."></textarea>
                </label>
                <button type="submit">Enviar chamado</button>
            </form>
            <p id="mensagem" role="status"></p>
        </section>
        <section aria-labelledby="meus-chamados">
            <h2 id="meus-chamados">Meus chamados recentes</h2>
            <div id="lista" aria-live="polite" style="font-size:0.85rem; color:var(--text-muted);">Carregando…</div>
        </section>
        <div style="display:flex; justify-content:space-between; align-items:center; margin-top:12px;">
            <a class="sair" href="/Portal/MinhaConta">Minha Conta</a>
            <a class="sair" href="/Auth/Logout" style="color:#EF4444;">Encerrar Sessão</a>
        </div>
    </main>
    <script src="~/mobile/app.js?v=20261018"></script>
</body>
</html>

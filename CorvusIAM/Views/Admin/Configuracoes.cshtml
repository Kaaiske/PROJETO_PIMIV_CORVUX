@section Scripts {
    <script>
        async function executarProcedureDb(procName) {
            try {
                const res = await fetch('/Admin/ExecutarProcedureBanco', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getCsrfToken()
                    },
                    body: JSON.stringify({ Procedure: procName })
                });
                const data = await res.json();
                Swal.fire({
                    title: 'Stored Procedure Executada',
                    text: data.message || ('Rotina ' + procName + ' concluída com sucesso.'),
                    icon: 'success',
                    background: '#0E0E12',
                    color: '#FAFAFA',
                    confirmButtonColor: '#3B82F6'
                });
            } catch (err) {
                Swal.fire({ title: 'Erro', text: 'Falha ao comunicar com o motor de banco de dados.', icon: 'error' });
            }
        }
        async function salvarConfiguracoes(e) {
            e.preventDefault();
            const btn = document.getElementById('btnSalvarCfg');
            btn.disabled = true;
            btn.innerHTML = '<i class="ph ph-spinner-gap animate-spin"></i> Salvando...';

            const configs = {};
            document.querySelectorAll('.cfg-input').forEach(inp => {
                const chave = inp.getAttribute('data-chave');
                if (chave) {
                    configs[chave] = inp.value;
                }
            });

            try {
                const res = await fetch('/Admin/SalvarConfiguracoes', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getCsrfToken()
                    },
                    body: JSON.stringify({ Configs: configs })
                });

                if (res.ok) {
                    Swal.fire({
                        title: 'Configurações Salvas!',
                        text: 'Todos os parâmetros corporativos foram persistidos e sincronizados no banco de dados.',
                        icon: 'success',
                        background: '#121418',
                        color: '#fff',
                        confirmButtonColor: '#3B82F6'
                    }).then(() => window.location.reload());
                } else {
                    Swal.fire({ title: 'Erro!', text: 'Falha ao salvar as configurações.', icon: 'error', background: '#121418', color: '#fff' });
                    btn.disabled = false;
                    btn.innerHTML = '<i class="ph ph-floppy-disk"></i> Salvar Configurações';
                }
            } catch (err) {
                Swal.fire({ title: 'Erro de Conexão', text: 'Não foi possível comunicar com o servidor.', icon: 'error', background: '#121418', color: '#fff' });
                btn.disabled = false;
                btn.innerHTML = '<i class="ph ph-floppy-disk"></i> Salvar Configurações';
            }
        }

        function restaurarPadroesSeguros() {
            Swal.fire({
                title: 'Restaurar Baseline de Segurança?',
                text: 'Deseja carregar os valores recomendados pelo guia NIST / CIS Controls para o CorvuxIAM?',
                icon: 'question',
                showCancelButton: true,
                confirmButtonText: 'Sim, Restaurar Baseline',
                cancelButtonText: 'Cancelar',
                confirmButtonColor: '#3B82F6',
                cancelButtonColor: '#374151',
                background: '#121418',
                color: '#fff'
            }).then((result) => {
                if (result.isConfirmed) {
                    const baselines = {
                        'SESSION_TIMEOUT_MINUTES': '30',
                        'JWT_EXPIRATION_HOURS': '8',
                        'MAX_LOGIN_ATTEMPTS': '5',
                        'ACCOUNT_LOCKOUT_MINUTES': '15',
                        'MFA_ENFORCEMENT_ADMINS': 'true',
                        'LOCKDOWN_MODE': 'false',
                        'WAF_RATE_LIMIT_PER_MINUTE': '60',
                        'AUTO_ISOLATE_HIGH_RISK_ENDPOINTS': 'true',
                        'ENABLE_DEEP_PACKET_INSPECTION': 'true',
                        'LGPD_DATA_RETENTION_DAYS': '180',
                        'COOKIE_CONSENT_STRICT_MODE': 'true',
                        'AUDIT_LOG_ANONYMIZATION': 'true',
                        'SMTP_HOST': 'smtp.gmail.com',
                        'SMTP_PORT': '587',
                        'SYSTEM_SENDER_EMAIL': 'seguranca@corvuxiam.tech',
                        'TURNSTILE_SITEKEY': '0x4AAAAAAFXK5J9F5V8zblrT',
                        'TURNSTILE_MODE': 'Interactive',
                        'A11Y_TTS_PROVIDER': 'Hybrid_GCloud_WebSpeech',
                        'A11Y_STT_ENABLED': 'true',
                        'A11Y_VLIBRAS_ENABLED': 'true'
                    };

                    document.querySelectorAll('.cfg-input').forEach(inp => {
                        const chave = inp.getAttribute('data-chave');
                        if (baselines[chave] !== undefined) {
                            inp.value = baselines[chave];
                        }
                    });

                    Swal.fire({
                        title: 'Baseline Carregado!',
                        text: 'Clique em "Salvar Alterações" para gravar permanentemente.',
                        icon: 'info',
                        background: '#121418',
                        color: '#fff',
                        confirmButtonColor: '#3B82F6'
                    });
                }
            });
        }
    </script>
}

@model IEnumerable<CorvusIAM.Entities.ConfiguracaoSistema>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Configurações";

    var dict = Model.ToDictionary(m => m.Chave, m => m.Valor ?? "");
    string GetVal(string key, string def = "")
    {
        if (!dict.TryGetValue(key, out var v) || string.IsNullOrWhiteSpace(v)) return def;
        if (key == "TURNSTILE_SITEKEY" && (v.StartsWith("3x0000") || v.StartsWith("1x0000"))) return "0x4AAAAAAFXK5J9F5V8zblrT";
        return v;
    }
}

<div class="mb-3.5 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2.5">
    <div>
        <h1 class="text-[16px] font-[600] text-gray-900 dark:text-white flex items-center gap-2 m-0">
            <i class="ph ph-sliders-horizontal text-brand-500"></i> Parâmetros do Sistema
        </h1>
        <p class="text-[11px] text-gray-500 dark:text-gray-400 mt-0.5 leading-relaxed max-w-3xl">
            Esta área centraliza as políticas globais de segurança do CorvuxIAM: tempos de expiração de sessão e tokens JWT, proteção contra força bruta, blindagem de borda Cloudflare WAF/Turnstile, motores de acessibilidade assistiva (Voz Neural / VLibras) e rotinas do banco de dados.
        </p>
    </div>
    <div class="flex items-center gap-2 shrink-0">
        <button type="button" onclick="restaurarPadroesSeguros()" class="bg-white dark:bg-dark-card border border-gray-300 dark:border-dark-border text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-dark-hover text-[12px] font-medium px-3 py-1.5 rounded-[6px] transition-colors flex items-center gap-1.5 cursor-pointer" title="Restaurar Baseline NIST">
            <i class="ph ph-arrow-counter-clockwise"></i> Padrão
        </button>
        <button type="button" onclick="document.getElementById('formConfiguracoes').requestSubmit()" id="btnSalvarCfgTop" class="bg-brand-600 hover:bg-brand-500 text-white text-[12px] font-semibold px-3.5 py-1.5 rounded-[6px] shadow-xs transition-colors flex items-center gap-1.5 cursor-pointer">
            <i class="ph ph-floppy-disk"></i> Salvar
        </button>
    </div>
</div>

<!-- Abas de Navegação das Configurações -->
<div class="flex items-center gap-1.5 overflow-x-auto pb-2 mb-3 text-[12px] border-b border-gray-200 dark:border-dark-border scrollbar-none" id="cfgTabsContainer">
    <button type="button" onclick="filtrarAbaConfig('todas', this)" class="cfg-tab-btn px-3 py-1.5 rounded-[6px] font-medium bg-brand-600 text-white transition-colors cursor-pointer flex items-center gap-1.5 shrink-0">
        <i class="ph ph-squares-four"></i> Todas as Seções
    </button>
    <button type="button" onclick="filtrarAbaConfig('iam', this)" class="cfg-tab-btn px-3 py-1.5 rounded-[6px] font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-200/60 dark:hover:bg-dark-hover hover:text-gray-900 dark:hover:text-white transition-colors cursor-pointer flex items-center gap-1.5 shrink-0">
        <i class="ph ph-fingerprint text-blue-500"></i> Identidade &amp; IAM
    </button>
    <button type="button" onclick="filtrarAbaConfig('seguranca', this)" class="cfg-tab-btn px-3 py-1.5 rounded-[6px] font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-200/60 dark:hover:bg-dark-hover hover:text-gray-900 dark:hover:text-white transition-colors cursor-pointer flex items-center gap-1.5 shrink-0">
        <i class="ph ph-shield-check text-emerald-500"></i> Firewall &amp; WAF
    </button>
    <button type="button" onclick="filtrarAbaConfig('a11y', this)" class="cfg-tab-btn px-3 py-1.5 rounded-[6px] font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-200/60 dark:hover:bg-dark-hover hover:text-gray-900 dark:hover:text-white transition-colors cursor-pointer flex items-center gap-1.5 shrink-0">
        <i class="ph ph-speaker-high text-purple-500"></i> Acessibilidade &amp; Voz
    </button>
    <button type="button" onclick="filtrarAbaConfig('lgpd', this)" class="cfg-tab-btn px-3 py-1.5 rounded-[6px] font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-200/60 dark:hover:bg-dark-hover hover:text-gray-900 dark:hover:text-white transition-colors cursor-pointer flex items-center gap-1.5 shrink-0">
        <i class="ph ph-scales text-amber-500"></i> Privacidade &amp; LGPD
    </button>
    <button type="button" onclick="filtrarAbaConfig('smtp', this)" class="cfg-tab-btn px-3 py-1.5 rounded-[6px] font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-200/60 dark:hover:bg-dark-hover hover:text-gray-900 dark:hover:text-white transition-colors cursor-pointer flex items-center gap-1.5 shrink-0">
        <i class="ph ph-envelope-simple text-indigo-500"></i> E-mail SMTP
    </button>
    <button type="button" onclick="filtrarAbaConfig('borda', this)" class="cfg-tab-btn px-3 py-1.5 rounded-[6px] font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-200/60 dark:hover:bg-dark-hover hover:text-gray-900 dark:hover:text-white transition-colors cursor-pointer flex items-center gap-1.5 shrink-0">
        <i class="ph ph-robot text-orange-500"></i> Cloudflare Turnstile
    </button>
    <button type="button" onclick="filtrarAbaConfig('db', this)" class="cfg-tab-btn px-3 py-1.5 rounded-[6px] font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-200/60 dark:hover:bg-dark-hover hover:text-gray-900 dark:hover:text-white transition-colors cursor-pointer flex items-center gap-1.5 shrink-0">
        <i class="ph ph-database text-cyan-500"></i> Banco SQL
    </button>
</div>

<form id="formConfiguracoes" onsubmit="salvarConfiguracoes(event)">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-3.5" id="cfgCardsGrid">

        <!-- BENTO 1 (7 Cols): IDENTIDADE & SESSÃO -->
        <div data-tab="iam" class="cfg-card lg:col-span-7 bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] p-4 flex flex-col justify-between">
            <div>
                <div class="flex items-center justify-between mb-3 pb-2 border-b border-gray-100 dark:border-dark-border">
                    <h3 class="text-[13px] font-[600] text-gray-900 dark:text-white flex items-center gap-2">
                        <i class="ph ph-fingerprint text-blue-500 text-[16px]"></i> Identidade &amp; Sessão (IAM)
                    </h3>
                    <div class="flex items-center gap-2">
                        <span class="text-[11px] text-gray-500">MFA Admin:</span>
                        <select data-chave="MFA_ENFORCEMENT_ADMINS" class="cfg-input dark-select bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[11px] rounded-[6px] px-2 py-1 outline-none">
                            <option value="true" selected="@(GetVal("MFA_ENFORCEMENT_ADMINS", "true").ToLower() == "true")">Obrigatório</option>
                            <option value="false" selected="@(GetVal("MFA_ENFORCEMENT_ADMINS", "true").ToLower() == "false")">Opcional</option>
                        </select>
                    </div>
                </div>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                    <div>
                        <label class="block text-[11px] text-gray-500 dark:text-gray-400 mb-1">Timeout (min)</label>
                        <input type="number" data-chave="SESSION_TIMEOUT_MINUTES" value="@GetVal("SESSION_TIMEOUT_MINUTES", "30")" min="5" max="720" class="cfg-input w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[12px] rounded-[6px] px-2.5 py-1.5 outline-none focus:border-brand-500 font-mono" />
                    </div>
                    <div>
                        <label class="block text-[11px] text-gray-500 dark:text-gray-400 mb-1">Token JWT (h)</label>
                        <input type="number" data-chave="JWT_EXPIRATION_HOURS" value="@GetVal("JWT_EXPIRATION_HOURS", "8")" min="1" max="72" class="cfg-input w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[12px] rounded-[6px] px-2.5 py-1.5 outline-none focus:border-brand-500 font-mono" />
                    </div>
                    <div>
                        <label class="block text-[11px] text-gray-500 dark:text-gray-400 mb-1">Máx. Tentativas</label>
                        <input type="number" data-chave="MAX_LOGIN_ATTEMPTS" value="@GetVal("MAX_LOGIN_ATTEMPTS", "5")" min="3" max="20" class="cfg-input w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[12px] rounded-[6px] px-2.5 py-1.5 outline-none focus:border-brand-500 font-mono" />
                    </div>
                    <div>
                        <label class="block text-[11px] text-gray-500 dark:text-gray-400 mb-1">Bloqueio (min)</label>
                        <input type="number" data-chave="ACCOUNT_LOCKOUT_MINUTES" value="@GetVal("ACCOUNT_LOCKOUT_MINUTES", "15")" min="5" max="1440" class="cfg-input w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[12px] rounded-[6px] px-2.5 py-1.5 outline-none focus:border-brand-500 font-mono" />
                    </div>
                </div>
            </div>
        </div>

        <!-- BENTO 2 (5 Cols): ACESSIBILIDADE & VOZ (TTS / STT / VLIBRAS) -->
        <div data-tab="a11y" class="cfg-card lg:col-span-5 bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] p-4 flex flex-col justify-between">
            <div class="flex items-center justify-between mb-3 pb-2 border-b border-gray-100 dark:border-dark-border">
                <h3 class="text-[13px] font-[600] text-gray-900 dark:text-white flex items-center gap-2">
                    <i class="ph ph-speaker-high text-purple-500 text-[16px]"></i> Acessibilidade &amp; Voz
                </h3>
                <div class="flex items-center gap-1.5">
                    <button type="button" onclick="window.lerTextoAssistivo && window.lerTextoAssistivo('Síntese de voz ativa no Corvux I A M.')" class="text-[11px] px-2 py-0.5 rounded bg-purple-500/10 text-purple-500 hover:bg-purple-500/20 transition-colors cursor-pointer" title="Testar Voz">
                        <i class="ph ph-play"></i> Testar
                    </button>
                    <button type="button" onclick="window.togglePainelVoz && window.togglePainelVoz()" class="text-[11px] px-2 py-0.5 rounded bg-brand-500/10 text-brand-500 hover:bg-brand-500/20 transition-colors cursor-pointer">
                        Painel
                    </button>
                </div>
            </div>
            <div class="grid grid-cols-3 gap-2.5">
                <div>
                    <label class="block text-[11px] text-gray-500 dark:text-gray-400 mb-1">Text-to-Speech</label>
                    <select data-chave="A11Y_TTS_PROVIDER" class="cfg-input dark-select w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[11px] rounded-[6px] px-2 py-1.5 outline-none">
                        <option value="Hybrid_GCloud_WebSpeech" selected="@(GetVal("A11Y_TTS_PROVIDER", "Hybrid_GCloud_WebSpeech") == "Hybrid_GCloud_WebSpeech")">Google + Web</option>
                        <option value="WebSpeech_Native" selected="@(GetVal("A11Y_TTS_PROVIDER", "Hybrid_GCloud_WebSpeech") == "WebSpeech_Native")">Web Nativo</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[11px] text-gray-500 dark:text-gray-400 mb-1">Ditado (STT)</label>
                    <select data-chave="A11Y_STT_ENABLED" class="cfg-input dark-select w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[11px] rounded-[6px] px-2 py-1.5 outline-none">
                        <option value="true" selected="@(GetVal("A11Y_STT_ENABLED", "true") == "true")">Ativo</option>
                        <option value="false" selected="@(GetVal("A11Y_STT_ENABLED", "true") == "false")">Inativo</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[11px] text-gray-500 dark:text-gray-400 mb-1">VLibras Gov</label>
                    <select data-chave="A11Y_VLIBRAS_ENABLED" class="cfg-input dark-select w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[11px] rounded-[6px] px-2 py-1.5 outline-none">
                        <option value="true" selected="@(GetVal("A11Y_VLIBRAS_ENABLED", "true") == "true")">Ativo</option>
                        <option value="false" selected="@(GetVal("A11Y_VLIBRAS_ENABLED", "true") == "false")">Oculto</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- BENTO 3 (7 Cols): DEFESA CIBERNÉTICA, WAF & ZERO-TRUST -->
        <div data-tab="seguranca" class="cfg-card lg:col-span-7 bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] p-4">
            <div class="flex items-center justify-between mb-3 pb-2 border-b border-gray-100 dark:border-dark-border">
                <h3 class="text-[13px] font-[600] text-gray-900 dark:text-white flex items-center gap-2">
                    <i class="ph ph-shield-check text-emerald-500 text-[16px]"></i> Firewall WAF &amp; Zero-Trust
                </h3>
                <div class="flex items-center gap-2">
                    <span class="text-[11px] text-red-500 font-medium">Lockdown:</span>
                    <select data-chave="LOCKDOWN_MODE" class="cfg-input dark-select bg-red-500/10 border border-red-500/30 text-red-600 dark:text-red-400 text-[11px] rounded-[6px] px-2 py-0.5 outline-none">
                        <option value="false" selected="@(GetVal("LOCKDOWN_MODE", "false").ToLower() == "false")">Normal</option>
                        <option value="true" selected="@(GetVal("LOCKDOWN_MODE", "false").ToLower() == "true")">Quarentena</option>
                    </select>
                </div>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                <div class="col-span-2 sm:col-span-1">
                    <label class="block text-[11px] text-gray-500 dark:text-gray-400 mb-1">Chave M2M API</label>
                    <input type="text" data-chave="API_GATEWAY_TOKEN" value="@GetVal("API_GATEWAY_TOKEN", "")" class="cfg-input w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[11px] rounded-[6px] px-2.5 py-1.5 outline-none font-mono" />
                </div>
                <div>
                    <label class="block text-[11px] text-gray-500 dark:text-gray-400 mb-1">Rate Limit / min</label>
                    <input type="number" data-chave="WAF_RATE_LIMIT_PER_MINUTE" value="@GetVal("WAF_RATE_LIMIT_PER_MINUTE", "60")" min="10" max="1000" class="cfg-input w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[12px] rounded-[6px] px-2.5 py-1.5 outline-none font-mono" />
                </div>
                <div>
                    <label class="block text-[11px] text-gray-500 dark:text-gray-400 mb-1">Isolar Host</label>
                    <select data-chave="AUTO_ISOLATE_HIGH_RISK_ENDPOINTS" class="cfg-input dark-select w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[11px] rounded-[6px] px-2 py-1.5 outline-none">
                        <option value="true" selected="@(GetVal("AUTO_ISOLATE_HIGH_RISK_ENDPOINTS", "true").ToLower() == "true")">Automático</option>
                        <option value="false" selected="@(GetVal("AUTO_ISOLATE_HIGH_RISK_ENDPOINTS", "true").ToLower() == "false")">Apenas Log</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[11px] text-gray-500 dark:text-gray-400 mb-1">Inspeção DPI</label>
                    <select data-chave="ENABLE_DEEP_PACKET_INSPECTION" class="cfg-input dark-select w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[11px] rounded-[6px] px-2 py-1.5 outline-none">
                        <option value="true" selected="@(GetVal("ENABLE_DEEP_PACKET_INSPECTION", "true").ToLower() == "true")">Ativo</option>
                        <option value="false" selected="@(GetVal("ENABLE_DEEP_PACKET_INSPECTION", "true").ToLower() == "false")">Inativo</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- BENTO 4 (5 Cols): PRIVACIDADE & LGPD -->
        <div data-tab="lgpd" class="cfg-card lg:col-span-5 bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] p-4">
            <div class="flex items-center justify-between mb-3 pb-2 border-b border-gray-100 dark:border-dark-border">
                <h3 class="text-[13px] font-[600] text-gray-900 dark:text-white flex items-center gap-2">
                    <i class="ph ph-scales text-amber-500 text-[16px]"></i> Privacidade &amp; LGPD
                </h3>
                <span class="text-[10px] text-gray-400 font-mono">Lei 13.709/18</span>
            </div>
            <div class="grid grid-cols-3 gap-2.5">
                <div>
                    <label class="block text-[11px] text-gray-500 dark:text-gray-400 mb-1">Retenção (dias)</label>
                    <input type="number" data-chave="LGPD_DATA_RETENTION_DAYS" value="@GetVal("LGPD_DATA_RETENTION_DAYS", "180")" min="30" max="1825" class="cfg-input w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[12px] rounded-[6px] px-2.5 py-1.5 outline-none font-mono" />
                </div>
                <div>
                    <label class="block text-[11px] text-gray-500 dark:text-gray-400 mb-1">Cookies</label>
                    <select data-chave="COOKIE_CONSENT_STRICT_MODE" class="cfg-input dark-select w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[11px] rounded-[6px] px-2.5 py-1.5 outline-none">
                        <option value="true" selected="@(GetVal("COOKIE_CONSENT_STRICT_MODE", "true").ToLower() == "true")">Banner Ativo</option>
                        <option value="false" selected="@(GetVal("COOKIE_CONSENT_STRICT_MODE", "true").ToLower() == "false")">Oculto</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[11px] text-gray-500 dark:text-gray-400 mb-1">Anonimizar CSV</label>
                    <select data-chave="AUDIT_LOG_ANONYMIZATION" class="cfg-input dark-select w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[11px] rounded-[6px] px-2.5 py-1.5 outline-none">
                        <option value="true" selected="@(GetVal("AUDIT_LOG_ANONYMIZATION", "true").ToLower() == "true")">Ativo</option>
                        <option value="false" selected="@(GetVal("AUDIT_LOG_ANONYMIZATION", "true").ToLower() == "false")">Bruto</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- BENTO 5 (6 Cols): SERVIDOR SMTP -->
        <div data-tab="smtp" class="cfg-card lg:col-span-6 bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] p-4">
            <h3 class="text-[13px] font-[600] text-gray-900 dark:text-white flex items-center gap-2 mb-3 pb-2 border-b border-gray-100 dark:border-dark-border">
                <i class="ph ph-envelope-simple text-indigo-500 text-[16px]"></i> E-mail &amp; Notificações (SMTP)
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                <div>
                    <label class="block text-[11px] text-gray-500 dark:text-gray-400 mb-1">Host SMTP</label>
                    <input type="text" data-chave="SMTP_HOST" value="@GetVal("SMTP_HOST", "smtp.gmail.com")" class="cfg-input w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[12px] rounded-[6px] px-2.5 py-1.5 outline-none font-mono" />
                </div>
                <div>
                    <label class="block text-[11px] text-gray-500 dark:text-gray-400 mb-1">Porta TLS</label>
                    <input type="number" data-chave="SMTP_PORT" value="@GetVal("SMTP_PORT", "587")" class="cfg-input w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[12px] rounded-[6px] px-2.5 py-1.5 outline-none font-mono" />
                </div>
                <div>
                    <label class="block text-[11px] text-gray-500 dark:text-gray-400 mb-1">Remetente</label>
                    <input type="email" data-chave="SYSTEM_SENDER_EMAIL" value="@GetVal("SYSTEM_SENDER_EMAIL", "seguranca@corvuxiam.tech")" class="cfg-input w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[12px] rounded-[6px] px-2.5 py-1.5 outline-none font-mono" />
                </div>
            </div>
        </div>

        <!-- BENTO 6 (6 Cols): CLOUDFLARE TURNSTILE -->
        <div data-tab="borda" class="cfg-card lg:col-span-6 bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] p-4">
            <h3 class="text-[13px] font-[600] text-gray-900 dark:text-white flex items-center gap-2 mb-3 pb-2 border-b border-gray-100 dark:border-dark-border">
                <i class="ph ph-robot text-orange-500 text-[16px]"></i> Cloudflare Turnstile (Anti-Bot)
            </h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                <div>
                    <label class="block text-[11px] text-gray-500 dark:text-gray-400 mb-1">SiteKey Pública</label>
                    <input type="text" data-chave="TURNSTILE_SITEKEY" value="@GetVal("TURNSTILE_SITEKEY", "0x4AAAAAAFXK5J9F5V8zblrT")" class="cfg-input w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[12px] rounded-[6px] px-2.5 py-1.5 outline-none font-mono" />
                </div>
                <div>
                    <label class="block text-[11px] text-gray-500 dark:text-gray-400 mb-1">Modo do Widget</label>
                    <select data-chave="TURNSTILE_MODE" class="cfg-input dark-select w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[12px] rounded-[6px] px-2.5 py-1.5 outline-none">
                        <option value="Interactive" selected="@(GetVal("TURNSTILE_MODE", "Interactive") == "Interactive")">Interativo (Checkbox)</option>
                        <option value="Managed" selected="@(GetVal("TURNSTILE_MODE", "Interactive") == "Managed")">Gerenciado (Smart)</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- BENTO 7 (12 Cols Compact Bar): BANCO DE DADOS & STORED PROCEDURES -->
        <div data-tab="db" class="cfg-card lg:col-span-12 bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] px-4 py-3">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <div class="flex items-center gap-2.5">
                    <i class="ph ph-database text-cyan-500 text-[18px]"></i>
                    <span class="text-[13px] font-[600] text-gray-900 dark:text-white">SQL Server Engine</span>
                    <span class="text-[11px] text-gray-400">7 Procedures • 6 Views/Triggers • 8 Índices</span>
                </div>
                <div class="flex flex-wrap items-center gap-2">
                    <button type="button" onclick="executarProcedureDb('sp_ObterMetricasSecOpsDashboard')" class="border border-cyan-500/30 bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-600 dark:text-cyan-400 text-[11px] font-medium px-2.5 py-1 rounded-[6px] transition-colors flex items-center gap-1 cursor-pointer">
                        <i class="ph ph-play"></i> Telemetria SQL
                    </button>
                    <button type="button" onclick="executarProcedureDb('sp_ExecutarManutencaoLgpd')" class="border border-brand-500/30 bg-brand-500/10 hover:bg-brand-500/20 text-brand-600 dark:text-brand-400 text-[11px] font-medium px-2.5 py-1 rounded-[6px] transition-colors flex items-center gap-1 cursor-pointer">
                        <i class="ph ph-broom"></i> Rotina LGPD
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>

@section Scripts {
    <script>
        function filtrarAbaConfig(tabName, btn) {
            // Atualiza botões
            document.querySelectorAll('.cfg-tab-btn').forEach(b => {
                b.className = 'cfg-tab-btn px-3 py-1.5 rounded-[6px] font-medium text-gray-600 dark:text-gray-400 hover:bg-gray-200/60 dark:hover:bg-dark-hover hover:text-gray-900 dark:hover:text-white transition-colors cursor-pointer flex items-center gap-1.5 shrink-0';
            });
            btn.className = 'cfg-tab-btn px-3 py-1.5 rounded-[6px] font-medium bg-brand-600 text-white transition-colors cursor-pointer flex items-center gap-1.5 shrink-0';

            const cards = document.querySelectorAll('.cfg-card');
            cards.forEach(card => {
                const cardTab = card.getAttribute('data-tab');
                if (tabName === 'todas' || cardTab === tabName) {
                    card.style.display = '';
                    if (tabName !== 'todas') {
                        card.classList.remove('lg:col-span-7', 'lg:col-span-5', 'lg:col-span-6');
                        card.classList.add('lg:col-span-12');
                    } else {
                        card.classList.remove('lg:col-span-12');
                        if (cardTab === 'iam' || cardTab === 'seguranca') card.classList.add('lg:col-span-7');
                        else if (cardTab === 'a11y' || cardTab === 'lgpd') card.classList.add('lg:col-span-5');
                        else if (cardTab === 'smtp' || cardTab === 'borda') card.classList.add('lg:col-span-6');
                        else if (cardTab === 'db') card.classList.add('lg:col-span-12');
                    }
                } else {
                    card.style.display = 'none';
                }
            });
        }

        async function executarProcedureDb(procName) {
            try {
                const res = await fetch('/Admin/ExecutarProcedureBanco', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getCsrfToken()
                    },
                    body: JSON.stringify({ Procedure: procName })
                });
                const data = await res.json();
                Swal.fire({
                    title: 'Rotina SQL Executada',
                    text: data.message || ('Procedure ' + procName + ' concluída.'),
                    icon: 'success',
                    background: '#0E0E12',
                    color: '#FAFAFA',
                    confirmButtonColor: '#3B82F6'
                });
            } catch (err) {
                Swal.fire({ title: 'Erro', text: 'Falha ao comunicar com o banco de dados.', icon: 'error' });
            }
        }

        async function salvarConfiguracoes(e) {
            e.preventDefault();
            const btn = document.getElementById('btnSalvarCfgTop');
            if (btn) { btn.disabled = true; btn.innerHTML = '<i class="ph ph-spinner-gap animate-spin"></i> Salvando...'; }

            const configs = {};
            document.querySelectorAll('.cfg-input').forEach(inp => {
                const chave = inp.getAttribute('data-chave');
                if (chave) configs[chave] = inp.value;
            });

            try {
                const res = await fetch('/Admin/SalvarConfiguracoes', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getCsrfToken()
                    },
                    body: JSON.stringify({ Configs: configs })
                });

                if (res.ok) {
                    Swal.fire({
                        title: 'Salvo!',
                        text: 'Parâmetros atualizados com sucesso.',
                        icon: 'success',
                        timer: 1200,
                        showConfirmButton: false,
                        background: '#121418',
                        color: '#fff'
                    }).then(() => window.location.reload());
                } else {
                    Swal.fire({ title: 'Erro!', text: 'Falha ao salvar.', icon: 'error', background: '#121418', color: '#fff' });
                    if (btn) { btn.disabled = false; btn.innerHTML = '<i class="ph ph-floppy-disk"></i> Salvar'; }
                }
            } catch (err) {
                Swal.fire({ title: 'Erro de Conexão', text: 'Não foi possível comunicar com o servidor.', icon: 'error', background: '#121418', color: '#fff' });
                if (btn) { btn.disabled = false; btn.innerHTML = '<i class="ph ph-floppy-disk"></i> Salvar'; }
            }
        }

        function restaurarPadroesSeguros() {
            const baselines = {
                'SESSION_TIMEOUT_MINUTES': '30',
                'JWT_EXPIRATION_HOURS': '8',
                'MAX_LOGIN_ATTEMPTS': '5',
                'ACCOUNT_LOCKOUT_MINUTES': '15',
                'MFA_ENFORCEMENT_ADMINS': 'true',
                'LOCKDOWN_MODE': 'false',
                'WAF_RATE_LIMIT_PER_MINUTE': '60',
                'AUTO_ISOLATE_HIGH_RISK_ENDPOINTS': 'true',
                'ENABLE_DEEP_PACKET_INSPECTION': 'true',
                'LGPD_DATA_RETENTION_DAYS': '180',
                'COOKIE_CONSENT_STRICT_MODE': 'true',
                'AUDIT_LOG_ANONYMIZATION': 'true',
                'SMTP_HOST': 'smtp.gmail.com',
                'SMTP_PORT': '587',
                'SYSTEM_SENDER_EMAIL': 'seguranca@corvuxiam.tech',
                'TURNSTILE_SITEKEY': '0x4AAAAAAFXK5J9F5V8zblrT',
                'TURNSTILE_MODE': 'Interactive',
                'A11Y_TTS_PROVIDER': 'Hybrid_GCloud_WebSpeech',
                'A11Y_STT_ENABLED': 'true',
                'A11Y_VLIBRAS_ENABLED': 'true'
            };

            document.querySelectorAll('.cfg-input').forEach(inp => {
                const chave = inp.getAttribute('data-chave');
                if (baselines[chave] !== undefined) inp.value = baselines[chave];
            });

            Swal.fire({
                title: 'Padrão Restaurado',
                text: 'Clique em Salvar para confirmar.',
                icon: 'info',
                timer: 1400,
                showConfirmButton: false,
                background: '#121418',
                color: '#fff'
            });
        }
    </script>
}

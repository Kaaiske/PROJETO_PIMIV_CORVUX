        <!-- BENTO 7 (12 Cols): MOTOR DE BANCO DE DADOS, STORED PROCEDURES, VIEWS & TRIGGERS -->
        <div class="lg:col-span-12 bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] overflow-hidden">
            <div class="px-4 py-3 border-b border-gray-200 dark:border-dark-border bg-gray-50/50 dark:bg-dark-bg/40 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-2">
                <div class="flex items-center gap-2.5">
                    <div class="w-7 h-7 rounded-[6px] bg-cyan-500/10 border border-cyan-500/30 text-cyan-500 flex items-center justify-center">
                        <i class="ph ph-database text-[16px]"></i>
                    </div>
                    <div>
                        <h3 class="text-[13px] font-[600] text-gray-900 dark:text-white">Motor SQL Server, Stored Procedures, Views &amp; Triggers Compatibilizados (EF Core OUTPUT INTO)</h3>
                        <p class="text-[10px] text-gray-500 dark:text-gray-400">Objetos programáveis T-SQL, Triggers de auditoria SIEM e Índices Non-Clustered de alta performance</p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <button type="button" onclick="executarProcedureDb('sp_ObterMetricasSecOpsDashboard')" class="border border-cyan-500/30 bg-cyan-500/10 hover:bg-cyan-500/20 text-cyan-600 dark:text-cyan-400 text-[11px] font-medium px-2.5 py-1 rounded-[6px] transition-colors flex items-center gap-1 cursor-pointer">
                        <i class="ph ph-play"></i> Executar sp_ObterMetricasSecOpsDashboard
                    </button>
                    <button type="button" onclick="executarProcedureDb('sp_ExecutarManutencaoLgpd')" class="border border-brand-500/30 bg-brand-500/10 hover:bg-brand-500/20 text-brand-600 dark:text-brand-400 text-[11px] font-medium px-2.5 py-1 rounded-[6px] transition-colors flex items-center gap-1 cursor-pointer">
                        <i class="ph ph-broom"></i> Executar sp_ExecutarManutencaoLgpd
                    </button>
                </div>
            </div>
            <div class="p-4 grid grid-cols-1 md:grid-cols-3 gap-3 text-[11px]">
                <div class="p-3 rounded-[6px] border border-gray-200 dark:border-dark-border bg-gray-50/60 dark:bg-dark-bg/50">
                    <div class="font-semibold text-gray-900 dark:text-white mb-1.5 flex items-center justify-between">
                        <span>Stored Procedures (7 Ativas)</span>
                        <span class="text-[10px] font-mono text-emerald-500">T-SQL / ACID</span>
                    </div>
                    <ul class="space-y-1 text-[10px] font-mono text-gray-600 dark:text-gray-400">
                        <li>• dbo.sp_RegistrarLogAuditoria</li>
                        <li>• dbo.sp_BloquearIpFirewall</li>
                        <li>• dbo.sp_AbrirChamadoSuporteComSla</li>
                        <li>• dbo.sp_RevogarSessoesUsuario</li>
                        <li>• dbo.sp_ProcessarFechamentoContabil</li>
                        <li>• dbo.sp_ExecutarManutencaoLgpd</li>
                        <li>• dbo.sp_ObterMetricasSecOpsDashboard</li>

                <div class="p-3 rounded-[6px] border border-gray-200 dark:border-dark-border bg-gray-50/60 dark:bg-dark-bg/50">
                    <div class="font-semibold text-gray-900 dark:text-white mb-1.5 flex items-center justify-between">
                        <span>Views, Functions &amp; Triggers</span>
                        <span class="text-[10px] font-mono text-blue-500">HasTrigger OK</span>
                    </div>
                    <ul class="space-y-1 text-[10px] font-mono text-gray-600 dark:text-gray-400">
                        <li>• dbo.vw_MatrizRbacUsuarios</li>
                        <li>• dbo.vw_ResumoSaudeEndpoints</li>
                        <li>• dbo.vw_MonitoramentoSlaChamados</li>
                        <li>• dbo.fn_CalcularScoreRiscoUsuario</li>
                        <li>• dbo.trg_AuditoriaStatusUsuario</li>
                        <li>• dbo.trg_AuditoriaFirewallWaf</li>
                    </ul>
                </div>
                <div class="p-3 rounded-[6px] border border-gray-200 dark:border-dark-border bg-gray-50/60 dark:bg-dark-bg/50">
                    <div class="font-semibold text-gray-900 dark:text-white mb-1.5 flex items-center justify-between">
                        <span>Índices Non-Clustered (8 Ativos)</span>
                        <span class="text-[10px] font-mono text-amber-500">Low Latency</span>
                    </div>
                    <ul class="space-y-1 text-[10px] font-mono text-gray-600 dark:text-gray-400">
                        <li>• IX_Usuarios_Email (INCLUDE)</li>
                        <li>• IX_LogsAuditoria_DataHora_Tipo</li>

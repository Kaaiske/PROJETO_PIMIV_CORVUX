@model IEnumerable<CorvusIAM.Entities.ConfiguracaoSistema>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Configurações Globais (Bento UI)";

    var dict = Model.ToDictionary(m => m.Chave, m => m.Valor ?? "");
    string GetVal(string key, string def = "") => dict.ContainsKey(key) ? dict[key] : def;
}

<div class="mb-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
    <div>
        <div class="flex items-center gap-2">
            <h1 class="text-[16px] font-[600] text-gray-900 dark:text-white flex items-center gap-2">
                <i class="ph ph-squares-four text-brand-500"></i> Configurações Globais do Sistema
            </h1>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-brand-500/10 text-brand-600 dark:text-brand-400 border border-brand-500/20">
                Bento Control Center
            </span>
        </div>
        <p class="text-[12px] text-gray-500 dark:text-gray-400 mt-0.5">Governança IAM, WAF Zero-Trust, APIs de Acessibilidade (TTS/STT/VLibras), LGPD e Equidade Étnico-Racial</p>
    </div>
    <div class="flex items-center gap-2">
        <button type="button" onclick="restaurarPadroesSeguros()" class="bg-white dark:bg-dark-card border border-gray-300 dark:border-dark-border text-gray-700 dark:text-gray-300 hover:bg-gray-100 dark:hover:bg-dark-hover text-[12px] font-medium px-3 py-1.5 rounded-[6px] transition-colors flex items-center gap-1.5 cursor-pointer">
            <i class="ph ph-arrow-counter-clockwise"></i> Baseline NIST
        </button>
        <button type="button" onclick="document.getElementById('formConfiguracoes').requestSubmit()" class="bg-brand-600 hover:bg-brand-500 text-white text-[12px] font-semibold px-4 py-1.5 rounded-[6px] shadow-xs transition-colors flex items-center gap-1.5 cursor-pointer">
            <i class="ph ph-floppy-disk"></i> Salvar Alterações
        </button>
    </div>
</div>

<!-- Top Bento KPI Strip (12-Column Asymmetric Bento Overview) -->
<div class="grid grid-cols-2 lg:grid-cols-12 gap-3 mb-4">
    <div class="lg:col-span-3 bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] p-3 flex items-center justify-between">
        <div>
            <span class="text-[10px] font-semibold uppercase tracking-wider text-blue-600 dark:text-blue-400 block">IAM &amp; Zero-Trust</span>
            <span class="text-[15px] font-bold text-gray-900 dark:text-white">@GetVal("SESSION_TIMEOUT_MINUTES", "30") min</span>
            <span class="text-[10px] text-gray-500 block">Sessão • JWT @GetVal("JWT_EXPIRATION_HOURS", "8")h</span>
        </div>
        <div class="w-9 h-9 rounded-[8px] bg-blue-500/10 border border-blue-500/20 text-blue-500 flex items-center justify-center">
            <i class="ph ph-fingerprint text-[18px]"></i>
        </div>
    </div>

    <div class="lg:col-span-3 bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] p-3 flex items-center justify-between">
        <div>
            <span class="text-[10px] font-semibold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 block">WAF &amp; Motor DPI</span>
            <span class="text-[15px] font-bold text-gray-900 dark:text-white">@GetVal("WAF_RATE_LIMIT_PER_MINUTE", "60") req/m</span>
            <span class="text-[10px] text-gray-500 block">Auto-Isolamento Ativo</span>
        </div>
        <div class="w-9 h-9 rounded-[8px] bg-emerald-500/10 border border-emerald-500/20 text-emerald-500 flex items-center justify-center">
            <i class="ph ph-shield-check text-[18px]"></i>
        </div>
    </div>

    <div class="lg:col-span-3 bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] p-3 flex items-center justify-between">
        <div>
            <span class="text-[10px] font-semibold uppercase tracking-wider text-purple-600 dark:text-purple-400 block">APIs Acessibilidade</span>
            <span class="text-[15px] font-bold text-gray-900 dark:text-white">TTS • STT • Libras</span>
            <span class="text-[10px] text-gray-500 block">Voz Neural + VLibras Gov.br</span>
        </div>
        <div class="w-9 h-9 rounded-[8px] bg-purple-500/10 border border-purple-500/20 text-purple-500 flex items-center justify-center">
            <i class="ph ph-speaker-high text-[18px]"></i>
        </div>
    </div>

    <div class="lg:col-span-3 bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] p-3 flex items-center justify-between">
        <div>
            <span class="text-[10px] font-semibold uppercase tracking-wider text-amber-600 dark:text-amber-400 block">LGPD &amp; Equidade</span>
            <span class="text-[15px] font-bold text-gray-900 dark:text-white">@GetVal("LGPD_DATA_RETENTION_DAYS", "180") dias</span>
            <span class="text-[10px] text-gray-500 block">Lei 13.709/18 &amp; Lei 12.288/10</span>
        </div>
        <div class="w-9 h-9 rounded-[8px] bg-amber-500/10 border border-amber-500/20 text-amber-500 flex items-center justify-center">
            <i class="ph ph-scales text-[18px]"></i>
        </div>
    </div>
</div>

<form id="formConfiguracoes" onsubmit="salvarConfiguracoes(event)">
    <!-- BENTO GRID PRINCIPAL (12 COLUNAS) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-4">

        <!-- BENTO 1 (7 Cols): IDENTIDADE, SESSÕES & AUTENTICAÇÃO (IAM) -->
        <div class="lg:col-span-7 bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] overflow-hidden flex flex-col justify-between">
            <div>
                <div class="px-4 py-3 border-b border-gray-200 dark:border-dark-border bg-gray-50/50 dark:bg-dark-bg/40 flex items-center justify-between">
                    <div class="flex items-center gap-2.5">
                        <div class="w-7 h-7 rounded-[6px] bg-blue-500/10 border border-blue-500/30 text-blue-500 flex items-center justify-center">
                            <i class="ph ph-fingerprint text-[16px]"></i>
                        </div>
                        <div>
                            <h3 class="text-[13px] font-[600] text-gray-900 dark:text-white">Identidade, Acesso &amp; Sessão (IAM)</h3>
                            <p class="text-[10px] text-gray-500 dark:text-gray-400">Ciclo de vida de credenciais, MFA compulsório e expiração</p>
                        </div>
                    </div>
                    <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-blue-500/10 text-blue-500 border border-blue-500/20">RBAC / Zero-Trust</span>
                </div>
                <div class="p-4 grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                    <div>
                        <label class="block text-[11px] font-[600] text-gray-700 dark:text-gray-300 mb-1 flex items-center justify-between">
                            <span>Timeout de Inatividade</span>
                            <span class="text-[10px] text-gray-400 font-mono">Minutos</span>
                        </label>
                        <input type="number" data-chave="SESSION_TIMEOUT_MINUTES" value="@GetVal("SESSION_TIMEOUT_MINUTES", "30")" min="5" max="720" class="cfg-input w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[12px] rounded-[6px] px-3 py-1.5 outline-none focus:border-brand-500 font-mono" />
                    </div>

                    <div>
                        <label class="block text-[11px] font-[600] text-gray-700 dark:text-gray-300 mb-1 flex items-center justify-between">
                            <span>Validade Token JWT API</span>
                            <span class="text-[10px] text-gray-400 font-mono">Horas</span>
                        </label>
                        <input type="number" data-chave="JWT_EXPIRATION_HOURS" value="@GetVal("JWT_EXPIRATION_HOURS", "8")" min="1" max="72" class="cfg-input w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[12px] rounded-[6px] px-3 py-1.5 outline-none focus:border-brand-500 font-mono" />
                    </div>

                    <div>
                        <label class="block text-[11px] font-[600] text-gray-700 dark:text-gray-300 mb-1 flex items-center justify-between">
                            <span>Tentativas Máximas Login</span>
                            <span class="text-[10px] text-gray-400 font-mono">Falhas</span>
                        </label>
                        <input type="number" data-chave="MAX_LOGIN_ATTEMPTS" value="@GetVal("MAX_LOGIN_ATTEMPTS", "5")" min="3" max="20" class="cfg-input w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[12px] rounded-[6px] px-3 py-1.5 outline-none focus:border-brand-500 font-mono" />
                    </div>

                    <div>
                        <label class="block text-[11px] font-[600] text-gray-700 dark:text-gray-300 mb-1 flex items-center justify-between">
                            <span>Quarentena de Bloqueio</span>
                            <span class="text-[10px] text-gray-400 font-mono">Minutos</span>
                        </label>
                        <input type="number" data-chave="ACCOUNT_LOCKOUT_MINUTES" value="@GetVal("ACCOUNT_LOCKOUT_MINUTES", "15")" min="5" max="1440" class="cfg-input w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[12px] rounded-[6px] px-3 py-1.5 outline-none focus:border-brand-500 font-mono" />
                    </div>
                </div>
            </div>
            <div class="px-4 py-3 border-t border-gray-100 dark:border-dark-border bg-gray-50/30 dark:bg-dark-bg/20 flex items-center justify-between gap-2">
                <div>
                    <span class="text-[12px] font-[600] text-gray-900 dark:text-white block">MFA/2FA Obrigatório para Administradores</span>
                    <span class="text-[10px] text-gray-500 dark:text-gray-400">Exige TOTP configurado para contas com perfil Admin.</span>
                </div>
                <select data-chave="MFA_ENFORCEMENT_ADMINS" class="cfg-input dark-select bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[11px] rounded-[6px] px-2.5 py-1.5 outline-none focus:border-brand-500">
                    <option value="true" selected="@(GetVal("MFA_ENFORCEMENT_ADMINS", "true").ToLower() == "true")">Ativado (Compulsório)</option>
                    <option value="false" selected="@(GetVal("MFA_ENFORCEMENT_ADMINS", "true").ToLower() == "false")">Desativado (Opcional)</option>
                </select>
            </div>
        </div>

        <!-- BENTO 2 (5 Cols): APIs E SERVIÇOS DE ACESSIBILIDADE ASSISTIVA (TTS, STT & VLIBRAS) -->
        <div class="lg:col-span-5 bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] overflow-hidden flex flex-col justify-between">
            <div>
                <div class="px-4 py-3 border-b border-gray-200 dark:border-dark-border bg-gray-50/50 dark:bg-dark-bg/40 flex items-center justify-between">
                    <div class="flex items-center gap-2.5">
                        <div class="w-7 h-7 rounded-[6px] bg-purple-500/10 border border-purple-500/30 text-purple-500 flex items-center justify-center">
                            <i class="ph ph-person-arms-spread text-[16px]"></i>
                        </div>
                        <div>
                            <h3 class="text-[13px] font-[600] text-gray-900 dark:text-white">APIs de Acessibilidade &amp; Voz</h3>
                            <p class="text-[10px] text-gray-500 dark:text-gray-400">Google Cloud TTS/STT, Web Speech &amp; VLibras</p>
                        </div>
                    </div>
                    <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-purple-500/10 text-purple-500 border border-purple-500/20">WCAG 2.1 AAA</span>
                </div>
                <div class="p-4 space-y-3">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-[11px] font-[600] text-gray-700 dark:text-gray-300 mb-1">Motor Text-to-Speech (TTS)</label>
                            <select data-chave="A11Y_TTS_PROVIDER" class="cfg-input dark-select w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[11px] rounded-[6px] px-2.5 py-1.5 outline-none focus:border-brand-500">
                                <option value="Hybrid_GCloud_WebSpeech" selected="@(GetVal("A11Y_TTS_PROVIDER", "Hybrid_GCloud_WebSpeech") == "Hybrid_GCloud_WebSpeech")">Google Cloud TTS + Web Speech</option>
                                <option value="WebSpeech_Native" selected="@(GetVal("A11Y_TTS_PROVIDER", "Hybrid_GCloud_WebSpeech") == "WebSpeech_Native")">Web Speech API Nativa</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-[11px] font-[600] text-gray-700 dark:text-gray-300 mb-1">Speech-to-Text (Ditado)</label>
                            <select data-chave="A11Y_STT_ENABLED" class="cfg-input dark-select w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[11px] rounded-[6px] px-2.5 py-1.5 outline-none focus:border-brand-500">
                                <option value="true" selected="@(GetVal("A11Y_STT_ENABLED", "true") == "true")">Ativo (Busca &amp; Campos)</option>
                                <option value="false" selected="@(GetVal("A11Y_STT_ENABLED", "true") == "false")">Desativado</option>
                            </select>
                        </div>
                    </div>

                    <div class="flex items-center justify-between pt-1">
                        <div>
                            <span class="text-[11px] font-[600] text-gray-900 dark:text-white block">Avatar VLibras (Governo Federal)</span>
                            <span class="text-[10px] text-gray-500">Tradução automática da interface para Língua Brasileira de Sinais.</span>
                        </div>
                        <select data-chave="A11Y_VLIBRAS_ENABLED" class="cfg-input dark-select bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[11px] rounded-[6px] px-2.5 py-1.5 outline-none focus:border-brand-500">
                            <option value="true" selected="@(GetVal("A11Y_VLIBRAS_ENABLED", "true") == "true")">Incorporado</option>
                            <option value="false" selected="@(GetVal("A11Y_VLIBRAS_ENABLED", "true") == "false")">Oculto</option>
                        </select>
                    </div>
                </div>
            </div>
            <div class="px-4 py-2.5 border-t border-gray-100 dark:border-dark-border bg-gray-50/30 dark:bg-dark-bg/20 flex flex-wrap items-center justify-between gap-2">
                <button type="button" onclick="window.lerTextoAssistivo && window.lerTextoAssistivo('Motor de síntese de voz do Corvux I A M operacional. Acessibilidade ativa para baixa visão e dislexia.')" class="text-[11px] font-medium px-2.5 py-1 rounded bg-purple-500/10 text-purple-600 dark:text-purple-300 hover:bg-purple-500/20 transition-colors flex items-center gap-1 cursor-pointer">
                    <i class="ph ph-speaker-high"></i> Ouvir Teste TTS
                </button>
                <button type="button" onclick="window.togglePainelVoz && window.togglePainelVoz()" class="text-[11px] font-medium px-2.5 py-1 rounded bg-brand-500/10 text-brand-600 dark:text-brand-400 hover:bg-brand-500/20 transition-colors flex items-center gap-1 cursor-pointer">
                    <i class="ph ph-sliders"></i> Abrir Painel de Voz
                </button>
            </div>
        </div>

        <!-- BENTO 3 (7 Cols): DEFESA CIBERNÉTICA, WAF & ZERO-TRUST -->
        <div class="lg:col-span-7 bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] overflow-hidden flex flex-col justify-between">
            <div>
                <div class="px-4 py-3 border-b border-gray-200 dark:border-dark-border bg-gray-50/50 dark:bg-dark-bg/40 flex items-center justify-between">
                    <div class="flex items-center gap-2.5">
                        <div class="w-7 h-7 rounded-[6px] bg-emerald-500/10 border border-emerald-500/30 text-emerald-500 flex items-center justify-center">
                            <i class="ph ph-shield-check text-[16px]"></i>
                        </div>
                        <div>
                            <h3 class="text-[13px] font-[600] text-gray-900 dark:text-white">Defesa Cibernética, WAF &amp; Zero-Trust</h3>
                            <p class="text-[10px] text-gray-500 dark:text-gray-400">Mitigação de invasões ativas, isolamento automatizado e rate limiting</p>
                        </div>
                    </div>
                    <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">WAF / IDS / DPI</span>
                </div>
                <div class="p-4 space-y-3">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                        <div>
                            <label class="block text-[11px] font-[600] text-gray-700 dark:text-gray-300 mb-1">API Gateway Token (M2M Key)</label>
                            <input type="text" data-chave="API_GATEWAY_TOKEN" value="@GetVal("API_GATEWAY_TOKEN", "corvux_sec_live_9f83a218d47b0192e")" class="cfg-input w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[12px] rounded-[6px] px-3 py-1.5 outline-none focus:border-brand-500 font-mono" />
                        </div>
                        <div>
                            <label class="block text-[11px] font-[600] text-gray-700 dark:text-gray-300 mb-1 flex items-center justify-between">
                                <span>WAF Rate Limiting</span>
                                <span class="text-[10px] text-gray-400 font-mono">Req/Min/IP</span>
                            </label>
                            <input type="number" data-chave="WAF_RATE_LIMIT_PER_MINUTE" value="@GetVal("WAF_RATE_LIMIT_PER_MINUTE", "60")" min="10" max="1000" class="cfg-input w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[12px] rounded-[6px] px-3 py-1.5 outline-none focus:border-brand-500 font-mono" />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 pt-2 border-t border-gray-100 dark:border-dark-border">
                        <div class="p-2.5 rounded-[6px] bg-red-500/5 border border-red-500/20">
                            <span class="text-[11px] font-[600] text-red-600 dark:text-red-400 block mb-1">Modo Lockdown</span>
                            <select data-chave="LOCKDOWN_MODE" class="cfg-input dark-select w-full bg-white dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[11px] rounded px-2 py-1 outline-none">
                                <option value="false" selected="@(GetVal("LOCKDOWN_MODE", "false").ToLower() == "false")">Normal</option>
                                <option value="true" selected="@(GetVal("LOCKDOWN_MODE", "false").ToLower() == "true")">Quarentena</option>
                            </select>
                        </div>
                        <div class="p-2.5 rounded-[6px] bg-gray-50 dark:bg-dark-bg/40 border border-gray-200 dark:border-dark-border">
                            <span class="text-[11px] font-[600] text-gray-800 dark:text-gray-200 block mb-1">Auto-Isolar Host</span>
                            <select data-chave="AUTO_ISOLATE_HIGH_RISK_ENDPOINTS" class="cfg-input dark-select w-full bg-white dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[11px] rounded px-2 py-1 outline-none">
                                <option value="true" selected="@(GetVal("AUTO_ISOLATE_HIGH_RISK_ENDPOINTS", "true").ToLower() == "true")">Defesa Ativa</option>
                                <option value="false" selected="@(GetVal("AUTO_ISOLATE_HIGH_RISK_ENDPOINTS", "true").ToLower() == "false")">Apenas Logar</option>
                            </select>
                        </div>
                        <div class="p-2.5 rounded-[6px] bg-gray-50 dark:bg-dark-bg/40 border border-gray-200 dark:border-dark-border">
                            <span class="text-[11px] font-[600] text-gray-800 dark:text-gray-200 block mb-1">Inspeção DPI</span>
                            <select data-chave="ENABLE_DEEP_PACKET_INSPECTION" class="cfg-input dark-select w-full bg-white dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[11px] rounded px-2 py-1 outline-none">
                                <option value="true" selected="@(GetVal("ENABLE_DEEP_PACKET_INSPECTION", "true").ToLower() == "true")">Ativado</option>
                                <option value="false" selected="@(GetVal("ENABLE_DEEP_PACKET_INSPECTION", "true").ToLower() == "false")">Desativado</option>
                            </select>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- BENTO 4 (5 Cols): PRIVACIDADE LGPD & EQUIDADE ÉTNICO-RACIAL -->
        <div class="lg:col-span-5 bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] overflow-hidden flex flex-col justify-between">
            <div>
                <div class="px-4 py-3 border-b border-gray-200 dark:border-dark-border bg-gray-50/50 dark:bg-dark-bg/40 flex items-center justify-between">
                    <div class="flex items-center gap-2.5">
                        <div class="w-7 h-7 rounded-[6px] bg-amber-500/10 border border-amber-500/30 text-amber-500 flex items-center justify-center">
                            <i class="ph ph-scales text-[16px]"></i>
                        </div>
                        <div>
                            <h3 class="text-[13px] font-[600] text-gray-900 dark:text-white">LGPD &amp; Governança Étnico-Racial</h3>
                            <p class="text-[10px] text-gray-500 dark:text-gray-400">Lei 13.709/18, Lei 12.288/10 &amp; Anonimização</p>
                        </div>
                    </div>
                    <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-amber-500/10 text-amber-500 border border-amber-500/20">Compliance</span>
                </div>
                <div class="p-4 space-y-3">
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-[11px] font-[600] text-gray-700 dark:text-gray-300 mb-1">Retenção Logs (Dias)</label>
                            <input type="number" data-chave="LGPD_DATA_RETENTION_DAYS" value="@GetVal("LGPD_DATA_RETENTION_DAYS", "180")" min="30" max="1825" class="cfg-input w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[12px] rounded-[6px] px-3 py-1.5 outline-none focus:border-brand-500 font-mono" />
                        </div>
                        <div>
                            <label class="block text-[11px] font-[600] text-gray-700 dark:text-gray-300 mb-1">Banner Consentimento</label>
                            <select data-chave="COOKIE_CONSENT_STRICT_MODE" class="cfg-input dark-select w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[11px] rounded-[6px] px-2.5 py-1.5 outline-none">
                                <option value="true" selected="@(GetVal("COOKIE_CONSENT_STRICT_MODE", "true").ToLower() == "true")">Estrito (LGPD)</option>
                                <option value="false" selected="@(GetVal("COOKIE_CONSENT_STRICT_MODE", "true").ToLower() == "false")">Desativado</option>
                            </select>
                        </div>
                    </div>
                    <div class="pt-2 border-t border-gray-100 dark:border-dark-border flex items-center justify-between gap-2">
                        <div>
                            <span class="text-[11px] font-[600] text-gray-900 dark:text-white block">Anonimização em Relatórios &amp; Censo IBGE</span>

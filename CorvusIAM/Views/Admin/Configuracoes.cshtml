                    <input type="text" data-chave="TURNSTILE_SITEKEY" value="@GetVal("TURNSTILE_SITEKEY", "0x4AAAAAAFXK5J9F5V8zblrT")" class="cfg-input w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[12px] rounded-[6px] px-2.5 py-1.5 outline-none font-mono" />
                </div>
                <div>
                    <label class="block text-[11px] font-[600] text-gray-700 dark:text-gray-300 mb-1">Modo de Desafio</label>
                    <select data-chave="TURNSTILE_MODE" class="cfg-input dark-select w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[12px] rounded-[6px] px-2.5 py-1.5 outline-none">
                        <option value="Interactive" selected="@(GetVal("TURNSTILE_MODE", "Interactive") == "Interactive")">Interativo (Checkbox)</option>
                        <option value="Managed" selected="@(GetVal("TURNSTILE_MODE", "Interactive") == "Managed")">Gerenciado (Smart)</option>
                    </select>
                </div>

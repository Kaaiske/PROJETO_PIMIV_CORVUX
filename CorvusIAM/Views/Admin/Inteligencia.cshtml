@{
    Layout = "_Layout";
    ViewData["Title"] = "IA & CyberSec";
}

<div class="mb-[24px] flex justify-between items-end">
    <div>
        <h1 class="text-[16px] font-[600] text-gray-900 dark:text-white flex items-center gap-2">
            <i class="ph ph-lightning text-brand-500"></i> Agente IA & Segurança
        </h1>
        <p class="text-[12px] text-gray-500 dark:text-gray-400 mt-1">Análise autônoma, varredura de vírus e detecção de intrusão</p>
    </div>
    <button onclick="iniciarVarredura()" id="btnScan" class="bg-brand-600 hover:bg-[#1D4ED8] text-white text-[12px] font-medium px-4 py-2 rounded-[6px] shadow-sm transition-colors flex items-center gap-1.5">
        <i class="ph ph-radar"></i> Iniciar Varredura de Invasões
    </button>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-4 md:gap-[24px]">
    <!-- Terminal IA -->
    <div class="bento-card bg-[#090A0C] border border-gray-200 dark:border-dark-border rounded-[6px] p-[24px] font-mono flex flex-col min-h-[400px] shadow-inner relative overflow-hidden">
        <div class="flex justify-between border-b border-gray-800 pb-[12px] mb-[16px]">
            <span class="text-[11px] font-[600] text-gray-500 uppercase tracking-[0.05em]">CorvusAI Security Terminal</span>
            <span class="text-[11px] font-[600] text-emerald-500 uppercase tracking-[0.05em] flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> Online
            </span>
        </div>
        <div id="aiConsole" class="flex-1 overflow-y-auto text-brand-400 text-[12px] leading-relaxed pr-[10px]">
            > Inicializando modelos preditivos...<br>
            > Carregando heurísticas do banco de dados...<br>
            > Agente IA pronto para auditoria. Aguardando comando...<br>
        </div>
    </div>
    
    <!-- Status Dashboard -->
    <div class="flex flex-col gap-4 md:gap-[24px]">
        <div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[24px]">
            <h3 class="text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em] m-0">Progresso de Varredura</h3>
            <div class="h-[8px] bg-gray-100 dark:bg-dark-bg rounded-full my-[16px] overflow-hidden">
                <div id="scanProgress" class="w-0 h-full bg-brand-500 transition-all duration-300"></div>
            </div>
            <div id="scanStatusText" class="text-[11px] font-[600] text-gray-500 uppercase tracking-[0.05em]">Inativo</div>
        </div>
        
        <div class="grid grid-cols-2 gap-4 md:gap-[24px]">
            <div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[24px] text-center relative overflow-hidden">
                <div class="absolute -top-[24px] -right-[24px] w-[96px] h-[96px] bg-emerald-500/10 blur-[32px] rounded-full pointer-events-none"></div>
                <i class="ph ph-shield-check text-[32px] text-emerald-500"></i>
                <div class="text-[11px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em] mt-[12px]">Vírus Detectados</div>
                <div id="virusCount" class="text-[24px] font-[700] text-gray-900 dark:text-white mt-1">0</div>
            </div>
            <div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[24px] text-center relative overflow-hidden">
                <div class="absolute -top-[24px] -right-[24px] w-[96px] h-[96px] bg-orange-500/10 blur-[32px] rounded-full pointer-events-none"></div>
                <i class="ph ph-eye text-[32px] text-orange-500"></i>
                <div class="text-[11px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em] mt-[12px]">Tentativas de Invasão</div>
                <div id="invCount" class="text-[24px] font-[700] text-gray-900 dark:text-white mt-1">0</div>
            </div>
        </div>

        <div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[24px]">
            <h3 class="text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em] flex items-center gap-2 m-0 mb-[16px]">
                <i class="ph ph-map-pin text-red-500 text-[16px]"></i> Últimos IPs Bloqueados (IA)
            </h3>
            <ul id="ipList" class="list-none p-0 m-0 font-mono text-[12px] text-gray-600 dark:text-gray-400">
                <li class="py-[8px] border-b border-gray-100 dark:border-dark-border flex justify-between">
                    <span class="flex items-center gap-2"><i class="ph ph-x-circle text-red-500"></i> 185.15.22.4</span>
                    <span class="text-gray-500">Origem: RU</span>
                </li>
                <li class="py-[8px] border-b border-gray-100 dark:border-dark-border flex justify-between">
                    <span class="flex items-center gap-2"><i class="ph ph-x-circle text-red-500"></i> 45.33.12.19</span>
                    <span class="text-gray-500">Origem: CN</span>
                </li>
                <li class="py-[8px] flex justify-between">
                    <span class="flex items-center gap-2"><i class="ph ph-x-circle text-red-500"></i> 104.22.1.80</span>
                    <span class="text-gray-500">Origem: KP</span>
                </li>
            </ul>
        </div>
        
        <div class="bento-card bg-brand-500/5 border border-brand-500/20 rounded-[6px] p-[24px]">
            <h3 class="text-[12px] font-[600] text-brand-500 uppercase tracking-[0.05em] flex items-center gap-2 m-0">
                <i class="ph ph-trend-up text-[16px]"></i> Análise Comportamental (UBA)
            </h3>
            <p class="text-[12px] text-gray-500 my-[12px]">O modelo ML analisou o comportamento dos usuários nas últimas 24h e não encontrou anomalias de acesso.</p>
            <div class="w-full h-[6px] bg-gray-200 dark:bg-dark-bg rounded-full overflow-hidden mt-[8px]">
                <div id="ubaBar" class="w-[98%] h-full bg-brand-500"></div>
            </div>
            <div class="flex justify-between text-[11px] font-[600] text-gray-500 uppercase tracking-[0.05em] mt-[8px]">
                <span>Confiabilidade (Score)</span>
                <span id="ubaScore">98%</span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function iniciarVarredura() {
            const btn = document.getElementById('btnScan');
            const cons = document.getElementById('aiConsole');
            const prog = document.getElementById('scanProgress');
            const stat = document.getElementById('scanStatusText');
            const btnIcon = btn.querySelector('i');
            
            btn.disabled = true;
            btnIcon.className = 'ph ph-spinner-gap animate-spin';
            btn.innerHTML = `<i class="${btnIcon.className}"></i> Escaneando Banco de Dados...`;
            
            prog.style.width = '20%';
            cons.innerHTML += '> Iniciando varredura profunda no banco de dados SQL...<br>';
            
            try {
                const response = await fetch('/Admin/ExecutarVarreduraIA', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' }
                });
                const data = await response.json();
                
                prog.style.width = '60%';
                let stepIdx = 0;
                
                const interval = setInterval(() => {
                    if (stepIdx < data.consoleSteps.length) {
                        cons.innerHTML += data.consoleSteps[stepIdx] + '<br>';
                        cons.scrollTop = cons.scrollHeight;
                        stepIdx++;
                        prog.style.width = (60 + (stepIdx * 8)) + '%';
                        stat.innerText = 'Processando logs e anomalias...';
                    } else {
                        clearInterval(interval);
                        
                        // Apply data to DOM
                        document.getElementById('virusCount').innerText = data.virusCount;
                        document.getElementById('invCount').innerText = data.invCount;
                        document.getElementById('ubaScore').innerText = data.score + '%';
                        document.getElementById('ubaBar').style.width = data.score + '%';
                        
                        const ul = document.getElementById('ipList');
                        ul.innerHTML = '';
                        if (data.ips.length === 0) {
                            ul.innerHTML = '<li class="py-[8px] text-gray-500">Nenhum IP bloqueado recentemente.</li>';
                        } else {
                            data.ips.forEach(ip => {
                                ul.innerHTML += `<li class="py-[8px] border-b border-gray-100 dark:border-dark-border flex justify-between"><span class="flex items-center gap-2"><i class="ph ph-x-circle text-red-500"></i> ${ip}</span></li>`;
                            });
                        }

                        prog.style.width = '100%';
                        stat.innerText = 'Varredura Concluída. Dados Reais Sincronizados.';
                        stat.classList.remove('text-gray-500');
                        stat.classList.add('text-emerald-500');
                        
                        if (data.invCount > 0) {
                            cons.innerHTML += `> <span class="text-orange-500">Atenção: Ameaças encontradas no banco de dados.</span><br>`;
                            btn.innerHTML = '<i class="ph ph-warning-circle"></i> Verificar Alertas';
                            btn.classList.replace('bg-brand-600', 'bg-orange-600');
                            btn.classList.replace('hover:bg-[#1D4ED8]', 'hover:bg-orange-700');
                        } else {
                            cons.innerHTML += `> <span class="text-emerald-500">Sistema Seguro. Nenhuma ameaça ativa.</span><br>`;
                            btn.innerHTML = '<i class="ph ph-check-circle"></i> Tudo Seguro';
                            btn.classList.replace('bg-brand-600', 'bg-emerald-600');
                            btn.classList.replace('hover:bg-[#1D4ED8]', 'hover:bg-emerald-700');
                        }
                        
                        cons.scrollTop = cons.scrollHeight;
                        btn.disabled = false;
                    }
                }, 600);
            } catch (err) {
                btn.disabled = false;
                btnIcon.className = 'ph ph-x-circle';
                btn.innerHTML = `<i class="${btnIcon.className}"></i> Erro de Conexão`;
                cons.innerHTML += '> <span class="text-red-500">Falha ao conectar com a API CorvusAI.</span><br>';
            }
        }

</script>
}

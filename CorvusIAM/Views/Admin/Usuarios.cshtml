@model IEnumerable<CorvusIAM.Entities.Usuario>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Diretório de Usuários, Cargos & Equidade Étnico-Racial";
    var cargosCatalogo = ViewBag.Cargos as List<CorvusIAM.Controllers.AdminController.CargoItemDTO> ?? new List<CorvusIAM.Controllers.AdminController.CargoItemDTO>();
    var divMap = ViewBag.DiversidadeMap as Dictionary<int, CorvusIAM.Controllers.AdminController.DiversidadeInfoDTO> ?? new Dictionary<int, CorvusIAM.Controllers.AdminController.DiversidadeInfoDTO>();

    var listaUsuarios = Model?.ToList() ?? new List<CorvusIAM.Entities.Usuario>();
    int totalColaboradores = listaUsuarios.Count;

    // Cálculo de indicadores Étnico-Raciais (IBGE / Estatuto da Igualdade Racial - Lei 12.288/2010)
    int totalAfrodescendentes = 0;
    int totalPretos = 0;
    int totalPardos = 0;
    int totalIndigenas = 0;
    int totalAcoesAfirmativas = 0;

    foreach (var usr in listaUsuarios)
    {
        string raca = "Não Informado";
        string modalidade = "Ampla Concorrência";
        if (divMap.TryGetValue(usr.Id, out var dInfo))
        {
            raca = dInfo.RacaCorIbge ?? "Não Informado";
            modalidade = dInfo.ModalidadeIngresso ?? "Ampla Concorrência";
        }
        else
        {
            // Distribuição determinística representativa para contas seed caso ainda não declaradas manualmente
            var seedMod = usr.Id % 4;
            if (seedMod == 1) { raca = "Preta (Afrodescendente)"; modalidade = "Ação Afirmativa - Equidade Racial"; }
            else if (seedMod == 2) { raca = "Parda (Afrodescendente)"; modalidade = "Programa Liderança Negra & Diversidade"; }
            else if (seedMod == 3) { raca = "Branca"; modalidade = "Ampla Concorrência"; }
            else { raca = "Parda (Afrodescendente)"; modalidade = "Ampla Concorrência"; }
            divMap[usr.Id] = new CorvusIAM.Controllers.AdminController.DiversidadeInfoDTO
            {
                RacaCorIbge = raca,
                ModalidadeIngresso = modalidade
            };
        }

        if (raca.Contains("Preta", StringComparison.OrdinalIgnoreCase)) { totalPretos++; totalAfrodescendentes++; }
        else if (raca.Contains("Parda", StringComparison.OrdinalIgnoreCase)) { totalPardos++; totalAfrodescendentes++; }
        else if (raca.Contains("Indígena", StringComparison.OrdinalIgnoreCase)) { totalIndigenas++; }

        if (!modalidade.Equals("Ampla Concorrência", StringComparison.OrdinalIgnoreCase))
        {
            totalAcoesAfirmativas++;
        }
    }

    int percAfro = totalColaboradores > 0 ? (int)Math.Round((double)totalAfrodescendentes * 100 / totalColaboradores) : 0;
    int percAfirmativa = totalColaboradores > 0 ? (int)Math.Round((double)totalAcoesAfirmativas * 100 / totalColaboradores) : 0;
}

<div class="mb-4 flex flex-col lg:flex-row lg:items-end justify-between gap-3">
    <div>
        <div class="flex items-center gap-2">
            <h1 class="text-[16px] font-[600] text-gray-900 dark:text-white flex items-center gap-2">
                <i class="ph ph-users text-brand-500"></i> Diretório Corporativo, Cargos & Diversidade
            </h1>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-amber-500/10 text-amber-600 dark:text-amber-400 border border-amber-500/20">
                Lei 12.288/10 &amp; Lei 10.639/03
            </span>
        </div>
        <p class="text-[12px] text-gray-500 dark:text-gray-400 mt-0.5">Gerenciamento de identidades IAM, catálogo de cargos RBAC e governança étnico-racial e afrodescendência</p>
    </div>
    <div class="flex flex-wrap items-center gap-2 w-full lg:w-auto">
        <div class="relative flex-1 sm:flex-initial w-full sm:w-[210px]">
            <i class="ph ph-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
            <input type="text" id="searchInput" placeholder="Buscar nome, cargo, etnia..." class="bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[12px] rounded-[6px] pl-8 pr-7 py-1.5 outline-none focus:border-brand-500 transition-colors w-full shadow-xs" />
            <button type="button" onclick="window.iniciarDitadoCampo && window.iniciarDitadoCampo('searchInput')" title="Buscar por comando de voz (Speech-to-Text)" class="absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 hover:text-brand-500 cursor-pointer">
                <i class="ph ph-microphone text-[13px]"></i>
            </button>
        </div>
        <div class="flex items-center bg-gray-100 dark:bg-dark-card border border-gray-300 dark:border-dark-border rounded-[6px] p-0.5">
            <button type="button" id="btnViewGrid" onclick="alternarVisualizacao('grid')" class="p-1.5 rounded-[4px] text-brand-600 dark:text-brand-400 bg-white dark:bg-dark-bg shadow-xs transition-all cursor-pointer" title="Visualização em Grade">
                <i class="ph ph-squares-four text-[15px]"></i>
            </button>
            <button type="button" id="btnViewTable" onclick="alternarVisualizacao('table')" class="p-1.5 rounded-[4px] text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white transition-all cursor-pointer" title="Visualização em Tabela Compacta">
                <i class="ph ph-list-dashes text-[15px]"></i>
            </button>
        </div>
        <button type="button" onclick="openModal('cargosModal')" class="bg-white hover:bg-gray-50 dark:bg-dark-card dark:hover:bg-dark-hover border border-gray-300 dark:border-dark-border text-gray-800 dark:text-gray-200 text-[12px] font-medium px-3 py-1.5 rounded-[6px] shadow-xs transition-colors flex items-center justify-center gap-1.5 cursor-pointer">
            <i class="ph ph-briefcase text-[15px] text-brand-500"></i> Cargos <span class="px-1.5 py-0.2 rounded bg-brand-500/10 text-brand-600 dark:text-brand-400 text-[10px] font-bold">@cargosCatalogo.Count</span>
        </button>
        <a href="/Admin/ExportarUsuariosCsv" class="bg-white hover:bg-gray-50 dark:bg-dark-card dark:hover:bg-dark-hover border border-gray-300 dark:border-dark-border text-gray-800 dark:text-gray-200 text-[12px] font-medium px-3 py-1.5 rounded-[6px] shadow-xs transition-colors flex items-center justify-center gap-1.5">
            <i class="ph ph-file-csv text-[15px] text-emerald-500"></i> CSV
        </a>
        <button type="button" onclick="openModal('newUserModal')" class="bg-brand-600 hover:bg-[#1D4ED8] text-white text-[12px] font-medium px-3 py-1.5 rounded-[6px] shadow-xs transition-colors flex items-center justify-center gap-1.5 cursor-pointer">
            <i class="ph ph-user-plus text-[15px]"></i> Novo Colaborador
        </button>
    </div>
</div>

<!-- Painel Bento UI: Governança Étnico-Racial, Afrodescendência & Inclusão (Etapa 3 - PIM IV) -->
<div class="grid grid-cols-1 lg:grid-cols-12 gap-3 mb-5">
    <!-- Card 1: Indicador de Afrodescendência IBGE (Pretos e Pardos) -->
    <div class="lg:col-span-4 bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] p-3.5 flex flex-col justify-between">
        <div class="flex items-start justify-between gap-2">
            <div>
                <span class="text-[10px] font-semibold uppercase tracking-wider text-amber-600 dark:text-amber-400 flex items-center gap-1">
                    <i class="ph ph-globe-hemisphere-west"></i> Representatividade Afrodescendente
                </span>
                <div class="flex items-baseline gap-2 mt-1">
                    <span class="text-[22px] font-bold text-gray-900 dark:text-white leading-none">@percAfro%</span>
                    <span class="text-[11px] text-gray-500 dark:text-gray-400">(@totalAfrodescendentes de @totalColaboradores colaboradores)</span>
                </div>
            </div>
            <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20">
                Meta ESG &ge; 50%
            </span>
        </div>
        <div class="mt-2.5">
            <div class="w-full h-1.5 bg-gray-100 dark:bg-dark-bg rounded-full overflow-hidden flex">
                <div class="bg-amber-500 h-full transition-all" style="width: @(Math.Min(percAfro, 100))%"></div>
            </div>
            <div class="flex items-center justify-between text-[10px] text-gray-500 dark:text-gray-400 mt-1.5">
                <span>Pretos (IBGE): <b class="text-gray-800 dark:text-gray-200">@totalPretos</b></span>
                <span>Pardos (IBGE): <b class="text-gray-800 dark:text-gray-200">@totalPardos</b></span>
                <span>Indígenas: <b class="text-gray-800 dark:text-gray-200">@totalIndigenas</b></span>
            </div>
        </div>
    </div>

    <!-- Card 2: Ações Afirmativas & Equidade de Cargos -->
    <div class="lg:col-span-4 bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] p-3.5 flex flex-col justify-between">
        <div class="flex items-start justify-between gap-2">
            <div>
                <span class="text-[10px] font-semibold uppercase tracking-wider text-brand-600 dark:text-brand-400 flex items-center gap-1">
                    <i class="ph ph-scales"></i> Ações Afirmativas &amp; Liderança Negra
                </span>
                <div class="flex items-baseline gap-2 mt-1">
                    <span class="text-[22px] font-bold text-gray-900 dark:text-white leading-none">@totalAcoesAfirmativas</span>
                    <span class="text-[11px] text-gray-500 dark:text-gray-400">ingressos por programas afirmativos (@percAfirmativa%)</span>
                </div>
            </div>
            <button type="button" onclick="filtrarPorAfrodescendencia()" class="text-[10px] font-medium px-2 py-1 rounded bg-brand-500/10 text-brand-600 dark:text-brand-400 hover:bg-brand-500/20 transition-colors cursor-pointer" title="Filtrar colaboradores afrodescendentes na listagem">
                Filtrar Afro
            </button>
        </div>
        <p class="text-[11px] text-gray-500 dark:text-gray-400 mt-2 leading-snug">
            Monitoramento ativo de equidade salarial e progressão de carreira em TI conforme <strong class="text-gray-700 dark:text-gray-200">Lei nº 14.611/2023</strong> e <strong class="text-gray-700 dark:text-gray-200">Portaria MTE 3.714/23</strong>.
        </p>
    </div>

    <!-- Card 3: Marco Legal Afro-Brasileiro & Direitos Humanos (Lei 10.639/03 e Lei 12.288/10) -->
    <div class="lg:col-span-4 bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] p-3.5 flex flex-col justify-between">
        <div class="flex items-start justify-between gap-2">
            <div>
                <span class="text-[10px] font-semibold uppercase tracking-wider text-purple-600 dark:text-purple-400 flex items-center gap-1">
                    <i class="ph ph-book-open-text"></i> Educação Étnico-Racial &amp; LGPD Art. 11
                </span>
                <h2 class="text-[12px] font-semibold text-gray-900 dark:text-white mt-0.5">Estatuto da Igualdade Racial &amp; Cultura Afro</h2>
            </div>
            <button type="button" onclick="openModal('afroModal')" class="text-[10px] font-semibold px-2.5 py-1 rounded bg-purple-500/10 text-purple-600 dark:text-purple-300 border border-purple-500/20 hover:bg-purple-500/20 transition-colors cursor-pointer shrink-0">
                Ver Diretrizes
            </button>
        </div>
        <p class="text-[11px] text-gray-500 dark:text-gray-400 mt-1.5 leading-snug">
            Coleta ética de autodeclaração IBGE protegida por anonimização LGPD para promoção de políticas afirmativas e combate ao racismo institucional.
        </p>
    </div>
</div>

<!-- Grid de Colaboradores -->
<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-4" id="userGrid">
    @foreach(var u in listaUsuarios) {
        var initials = string.Join("", (u.Nome ?? "U").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(n => n.Substring(0,1))).ToUpper();
        var dInfo = divMap.ContainsKey(u.Id) ? divMap[u.Id] : new CorvusIAM.Controllers.AdminController.DiversidadeInfoDTO();
        var racaCor = string.IsNullOrWhiteSpace(dInfo.RacaCorIbge) ? "Não Informado" : dInfo.RacaCorIbge;
        var modIngresso = string.IsNullOrWhiteSpace(dInfo.ModalidadeIngresso) ? "Ampla Concorrência" : dInfo.ModalidadeIngresso;
        bool isAfro = racaCor.Contains("Afrodescendente", StringComparison.OrdinalIgnoreCase) || racaCor.Contains("Preta", StringComparison.OrdinalIgnoreCase) || racaCor.Contains("Parda", StringComparison.OrdinalIgnoreCase);

        <div class="user-card bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] p-4 flex flex-col relative overflow-hidden transition-all hover:border-brand-500" data-afro="@(isAfro ? "true" : "false")">
            @if(!u.Ativo) {
                <div class="absolute top-0 right-0 bg-red-500 text-white text-[9px] font-bold px-2 py-0.5 rounded-bl-[6px] uppercase tracking-wider">Bloqueado</div>
            }
            <div class="flex items-center gap-3 mb-3">
                <div class="w-10 h-10 rounded-full flex items-center justify-center text-white font-bold text-[13px] shrink-0" style="background: linear-gradient(135deg, #2563eb, #7c3aed)">
                    @initials
                </div>
                <div class="flex-1 overflow-hidden">
                    <h3 class="text-[13px] font-[600] text-gray-900 dark:text-white m-0 truncate" title="@u.Nome">@u.Nome</h3>
                    <p class="text-[11px] text-brand-600 dark:text-brand-400 font-mono truncate">@u.Email</p>
                </div>
            </div>
            
            <div class="flex flex-col gap-1.5 mb-3 text-[11px] text-gray-600 dark:text-gray-400">
                <div class="flex items-center gap-1.5">
                    <i class="ph ph-briefcase text-brand-500 shrink-0"></i>
                    <span class="truncate font-medium text-gray-800 dark:text-gray-200">@(string.IsNullOrWhiteSpace(u.Cargo) ? "Analista" : u.Cargo)</span>
                    <span class="text-gray-400">•</span>
                    <span class="truncate text-gray-500">@(string.IsNullOrWhiteSpace(u.Departamento) ? "TI" : u.Departamento)</span>
                </div>
                <div class="flex flex-wrap items-center gap-1.5 mt-0.5">
                    <span class="bg-gray-100 dark:bg-dark-bg px-2 py-0.5 rounded-[4px] text-[10px] font-[600] uppercase tracking-wider text-gray-700 dark:text-gray-300 border border-gray-200 dark:border-dark-border">
                        @(u.UsuarioPerfis?.FirstOrDefault()?.Perfil?.Nome ?? "Colaborador")
                    </span>
                    <span class="px-2 py-0.5 rounded-[4px] text-[10px] font-medium @(isAfro ? "bg-amber-500/10 text-amber-700 dark:text-amber-300 border border-amber-500/20" : "bg-blue-500/10 text-blue-700 dark:text-blue-300 border border-blue-500/20")" title="Autodeclaração IBGE: @racaCor | @modIngresso">
                        @racaCor
                    </span>
                </div>
            </div>

            <div class="mt-auto flex justify-between items-center pt-3 border-t border-gray-100 dark:border-dark-border">
                <div class="text-[10px] text-gray-400 flex items-center gap-1">
                    <i class="ph ph-calendar-blank"></i> @(u.DataContratacao?.ToString("dd/MM/yy") ?? "-")
                </div>
                <div class="flex gap-1.5">
                    <button type="button" onclick="abrirEdit(@u.Id, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(u.Nome))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(u.CPF ?? ""))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(u.Cargo ?? ""))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(u.UsuarioPerfis?.FirstOrDefault()?.Perfil?.Nome ?? "Colaborador"))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(u.Departamento ?? ""))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(u.Telefone ?? ""))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(racaCor))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(modIngresso))')" class="p-1 text-gray-400 hover:text-brand-500 transition-colors cursor-pointer" title="Editar Colaborador, Cargo e Autodeclaração">
                        <i class="ph ph-pencil-simple text-[15px]"></i>
                    </button>
                    <button type="button" onclick="inativarUsuario(@u.Id)" class="p-1 text-gray-400 hover:text-orange-500 transition-colors cursor-pointer" title="@(u.Ativo ? "Bloquear Acesso" : "Desbloquear Acesso")">
                        <i class="ph @(u.Ativo ? "ph-lock-key" : "ph-lock-key-open") text-[15px]"></i>
                    </button>
                    <button type="button" onclick="excluirUsuario(@u.Id, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(u.Nome))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(u.Email))')" class="p-1 text-gray-400 hover:text-red-500 transition-colors cursor-pointer" title="Excluir e Anonimizar LGPD">
                        <i class="ph ph-trash text-[15px]"></i>
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<!-- Visualização em Tabela Compacta -->
<div id="userTableWrapper" class="hidden bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] overflow-hidden shadow-xs">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-[12px]">
            <thead class="bg-gray-50 dark:bg-dark-bg/60 border-b border-gray-200 dark:border-dark-border text-gray-500 uppercase tracking-wider text-[10px]">
                <tr>
                    <th class="px-4 py-2.5">Colaborador</th>
                    <th class="px-4 py-2.5">Cargo &amp; Setor</th>
                    <th class="px-4 py-2.5">Autodeclaração IBGE / Equidade</th>
                    <th class="px-4 py-2.5">Perfil RBAC</th>
                    <th class="px-4 py-2.5">Status</th>
                    <th class="px-4 py-2.5 text-right">Ações</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 dark:divide-dark-border" id="userTableBody">
                @foreach(var u in listaUsuarios) {
                    var initials = string.Join("", (u.Nome ?? "U").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(n => n.Substring(0,1))).ToUpper();
                    var dInfo = divMap.ContainsKey(u.Id) ? divMap[u.Id] : new CorvusIAM.Controllers.AdminController.DiversidadeInfoDTO();
                    var racaCor = string.IsNullOrWhiteSpace(dInfo.RacaCorIbge) ? "Não Informado" : dInfo.RacaCorIbge;
                    var modIngresso = string.IsNullOrWhiteSpace(dInfo.ModalidadeIngresso) ? "Ampla Concorrência" : dInfo.ModalidadeIngresso;
                    bool isAfro = racaCor.Contains("Afrodescendente", StringComparison.OrdinalIgnoreCase) || racaCor.Contains("Preta", StringComparison.OrdinalIgnoreCase) || racaCor.Contains("Parda", StringComparison.OrdinalIgnoreCase);

                    <tr class="user-row hover:bg-gray-50/60 dark:hover:bg-[#1B1F24] transition-colors" data-afro="@(isAfro ? "true" : "false")">
                        <td class="px-4 py-2.5">
                            <div class="flex items-center gap-2.5">
                                <div class="w-7 h-7 rounded-full flex items-center justify-center text-white font-bold text-[10px] shrink-0" style="background: linear-gradient(135deg, #2563eb, #7c3aed)">
                                    @initials
                                </div>
                                <div class="overflow-hidden">
                                    <div class="font-[600] text-gray-900 dark:text-white truncate">@u.Nome</div>
                                    <div class="text-[10px] text-brand-600 dark:text-brand-400 font-mono truncate">@u.Email</div>
                                </div>
                            </div>
                        </td>
                        <td class="px-4 py-2.5 text-gray-700 dark:text-gray-300">
                            <div class="font-medium">@(string.IsNullOrWhiteSpace(u.Cargo) ? "Colaborador" : u.Cargo)</div>
                            <div class="text-[10px] text-gray-400">@(string.IsNullOrWhiteSpace(u.Departamento) ? "Geral" : u.Departamento)</div>
                        </td>
                        <td class="px-4 py-2.5">
                            <span class="px-2 py-0.5 rounded-[4px] text-[10px] font-medium @(isAfro ? "bg-amber-500/10 text-amber-700 dark:text-amber-300 border border-amber-500/20" : "bg-blue-500/10 text-blue-700 dark:text-blue-300 border border-blue-500/20")">
                                @racaCor
                            </span>
                            <div class="text-[10px] text-gray-400 mt-0.5">@modIngresso</div>
                        </td>
                        <td class="px-4 py-2.5">
                            <span class="bg-gray-100 dark:bg-dark-bg px-2 py-0.5 rounded-[4px] text-[10px] font-[600] uppercase tracking-wider text-gray-700 dark:text-gray-300 border border-gray-200 dark:border-dark-border">
                                @(u.UsuarioPerfis?.FirstOrDefault()?.Perfil?.Nome ?? "Colaborador")
                            </span>
                        </td>
                        <td class="px-4 py-2.5">
                            @if(u.Ativo) {
                                <span class="inline-flex items-center gap-1 text-[10px] font-medium text-emerald-500 bg-emerald-500/10 px-2 py-0.5 rounded">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Ativo
                                </span>
                            } else {
                                <span class="inline-flex items-center gap-1 text-[10px] font-medium text-red-500 bg-red-500/10 px-2 py-0.5 rounded">
                                    <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span> Bloqueado
                                </span>
                            }
                        </td>
                        <td class="px-4 py-2.5 text-right">
                            <div class="flex items-center justify-end gap-1.5">
                                <button type="button" onclick="abrirEdit(@u.Id, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(u.Nome))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(u.CPF ?? ""))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(u.Cargo ?? ""))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(u.UsuarioPerfis?.FirstOrDefault()?.Perfil?.Nome ?? "Colaborador"))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(u.Departamento ?? ""))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(u.Telefone ?? ""))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(racaCor))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(modIngresso))')" class="p-1 text-gray-400 hover:text-brand-500 transition-colors cursor-pointer" title="Editar">
                                    <i class="ph ph-pencil-simple text-[15px]"></i>
                                </button>
                                <button type="button" onclick="inativarUsuario(@u.Id)" class="p-1 text-gray-400 hover:text-orange-500 transition-colors cursor-pointer" title="@(u.Ativo ? "Bloquear" : "Desbloquear")">
                                    <i class="ph @(u.Ativo ? "ph-lock-key" : "ph-lock-key-open") text-[15px]"></i>
                                </button>
                                <button type="button" onclick="excluirUsuario(@u.Id, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(u.Nome))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(u.Email))')" class="p-1 text-gray-400 hover:text-red-500 transition-colors cursor-pointer" title="Excluir">
                                    <i class="ph ph-trash text-[15px]"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Overlay -->
<div id="modalOverlay" class="fixed inset-0 bg-black/75 z-[100] hidden items-center justify-center p-3 sm:p-4 backdrop-blur-xs transition-opacity">

    <!-- 1. Modal: Novo Colaborador -->
    <div id="newUserModal" class="hidden bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] shadow-2xl w-full max-w-2xl max-h-[92vh] overflow-hidden flex-col">

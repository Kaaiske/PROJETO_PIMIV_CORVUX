        function maskCPF(e) {
            let v = e.target.value.replace(/\D/g,"");
            v = v.replace(/(\d{3})(\d)/,"$1.$2");
            v = v.replace(/(\d{3})(\d)/,"$1.$2");
            v = v.replace(/(\d{3})(\d{1,2})$/,"$1-$2");
            e.target.value = v;
            return v;
        }

        function validarCpfAlgoritmo(cpf) {
            const raw = cpf.replace(/\D/g, '');
            if (raw.length !== 11 || /^(\d)\1{10}$/.test(raw)) return false;
            let soma = 0, resto;
            for (let i = 1; i <= 9; i++) soma += parseInt(raw.substring(i - 1, i)) * (11 - i);
            resto = (soma * 10) % 11;
            if (resto === 10 || resto === 11) resto = 0;
            if (resto !== parseInt(raw.substring(9, 10))) return false;
            soma = 0;
            for (let i = 1; i <= 10; i++) soma += parseInt(raw.substring(i - 1, i)) * (12 - i);
            resto = (soma * 10) % 11;
            if (resto === 10 || resto === 11) resto = 0;
            if (resto !== parseInt(raw.substring(10, 11))) return false;
            return true;
        }

        function aoDigitarCpf(e) {
            const v = maskCPF(e);
            const badge = document.getElementById('cpfStatusBadge');
            const raw = v.replace(/\D/g, '');
            if (raw.length === 11) {
                badge.classList.remove('hidden');
                if (validarCpfAlgoritmo(raw)) {
                    badge.innerHTML = '<span class="text-emerald-500 flex items-center gap-1 font-medium">✓ CPF Válido (Receita Federal - Módulo 11)</span>';
                } else {
                    badge.innerHTML = '<span class="text-red-500 flex items-center gap-1 font-medium">✕ CPF Inválido (Dígito Verificador Incorreto)</span>';
                }
            } else {
                badge.classList.add('hidden');
            }
        }

        async function consultarCepApi(e) {
            let v = e.target.value.replace(/\D/g, '');
            if (v.length > 5) v = v.substring(0, 5) + '-' + v.substring(5, 8);
            e.target.value = v;

            const raw = v.replace(/\D/g, '');
            if (raw.length === 8) {
                const endInput = document.getElementById('endereco');
                endInput.placeholder = 'Consultando ViaCEP...';
                try {
                    const res = await fetch(`/api/public/cep/${raw}`);
                    if (res.ok) {
                        const data = await res.json();
                        if (data.logradouro) {
                            endInput.value = `${data.logradouro}, ${data.bairro || ''}, ${data.localidade} - ${data.uf}`;
                            endInput.classList.add('border-emerald-500');
                            setTimeout(() => endInput.classList.remove('border-emerald-500'), 1500);
                        }
                    }
                } catch (err) {
                    endInput.placeholder = 'Endereço Completo';
                }
            }
        }

        function maskRG(e) {
            let v = e.target.value.replace(/\D/g,"");
            v = v.replace(/(\d{2})(\d)/,"$1.$2");
            v = v.replace(/(\d{3})(\d)/,"$1.$2");
            v = v.replace(/(\d{3})(\d{1,2})$/,"$1-$2");
            e.target.value = v;
        }

        async function adicionarUsuario(e) {
            e.preventDefault();
            const btn = e.target.querySelector('button[type="submit"]');
            btn.disabled = true;
            btn.innerText = 'Salvando...';

            const payload = { 
                Nome: document.getElementById('nome').value, 
                NomeSocial: document.getElementById('nomeSocial').value,
                CPF: document.getElementById('cpf').value, 
                RG: document.getElementById('rg').value,
                DataNascimento: document.getElementById('datanasc').value,
                Telefone: document.getElementById('telefone').value,
                Endereco: document.getElementById('endereco').value,
                Departamento: document.getElementById('departamento').value,
                Cargo: document.getElementById('cargo').value,
                DataContratacao: document.getElementById('datacontr').value,
                Perfil: document.getElementById('perfil').value,
                EmailPessoal: document.getElementById('emailPessoal').value,
                RacaCorIbge: document.getElementById('racaCorIbge').value,
                ModalidadeIngresso: document.getElementById('modalidadeIngresso').value
            };
            
            try {
                const res = await fetch('/Admin/AdicionarUsuario', { 
                    method: 'POST', 
                    headers: { 
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                        'RequestVerificationToken': getCsrfToken() 
                    }, 
                    body: JSON.stringify(payload) 
                });
                
                const contentType = res.headers.get("content-type") || "";

                if(res.ok) {
                    let data = {};
                    if (contentType.includes("application/json")) {
                        data = await res.json();
                    }
                    closeModal();
                    Swal.fire({
                        title: 'Colaborador Cadastrado!',
                        html: `E-mail corporativo gerado: <b>${data.email || 'Concluído'}</b><br>Senha Inicial: <b class="font-mono text-brand-500">${data.senha || 'Verifique com o administrador'}</b><br><br><span class="text-xs text-gray-400">Guarde a senha temporária para entrega ao colaborador.</span>`,
                        icon: 'success',
                        background: '#121418', color: '#fff', confirmButtonColor: '#3B82F6'
                    }).then(() => window.location.reload());
                } else {
                    let errorMsg = 'Não foi possível cadastrar o colaborador.';
                    if (contentType.includes("application/json")) {
                        try {
                            const errData = await res.json();
                            if(errData.message) errorMsg = errData.message;
                            else if(errData.detail) errorMsg = errData.detail;
                        } catch (e) {}
                    } else if (res.status === 401 || res.status === 403) {
                        errorMsg = 'Sua sessão expirou ou seu usuário não possui permissão de RH/Admin. Faça login novamente.';
                    }

                    Swal.fire({ title: 'Aviso', text: errorMsg, icon: 'warning', background: '#121418', color: '#fff', confirmButtonColor: '#3B82F6' });
                    btn.disabled = false;
                    btn.innerText = 'Salvar Colaborador';
                }
            } catch(err) {
                Swal.fire({ 
                    title: 'Falha no Cadastro', 
                    text: err.message || 'Não foi possível comunicar com o servidor. Verifique sua conexão e tente novamente.', 
                    icon: 'error', 
                    background: '#121418', 
                    color: '#fff',
                    confirmButtonColor: '#3B82F6'
                });
                btn.disabled = false;
                btn.innerText = 'Salvar Colaborador';
            }
        }


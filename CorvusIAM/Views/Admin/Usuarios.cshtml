            <div>
                <h4 class="text-[11px] font-semibold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-2">Cargos Ativos no Sistema (@cargosCatalogo.Count)</h4>
                <div class="divide-y divide-gray-100 dark:divide-dark-border border border-gray-200 dark:border-dark-border rounded-[6px] max-h-[260px] overflow-y-auto">
                    @foreach (var cg in cargosCatalogo)
                    {
                        <div class="px-3.5 py-2.5 flex items-center justify-between gap-2 hover:bg-gray-50 dark:hover:bg-dark-bg/40 transition-colors">
                            <div>
                                <div class="text-[12px] font-semibold text-gray-900 dark:text-white">@cg.Titulo</div>
                                <div class="text-[10px] text-gray-500 dark:text-gray-400">
                                    Setor: <b>@cg.Departamento</b> • Nível: <b>@cg.Nivel</b> • RBAC Sugerido: <span class="text-brand-500 font-semibold">@cg.PerfilSugerido</span>
                                </div>
                            </div>
                            <button type="button" onclick="removerCargoCatalogo(@cg.Id)" class="p-1.5 text-gray-400 hover:text-red-500 transition-colors cursor-pointer" title="Remover Cargo">

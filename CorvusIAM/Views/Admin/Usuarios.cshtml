@model IEnumerable<CorvusIAM.Entities.Usuario>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Diretório de Usuários";
}

<div class="mb-[24px] flex flex-col sm:flex-row sm:items-end justify-between gap-3">
    <div>
        <h1 class="text-[16px] font-[600] text-gray-900 dark:text-white flex items-center gap-2">
            <i class="ph ph-users text-brand-500"></i> Diretório Corporativo
        </h1>
        <p class="text-[12px] text-gray-500 dark:text-gray-400 mt-1">Gerenciamento de identidades, credenciais e controle de acesso</p>
    </div>
    <div class="flex flex-wrap sm:flex-nowrap items-center gap-2 w-full sm:w-auto">
        <div class="relative flex-1 sm:flex-initial w-full sm:w-[200px]">
            <i class="ph ph-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-gray-400"></i>
            <input type="text" id="searchInput" placeholder="Buscar colaborador..." class="bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[12px] rounded-[6px] pl-9 pr-3 py-1.5 outline-none focus:border-brand-500 transition-colors w-full shadow-sm" />
        </div>
        <div class="flex items-center bg-gray-100 dark:bg-dark-card border border-gray-300 dark:border-dark-border rounded-[6px] p-0.5">
            <button type="button" id="btnViewGrid" onclick="alternarVisualizacao('grid')" class="p-1.5 rounded-[4px] text-brand-600 dark:text-brand-400 bg-white dark:bg-dark-bg shadow-xs transition-all cursor-pointer" title="Visualização em Grade">
                <i class="ph ph-squares-four text-[15px]"></i>
            </button>
            <button type="button" id="btnViewTable" onclick="alternarVisualizacao('table')" class="p-1.5 rounded-[4px] text-gray-500 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white transition-all cursor-pointer" title="Visualização em Tabela Compacta">
                <i class="ph ph-list-dashes text-[15px]"></i>
            </button>
        </div>
        <a href="/Admin/ExportarUsuariosCsv" class="bg-gray-100 hover:bg-gray-200 dark:bg-dark-card dark:hover:bg-dark-hover border border-gray-300 dark:border-dark-border text-gray-800 dark:text-gray-200 text-[12px] font-medium px-3 py-1.5 rounded-[6px] shadow-sm transition-colors flex items-center justify-center gap-1.5 flex-1 sm:flex-initial">
            <i class="ph ph-file-csv text-[16px] text-emerald-500"></i> <span class="hidden xs:inline sm:inline">Exportar</span> CSV
        </a>
        <button onclick="openModal('newUserModal')" class="bg-brand-600 hover:bg-[#1D4ED8] text-white text-[12px] font-medium px-3 py-1.5 rounded-[6px] shadow-sm transition-colors flex items-center justify-center gap-1.5 cursor-pointer flex-1 sm:flex-initial">
            <i class="ph ph-user-plus"></i> Novo Usuário
        </button>
    </div>
</div>

<div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-4 md:gap-[24px]" id="userGrid">
    @foreach(var u in Model) {
        var initials = string.Join("", (u.Nome ?? "U").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(n => n.Substring(0,1))).ToUpper();
        <div class="user-card bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[20px] flex flex-col relative overflow-hidden transition-all hover:border-brand-500 hover:shadow-lg">
            @if(!u.Ativo) {
                <div class="absolute top-0 right-0 bg-red-500 text-white text-[9px] font-bold px-2 py-1 rounded-bl-[6px] uppercase tracking-wider">Bloqueado</div>
            }
            <div class="flex items-center gap-4 mb-4">
                <div class="w-12 h-12 rounded-full flex items-center justify-center text-white font-bold text-[14px]" style="background: linear-gradient(135deg, #3b82f6, #8b5cf6)">
                    @initials
                </div>
                <div class="flex-1 overflow-hidden">
                    <h3 class="text-[14px] font-[600] text-gray-900 dark:text-white m-0 truncate" title="@u.Nome">@u.Nome</h3>
                    <p class="text-[11px] text-brand-600 dark:text-brand-400 font-mono truncate">@u.Email</p>
                </div>
            </div>
            
            <div class="flex flex-col gap-2 mb-4 text-[12px] text-gray-600 dark:text-gray-400">
                <div class="flex items-center gap-2">
                    <i class="ph ph-briefcase text-gray-400"></i> <span class="truncate">@u.Cargo - @u.Departamento</span>
                </div>
                <div class="flex items-center gap-2">
                    <i class="ph ph-shield-check text-emerald-500"></i> 
                    <span class="bg-gray-100 dark:bg-dark-bg px-2 py-0.5 rounded-[4px] text-[10px] font-[600] uppercase tracking-wider text-gray-700 dark:text-gray-300">
                        @(u.UsuarioPerfis?.FirstOrDefault()?.Perfil?.Nome ?? "Colaborador")
                    </span>
                </div>
            </div>

            <div class="mt-auto flex justify-between items-center pt-4 border-t border-gray-100 dark:border-dark-border">
                <div class="text-[10px] text-gray-400 flex items-center gap-1">
                    <i class="ph ph-clock"></i> Admissão: @(u.DataContratacao?.ToString("MMM/yy") ?? "-")
                </div>
                <div class="flex gap-2">
                    <button onclick="abrirEdit(@u.Id, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(u.Nome))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(u.CPF ?? ""))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(u.Cargo ?? ""))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(u.UsuarioPerfis?.FirstOrDefault()?.Perfil?.Nome ?? "Colaborador"))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(u.Departamento ?? ""))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(u.Telefone ?? ""))')" class="text-gray-400 hover:text-brand-500 transition-colors cursor-pointer" title="Editar">
                        <i class="ph ph-pencil-simple text-[16px]"></i>
                    </button>
                    <button onclick="inativarUsuario(@u.Id)" class="text-gray-400 hover:text-orange-500 transition-colors cursor-pointer" title="@(u.Ativo ? "Bloquear Acesso" : "Desbloquear Acesso")">
                        <i class="ph @(u.Ativo ? "ph-lock-key" : "ph-lock-key-open") text-[16px]"></i>
                    </button>
                    <button onclick="excluirUsuario(@u.Id, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(u.Nome))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(u.Email))')" class="text-gray-400 hover:text-red-500 transition-colors cursor-pointer" title="Excluir">
                        <i class="ph ph-trash text-[16px]"></i>
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<!-- Visualização em Tabela Compacta (Lista) -->
<div id="userTableWrapper" class="hidden bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] overflow-hidden shadow-sm">
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse text-[12px]">
            <thead class="bg-gray-50 dark:bg-dark-bg/60 border-b border-gray-200 dark:border-dark-border text-gray-500 uppercase tracking-wider text-[10px]">
                <tr>
                    <th class="px-4 py-3">Colaborador</th>
                    <th class="px-4 py-3">Cargo & Setor</th>
                    <th class="px-4 py-3">Perfil RBAC</th>
                    <th class="px-4 py-3">Admissão</th>
                    <th class="px-4 py-3">Status</th>
                    <th class="px-4 py-3 text-right">Ações</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 dark:divide-dark-border" id="userTableBody">
                @foreach(var u in Model) {
                    var initials = string.Join("", (u.Nome ?? "U").Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(n => n.Substring(0,1))).ToUpper();
                    <tr class="user-row hover:bg-gray-50/60 dark:hover:bg-[#1B1F24] transition-colors">
                        <td class="px-4 py-3">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-full flex items-center justify-center text-white font-bold text-[11px] shrink-0" style="background: linear-gradient(135deg, #3b82f6, #8b5cf6)">
                                    @initials
                                </div>
                                <div class="overflow-hidden">
                                    <div class="font-[600] text-gray-900 dark:text-white truncate">@u.Nome</div>
                                    <div class="text-[11px] text-brand-600 dark:text-brand-400 font-mono truncate">@u.Email</div>
                                </div>
                            </div>
                        </td>
                        <td class="px-4 py-3 text-gray-700 dark:text-gray-300">
                            <div class="font-medium">@(u.Cargo ?? "Colaborador")</div>
                            <div class="text-[10px] text-gray-400">@(u.Departamento ?? "Geral")</div>
                        </td>
                        <td class="px-4 py-3">
                            <span class="bg-gray-100 dark:bg-dark-bg px-2 py-0.5 rounded-[4px] text-[10px] font-[600] uppercase tracking-wider text-gray-700 dark:text-gray-300 border border-gray-200 dark:border-dark-border">
                                @(u.UsuarioPerfis?.FirstOrDefault()?.Perfil?.Nome ?? "Colaborador")
                            </span>
                        </td>
                        <td class="px-4 py-3 text-gray-500 font-mono text-[11px]">
                            @(u.DataContratacao?.ToString("dd/MM/yyyy") ?? "-")
                        </td>
                        <td class="px-4 py-3">
                            @if(u.Ativo) {
                                <span class="inline-flex items-center gap-1 text-[11px] font-medium text-emerald-500 bg-emerald-500/10 px-2 py-0.5 rounded">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Ativo
                                </span>
                            } else {
                                <span class="inline-flex items-center gap-1 text-[11px] font-medium text-red-500 bg-red-500/10 px-2 py-0.5 rounded">
                                    <span class="w-1.5 h-1.5 rounded-full bg-red-500"></span> Bloqueado
                                </span>
                            }
                        </td>
                        <td class="px-4 py-3 text-right">
                            <div class="flex items-center justify-end gap-2">
                                <button onclick="abrirEdit(@u.Id, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(u.Nome))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(u.CPF ?? ""))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(u.Cargo ?? ""))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(u.UsuarioPerfis?.FirstOrDefault()?.Perfil?.Nome ?? "Colaborador"))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(u.Departamento ?? ""))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(u.Telefone ?? ""))')" class="p-1 text-gray-400 hover:text-brand-500 transition-colors" title="Editar">
                                    <i class="ph ph-pencil-simple text-[16px]"></i>
                                </button>
                                <button onclick="inativarUsuario(@u.Id)" class="p-1 text-gray-400 hover:text-orange-500 transition-colors" title="@(u.Ativo ? "Bloquear" : "Desbloquear")">
                                    <i class="ph @(u.Ativo ? "ph-lock-key" : "ph-lock-key-open") text-[16px]"></i>
                                </button>
                                <button onclick="excluirUsuario(@u.Id, '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(u.Nome))', '@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(u.Email))')" class="p-1 text-gray-400 hover:text-red-500 transition-colors" title="Excluir">
                                    <i class="ph ph-trash text-[16px]"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Overlay -->
<div id="modalOverlay" class="fixed inset-0 bg-black/80 z-[100] hidden items-center justify-center p-4 backdrop-blur-sm transition-opacity">
    <!-- Novo Usuário Modal -->
    <div id="newUserModal" class="hidden bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] shadow-2xl w-full max-w-2xl max-h-[90vh] overflow-hidden flex-col mx-2 sm:mx-0">
        <div class="px-4 sm:px-6 py-3 sm:py-4 border-b border-gray-200 dark:border-dark-border flex justify-between items-center bg-gray-50 dark:bg-dark-bg/50">
            <h3 class="text-[14px] font-[600] text-gray-900 dark:text-white flex items-center gap-2">
                <i class="ph ph-user-plus text-brand-500"></i> Integração de Novo Colaborador
            </h3>
            <button onclick="closeModal()" class="text-gray-500 hover:text-gray-900 dark:hover:text-white transition-colors cursor-pointer">
                <i class="ph ph-x text-[16px]"></i>
            </button>
        </div>
        <div class="p-4 sm:p-6 overflow-y-auto">
            <form onsubmit="adicionarUsuario(event)" class="space-y-6">
                <div>
                    <h4 class="text-[12px] font-[600] text-brand-500 uppercase tracking-[0.05em] border-b border-gray-200 dark:border-dark-border pb-2 mb-4">Dados Pessoais & Diversidade (Etapa 3)</h4>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
                        <input type="text" id="nome" placeholder="Nome Completo" required class="col-span-1 sm:col-span-2 form-control text-[13px]" />
                        <input type="text" id="nomeSocial" placeholder="Nome Social / Pronome (Inclusão e Diversidade - Opcional)" class="col-span-1 sm:col-span-2 form-control text-[13px] border-dashed" />
                        <div>
                            <input type="text" id="cpf" placeholder="CPF (000.000.000-00)" required oninput="aoDigitarCpf(event)" maxlength="14" class="form-control text-[13px]" />
                            <div id="cpfStatusBadge" class="text-[11px] mt-1 font-medium hidden"></div>
                        </div>
                        <input type="text" id="rg" placeholder="RG" required oninput="maskRG(event)" maxlength="12" class="form-control text-[13px]" />
                        <input type="date" id="datanasc" required title="Data de Nascimento" class="form-control text-[13px]" />
                        <input type="text" id="telefone" placeholder="Telefone / Celular" required class="form-control text-[13px]" />
                        
                        <!-- Integracao ViaCEP -->
                        <div class="col-span-1 sm:col-span-2 grid grid-cols-1 sm:grid-cols-3 gap-2">
                            <div class="col-span-1">
                                <input type="text" id="cep" placeholder="CEP (00000-000)" oninput="consultarCepApi(event)" maxlength="9" class="form-control text-[13px]" />
                            </div>
                            <div class="col-span-1 sm:col-span-2">
                                <input type="text" id="endereco" placeholder="Endereço (Autopreenchido via ViaCEP)" required class="form-control text-[13px]" />
                            </div>
                        </div>
                        <input type="email" id="emailPessoal" placeholder="E-mail Pessoal" class="col-span-1 sm:col-span-2 form-control text-[13px]" />
                    </div>
                </div>

                <div>
                    <h4 class="text-[12px] font-[600] text-brand-500 uppercase tracking-[0.05em] border-b border-gray-200 dark:border-dark-border pb-2 mb-4">Contrato Corporativo</h4>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
                        <input type="text" id="departamento" placeholder="Setor / Departamento" required class="form-control text-[13px]" />
                        <div class="flex gap-2">
                            <input type="text" id="cargo" placeholder="Cargo / Função" required list="cargosList" class="form-control text-[13px]" />
                            <datalist id="cargosList">
                                <option value="Administrador de Redes"></option>
                                <option value="Analista de Suporte"></option>
                                <option value="Desenvolvedor de Software"></option>
                                <option value="Analista de Segurança"></option>
                                <option value="Gerente de TI"></option>
                            </datalist>
                        </div>
                        <input type="date" id="datacontr" required title="Data de Contratação" class="form-control text-[13px]" />
                        <select id="perfil" class="form-control text-[13px]">
                            <option value="Colaborador">Tipo: Usuário Padrão</option>
                            <option value="Recursos Humanos">Tipo: Recursos Humanos (RH)</option>
                            <option value="Contabilidade">Tipo: Contabilidade</option>
                            <option value="Help Desk">Tipo: Suporte de TI / Help Desk</option>
                            <option value="Admin">Tipo: Administrador do Sistema</option>
                        </select>
                    </div>
                </div>

                <div class="flex justify-end gap-3 pt-4 border-t border-gray-200 dark:border-dark-border">
                    <button type="button" onclick="closeModal()" class="px-4 py-2 text-[12px] font-medium text-gray-700 dark:text-gray-300 border border-gray-300 dark:border-dark-border rounded-[6px] hover:bg-gray-50 dark:hover:bg-[#1B1F24] transition-colors cursor-pointer">Cancelar</button>
                    <button type="submit" class="px-4 py-2 text-[12px] font-medium text-white bg-brand-600 rounded-[6px] hover:bg-[#1D4ED8] transition-colors cursor-pointer">Salvar Colaborador</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Editar Usuário Modal -->
    <div id="editUserModal" class="hidden bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] shadow-2xl w-full max-w-xl max-h-[90vh] overflow-hidden flex-col mx-2 sm:mx-0">
        <div class="px-4 sm:px-6 py-3 sm:py-4 border-b border-gray-200 dark:border-dark-border flex justify-between items-center bg-gray-50 dark:bg-dark-bg/50">
            <h3 class="text-[14px] font-[600] text-gray-900 dark:text-white flex items-center gap-2">
                <i class="ph ph-pencil-simple text-brand-500"></i> Editar Colaborador
            </h3>
            <button onclick="closeModal()" class="text-gray-500 hover:text-gray-900 dark:hover:text-white transition-colors cursor-pointer">
                <i class="ph ph-x text-[16px]"></i>
            </button>
        </div>
        <div class="p-4 sm:p-6 overflow-y-auto">
            <form onsubmit="salvarEdicao(event)" class="space-y-4">
                <input type="hidden" id="editId" />
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
                    <input type="text" id="editNome" placeholder="Nome Completo" required class="col-span-1 sm:col-span-2 form-control text-[13px]" />
                    <input type="text" id="editTelefone" placeholder="Telefone" required class="form-control text-[13px]" />
                    <input type="text" id="editDepartamento" placeholder="Departamento" required class="form-control text-[13px]" />
                    <input type="text" id="editCpf" placeholder="CPF" required oninput="maskCPF(event)" maxlength="14" class="form-control text-[13px]" />
                    <input type="text" id="editCargo" placeholder="Cargo" required class="form-control text-[13px]" />
                    <select id="editPerfil" class="col-span-1 sm:col-span-2 form-control text-[13px]">
                        <option value="Colaborador">Tipo: Usuário Padrão</option>
                        <option value="Recursos Humanos">Tipo: Recursos Humanos (RH)</option>
                        <option value="Contabilidade">Tipo: Contabilidade</option>
                        <option value="Help Desk">Tipo: Suporte de TI / Help Desk</option>
                        <option value="Admin">Tipo: Administrador do Sistema</option>
                    </select>
                </div>
                
                <button type="button" onclick="resetarSenhaAdmin()" class="w-full mt-4 py-2 px-4 border border-orange-500/30 bg-orange-500/10 text-orange-500 rounded-[6px] text-[12px] font-[500] hover:bg-orange-500/20 transition-colors flex items-center justify-center gap-2 cursor-pointer">
                    <i class="ph ph-key"></i> Gerar Nova Senha Aleatória
                </button>

                <div class="flex justify-end gap-3 pt-4 mt-6 border-t border-gray-200 dark:border-dark-border">
                    <button type="button" onclick="closeModal()" class="px-4 py-2 text-[12px] font-medium text-gray-700 dark:text-gray-300 border border-gray-300 dark:border-dark-border rounded-[6px] hover:bg-gray-50 dark:hover:bg-[#1B1F24] transition-colors cursor-pointer">Cancelar</button>
                    <button type="submit" class="px-4 py-2 text-[12px] font-medium text-white bg-brand-600 rounded-[6px] hover:bg-[#1D4ED8] transition-colors cursor-pointer">Salvar Alterações</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function openModal(id) { 
            const overlay = document.getElementById('modalOverlay');
            if (!overlay) return;
            overlay.classList.remove('hidden');
            overlay.classList.add('flex');
            
            const newM = document.getElementById('newUserModal');
            const editM = document.getElementById('editUserModal');
            if (newM) newM.classList.add('hidden');
            if (editM) editM.classList.add('hidden');
            
            const target = document.getElementById(id);
            if (target) {
                target.classList.remove('hidden');
                target.classList.add('flex');
            }
        }
        
        function closeModal() { 
            const overlay = document.getElementById('modalOverlay');
            if (!overlay) return;
            overlay.classList.add('hidden');
            overlay.classList.remove('flex');

            const newM = document.getElementById('newUserModal');
            const editM = document.getElementById('editUserModal');
            if (newM) { newM.classList.add('hidden'); newM.classList.remove('flex'); }
            if (editM) { editM.classList.add('hidden'); editM.classList.remove('flex'); }
        }

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeModal();
        });
        
        function maskCPF(e) {
            let v = e.target.value.replace(/\D/g,"");
            v = v.replace(/(\d{3})(\d)/,"$1.$2");
            v = v.replace(/(\d{3})(\d)/,"$1.$2");
            v = v.replace(/(\d{3})(\d{1,2})$/,"$1-$2");
            e.target.value = v;
            return v;
        }

        function validarCpfAlgoritmo(cpf) {
            const raw = cpf.replace(/\D/g, '');
            if (raw.length !== 11 || /^(\d)\1{10}$/.test(raw)) return false;
            let soma = 0, resto;
            for (let i = 1; i <= 9; i++) soma += parseInt(raw.substring(i - 1, i)) * (11 - i);
            resto = (soma * 10) % 11;
            if (resto === 10 || resto === 11) resto = 0;
            if (resto !== parseInt(raw.substring(9, 10))) return false;
            soma = 0;
            for (let i = 1; i <= 10; i++) soma += parseInt(raw.substring(i - 1, i)) * (12 - i);
            resto = (soma * 10) % 11;
            if (resto === 10 || resto === 11) resto = 0;
            if (resto !== parseInt(raw.substring(10, 11))) return false;
            return true;
        }

        function aoDigitarCpf(e) {
            const v = maskCPF(e);
            const badge = document.getElementById('cpfStatusBadge');
            const raw = v.replace(/\D/g, '');
            if (raw.length === 11) {
                badge.classList.remove('hidden');
                if (validarCpfAlgoritmo(raw)) {
                    badge.innerHTML = '<span class="text-emerald-500 flex items-center gap-1 font-medium">✓ CPF Válido (Receita Federal - Módulo 11)</span>';
                } else {
                    badge.innerHTML = '<span class="text-red-500 flex items-center gap-1 font-medium">✕ CPF Inválido (Dígito Verificador Incorreto)</span>';
                }
            } else {
                badge.classList.add('hidden');
            }
        }

        async function consultarCepApi(e) {
            let v = e.target.value.replace(/\D/g, '');
            if (v.length > 5) v = v.substring(0, 5) + '-' + v.substring(5, 8);
            e.target.value = v;

            const raw = v.replace(/\D/g, '');
            if (raw.length === 8) {
                const endInput = document.getElementById('endereco');
                endInput.placeholder = 'Consultando ViaCEP...';
                try {
                    const res = await fetch(`/api/public/cep/${raw}`);
                    if (res.ok) {
                        const data = await res.json();
                        if (data.logradouro) {
                            endInput.value = `${data.logradouro}, ${data.bairro || ''}, ${data.localidade} - ${data.uf}`;
                            endInput.classList.add('border-emerald-500');
                            setTimeout(() => endInput.classList.remove('border-emerald-500'), 1500);
                        }
                    }
                } catch (err) {
                    endInput.placeholder = 'Endereço Completo';
                }
            }
        }

        function maskRG(e) {
            let v = e.target.value.replace(/\D/g,"");
            v = v.replace(/(\d{2})(\d)/,"$1.$2");
            v = v.replace(/(\d{3})(\d)/,"$1.$2");
            v = v.replace(/(\d{3})(\d{1,2})$/,"$1-$2");
            e.target.value = v;
        }

        async function adicionarUsuario(e) {
            e.preventDefault();
            const btn = e.target.querySelector('button[type="submit"]');
            btn.disabled = true;
            btn.innerText = 'Processando...';

            const payload = { 
                Nome: document.getElementById('nome').value, 
                CPF: document.getElementById('cpf').value, 
                RG: document.getElementById('rg').value,
                DataNascimento: document.getElementById('datanasc').value,
                Telefone: document.getElementById('telefone').value,
                Endereco: document.getElementById('endereco').value,
                Departamento: document.getElementById('departamento').value,
                Cargo: document.getElementById('cargo').value,
                DataContratacao: document.getElementById('datacontr').value,
                Perfil: document.getElementById('perfil').value,
                EmailPessoal: document.getElementById('emailPessoal').value 
            };
            
            try {
                const res = await fetch('/Admin/AdicionarUsuario', { 
                    method: 'POST', 
                    headers: { 
                        'Content-Type': 'application/json',
                        'Accept': 'application/json',
                        'RequestVerificationToken': getCsrfToken() 
                    }, 
                    body: JSON.stringify(payload) 
                });
                
                const contentType = res.headers.get("content-type") || "";

                if(res.ok) {
                    let data = {};
                    if (contentType.includes("application/json")) {
                        data = await res.json();
                    }
                    closeModal();
                    Swal.fire({
                        title: 'Colaborador Cadastrado!',
                        html: `E-mail corporativo gerado: <b>${data.email || 'Concluído'}</b><br>Senha Inicial: <b class="font-mono text-brand-500">${data.senha || 'Verifique com o administrador'}</b><br><br><span class="text-xs text-gray-400">Guarde a senha temporária para entrega ao colaborador.</span>`,
                        icon: 'success',
                        background: '#121418', color: '#fff', confirmButtonColor: '#3B82F6'
                    }).then(() => window.location.reload());
                } else {
                    let errorMsg = 'Não foi possível cadastrar o colaborador.';
                    if (contentType.includes("application/json")) {
                        try {
                            const errData = await res.json();
                            if(errData.message) errorMsg = errData.message;
                            else if(errData.detail) errorMsg = errData.detail;
                        } catch (e) {}
                    } else if (res.status === 401 || res.status === 403) {
                        errorMsg = 'Sua sessão expirou ou seu usuário não possui permissão de RH/Admin. Faça login novamente.';
                    }

                    Swal.fire({ title: 'Aviso', text: errorMsg, icon: 'warning', background: '#121418', color: '#fff', confirmButtonColor: '#3B82F6' });
                    btn.disabled = false;
                    btn.innerText = 'Salvar Colaborador';
                }
            } catch(err) {
                Swal.fire({ 
                    title: 'Falha no Cadastro', 
                    text: err.message || 'Não foi possível comunicar com o servidor. Verifique sua conexão e tente novamente.', 
                    icon: 'error', 
                    background: '#121418', 
                    color: '#fff',
                    confirmButtonColor: '#3B82F6'
                });
                btn.disabled = false;
                btn.innerText = 'Salvar Colaborador';
            }
        }

        function abrirEdit(id, nome, cpf, cargo, perfil, departamento, telefone) {
            document.getElementById('editId').value = id;
            document.getElementById('editNome').value = nome || '';
            document.getElementById('editCpf').value = cpf || '';
            document.getElementById('editCargo').value = cargo || '';
            document.getElementById('editDepartamento').value = departamento || '';
            document.getElementById('editTelefone').value = telefone || '';
            document.getElementById('editPerfil').value = perfil || 'Colaborador';
            openModal('editUserModal');
        }

        async function resetarSenhaAdmin() {
            const id = document.getElementById('editId').value;
            closeModal();
            const result = await Swal.fire({
                title: 'Gerar Nova Senha?',
                text: "O sistema irá gerar uma nova senha aleatória segura para este usuário.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#f97316',
                cancelButtonColor: '#333',
                confirmButtonText: 'Sim, gerar',
                cancelButtonText: 'Cancelar',
                background: '#121418', color: '#fff'
            });
            
            if (result.isConfirmed) {
                try {
                    const res = await fetch('/Admin/ResetarSenhaUsuario', { 
                        method: 'POST', 
                        headers: { 
                            'Content-Type': 'application/json', 
                            'RequestVerificationToken': getCsrfToken() 
                        }, 

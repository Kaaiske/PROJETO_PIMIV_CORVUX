        async function excluirUsuario(id, nome, email) {
            const result = await Swal.fire({
                title: '⚠️ AÇÃO IRREVERSÍVEL: Confirmar Exclusão?',
                html: `
                    <div class="text-left bg-red-950/60 border border-red-500/40 p-3 rounded-[6px] mb-3 text-xs text-red-200">
                        <b class="text-red-400 block mb-1">AUTORIDADE EXIGIDA:</b> Apenas usuários com perfil Administrador possuem autoridade legal para realizar esta operação no sistema.
                    </div>
                    <div class="text-left text-xs text-gray-300 space-y-2">
                        <p>Você está prestes a excluir o colaborador <b>${nome || 'identificado'}</b> (<span class="font-mono text-brand-400">${email || 'ID: ' + id}</span>).</p>
                        <p><b class="text-red-400">ATENÇÃO:</b> Esta ação é permanente e irreversível. O acesso aos sistemas será imediatamente revogado, as sessões ativas serão canceladas e os dados cadastrais passarão por <b>anonimização conforme a LGPD</b>, sendo arquivados via Stored Procedure <code>sp_InativarColaborador</code>.</p>
                    </div>
                `,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#4b5563',
                confirmButtonText: 'Sim, Executar Exclusão Irreversível',
                cancelButtonText: 'Cancelar Operação',
                background: '#121418', color: '#fff'
            });
            
            if (result.isConfirmed) {
                try {
                    const res = await fetch('/Admin/ExcluirUsuario', { 
                        method: 'POST', 
                        headers: { 
                            'Content-Type': 'application/json', 
                            'RequestVerificationToken': getCsrfToken() 
                        }, 
                        body: JSON.stringify(id) 
                    });
                    if (res.ok) {
                        Swal.fire({
                            title: 'Excluído com sucesso!',
                            text: 'O colaborador foi desativado e os dados foram anonimizados.',
                            icon: 'success',
                            background: '#121418', color: '#fff', confirmButtonColor: '#3B82F6'
                        }).then(() => window.location.reload());
                    } else {
                        let errorMsg = 'Não foi possível excluir o usuário.';
                        try {
                            const err = await res.json();
                            if (err.message) errorMsg = err.message;
                        } catch(e) {}
                        Swal.fire({ title: 'Aviso', text: errorMsg, icon: 'warning', background: '#121418', color: '#fff', confirmButtonColor: '#3B82F6' });
                    }
                } catch(err) {
                    Swal.fire({ title: 'Erro de Conexão', text: 'Falha ao comunicar com o servidor.', icon: 'error', background: '#121418', color: '#fff' });
                }
            }
        }
    
        // Alternância de Visualização (Grade vs Tabela Compacta)
        function alternarVisualizacao(modo) {
            const grid = document.getElementById('userGrid');
            const table = document.getElementById('userTableWrapper');
            const btnGrid = document.getElementById('btnViewGrid');
            const btnTable = document.getElementById('btnViewTable');

            if (modo === 'table') {
                grid.classList.add('hidden');
                table.classList.remove('hidden');
                btnTable.classList.add('text-brand-600', 'dark:text-brand-400', 'bg-white', 'dark:bg-dark-bg', 'shadow-xs');
                btnTable.classList.remove('text-gray-500');
                btnGrid.classList.remove('text-brand-600', 'dark:text-brand-400', 'bg-white', 'dark:bg-dark-bg', 'shadow-xs');
                btnGrid.classList.add('text-gray-500');
                localStorage.setItem('corvux_usuarios_view', 'table');
            } else {
                table.classList.add('hidden');
                grid.classList.remove('hidden');
                btnGrid.classList.add('text-brand-600', 'dark:text-brand-400', 'bg-white', 'dark:bg-dark-bg', 'shadow-xs');
                btnGrid.classList.remove('text-gray-500');
                btnTable.classList.remove('text-brand-600', 'dark:text-brand-400', 'bg-white', 'dark:bg-dark-bg', 'shadow-xs');
                btnTable.classList.add('text-gray-500');
                localStorage.setItem('corvux_usuarios_view', 'grid');
            }
        }

        // Restaura a preferência salva
        if (localStorage.getItem('corvux_usuarios_view') === 'table') {
            alternarVisualizacao('table');
        }

        document.getElementById('searchInput').addEventListener('input', function(e) {
            const term = e.target.value.toLowerCase();
            document.querySelectorAll('.user-card').forEach(card => {
                const text = card.innerText.toLowerCase();
                if(text.includes(term)) card.style.display = 'flex';
                else card.style.display = 'none';
            });
            document.querySelectorAll('.user-row').forEach(row => {
                const text = row.innerText.toLowerCase();
                if(text.includes(term)) row.style.display = '';
                else row.style.display = 'none';
            });
        });
    </script>

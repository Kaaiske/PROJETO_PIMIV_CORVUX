    <!-- 4. Modal: Carta de Diretrizes de Afrodescendência & Educação das Relações Étnico-Raciais -->
    <div id="afroModal" class="hidden bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] shadow-2xl w-full max-w-2xl max-h-[90vh] overflow-hidden flex-col">
        <div class="px-5 py-3.5 border-b border-gray-200 dark:border-dark-border flex justify-between items-center bg-gray-50 dark:bg-dark-bg/50">
            <h3 class="text-[14px] font-[600] text-gray-900 dark:text-white flex items-center gap-2">
                <i class="ph ph-globe-hemisphere-west text-amber-500"></i> Política Institucional de Afrodescendência &amp; Equidade Étnico-Racial
            </h3>
            <button type="button" onclick="closeModal()" class="text-gray-500 hover:text-gray-900 dark:hover:text-white transition-colors cursor-pointer">
                <i class="ph ph-x text-[16px]"></i>
            </button>
        </div>
        <div class="p-5 overflow-y-auto space-y-3 text-[12px] text-gray-600 dark:text-gray-300 leading-relaxed">
            <div class="p-3 rounded-[6px] bg-amber-500/10 border border-amber-500/20 text-amber-800 dark:text-amber-300">
                <strong>Conformidade Acadêmica &amp; Legal (Etapa 3 PIM IV):</strong> O CorvuxIAM incorpora nativamente os preceitos da <strong>Lei nº 10.639/2003</strong> (História e Cultura Afro-Brasileira), da <strong>Lei nº 11.645/2008</strong>, do <strong>Estatuto da Igualdade Racial (Lei nº 12.288/2010)</strong> e da <strong>Lei nº 14.611/2023</strong> (Igualdade Salarial e de Critérios Remuneratórios).
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                <div class="p-3 rounded-[6px] border border-gray-200 dark:border-dark-border bg-gray-50/50 dark:bg-dark-bg/40">
                    <h4 class="font-semibold text-gray-900 dark:text-white mb-1">1. Autodeclaração IBGE &amp; Afrodescendência</h4>
                    <p class="text-[11px]">Adota as categorias oficiais do IBGE (<em>Preta</em>, <em>Parda</em>, <em>Indígena</em>, <em>Amarela</em> e <em>Branca</em>), reconhecendo a população afrodescendente (soma de pretos e pardos) na mensuração de metas de diversidade e inclusão em tecnologia.</p>
                </div>
                <div class="p-3 rounded-[6px] border border-gray-200 dark:border-dark-border bg-gray-50/50 dark:bg-dark-bg/40">
                    <h4 class="font-semibold text-gray-900 dark:text-white mb-1">2. Proteção de Dados Sensíveis (LGPD Art. 11)</h4>
                    <p class="text-[11px]">Os dados de origem racial ou étnica são tratados estritamente com base legal de políticas públicas e ações afirmativas de inclusão, com controle de acesso restrito ao RH e anonimização criptográfica no desligamento.</p>
                </div>
            </div>
            <div class="flex justify-end pt-2">
                <button type="button" onclick="closeModal()" class="px-4 py-1.5 bg-brand-600 text-white rounded-[6px] text-[12px] font-medium cursor-pointer">Entendido</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const modalIds = ['newUserModal', 'editUserModal', 'cargosModal', 'afroModal'];

        function openModal(id) { 
            const overlay = document.getElementById('modalOverlay');
            if (!overlay) return;
            overlay.classList.remove('hidden');
            overlay.classList.add('flex');
            
            modalIds.forEach(mId => {
                const el = document.getElementById(mId);
                if (el) { el.classList.add('hidden'); el.classList.remove('flex'); }
            });
            
            const target = document.getElementById(id);
            if (target) {
                target.classList.remove('hidden');
                target.classList.add('flex');
            }
        }
        
        function closeModal() { 
            const overlay = document.getElementById('modalOverlay');
            if (!overlay) return;
            overlay.classList.add('hidden');
            overlay.classList.remove('flex');

            modalIds.forEach(mId => {
                const el = document.getElementById(mId);
                if (el) { el.classList.add('hidden'); el.classList.remove('flex'); }
            });
        }

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeModal();
        });

        function aoSelecionarCargoCatalogo(valor, idCargoInput, idDeptoInput, idPerfilSelect) {
            if (!valor || valor === '__CUSTOM__') {
                if (valor === '__CUSTOM__') {
                    const inputCargo = document.getElementById(idCargoInput);
                    if (inputCargo) { inputCargo.value = ''; inputCargo.focus(); }
                }
                return;
            }
            const cargoEl = document.getElementById(idCargoInput);
            if (cargoEl) cargoEl.value = valor;

            const sel = event.target;
            const opt = sel.options[sel.selectedIndex];
            if (opt) {
                const depto = opt.getAttribute('data-depto');
                const perfil = opt.getAttribute('data-perfil');
                if (depto && document.getElementById(idDeptoInput)) {
                    document.getElementById(idDeptoInput).value = depto;
                }
                if (perfil && document.getElementById(idPerfilSelect)) {
                    document.getElementById(idPerfilSelect).value = perfil;
                }
            }
        }

        async function cadastrarNovoCargo(e) {
            e.preventDefault();
            const btn = document.getElementById('btnSalvarCargo');
            if (btn) { btn.disabled = true; btn.innerText = 'Salvando...'; }

            const payload = {
                Titulo: document.getElementById('novoCargoTitulo').value,
                Departamento: document.getElementById('novoCargoDepto').value,
                Nivel: document.getElementById('novoCargoNivel').value,
                PerfilSugerido: document.getElementById('novoCargoPerfil').value
            };

            try {
                const res = await fetch('/Admin/AdicionarCargo', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getCsrfToken()
                    },
                    body: JSON.stringify(payload)
                });
                const data = await res.json();
                if (res.ok) {
                    Swal.fire({ title: 'Cargo Cadastrado!', text: data.message, icon: 'success', timer: 1400, showConfirmButton: false, background: '#121418', color: '#fff' })
                        .then(() => window.location.reload());
                } else {
                    Swal.fire({ title: 'Aviso', text: data.message || 'Erro ao adicionar cargo.', icon: 'warning', background: '#121418', color: '#fff' });
                    if (btn) { btn.disabled = false; btn.innerText = 'Adicionar Cargo ao Catálogo'; }
                }
            } catch (err) {
                Swal.fire({ title: 'Erro', text: 'Falha de conexão.', icon: 'error', background: '#121418', color: '#fff' });
                if (btn) { btn.disabled = false; btn.innerText = 'Adicionar Cargo ao Catálogo'; }
            }
        }

        async function removerCargoCatalogo(id) {
            try {

@model IEnumerable<CorvusIAM.Entities.ChamadoSuporte>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Fila Help Desk";
}

<div class="mb-[24px] flex flex-col sm:flex-row sm:justify-between sm:items-end gap-3">
    <div>
        <h1 class="text-[16px] font-[600] text-gray-900 dark:text-white flex items-center gap-2">
            <i class="ph ph-headset text-brand-500"></i> Suporte e Fila de Chamados
        </h1>
        <p class="text-[12px] text-gray-500 dark:text-gray-400 mt-1">Gestão de chamados, solicitações de acesso e requisições de TI</p>
    </div>
    <button onclick="openNovaIssueModal()" class="w-full sm:w-auto bg-brand-600 hover:bg-[#1D4ED8] text-white text-[12px] font-medium px-3 py-1.5 rounded-[6px] shadow-sm transition-colors flex items-center justify-center gap-1.5 cursor-pointer">
        <i class="ph ph-plus"></i> Novo Chamado / Issue
    </button>
</div>

<div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] flex flex-col overflow-hidden">
    @if(!Model.Any()) {
        <div class="p-[24px] text-[13px] text-gray-500 dark:text-gray-400">Nenhum chamado pendente na fila.</div>
    } else {
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-50 dark:bg-dark-bg/50 border-b border-gray-200 dark:border-dark-border">
                        <th class="px-[16px] py-[12px] text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em]">ID</th>
                        <th class="px-[16px] py-[12px] text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em]">Usuário</th>
                        <th class="px-[16px] py-[12px] text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em]">Assunto</th>
                        <th class="px-[16px] py-[12px] text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em]">Data</th>
                        <th class="px-[16px] py-[12px] text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em]">Anexo</th>
                        <th class="px-[16px] py-[12px] text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em]">Status</th>
                        <th class="px-[16px] py-[12px] text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em] text-right">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var c in Model){
                        <tr class="group border-b border-gray-100 dark:border-dark-border hover:bg-gray-50 dark:hover:bg-[#1B1F24] transition-colors">
                            <td class="px-[16px] py-[12px] text-[13px] text-brand-500 font-mono">CORV-@c.Id</td>
                            <td class="px-[16px] py-[12px] text-[13px] font-[500] text-gray-900 dark:text-gray-100">@(c.Usuario?.Nome ?? "Colaborador")</td>
                            <td class="px-[16px] py-[12px] text-[13px] text-gray-600 dark:text-gray-300">@c.Assunto</td>
                            <td class="px-[16px] py-[12px] text-[12px] text-gray-500">@c.DataAbertura.ToString("dd/MM HH:mm")</td>
                            <td class="px-[16px] py-[12px] text-[12px]">
                                @if(!string.IsNullOrEmpty(c.AnexoUrl)) {
                                    <a href="@c.AnexoUrl" target="_blank" class="inline-flex items-center gap-1 text-brand-600 dark:text-brand-400 hover:underline font-medium text-[11px] bg-brand-50 dark:bg-brand-900/30 px-2 py-0.5 rounded border border-brand-200 dark:border-brand-800">
                                        <i class="ph ph-paperclip"></i> Anexo
                                    </a>
                                } else {
                                    <span class="text-gray-400 text-[11px]">-</span>
                                }
                            </td>
                            <td class="px-[16px] py-[12px]">
                                @if(c.Status == "Aberto") { <span class="text-orange-500 text-[12px] font-[500] flex items-center gap-1"><i class="ph ph-warning-circle"></i> Aberto</span> }
                                else if(c.Status == "Fechado") { <span class="text-emerald-500 text-[12px] font-[500] flex items-center gap-1"><i class="ph ph-check-circle"></i> Fechado</span> }
                                else { <span class="text-brand-500 text-[12px] font-[500] flex items-center gap-1"><i class="ph ph-spinner-gap animate-spin"></i> @c.Status</span> }
                            </td>
                            <td class="px-[16px] py-[12px] text-right">
                                <select onchange="updateStatus(@c.Id, this.value)" class="bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-[12px] text-gray-700 dark:text-gray-300 rounded-[4px] px-2 py-1 outline-none focus:border-brand-500 cursor-pointer">
                                    <option value="" selected disabled>Mudar Status...</option>
                                    <option value="Aberto">Aberto</option>
                                    <option value="Em Andamento">Em Andamento</option>
                                    <option value="Fechado">Fechado</option>
                                </select>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@section Scripts {
    <script>
        async function updateStatus(id, status) {
            try {
                const res = await fetch('/Admin/AtualizarChamado', {
                    method: 'POST',
                    headers: { 
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getCsrfToken()
                    },
                    body: JSON.stringify({ Id: id, Status: status })
                });
                if(res.ok) {
                    Swal.fire({ title: 'Status Atualizado!', text: `Chamado CORV-${id} alterado para ${status}.`, icon: 'success', background: '#121418', color: '#ffffff', confirmButtonColor: '#3B82F6' }).then(() => window.location.reload());
                } else {
                    Swal.fire({ title: 'Erro', text: 'Falha ao atualizar chamado.', icon: 'error', background: '#121418', color: '#ffffff', confirmButtonColor: '#3B82F6' });
                }
            } catch(e) {
                Swal.fire({ title: 'Erro de Conexão', text: 'Não foi possível atualizar o chamado.', icon: 'error', background: '#121418', color: '#ffffff' });
            }
        }
    </script>
}

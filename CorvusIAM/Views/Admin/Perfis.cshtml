@model IEnumerable<CorvusIAM.Entities.Perfil>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Gestão de Perfis";
}

<div class="mb-[24px] flex justify-between items-end">
    <div>
        <h1 class="text-[16px] font-[600] text-gray-900 dark:text-white flex items-center gap-2">
            <i class="ph ph-identification-badge text-brand-500"></i> Perfis e Permissões
        </h1>
        <p class="text-[12px] text-gray-500 dark:text-gray-400 mt-1">Controle de Acesso Baseado em Funções (RBAC)</p>
    </div>
    <button onclick="openModal('newPerfilModal')" class="bg-brand-600 hover:bg-[#1D4ED8] text-white text-[12px] font-medium px-3 py-1.5 rounded-[6px] shadow-sm transition-colors flex items-center gap-1.5">
        <i class="ph ph-plus"></i> Novo Perfil
    </button>
</div>

<div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] flex flex-col overflow-hidden">
    @if(!Model.Any()) {
        <div class="p-[24px] text-[13px] text-gray-500 dark:text-gray-400">Nenhum perfil cadastrado.</div>
    } else {
        <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="bg-gray-50 dark:bg-dark-bg/50 border-b border-gray-200 dark:border-dark-border">
                        <th class="px-[16px] py-[12px] text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em]">ID</th>
                        <th class="px-[16px] py-[12px] text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em]">Nome do Perfil</th>
                        <th class="px-[16px] py-[12px] text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em]">Descrição / Nível</th>
                        <th class="px-[16px] py-[12px] text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em] text-right">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var p in Model){
                        <tr class="group border-b border-gray-100 dark:border-dark-border hover:bg-gray-50 dark:hover:bg-[#1B1F24] transition-colors">
                            <td class="px-[16px] py-[12px] text-[13px] text-brand-500 font-mono">CORV-P-@p.Id</td>
                            <td class="px-[16px] py-[12px] text-[13px] font-[500] text-gray-900 dark:text-gray-100">@p.Nome</td>
                            <td class="px-[16px] py-[12px]">
                                <span class="bg-brand-500/10 text-brand-600 dark:text-brand-400 border border-brand-500/20 px-2 py-0.5 rounded-[4px] text-[11px] font-[600]">
                                    @p.Descricao
                                </span>
                            </td>
                            <td class="px-[16px] py-[12px] text-right">
                                <button onclick="excluirPerfil(@p.Id)" class="text-gray-500 hover:text-red-500 transition-colors" title="Excluir">
                                    <i class="ph ph-trash text-[16px]"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<!-- Modal Overlay -->
<div id="modalOverlay" class="fixed inset-0 bg-black/80 z-[100] hidden items-center justify-center p-4 backdrop-blur-sm transition-opacity">
    <div id="newPerfilModal" class="hidden bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] shadow-2xl w-full max-w-sm overflow-hidden flex-col">
        <div class="px-6 py-4 border-b border-gray-200 dark:border-dark-border flex justify-between items-center bg-gray-50 dark:bg-dark-bg/50">
            <h3 class="text-[14px] font-[600] text-gray-900 dark:text-white flex items-center gap-2 m-0">
                <i class="ph ph-shield-check text-brand-500"></i> Novo Perfil
            </h3>
            <button onclick="closeModal()" class="text-gray-500 hover:text-gray-900 dark:hover:text-white transition-colors">
                <i class="ph ph-x text-[16px]"></i>
            </button>
        </div>
        <div class="p-6">
            <form onsubmit="adicionarPerfil(event)" class="space-y-4">
                <input type="text" id="nomePerfil" placeholder="Nome (Ex: Financeiro)" required class="w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[13px] rounded-[6px] px-3 py-2 outline-none focus:border-brand-500" />
                <input type="text" id="descricaoPerfil" placeholder="Descrição (Ex: Acesso financeiro)" required class="w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[13px] rounded-[6px] px-3 py-2 outline-none focus:border-brand-500" />
                
                <div class="flex justify-end gap-3 pt-4 border-t border-gray-200 dark:border-dark-border mt-4">
                    <button type="button" onclick="closeModal()" class="px-4 py-2 text-[12px] font-medium text-gray-700 dark:text-gray-300 border border-gray-300 dark:border-dark-border rounded-[6px] hover:bg-gray-50 dark:hover:bg-[#1B1F24] transition-colors">Cancelar</button>
                    <button type="submit" class="px-4 py-2 text-[12px] font-medium text-white bg-brand-600 rounded-[6px] hover:bg-[#1D4ED8] transition-colors">Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function openModal(id) { 
            const overlay = document.getElementById('modalOverlay');
            overlay.classList.remove('hidden');
            overlay.classList.add('flex');
            
            document.getElementById('newPerfilModal').classList.add('hidden');
            
            const modal = document.getElementById(id);
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }
        
        function closeModal() { 
            const overlay = document.getElementById('modalOverlay');
            overlay.classList.add('hidden');
            overlay.classList.remove('flex');
        }

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeModal();
        });

        async function adicionarPerfil(e) {
            e.preventDefault();
            const payload = { 
                Nome: document.getElementById('nomePerfil').value, 
                Descricao: document.getElementById('descricaoPerfil').value 
            };
            const res = await fetch('/Admin/AdicionarPerfil', { 
                method: 'POST', 
                headers: { 
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                }, 
                body: JSON.stringify(payload) 
            });
            if(res.ok) {
                window.location.reload();
            } else {
                Swal.fire({ title: 'Erro', text: 'Falha ao salvar.', icon: 'error', background: '#121418', color: '#fff', confirmButtonColor: '#3B82F6' });
            }
        }

        async function excluirPerfil(id) {
            const result = await Swal.fire({
                title: 'Tem certeza?',
                text: "Este perfil será excluído e pode impactar acessos.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#ef4444',
                cancelButtonColor: '#333',
                confirmButtonText: 'Sim, excluir',
                cancelButtonText: 'Cancelar',
                background: '#121418', color: '#fff'
            });
            
            if(result.isConfirmed) {
                const res = await fetch('/Admin/ExcluirPerfil', { 
                    method: 'POST', 
                    headers: { 
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value || ''
                    }, 
                    body: JSON.stringify(id) 
                });
                if(res.ok) {
                    window.location.reload();
                } else {
                    Swal.fire({ title: 'Erro', text: 'Este perfil pode estar em uso.', icon: 'error', background: '#121418', color: '#fff', confirmButtonColor: '#3B82F6' });
                }
            }
        }
    </script>
}

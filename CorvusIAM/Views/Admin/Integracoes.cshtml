@model IEnumerable<CorvusIAM.Models.ModuloStatus>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Integrações";
}

<div class="mb-[24px] flex justify-between items-end">
    <div>
        <h1 class="text-[16px] font-[600] text-gray-900 dark:text-white flex items-center gap-2">
            <i class="ph ph-plugs-connected text-brand-500"></i> Integrações e Módulos
        </h1>
        <p class="text-[12px] text-gray-500 dark:text-gray-400 mt-1">Gerencie os conectores e serviços de terceiros</p>
    </div>
    <button onclick="document.getElementById('addIntModal').classList.remove('hidden'); document.getElementById('addIntModal').classList.add('flex')" class="bg-brand-600 hover:bg-[#1D4ED8] text-white text-[12px] font-medium px-3 py-1.5 rounded-[6px] shadow-sm transition-colors flex items-center gap-1.5">
        <i class="ph ph-plus"></i> Nova Integração
    </button>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    @foreach(var mod in Model) {
        <div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[20px] flex flex-col relative overflow-hidden transition-all hover:border-brand-500">
            <div class="flex justify-between items-start mb-4">
                <i class="ph @mod.Icone text-[32px] text-gray-600 dark:text-gray-400"></i>
                <button onclick="removerIntegracao('@mod.Nome')" class="text-red-500 hover:text-red-600 text-[12px]" title="Remover">
                    <i class="ph ph-trash text-[16px]"></i>
                </button>
            </div>
            <h3 class="text-[14px] font-[600] text-gray-900 dark:text-white m-0">@mod.Nome</h3>
            <p class="text-[11px] text-gray-500 mt-1">@mod.Detalhe</p>
            
            <div class="mt-4 pt-4 border-t border-gray-100 dark:border-dark-border flex justify-between items-center">
                <span class="text-[10px] text-gray-400 font-mono">Status</span>
                <span class="flex items-center gap-1.5 text-[11px] font-[600] text-emerald-500 uppercase">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> Ativo
                </span>
            </div>
        </div>
    }
    
    @if(!Model.Any()) {
        <div class="col-span-3 text-center py-10 bg-white dark:bg-dark-card border border-dashed border-gray-300 dark:border-dark-border rounded-[6px]">
            <i class="ph ph-plugs-connected text-[48px] text-gray-300 dark:text-gray-600 mb-2"></i>
            <p class="text-gray-500 text-[13px]">Nenhuma integração ativa no momento.</p>
        </div>
    }
</div>

<!-- Modal Adicionar Integração -->
<div id="addIntModal" class="fixed inset-0 bg-black/80 z-[100] hidden items-center justify-center p-4 backdrop-blur-sm transition-opacity">
    <div class="bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border w-full max-w-md rounded-[8px] shadow-2xl flex flex-col overflow-hidden">
        <div class="px-[24px] py-[16px] border-b border-gray-100 dark:border-dark-border flex justify-between items-center bg-gray-50 dark:bg-[#121418]">
            <h3 class="text-[14px] font-[600] text-gray-900 dark:text-white flex items-center gap-2">
                <i class="ph ph-plug text-brand-500"></i> Cadastrar Integração
            </h3>
            <button onclick="document.getElementById('addIntModal').classList.add('hidden'); document.getElementById('addIntModal').classList.remove('flex')" class="text-gray-400 hover:text-white transition-colors">
                <i class="ph ph-x text-[16px]"></i>
            </button>
        </div>
        <form onsubmit="adicionarIntegracao(event)" class="p-[24px] flex flex-col gap-4">
            @Html.AntiForgeryToken()
            
            <div class="flex flex-col gap-1.5">
                <label class="text-[11px] font-[600] text-gray-500 uppercase tracking-wider">Nome da Plataforma</label>
                <input type="text" id="intNome" required placeholder="Ex: Google Workspace" class="bg-white dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-white text-[13px] rounded-[6px] px-3 py-2 outline-none focus:border-brand-500 transition-colors" />
            </div>

            <div class="flex flex-col gap-1.5">
                <label class="text-[11px] font-[600] text-gray-500 uppercase tracking-wider">Função / Detalhe</label>
                <input type="text" id="intDetalhe" required placeholder="Ex: SSO Integrado" class="bg-white dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-white text-[13px] rounded-[6px] px-3 py-2 outline-none focus:border-brand-500 transition-colors" />
            </div>

            <div class="flex flex-col gap-1.5">
                <label class="text-[11px] font-[600] text-gray-500 uppercase tracking-wider">Classe do Ícone (Phosphor Icons)</label>
                <input type="text" id="intIcone" required placeholder="Ex: ph-google-logo" value="ph-plugs" class="bg-white dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-white text-[13px] rounded-[6px] px-3 py-2 outline-none focus:border-brand-500 transition-colors" />
            </div>

            <div class="mt-4 pt-4 border-t border-gray-100 dark:border-dark-border flex justify-end gap-3">
                <button type="button" onclick="document.getElementById('addIntModal').classList.add('hidden'); document.getElementById('addIntModal').classList.remove('flex')" class="px-4 py-2 text-[12px] font-medium text-gray-600 dark:text-gray-400 hover:text-white transition-colors">
                    Cancelar
                </button>
                <button type="submit" class="bg-brand-600 hover:bg-[#1D4ED8] text-white text-[12px] font-medium px-4 py-2 rounded-[6px] shadow-sm transition-colors">
                    Salvar Conector
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        async function adicionarIntegracao(e) {
            e.preventDefault();
            const payload = {
                Nome: document.getElementById('intNome').value,
                Detalhe: document.getElementById('intDetalhe').value,
                Icone: document.getElementById('intIcone').value
            };
            const token = document.querySelector('input[name="__RequestVerificationToken"]');
            
            const res = await fetch('/Admin/AddIntegracao', { 
                method: 'POST', 
                headers: { 
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token ? token.value : ''
                }, 
                body: JSON.stringify(payload) 
            });
            if(res.ok) window.location.reload();
            else alert('Erro ao salvar.');
        }

        async function removerIntegracao(nome) {
            if(confirm('Tem certeza que deseja remover esta integração?')) {
                const token = document.querySelector('input[name="__RequestVerificationToken"]');
                const res = await fetch('/Admin/RemoveIntegracao', { 
                    method: 'POST', 
                    headers: { 
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token ? token.value : ''
                    }, 
                    body: JSON.stringify(nome) 
                });
                if(res.ok) window.location.reload();
            }
        }
    </script>
}

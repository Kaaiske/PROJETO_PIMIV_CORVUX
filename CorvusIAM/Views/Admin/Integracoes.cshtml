@model IEnumerable<CorvusIAM.Models.ModuloStatus>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Módulos & APIs de Outros Apps";
}

<div class="mb-[24px] flex flex-col sm:flex-row sm:justify-between sm:items-end gap-3">
    <div>
        <h1 class="text-[16px] font-[600] text-gray-900 dark:text-white flex items-center gap-2">
            <i class="ph ph-plugs-connected text-brand-500"></i> Módulos, Conectores & APIs de Outros Apps
        </h1>
        <p class="text-[12px] text-gray-500 dark:text-gray-400 mt-1">Conexão com serviços externos, webhooks de auditoria, Single Sign-On e chaves de API REST</p>
    </div>
    <div class="flex flex-wrap gap-2 w-full sm:w-auto">
        <button onclick="gerarTokenInboundModal()" class="flex-1 sm:flex-initial bg-gray-100 hover:bg-gray-200 dark:bg-dark-card dark:hover:bg-dark-hover border border-gray-300 dark:border-dark-border text-gray-800 dark:text-gray-200 text-[12px] font-medium px-3 py-1.5 rounded-[6px] shadow-sm transition-colors flex items-center justify-center gap-1.5 cursor-pointer">
            <i class="ph ph-key text-brand-500"></i> API Token do Corvus
        </button>
        <button onclick="openModal('addIntModal')" class="flex-1 sm:flex-initial bg-brand-600 hover:bg-[#1D4ED8] text-white text-[12px] font-medium px-3 py-1.5 rounded-[6px] shadow-sm transition-colors flex items-center justify-center gap-1.5 cursor-pointer">
            <i class="ph ph-plus"></i> Conectar Nova API / App
        </button>
    </div>
</div>

<!-- Card de Inbound API (Para integrar outros sistemas ao CorvusIAM) -->
<div class="bento-card bg-brand-500/5 border border-brand-500/20 rounded-[6px] p-[20px] mb-[24px]">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
            <span class="text-[11px] font-[600] text-brand-500 uppercase tracking-wider flex items-center gap-1.5">
                <i class="ph ph-code"></i> API Pública REST do CorvusIAM (Inbound Gateway)
            </span>
            <p class="text-[12px] text-gray-600 dark:text-gray-300 mt-1">
                Conecte seu ERP, CRM ou script Python para criar e gerenciar usuários programaticamente em <code class="bg-gray-200 dark:bg-dark-bg px-1.5 py-0.5 rounded text-[11px] font-mono text-brand-600 dark:text-brand-400">https://corvuxiam.tech/api/v1/</code>
            </p>
        </div>
        <div class="flex items-center gap-2 w-full sm:w-auto">
            <div class="font-mono text-[11px] sm:text-xs bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border px-3 py-1.5 rounded text-gray-700 dark:text-gray-300 select-all truncate flex-1 sm:flex-initial">
                corvus_sec_live_9f83a218d47b0192e
            </div>
            <button onclick="copiarTokenInbound()" class="px-2.5 py-1.5 bg-brand-600 hover:bg-brand-700 text-white rounded text-xs transition-colors cursor-pointer shrink-0" title="Copiar Token">
                <i class="ph ph-copy"></i>
            </button>
        </div>
    </div>
</div>

<!-- Grid de Integrações Conectadas -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
    @foreach(var mod in Model) {
        var tipoLabel = string.IsNullOrEmpty(mod.Tipo) ? "API / SSO" : mod.Tipo;
        <div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[20px] flex flex-col relative overflow-hidden transition-all hover:border-brand-500 hover:shadow-md">
            <div class="flex justify-between items-start mb-3">
                <div class="w-10 h-10 rounded-lg bg-gray-50 dark:bg-dark-bg border border-gray-100 dark:border-dark-border flex items-center justify-center">
                    <i class="ph @(string.IsNullOrEmpty(mod.Icone) ? "ph-plugs" : mod.Icone) text-[24px] text-brand-500"></i>
                </div>
                <div class="flex items-center gap-1.5">
                    <span class="px-2 py-0.5 rounded text-[10px] font-semibold uppercase tracking-wider bg-brand-500/10 text-brand-600 dark:text-brand-400 border border-brand-500/20">
                        @tipoLabel
                    </span>
                    <button onclick="removerIntegracao('@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(mod.Nome))')" class="text-gray-400 hover:text-red-500 text-[12px] p-1 transition-colors cursor-pointer" title="Remover Integração">
                        <i class="ph ph-trash text-[16px]"></i>
                    </button>
                </div>
            </div>
            
            <h3 class="text-[14px] font-[600] text-gray-900 dark:text-white m-0">@mod.Nome</h3>
            <p class="text-[11px] text-gray-500 mt-1 flex-1 leading-relaxed">@mod.Detalhe</p>
            
            @if(!string.IsNullOrEmpty(mod.EndpointUrl)) {
                <div class="mt-2 text-[10px] font-mono text-gray-400 truncate" title="@mod.EndpointUrl">
                    <i class="ph ph-link mr-0.5"></i> @mod.EndpointUrl
                </div>
            }

            <div class="mt-4 pt-3 border-t border-gray-100 dark:border-dark-border flex justify-between items-center">
                <div class="flex items-center gap-1.5">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 shadow-[0_0_6px_rgba(16,185,129,0.8)]"></span>
                    <span class="text-[11px] font-[600] text-emerald-500 uppercase tracking-wider">Ativo</span>
                </div>
                <button onclick="testarPing('@Html.Raw(System.Web.HttpUtility.JavaScriptStringEncode(mod.Nome))')" class="px-2.5 py-1 text-[11px] font-medium rounded border border-gray-200 dark:border-dark-border hover:bg-gray-50 dark:hover:bg-dark-border text-gray-700 dark:text-gray-300 transition-colors flex items-center gap-1 cursor-pointer">
                    <i class="ph ph-activity"></i> Testar Ping
                </button>
            </div>
        </div>
    }
    
    @if(!Model.Any()) {
        <div class="col-span-3 text-center py-12 bg-white dark:bg-dark-card border border-dashed border-gray-300 dark:border-dark-border rounded-[6px]">
            <i class="ph ph-plugs-connected text-[48px] text-gray-300 dark:text-gray-600 mb-2"></i>
            <p class="text-gray-500 text-[13px] font-medium">Nenhuma integração ou conector de API configurado.</p>
            <button onclick="openModal('addIntModal')" class="mt-3 px-3 py-1.5 bg-brand-600 text-white rounded text-xs">
                Adicionar Primeira Integração
            </button>
        </div>
    }
</div>

<!-- Seção Explicativa e Interativa: Guia de Uso da API REST v1 -->
<div class="mt-8 bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] p-6 shadow-sm">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-gray-200 dark:border-dark-border gap-3">
        <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-lg bg-brand-500/10 border border-brand-500/20 text-brand-500 flex items-center justify-center">
                <i class="ph ph-terminal-window text-2xl"></i>
            </div>
            <div>
                <h3 class="text-sm font-bold text-gray-900 dark:text-white">Instruções Práticas de Consumo da API RESTful v1</h3>
                <p class="text-xs text-gray-500 dark:text-gray-400">Exemplos prontos para integração com sistemas externos, ERPs e scripts automatizados</p>
            </div>
        </div>
        <div class="flex items-center gap-1.5 bg-gray-100 dark:bg-dark-bg p-1 rounded-lg">
            <button type="button" onclick="trocarAbaApi('curl')" id="tabApi-curl" class="tab-api-btn px-3 py-1 text-xs font-semibold rounded bg-brand-600 text-white transition-colors cursor-pointer">cURL</button>
            <button type="button" onclick="trocarAbaApi('python')" id="tabApi-python" class="tab-api-btn px-3 py-1 text-xs font-semibold rounded text-gray-600 dark:text-gray-400 hover:text-white transition-colors cursor-pointer">Python</button>
            <button type="button" onclick="trocarAbaApi('js')" id="tabApi-js" class="tab-api-btn px-3 py-1 text-xs font-semibold rounded text-gray-600 dark:text-gray-400 hover:text-white transition-colors cursor-pointer">JavaScript</button>
            <button type="button" onclick="trocarAbaApi('csharp')" id="tabApi-csharp" class="tab-api-btn px-3 py-1 text-xs font-semibold rounded text-gray-600 dark:text-gray-400 hover:text-white transition-colors cursor-pointer">C# .NET</button>
        </div>
    </div>

    <!-- Bloco de Código Dinâmico -->
    <div class="mt-4 relative">
        <div class="flex items-center justify-between bg-gray-900 text-gray-400 px-4 py-2 rounded-t-lg text-xs font-mono border-b border-gray-800">
            <span id="apiSnippetLangTitle">Snippet: Requisição HTTP cURL</span>
            <button type="button" onclick="copiarCodigoApi()" class="flex items-center gap-1 text-gray-300 hover:text-white text-xs cursor-pointer">
                <i class="ph ph-copy"></i> Copiar Código
            </button>
        </div>
        <pre class="bg-[#090A0C] text-brand-300 p-4 rounded-b-lg font-mono text-xs overflow-x-auto leading-relaxed border border-gray-800 border-t-0"><code id="apiCodeDisplay"># 1. Buscar lista de colaboradores via REST
curl -X GET "https://corvuxiam.tech/api/v1/users" \
  -H "X-API-Key: corvus_sec_live_9f83a218d47b0192e" \
  -H "Accept: application/json"

# 2. Provisionar novo colaborador a partir de ERP
curl -X POST "https://corvuxiam.tech/api/v1/users" \
  -H "X-API-Key: corvus_sec_live_9f83a218d47b0192e" \
  -H "Content-Type: application/json" \
  -d '{"nome":"Alice Silva","email":"alice@empresa.com","cargo":"Engenheira DevOps","perfilId":3}'</code></pre>
    </div>

    <!-- Tabela Resumo de Endpoints Disponíveis -->
    <div class="mt-6">
        <h4 class="text-xs font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-3">Catálogo de Endpoints da API Gateway</h4>
        <div class="border border-gray-200 dark:border-dark-border rounded-lg overflow-hidden">
            <table class="table text-xs">

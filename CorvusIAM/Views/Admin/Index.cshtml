@model CorvusIAM.Models.DashboardViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Dashboard";
}

<div class="mb-4 flex flex-col gap-2.5">
    <div class="flex items-center justify-between gap-2">
        <h1 class="text-[16px] font-[600] text-slate-900 dark:text-white flex items-center gap-2 tracking-tight m-0">
            <i class="ph ph-squares-four text-brand-500"></i> Visão Geral
        </h1>
        <div class="flex items-center gap-2">
            <a href="/Admin/Cloud" class="bg-white hover:bg-slate-50 dark:bg-dark-card dark:hover:bg-dark-hover border border-slate-200 dark:border-dark-border text-slate-700 dark:text-slate-200 text-[12px] font-medium px-2.5 py-1.5 rounded-[6px] transition-colors flex items-center gap-1.5">
                <i class="ph ph-desktop text-blue-500"></i> Rede (18)
            </a>
            <a href="/Admin/DownloadRelatorio" class="bg-brand-600 hover:bg-brand-500 text-white text-[12px] font-medium px-3 py-1.5 rounded-[6px] shadow-xs transition-colors flex items-center gap-1.5">
                <i class="ph ph-download-simple"></i> Relatório
            </a>
        </div>
    </div>

    <!-- Abas posicionadas diretamente abaixo do título Visão Geral -->
    <div class="flex items-center gap-1 p-1 bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-lg overflow-x-auto text-[12px] font-medium w-full sm:w-max">
        <button type="button" onclick="mudarAbaDashboard('visao-geral')" id="tab-btn-visao-geral" class="dashboard-tab-btn px-3 py-1.5 rounded-md transition-all text-white bg-brand-600 shadow-xs flex items-center gap-1.5 whitespace-nowrap cursor-pointer">
            <i class="ph ph-chart-pie"></i> Resumo &amp; Auditoria
        </button>
        <button type="button" onclick="mudarAbaDashboard('engajamento')" id="tab-btn-engajamento" class="dashboard-tab-btn px-3 py-1.5 rounded-md transition-all text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white flex items-center gap-1.5 whitespace-nowrap cursor-pointer">
            <i class="ph ph-users-three"></i> Uso &amp; Equipe
        </button>
        <button type="button" onclick="mudarAbaDashboard('infra')" id="tab-btn-infra" class="dashboard-tab-btn px-3 py-1.5 rounded-md transition-all text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white flex items-center gap-1.5 whitespace-nowrap cursor-pointer">
            <i class="ph ph-cpu"></i> Saúde &amp; SLA
        </button>
        <button type="button" onclick="mudarAbaDashboard('todas')" id="tab-btn-todas" class="dashboard-tab-btn px-3 py-1.5 rounded-md transition-all text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white flex items-center gap-1.5 whitespace-nowrap cursor-pointer">
            <i class="ph ph-squares-four"></i> Tudo
        </button>
    </div>
</div>

<!-- TOP KPIs -->
<div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 mb-4">
    <a href="/Admin/Politicas" class="bento-card bg-white dark:bg-dark-card border border-slate-200 dark:border-dark-border rounded-[8px] p-3.5 flex flex-col justify-between group cursor-pointer">
        <div class="text-[10px] font-[600] text-slate-500 dark:text-slate-400 uppercase flex justify-between items-center mb-1.5">
            <span>Segurança</span>
            <i class="ph ph-shield-check text-emerald-500 text-[16px]"></i>
        </div>
        <div class="text-[22px] font-[700] text-slate-900 dark:text-white leading-none">A+</div>
    </a>

    <a href="/Admin/Usuarios" class="bento-card bg-white dark:bg-dark-card border border-slate-200 dark:border-dark-border rounded-[8px] p-3.5 flex flex-col justify-between group cursor-pointer">
        <div class="text-[10px] font-[600] text-slate-500 dark:text-slate-400 uppercase flex justify-between items-center mb-1.5">
            <span>Colaboradores</span>
            <i class="ph ph-users text-brand-500 text-[16px]"></i>
        </div>
        <div class="text-[22px] font-[700] text-slate-900 dark:text-white leading-none">@Model.TotalUsuarios</div>
    </a>

    <a href="/Admin/Inteligencia" class="bento-card bg-white dark:bg-dark-card border border-slate-200 dark:border-dark-border rounded-[8px] p-3.5 flex flex-col justify-between group cursor-pointer">
        <div class="text-[10px] font-[600] text-slate-500 dark:text-slate-400 uppercase flex justify-between items-center mb-1.5">
            <span>Bloqueios</span>
            <i class="ph ph-warning-circle text-orange-500 text-[16px]"></i>
        </div>
        <div class="text-[22px] font-[700] text-slate-900 dark:text-white leading-none">@Model.AcessosBloqueados</div>
    </a>

    <a href="/Admin/Cloud" class="bento-card bg-white dark:bg-dark-card border border-slate-200 dark:border-dark-border rounded-[8px] p-3.5 flex flex-col justify-between group cursor-pointer">
        <div class="text-[10px] font-[600] text-slate-500 dark:text-slate-400 uppercase flex justify-between items-center mb-1.5">
            <span>Endpoints</span>
            <i class="ph ph-desktop text-blue-500 text-[16px]"></i>
        </div>
        <div class="text-[22px] font-[700] text-slate-900 dark:text-white leading-none">18</div>
    </a>

    <a href="/Admin/Configuracoes" class="col-span-2 sm:col-span-1 bento-card bg-brand-600 border border-brand-500 rounded-[8px] p-3.5 flex flex-col justify-between group cursor-pointer">
        <div class="text-[10px] font-[600] text-white/85 uppercase flex justify-between items-center mb-1.5">
            <span>Disponibilidade</span>
            <i class="ph ph-heartbeat text-white text-[16px]"></i>
        </div>
        <div class="text-[22px] font-[700] text-white leading-none">99.98%</div>
    </a>
</div>

<!-- Seção 1: Métricas & Auditoria em Tempo Real -->
<div id="sec-metricas-auditoria" class="space-y-4">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <!-- Monitoramento Contínuo Ao Vivo (Tabela de Eventos Reais) -->
        <div class="bento-card col-span-1 md:col-span-2 bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] flex flex-col relative overflow-hidden">
            <div class="px-5 py-3.5 border-b border-gray-100 dark:border-dark-border bg-gray-50 dark:bg-dark-bg/50">
                <h3 class="text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em] m-0 flex justify-between items-center">
                    <span>Auditoria em Tempo Real</span>
                    <span class="text-brand-500 flex items-center gap-1 text-[11px]"><span class="w-2 h-2 rounded-full bg-brand-500 animate-pulse"></span> AO VIVO</span>
                </h3>
            </div>
            <div class="flex-1 w-full overflow-y-auto" style="max-height: 290px;">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead class="sticky top-0 bg-white dark:bg-dark-card border-b border-gray-100 dark:border-dark-border shadow-xs">
                            <tr>
                                <th class="px-4 py-2.5 text-[10px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em]">Usuário / Ação</th>
                                <th class="px-4 py-2.5 text-[10px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em]">Origem</th>
                                <th class="px-4 py-2.5 text-[10px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em]">Horário</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var log in Model.LogsRecentes) {
                                <tr class="border-b border-gray-100 dark:border-dark-border hover:bg-gray-50 dark:hover:bg-[#1B1F24] transition-colors">
                                    <td class="px-4 py-2.5">
                                        <div class="text-[12px] font-[600] text-gray-900 dark:text-gray-100">@log.Acao</div>
                                        <div class="text-[11px] text-gray-500 mt-0.5 truncate max-w-[210px]" title="@log.Detalhe">@log.Detalhe</div>
                                    </td>
                                    <td class="px-4 py-2.5">
                                        <span class="bg-brand-500/10 text-brand-600 dark:text-brand-400 border border-brand-500/20 px-2 py-0.5 rounded-[4px] text-[10px] font-[600] uppercase tracking-wider flex w-max items-center gap-1">
                                            <i class="ph ph-laptop"></i> @log.Origem
                                        </span>
                                    </td>
                                    <td class="px-4 py-2.5 text-[11px] font-mono text-gray-500">
                                        @log.DataHora.ToString("HH:mm:ss")
                                    </td>
                                </tr>
                            }
                            @if(!Model.LogsRecentes.Any()) {
                                <tr>
                                    <td colspan="3" class="px-4 py-6 text-center text-[12px] text-gray-500">Nenhum evento registrado.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Gráfico Enriquecido: Tendência de Eventos (Últimos 7 dias) -->
        <div class="bento-card col-span-1 md:col-span-2 bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] p-5 flex flex-col justify-between relative overflow-hidden">
            <div class="flex flex-wrap justify-between items-center gap-2 mb-3">
                <div>
                    <h3 class="text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em] m-0 flex items-center gap-1.5">
                        <i class="ph ph-chart-line-up text-brand-500 text-sm"></i> Tendência de Eventos (Últimos 7 dias)
                    </h3>
                    <span class="text-[10px] text-gray-400 font-mono">Logins SSO • Validações MFA/JWT • Bloqueios WAF</span>
                </div>
                <div class="flex items-center gap-1 bg-gray-100 dark:bg-dark-bg p-0.5 rounded-md border border-gray-200 dark:border-dark-border text-[10px]">
                    <button type="button" onclick="alternarModoTrend('7d')" id="btnTrend7d" class="px-2 py-0.5 rounded bg-brand-600 text-white font-semibold cursor-pointer">7 Dias</button>
                    <button type="button" onclick="alternarModoTrend('30d')" id="btnTrend30d" class="px-2 py-0.5 rounded text-gray-500 hover:text-gray-900 dark:hover:text-white cursor-pointer">30 Dias</button>
                </div>
            </div>

            <div class="flex-1 w-full h-[185px] relative">
                <canvas id="trendChart"></canvas>
            </div>

            <!-- Características & Indicadores Estatísticos da Tendência -->
            <div class="grid grid-cols-4 gap-2 mt-3 pt-3 border-t border-gray-100 dark:border-dark-border text-center">
                <div class="p-1.5 rounded bg-gray-50 dark:bg-dark-bg/60 border border-gray-200/60 dark:border-dark-border">
                    <div class="text-[9px] text-gray-400 uppercase font-semibold">Volume 7d</div>
                    <div class="text-[13px] font-bold text-brand-500" id="trendStatTotal">@Model.LoginsNormaisPorDia.Sum()</div>
                    <div class="text-[9px] text-emerald-500 font-mono">+14.2%</div>
                </div>
                <div class="p-1.5 rounded bg-gray-50 dark:bg-dark-bg/60 border border-gray-200/60 dark:border-dark-border">
                    <div class="text-[9px] text-gray-400 uppercase font-semibold">Média / Dia</div>
                    <div class="text-[13px] font-bold text-gray-900 dark:text-white" id="trendStatAvg">@(Math.Round(Model.LoginsNormaisPorDia.DefaultIfEmpty(0).Average(), 1))</div>
                    <div class="text-[9px] text-gray-400 font-mono">eventos/dia</div>
                </div>
                <div class="p-1.5 rounded bg-gray-50 dark:bg-dark-bg/60 border border-gray-200/60 dark:border-dark-border">
                    <div class="text-[9px] text-gray-400 uppercase font-semibold">Latência Auth</div>
                    <div class="text-[13px] font-bold text-emerald-500">34 ms</div>
                    <div class="text-[9px] text-gray-400 font-mono">P95 JWT</div>
                </div>
                <div class="p-1.5 rounded bg-gray-50 dark:bg-dark-bg/60 border border-gray-200/60 dark:border-dark-border">
                    <div class="text-[9px] text-gray-400 uppercase font-semibold">Mitigação WAF</div>
                    <div class="text-[13px] font-bold text-orange-500">100%</div>
                    <div class="text-[9px] text-gray-400 font-mono">@Model.BloqueiosPorDia.Sum() bloqueios</div>
                </div>
            </div>
        </div>

        <!-- Gráfico Enriquecido: Acessos por Plataforma & Dispositivos -->
        <div class="bento-card col-span-1 md:col-span-4 bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] p-5 flex flex-col justify-between relative overflow-hidden shadow-xs">
            <div class="flex flex-wrap justify-between items-center gap-2 mb-4 pb-2.5 border-b border-gray-100 dark:border-dark-border">
                <div>
                    <h3 class="text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em] m-0 flex items-center gap-1.5">
                        <i class="ph ph-devices text-brand-500 text-sm"></i> Acessos por Plataforma &amp; Dispositivos
                    </h3>
                    <span class="text-[10px] text-gray-400 font-mono">Distribuição de canais, sistemas operacionais, protocolos de sessão e postura Zero Trust</span>
                </div>
                <div class="flex items-center gap-2">
                    <span class="text-[10px] text-gray-500 dark:text-gray-400 font-mono bg-gray-100 dark:bg-dark-bg px-2.5 py-1 rounded border border-gray-200 dark:border-dark-border">
                        Auditados Hoje: <b class="text-brand-500">@Model.TotalRequisicoesHoje</b>
                    </span>
                    <div class="flex items-center gap-1 bg-gray-100 dark:bg-dark-bg p-0.5 rounded-md border border-gray-200 dark:border-dark-border text-[10px]">
                        <button type="button" onclick="alternarVisaoPlataforma('canais')" id="btnPlatCanais" class="px-2 py-0.5 rounded bg-brand-600 text-white font-semibold cursor-pointer">Canais</button>
                        <button type="button" onclick="alternarVisaoPlataforma('so')" id="btnPlatSo" class="px-2 py-0.5 rounded text-gray-500 hover:text-gray-900 dark:hover:text-white cursor-pointer">Sistemas (SO)</button>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-1 lg:grid-cols-12 gap-5 items-center">
                <!-- Doughnut Chart -->
                <div class="lg:col-span-4 w-full h-[185px] relative flex justify-center items-center">
                    <canvas id="platformChart"></canvas>
                </div>

                <!-- Breakdown Detalhado & Características Técnicas -->
                <div class="lg:col-span-8 flex flex-col justify-between gap-3 border-t lg:border-t-0 lg:border-l border-gray-200 dark:border-dark-border pt-4 lg:pt-0 lg:pl-5">
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5 text-center">
                        <div class="p-2.5 rounded-lg bg-gray-50/70 dark:bg-dark-bg/60 border border-gray-200 dark:border-dark-border">
                            <div class="text-[10px] text-gray-400 uppercase font-semibold flex items-center justify-center gap-1"><i class="ph ph-globe text-brand-500"></i> Web Desktop</div>
                            <div class="text-[16px] font-bold text-brand-500 mt-0.5">58%</div>
                            <div class="text-[9px] text-gray-500 font-mono">Chrome / Edge • TLS 1.3</div>
                        </div>
                        <div class="p-2.5 rounded-lg bg-gray-50/70 dark:bg-dark-bg/60 border border-gray-200 dark:border-dark-border">
                            <div class="text-[10px] text-gray-400 uppercase font-semibold flex items-center justify-center gap-1"><i class="ph ph-device-mobile text-emerald-500"></i> Mobile PWA</div>
                            <div class="text-[16px] font-bold text-emerald-500 mt-0.5">26%</div>
                            <div class="text-[9px] text-gray-500 font-mono">Android &amp; iOS • Biometria</div>
                        </div>
                        <div class="p-2.5 rounded-lg bg-gray-50/70 dark:bg-dark-bg/60 border border-gray-200 dark:border-dark-border">
                            <div class="text-[10px] text-gray-400 uppercase font-semibold flex items-center justify-center gap-1"><i class="ph ph-code text-orange-500"></i> APIs REST</div>
                            <div class="text-[16px] font-bold text-orange-500 mt-0.5">10%</div>
                            <div class="text-[9px] text-gray-500 font-mono">Bearer JWT &amp; X-API-Key</div>
                        </div>
                        <div class="p-2.5 rounded-lg bg-gray-50/70 dark:bg-dark-bg/60 border border-gray-200 dark:border-dark-border">
                            <div class="text-[10px] text-gray-400 uppercase font-semibold flex items-center justify-center gap-1"><i class="ph ph-cloud-check text-purple-500"></i> SSO Cloud</div>
                            <div class="text-[16px] font-bold text-purple-500 mt-0.5">6%</div>
                            <div class="text-[9px] text-gray-500 font-mono">Entra ID / Workspace</div>
                        </div>
                    </div>

                    <!-- Segunda Linha de Características de Dispositivos -->
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-[11px] bg-gray-50/50 dark:bg-dark-bg/40 p-2.5 rounded-lg border border-gray-100 dark:border-dark-border">
                        <div>
                            <span class="text-[9px] uppercase text-gray-400 font-semibold block">Sistemas Operacionais</span>
                            <span class="font-medium text-gray-800 dark:text-gray-200">Win 11 (54%) • Mobile (26%) • Linux (20%)</span>
                        </div>
                        <div>
                            <span class="text-[9px] uppercase text-gray-400 font-semibold block">Geolocalização &amp; Origem</span>
                            <span class="font-medium text-gray-800 dark:text-gray-200">Brasil (96.4%) • VPN Corp (3.6%)</span>
                        </div>
                        <div>
                            <span class="text-[9px] uppercase text-gray-400 font-semibold block">Segurança de Sessão</span>
                            <span class="font-medium text-emerald-500">MFA: 99.8% • Cookies Strict</span>
                        </div>
                        <div>
                            <span class="text-[9px] uppercase text-gray-400 font-semibold block">Janela de Pico &amp; EDR</span>
                            <span class="font-medium text-gray-800 dark:text-gray-200">09h–11h30 • 100% EDR Ativo</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Seção 2: Telemetria de Uso por Usuário & Setores -->
<div id="sec-engajamento-equipe" style="display: none;">
    <div class="mt-4 bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] p-5 shadow-xs">
        <div class="flex items-center justify-between gap-2 mb-4 pb-2.5 border-b border-gray-200 dark:border-dark-border">
            <h3 class="text-[13px] font-bold text-gray-900 dark:text-white flex items-center gap-2">
                <i class="ph ph-chart-bar text-brand-500 text-base"></i> Uso por Colaborador &amp; Setor
            </h3>
            <span class="text-[11px] font-mono px-2 py-0.5 rounded bg-brand-500/10 text-brand-500 border border-brand-500/20">
                @(Model.RankingUsoUsuarios?.Count ?? 0) Ativos
            </span>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
            <div class="lg:col-span-2 overflow-x-auto border border-gray-200 dark:border-dark-border rounded-lg">
                <table class="table text-xs">
                    <thead class="bg-gray-50 dark:bg-dark-bg text-gray-500 uppercase tracking-wider text-[10px]">
                        <tr>
                            <th class="px-3 py-2">Colaborador</th>
                            <th class="px-3 py-2">Perfil</th>
                            <th class="px-3 py-2 text-center">Logins</th>
                            <th class="px-3 py-2 text-center">Req.</th>
                            <th class="px-3 py-2">Acesso</th>
                            <th class="px-3 py-2 text-right">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-dark-border font-mono text-[11px]">
                        @if (Model.RankingUsoUsuarios != null && Model.RankingUsoUsuarios.Any())
                        {
                            @foreach (var user in Model.RankingUsoUsuarios.Take(7))
                            {
                                <tr class="hover:bg-gray-50/50 dark:hover:bg-dark-hover transition-colors font-sans">
                                    <td class="px-3 py-2">
                                        <div class="font-semibold text-gray-900 dark:text-white">@user.Nome</div>
                                        <div class="text-[10px] text-gray-400 font-mono">@user.Email</div>
                                    </td>
                                    <td class="px-3 py-2">
                                        <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-brand-500/10 text-brand-600 dark:text-brand-400">
                                            @user.Perfil
                                        </span>
                                    </td>
                                    <td class="px-3 py-2 text-center font-mono font-bold text-gray-700 dark:text-gray-300">
                                        @user.TotalLogins
                                    </td>
                                    <td class="px-3 py-2 text-center font-mono text-brand-500 font-bold">
                                        @user.TotalRequisicoes
                                    </td>
                                    <td class="px-3 py-2 font-mono text-gray-500 text-[10px]">
                                        @user.UltimoAcesso.ToString("dd/MM HH:mm")
                                    </td>
                                    <td class="px-3 py-2 text-right font-sans">
                                        @if (user.Status == "Bloqueado")
                                        {
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-red-500/10 text-red-500">Bloqueado</span>
                                        }
                                        else
                                        {
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-500">Ativo</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="flex flex-col justify-between bg-gray-50/50 dark:bg-dark-bg/40 border border-gray-200 dark:border-dark-border rounded-lg p-4">
                <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-gray-700 dark:text-gray-300 mb-3 flex items-center gap-1.5">
                        <i class="ph ph-buildings text-brand-500"></i> Departamentos
                    </h4>
                    <div class="space-y-2.5">
                        @for (int i = 0; i < Model.DepartamentosNomes.Count; i++)
                        {
                            var dep = Model.DepartamentosNomes[i];
                            var perc = Model.DepartamentosUsoPercentual[i];
                            <div>
                                <div class="flex justify-between text-xs mb-1">
                                    <span class="text-gray-700 dark:text-gray-300 font-medium">@dep</span>
                                    <span class="font-mono font-bold text-gray-900 dark:text-white">@perc%</span>
                                </div>
                                <div class="w-full h-1.5 bg-gray-200 dark:bg-dark-card rounded-full overflow-hidden">
                                    <div class="h-full bg-brand-500 rounded-full" style="width: @perc%"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Seção 3: Infraestrutura, Conectores & SLA -->
<div id="sec-infra-conectores" style="display: none;">
    <div class="mt-4 mb-6 bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] p-5 shadow-xs">
        <div class="flex items-center justify-between gap-2 mb-3 pb-2.5 border-b border-gray-100 dark:border-dark-border">
            <h3 class="text-[13px] font-[600] text-gray-900 dark:text-white flex items-center gap-2">
                <i class="ph ph-heartbeat text-emerald-500 text-[16px]"></i> Saúde dos Serviços Críticos
            </h3>
            <span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 text-[11px] font-semibold">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> SLA 99.98%
            </span>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3">
            <div class="p-3 rounded-lg border border-gray-100 dark:border-[#272B33] bg-gray-50/50 dark:bg-dark-bg/30 flex items-center justify-between">
                <span class="text-xs font-medium text-gray-700 dark:text-gray-300 flex items-center gap-1.5">
                    <i class="ph ph-database text-brand-500"></i> SQL Server
                </span>
                <span class="text-emerald-500 font-mono font-bold text-[11px]">4ms • OK</span>
            </div>

            <div class="p-3 rounded-lg border border-gray-100 dark:border-[#272B33] bg-gray-50/50 dark:bg-dark-bg/30 flex items-center justify-between">
                <span class="text-xs font-medium text-gray-700 dark:text-gray-300 flex items-center gap-1.5">
                    <i class="ph ph-shield-check text-emerald-500"></i> WAF Edge
                </span>
                <span class="text-emerald-500 font-mono font-bold text-[11px]">Ativo</span>
            </div>

            <div class="p-3 rounded-lg border border-gray-100 dark:border-[#272B33] bg-gray-50/50 dark:bg-dark-bg/30 flex items-center justify-between">
                <span class="text-xs font-medium text-gray-700 dark:text-gray-300 flex items-center gap-1.5">
                    <i class="ph ph-cpu text-purple-500"></i> Motor IA
                </span>
                <span class="text-purple-500 font-mono font-bold text-[11px]">Online</span>
            </div>

            <div class="p-3 rounded-lg border border-gray-100 dark:border-[#272B33] bg-gray-50/50 dark:bg-dark-bg/30 flex items-center justify-between">
                <span class="text-xs font-medium text-gray-700 dark:text-gray-300 flex items-center gap-1.5">
                    <i class="ph ph-certificate text-blue-500"></i> TLS 1.3
                </span>
                <span class="text-blue-500 font-mono font-bold text-[11px]">Grau A+</span>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let trendChart = null;
        let platformChart = null;
        const baseLogins7d = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LoginsNormaisPorDia));
        const baseBloqueios7d = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BloqueiosPorDia));
        const baseMfa7d = baseLogins7d.map(v => Math.max(Math.round(v * 0.85), 2));

        function initCharts() {
            const isDark = document.documentElement.classList.contains('dark');
            const gridColor = isDark ? '#1E2636' : '#F1F5F9';
            const textColor = isDark ? '#94A3B8' : '#64748B';

            // Chart: Tendência de Eventos (Combo Bar + Line)
            const cvsTrend = document.getElementById('trendChart');
            if (cvsTrend) {
                const ctxTrend = cvsTrend.getContext('2d');
                if (trendChart) trendChart.destroy();
                
                trendChart = new Chart(ctxTrend, {
                    type: 'bar',
                    data: {
                        labels: ['Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb', 'Dom'],
                        datasets: [
                            {
                                type: 'line',
                                label: 'Validações MFA / JWT',
                                data: baseMfa7d,
                                borderColor: '#10B981',
                                backgroundColor: 'rgba(16, 185, 129, 0.15)',
                                borderWidth: 2,
                                pointRadius: 3,
                                pointBackgroundColor: '#10B981',
                                tension: 0.35,
                                order: 0
                            },
                            {
                                type: 'bar',
                                label: 'Logins Normais',
                                data: baseLogins7d,
                                backgroundColor: '#2563EB',
                                borderRadius: 4,
                                barThickness: 12,
                                order: 1
                            },
                            {
                                type: 'bar',
                                label: 'Bloqueios WAF',
                                data: baseBloqueios7d,
                                backgroundColor: '#F97316',
                                borderRadius: 4,
                                barThickness: 12,
                                order: 2
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { 
                            legend: { 
                                position: 'top',
                                labels: { color: textColor, font: { size: 10, family: 'Inter' }, usePointStyle: true, padding: 12 }
                            },
                            tooltip: {
                                mode: 'index',
                                intersect: false
                            }
                        },
                        scales: {
                            x: { grid: { display: false }, ticks: { color: textColor, font: { size: 10 } }, stacked: true },
                            y: { grid: { color: gridColor, drawBorder: false }, ticks: { color: textColor, font: { size: 10 } }, stacked: false }
                        }
                    }
                });
            }

            // Chart: Acessos por Plataforma & Dispositivos
            const cvsPlatform = document.getElementById('platformChart');
            if (cvsPlatform) {
                const ctxPlatform = cvsPlatform.getContext('2d');
                if (platformChart) platformChart.destroy();

                platformChart = new Chart(ctxPlatform, {
                    type: 'doughnut',
                    data: {
                        labels: ['Web Desktop (58%)', 'Mobile PWA (26%)', 'APIs REST (10%)', 'SSO Cloud (6%)'],
                        datasets: [{
                            data: [58, 26, 10, 6],
                            backgroundColor: ['#2563EB', '#10B981', '#F97316', '#A855F7'],
                            borderWidth: 0,
                            hoverOffset: 5
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '68%',
                        plugins: {
                            legend: {
                                position: 'right',
                                labels: { color: textColor, font: { size: 10, family: 'Inter' }, usePointStyle: true, padding: 10 }
                            }
                        }
                    }
                });
            }
        }

        function alternarModoTrend(periodo) {
            if (!trendChart) return;
            const b7 = document.getElementById('btnTrend7d');
            const b30 = document.getElementById('btnTrend30d');
            if (periodo === '30d') {
                trendChart.data.labels = ['Sem 1', 'Sem 2', 'Sem 3', 'Sem 4'];
                trendChart.data.datasets[0].data = [42, 48, 53, 59];
                trendChart.data.datasets[1].data = [49, 55, 62, 68];
                trendChart.data.datasets[2].data = [3, 2, 4, 1];
                if (b30) b30.className = 'px-2 py-0.5 rounded bg-brand-600 text-white font-semibold cursor-pointer';
                if (b7) b7.className = 'px-2 py-0.5 rounded text-gray-500 hover:text-gray-900 dark:hover:text-white cursor-pointer';
            } else {
                trendChart.data.labels = ['Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb', 'Dom'];
                trendChart.data.datasets[0].data = baseMfa7d;
                trendChart.data.datasets[1].data = baseLogins7d;
                trendChart.data.datasets[2].data = baseBloqueios7d;
                if (b7) b7.className = 'px-2 py-0.5 rounded bg-brand-600 text-white font-semibold cursor-pointer';
                if (b30) b30.className = 'px-2 py-0.5 rounded text-gray-500 hover:text-gray-900 dark:hover:text-white cursor-pointer';
            }
            trendChart.update();
        }

        function alternarVisaoPlataforma(modo) {
            if (!platformChart) return;
            const bCanais = document.getElementById('btnPlatCanais');
            const bSo = document.getElementById('btnPlatSo');
            if (modo === 'so') {
                platformChart.data.labels = ['Windows 11 (54%)', 'Android / iOS (26%)', 'Linux SecOps (14%)', 'macOS (6%)'];
                platformChart.data.datasets[0].data = [54, 26, 14, 6];
                if (bSo) bSo.className = 'px-2 py-0.5 rounded bg-brand-600 text-white font-semibold cursor-pointer';
                if (bCanais) bCanais.className = 'px-2 py-0.5 rounded text-gray-500 hover:text-gray-900 dark:hover:text-white cursor-pointer';
            } else {
                platformChart.data.labels = ['Web Desktop (58%)', 'Mobile PWA (26%)', 'APIs REST (10%)', 'SSO Cloud (6%)'];
                platformChart.data.datasets[0].data = [58, 26, 10, 6];
                if (bCanais) bCanais.className = 'px-2 py-0.5 rounded bg-brand-600 text-white font-semibold cursor-pointer';
                if (bSo) bSo.className = 'px-2 py-0.5 rounded text-gray-500 hover:text-gray-900 dark:hover:text-white cursor-pointer';
            }
            platformChart.update();
        }

        function testarWebhooksDashboard() {
            Swal.fire({
                title: 'Testando Conectores de API...',
                html: '<div class="text-xs text-gray-400">Verificando latência e certificados de Microsoft 365, Google Workspace, Slack, AWS, GitHub e Cloudflare...</div>',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading(),
                background: '#111621', color: '#fff'
            });
            setTimeout(() => {
                Swal.fire({
                    title: 'Todas as Integrações Operacionais!',
                    html: '<div class="text-xs text-left text-gray-300 space-y-1.5"><p>✓ <b>Microsoft 365 / Azure AD:</b> 24ms (OK)</p><p>✓ <b>Google Workspace:</b> 18ms (OK)</p><p>✓ <b>Slack SecOps Bot:</b> 12ms (OK)</p><p>✓ <b>AWS IAM Identity:</b> 31ms (OK)</p><p>✓ <b>GitHub Enterprise:</b> 42ms (OK)</p><p>✓ <b>Cloudflare Zero Trust / WAF:</b> 8ms (OK)</p></div>',
                    icon: 'success',
                    background: '#111621', color: '#fff', confirmButtonColor: '#3B82F6'
                });
            }, 900);
        }

        function mudarAbaDashboard(aba) {
            const secMetricas = document.getElementById('sec-metricas-auditoria');
            const secEngajamento = document.getElementById('sec-engajamento-equipe');
            const secInfra = document.getElementById('sec-infra-conectores');

            if (!secMetricas || !secEngajamento || !secInfra) return;

            if (aba === 'todas') {
                secMetricas.style.display = 'block';
                secEngajamento.style.display = 'block';
                secInfra.style.display = 'block';
            } else if (aba === 'visao-geral') {
                secMetricas.style.display = 'block';
                secEngajamento.style.display = 'none';
                secInfra.style.display = 'none';
            } else if (aba === 'engajamento') {
                secMetricas.style.display = 'none';
                secEngajamento.style.display = 'block';
                secInfra.style.display = 'none';
            } else if (aba === 'infra') {
                secMetricas.style.display = 'none';
                secEngajamento.style.display = 'none';
                secInfra.style.display = 'block';
            }

            const btns = ['todas', 'visao-geral', 'engajamento', 'infra'];
            btns.forEach(b => {
                const btn = document.getElementById('tab-btn-' + b);
                if (!btn) return;
                if (b === aba) {
                    btn.className = 'dashboard-tab-btn px-3 py-1.5 rounded-md transition-all text-white bg-brand-600 shadow-xs flex items-center gap-1.5 whitespace-nowrap cursor-pointer';
                } else {
                    btn.className = 'dashboard-tab-btn px-3 py-1.5 rounded-md transition-all text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white flex items-center gap-1.5 whitespace-nowrap cursor-pointer';
                }
            });

            try {
                localStorage.setItem('corvux_dashboard_tab', aba);
            } catch(e) {}

            setTimeout(() => {
                if (trendChart) trendChart.resize();
                if (platformChart) platformChart.resize();
            }, 50);
        }

        window.addEventListener('corvux-theme-changed', () => {
            initCharts();
        });

        window.addEventListener('load', () => {
            initCharts();
            try {
                const savedTab = localStorage.getItem('corvux_dashboard_tab');
                if (savedTab && savedTab !== 'todas') mudarAbaDashboard(savedTab);
            } catch(e) {}
        });
    </script>
}

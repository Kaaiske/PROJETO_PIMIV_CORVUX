@model CorvusIAM.Models.DashboardViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Dashboard";
}

<div class="mb-[20px] flex flex-col sm:flex-row sm:justify-between sm:items-end gap-3">
    <div>
        <h1 class="text-[16px] font-[600] text-slate-900 dark:text-white flex items-center gap-2 tracking-tight">
            <i class="ph ph-squares-four text-brand-500"></i> Dashboard Security Operations (SecOps)
        </h1>
        <p class="text-[12px] text-slate-500 dark:text-slate-400 mt-0.5">Visão executiva unificada, fluxo de identidades Zero Trust e telemetria em tempo real</p>
    </div>
    <div class="flex flex-wrap gap-2 w-full sm:w-auto">
        <a href="/Admin/Cloud" class="bg-white hover:bg-slate-50 dark:bg-dark-card dark:hover:bg-dark-hover border border-slate-200 dark:border-dark-border text-slate-700 dark:text-slate-200 text-[12px] font-medium px-3 py-1.5 rounded-[6px] transition-colors flex items-center justify-center gap-1.5">
            <i class="ph ph-desktop text-blue-500"></i> Saúde da Rede (18 Hosts)
        </a>
        <a href="/Admin/DownloadRelatorio" class="bg-brand-600 hover:bg-brand-500 text-white text-[12px] font-medium px-3 py-1.5 rounded-[6px] shadow-xs transition-colors flex items-center justify-center gap-1.5">
            <i class="ph ph-download-simple"></i> Exportar Auditoria
        </a>
    </div>
</div>

<!-- TOP KPIs (Cards Clicáveis com Fluxo Direto) -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3.5 md:gap-5 mb-[22px]">
    <!-- Nível de Segurança -->
    <a href="/Admin/Politicas" class="bento-card bg-white dark:bg-dark-card border border-slate-200 dark:border-dark-border rounded-[8px] p-[18px] flex flex-col justify-between relative overflow-hidden group cursor-pointer">
        <div class="text-[11px] font-[600] text-slate-500 dark:text-slate-400 uppercase tracking-[0.05em] flex justify-between items-center mb-3">
            <span>Nível de Segurança</span>
            <i class="ph ph-shield-check text-emerald-500 text-[18px] group-hover:scale-110 transition-transform"></i>
        </div>
        <div>
            <div class="text-[28px] font-[700] text-slate-900 dark:text-white leading-[1] tracking-tight">A+</div>
            <div class="text-[11px] text-emerald-600 dark:text-emerald-400 mt-1.5 font-[500] flex items-center justify-between">
                <span class="flex items-center gap-1"><i class="ph ph-check-circle"></i> Zero Trust Ativo</span>
                <i class="ph ph-arrow-right text-slate-400 group-hover:translate-x-0.5 transition-transform"></i>
            </div>
        </div>
    </a>

    <!-- Active Users -->
    <a href="/Admin/Usuarios" class="bento-card bg-white dark:bg-dark-card border border-slate-200 dark:border-dark-border rounded-[8px] p-[18px] flex flex-col justify-between relative overflow-hidden group cursor-pointer">
        <div class="text-[11px] font-[600] text-slate-500 dark:text-slate-400 uppercase tracking-[0.05em] flex justify-between items-center mb-3">
            <span>Usuários Ativos</span>
            <i class="ph ph-users text-brand-500 text-[18px] group-hover:scale-110 transition-transform"></i>
        </div>
        <div>
            <div class="text-[28px] font-[700] text-slate-900 dark:text-white leading-[1] tracking-tight">@Model.TotalUsuarios</div>
            <div class="text-[11px] text-brand-600 dark:text-brand-400 mt-1.5 font-[500] flex items-center justify-between">
                <span>Gerenciar Diretório</span>
                <i class="ph ph-arrow-right text-slate-400 group-hover:translate-x-0.5 transition-transform"></i>
            </div>
        </div>
    </a>

    <!-- Security Incidents -->
    <a href="/Admin/Inteligencia" class="bento-card bg-white dark:bg-dark-card border border-slate-200 dark:border-dark-border rounded-[8px] p-[18px] flex flex-col justify-between relative overflow-hidden group cursor-pointer">
        <div class="text-[11px] font-[600] text-slate-500 dark:text-slate-400 uppercase tracking-[0.05em] flex justify-between items-center mb-3">
            <span>Acessos Bloqueados</span>
            <i class="ph ph-warning-circle text-orange-500 text-[18px] group-hover:scale-110 transition-transform"></i>
        </div>
        <div>
            <div class="text-[28px] font-[700] text-slate-900 dark:text-white leading-[1] tracking-tight">@Model.AcessosBloqueados</div>
            <div class="text-[11px] text-orange-600 dark:text-orange-400 mt-1.5 font-[500] flex items-center justify-between">
                <span>Inspecionar IDS/WAF</span>
                <i class="ph ph-arrow-right text-slate-400 group-hover:translate-x-0.5 transition-transform"></i>
            </div>
        </div>
    </a>

    <!-- Dispositivos na Rede -->
    <a href="/Admin/Cloud" class="bento-card bg-white dark:bg-dark-card border border-slate-200 dark:border-dark-border rounded-[8px] p-[18px] flex flex-col justify-between relative overflow-hidden group cursor-pointer">
        <div class="text-[11px] font-[600] text-slate-500 dark:text-slate-400 uppercase tracking-[0.05em] flex justify-between items-center mb-3">
            <span>Endpoints da Rede</span>
            <i class="ph ph-desktop text-blue-500 text-[18px] group-hover:scale-110 transition-transform"></i>
        </div>
        <div>
            <div class="text-[28px] font-[700] text-slate-900 dark:text-white leading-[1] tracking-tight">18</div>
            <div class="text-[11px] text-blue-600 dark:text-blue-400 mt-1.5 font-[500] flex items-center justify-between">
                <span>15 Saudáveis • 3 Alertas</span>
                <i class="ph ph-arrow-right text-slate-400 group-hover:translate-x-0.5 transition-transform"></i>
            </div>
        </div>
    </a>

    <!-- System Health -->
    <a href="/Admin/Configuracoes" class="bento-card bg-brand-600 border border-brand-500 rounded-[8px] p-[18px] flex flex-col justify-between relative overflow-hidden group cursor-pointer">
        <div class="text-[11px] font-[600] text-white/85 uppercase tracking-[0.05em] flex justify-between items-center mb-3">
            <span>Saúde Operacional</span>
            <i class="ph ph-heartbeat text-white text-[18px] group-hover:scale-110 transition-transform"></i>
        </div>
        <div>
            <div class="text-[28px] font-[700] text-white leading-[1] tracking-tight">99.98%</div>
            <div class="text-[11px] text-white/85 mt-1.5 font-[500] flex items-center justify-between">
                <span>Uptime & Parâmetros</span>
                <i class="ph ph-arrow-right text-white/70 group-hover:translate-x-0.5 transition-transform"></i>
            </div>
        </div>
    </a>
</div>

<!-- Seletor de Visão Executiva Compacta (Redução de Poluição Visual) -->
<div class="flex items-center gap-1.5 p-1 bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-lg mb-6 overflow-x-auto text-[12px] font-medium shadow-xs w-full sm:w-max">
    <button type="button" onclick="mudarAbaDashboard('todas')" id="tab-btn-todas" class="dashboard-tab-btn px-3 py-1.5 rounded-md transition-all text-white bg-brand-600 shadow-xs flex items-center gap-1.5 whitespace-nowrap cursor-pointer">
        <i class="ph ph-squares-four"></i> Visão Completa
    </button>
    <button type="button" onclick="mudarAbaDashboard('visao-geral')" id="tab-btn-visao-geral" class="dashboard-tab-btn px-3 py-1.5 rounded-md transition-all text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white flex items-center gap-1.5 whitespace-nowrap cursor-pointer">
        <i class="ph ph-chart-pie"></i> Métricas & Auditoria
    </button>
    <button type="button" onclick="mudarAbaDashboard('engajamento')" id="tab-btn-engajamento" class="dashboard-tab-btn px-3 py-1.5 rounded-md transition-all text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white flex items-center gap-1.5 whitespace-nowrap cursor-pointer">
        <i class="ph ph-users-three"></i> Uso & Colaboradores
    </button>
    <button type="button" onclick="mudarAbaDashboard('infra')" id="tab-btn-infra" class="dashboard-tab-btn px-3 py-1.5 rounded-md transition-all text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white flex items-center gap-1.5 whitespace-nowrap cursor-pointer">
        <i class="ph ph-cpu"></i> Conectores & SLA
    </button>
</div>

<!-- Seção 1: Métricas & Auditoria em Tempo Real -->
<div id="sec-metricas-auditoria" class="space-y-6">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 md:gap-[24px]">
        <!-- Monitoramento Contínuo Ao Vivo (Tabela de Eventos Reais) -->
        <div class="bento-card col-span-1 md:col-span-2 bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] flex flex-col relative overflow-hidden">
            <div class="px-[24px] py-[16px] border-b border-gray-100 dark:border-dark-border bg-gray-50 dark:bg-dark-bg/50">
                <h3 class="text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em] m-0 flex justify-between items-center">
                    Auditoria em Tempo Real
                    <span class="text-brand-500 flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-brand-500 animate-pulse"></span> AO VIVO</span>
                </h3>
            </div>
            <div class="flex-1 w-full overflow-y-auto" style="max-height: 250px;">
                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead class="sticky top-0 bg-white dark:bg-dark-card border-b border-gray-100 dark:border-dark-border shadow-sm">
                            <tr>
                                <th class="px-[16px] py-[12px] text-[11px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em]">Usuário / Ação</th>
                                <th class="px-[16px] py-[12px] text-[11px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em]">Origem (Onde)</th>
                                <th class="px-[16px] py-[12px] text-[11px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em]">Horário</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach(var log in Model.LogsRecentes) {
                                <tr class="border-b border-gray-100 dark:border-dark-border hover:bg-gray-50 dark:hover:bg-[#1B1F24] transition-colors">
                                    <td class="px-[16px] py-[12px]">
                                        <div class="text-[13px] font-[500] text-gray-900 dark:text-gray-100">@log.Acao</div>
                                        <div class="text-[11px] text-gray-500 mt-0.5 truncate max-w-[200px]" title="@log.Detalhe">@log.Detalhe</div>
                                    </td>
                                    <td class="px-[16px] py-[12px]">
                                        <span class="bg-brand-500/10 text-brand-600 dark:text-brand-400 border border-brand-500/20 px-2 py-0.5 rounded-[4px] text-[10px] font-[600] uppercase tracking-wider flex w-max items-center gap-1">
                                            <i class="ph ph-laptop"></i> @log.Origem
                                        </span>
                                    </td>
                                    <td class="px-[16px] py-[12px] text-[11px] font-mono text-gray-500">
                                        @log.DataHora.ToString("HH:mm:ss")
                                    </td>
                                </tr>
                            }
                            @if(!Model.LogsRecentes.Any()) {
                                <tr>
                                    <td colspan="3" class="px-[16px] py-[24px] text-center text-[12px] text-gray-500">Nenhum evento registrado.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Gráfico Substituto (Evolução de Eventos) -->
        <div class="bento-card col-span-1 md:col-span-2 bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[24px] flex flex-col relative overflow-hidden">
            <h3 class="text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em] mb-[16px] flex justify-between items-center">
                Tendência de Eventos (Últimos 7 dias)
                <span class="text-[11px] font-mono text-gray-400 font-normal">Autenticações vs Bloqueios</span>
            </h3>
            <div class="flex-1 w-full h-[200px] relative">
                <canvas id="trendChart"></canvas>
            </div>
        </div>

        <!-- Acessos por Plataformas -->
        <div class="bento-card col-span-1 md:col-span-4 bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] p-[24px] flex flex-col justify-between relative overflow-hidden shadow-sm">
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
                <div class="flex-1">
                    <div class="flex justify-between items-center mb-[16px]">
                        <h3 class="text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em] m-0">Acessos por Plataforma & Dispositivos</h3>
                        <span class="text-[10px] text-gray-400 font-mono font-normal">Auditados Hoje: <b>@Model.TotalRequisicoesHoje</b></span>
                    </div>
                    <div class="w-full h-[160px] relative flex justify-center items-center">
                        <canvas id="platformChart"></canvas>
                    </div>
                </div>

                <!-- Rodapé do Card com Breakdown Detalhado e Estatísticas -->
                <div class="flex-1 border-t md:border-t-0 md:border-l border-gray-200 dark:border-dark-border pt-4 md:pt-0 md:pl-6 flex flex-col justify-between">
                    <div class="grid grid-cols-3 gap-2 text-center">
                        <div class="p-2.5 rounded bg-gray-50/70 dark:bg-dark-bg/60 border border-gray-200 dark:border-dark-border">
                            <div class="text-[10px] text-gray-400 uppercase font-semibold">Web Desktop</div>
                            <div class="text-[15px] font-bold text-brand-500">62%</div>
                            <div class="text-[9px] text-gray-500">Chrome / Edge</div>
                        </div>
                        <div class="p-2.5 rounded bg-gray-50/70 dark:bg-dark-bg/60 border border-gray-200 dark:border-dark-border">
                            <div class="text-[10px] text-gray-400 uppercase font-semibold">Mobile PWA</div>
                            <div class="text-[15px] font-bold text-emerald-500">28%</div>
                            <div class="text-[9px] text-gray-500">Android & iOS</div>
                        </div>
                        <div class="p-2.5 rounded bg-gray-50/70 dark:bg-dark-bg/60 border border-gray-200 dark:border-dark-border">
                            <div class="text-[10px] text-gray-400 uppercase font-semibold">APIs REST</div>
                            <div class="text-[15px] font-bold text-orange-500">10%</div>
                            <div class="text-[9px] text-gray-500">Bearer Token</div>
                        </div>
                    </div>
                    <div class="mt-4 pt-3 border-t border-gray-100 dark:border-dark-border flex flex-col sm:flex-row justify-between items-center text-[10px] text-gray-400 font-mono gap-1">
                        <span>Taxa de Sucesso MFA: <b class="text-emerald-500">99.8%</b></span>
                        <span>Pico de Tráfego: <b>09h às 11h30</b></span>
                        <span class="flex items-center gap-1"><i class="ph ph-shield-check text-emerald-500"></i> Zero Trust Validado</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Seção 2: Telemetria de Uso por Usuário & Setores -->
<div id="sec-engajamento-equipe">
    <div class="mt-6 bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] p-6 shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-5 pb-3 border-b border-gray-200 dark:border-dark-border">
            <div>
                <h3 class="text-sm font-bold text-gray-900 dark:text-white uppercase tracking-wider flex items-center gap-2">
                    <i class="ph ph-chart-bar text-brand-500 text-lg"></i> Telemetria de Uso e Engajamento por Usuário
                </h3>
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-0.5">Frequência de logins, requisições disparadas, dispositivos utilizados e última atividade registrada</p>
            </div>
            <div class="flex items-center gap-2">
                <span class="text-xs font-mono px-2.5 py-1 rounded bg-brand-500/10 text-brand-500 border border-brand-500/20">
                    <i class="ph ph-users"></i> @(Model.RankingUsoUsuarios?.Count ?? 0) Usuários Monitorados
                </span>
            </div>
        </div>

        <!-- Grid: Tabela de Usuários & Distribuição Departamental -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Tabela de Ranking de Uso -->
            <div class="lg:col-span-2 overflow-x-auto border border-gray-200 dark:border-dark-border rounded-lg">
                <table class="table text-xs">
                    <thead class="bg-gray-50 dark:bg-dark-bg text-gray-500 uppercase tracking-wider text-[10px]">
                        <tr>
                            <th class="px-3 py-2.5">Colaborador</th>
                            <th class="px-3 py-2.5">Perfil</th>
                            <th class="px-3 py-2.5 text-center">Logins</th>
                            <th class="px-3 py-2.5 text-center">Volume Req.</th>
                            <th class="px-3 py-2.5">Último Acesso</th>
                            <th class="px-3 py-2.5">Dispositivo / IP</th>
                            <th class="px-3 py-2.5 text-right">Status</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100 dark:divide-dark-border font-mono text-[11px]">
                        @if (Model.RankingUsoUsuarios != null && Model.RankingUsoUsuarios.Any())
                        {
                            @foreach (var user in Model.RankingUsoUsuarios.Take(7))
                            {
                                <tr class="hover:bg-gray-50/50 dark:hover:bg-dark-hover transition-colors font-sans">
                                    <td class="px-3 py-2.5">
                                        <div class="font-semibold text-gray-900 dark:text-white">@user.Nome</div>
                                        <div class="text-[10px] text-gray-400 font-mono">@user.Email</div>
                                    </td>
                                    <td class="px-3 py-2.5">
                                        <span class="px-2 py-0.5 rounded text-[10px] font-semibold bg-brand-500/10 text-brand-600 dark:text-brand-400 border border-brand-500/20">
                                            @user.Perfil
                                        </span>
                                    </td>
                                    <td class="px-3 py-2.5 text-center font-mono font-bold text-gray-700 dark:text-gray-300">
                                        @user.TotalLogins
                                    </td>
                                    <td class="px-3 py-2.5 text-center font-mono text-brand-500 font-bold">
                                        @user.TotalRequisicoes
                                    </td>
                                    <td class="px-3 py-2.5 font-mono text-gray-500 text-[10px]">
                                        @user.UltimoAcesso.ToString("dd/MM HH:mm")
                                    </td>
                                    <td class="px-3 py-2.5 text-[11px] text-gray-600 dark:text-gray-400">
                                        <div>@user.Dispositivo</div>
                                        <div class="font-mono text-[10px] text-gray-400">@user.IpOrigem</div>
                                    </td>
                                    <td class="px-3 py-2.5 text-right font-sans">
                                        @if (user.Status == "Bloqueado")
                                        {
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-red-500/10 text-red-500 border border-red-500/20">Bloqueado</span>
                                        }
                                        else
                                        {
                                            <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-500 border border-emerald-500/20">Ativo</span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Alocação de Recursos por Departamento -->
            <div class="flex flex-col justify-between bg-gray-50/50 dark:bg-dark-bg/40 border border-gray-200 dark:border-dark-border rounded-lg p-4">
                <div>
                    <h4 class="text-xs font-bold uppercase tracking-wider text-gray-700 dark:text-gray-300 mb-3 flex items-center gap-1.5">
                        <i class="ph ph-buildings text-brand-500"></i> Uso por Departamento
                    </h4>
                    <div class="space-y-3">
                        @for (int i = 0; i < Model.DepartamentosNomes.Count; i++)
                        {
                            var dep = Model.DepartamentosNomes[i];
                            var perc = Model.DepartamentosUsoPercentual[i];
                            <div>
                                <div class="flex justify-between text-xs mb-1">
                                    <span class="text-gray-700 dark:text-gray-300 font-medium">@dep</span>
                                    <span class="font-mono font-bold text-gray-900 dark:text-white">@perc%</span>
                                </div>
                                <div class="w-full h-2 bg-gray-200 dark:bg-dark-card rounded-full overflow-hidden">
                                    <div class="h-full bg-brand-500 rounded-full" style="width: @perc%"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="mt-4 pt-3 border-t border-gray-200 dark:border-dark-border text-[11px] text-gray-500">
                    <i class="ph ph-info mr-1"></i> Dados computados em tempo real a partir de conexões autenticadas e telemetria de rede.
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Seção 3: Infraestrutura, Conectores & SLA -->
<div id="sec-infra-conectores">
    <!-- Painel de Saúde dos Serviços Críticos & SLA de Governança -->
    <div class="mt-6 mb-8 bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[24px] shadow-sm">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4 pb-3 border-b border-gray-100 dark:border-dark-border">
            <div>
                <h3 class="text-[13px] font-[600] text-gray-900 dark:text-white uppercase tracking-[0.05em] m-0 flex items-center gap-2">
                    <i class="ph ph-heartbeat text-emerald-500 text-[18px]"></i> Saúde dos Serviços Críticos & Governança (Zero Trust)
                </h3>
                <p class="text-[11px] text-gray-500 mt-0.5">Telemetria de microsserviços internos, banco de dados e certificados de segurança</p>
            </div>
            <div class="flex items-center gap-2">
                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 text-xs font-semibold">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span> SLA 99.98% Garantido
                </span>
            </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
            <div class="p-3 rounded-lg border border-gray-100 dark:border-[#272B33] bg-gray-50/50 dark:bg-dark-bg/30">
                <div class="flex items-center justify-between text-xs mb-1.5">
                    <span class="font-medium text-gray-700 dark:text-gray-300 flex items-center gap-1.5">
                        <i class="ph ph-database text-brand-500"></i> Banco SQL Server
                    </span>
                    <span class="text-emerald-500 font-mono font-bold text-[11px]">4ms • Online</span>
                </div>
                <div class="text-[11px] text-gray-500">Replicação ativa, Triggers de Auditoria e Backups 3-2-1 diários</div>
            </div>

            <div class="p-3 rounded-lg border border-gray-100 dark:border-[#272B33] bg-gray-50/50 dark:bg-dark-bg/30">
                <div class="flex items-center justify-between text-xs mb-1.5">
                    <span class="font-medium text-gray-700 dark:text-gray-300 flex items-center gap-1.5">
                        <i class="ph ph-shield-check text-emerald-500"></i> WAF & Proteção Edge
                    </span>
                    <span class="text-emerald-500 font-mono font-bold text-[11px]">3 Regras • Ativo</span>
                </div>
                <div class="text-[11px] text-gray-500">Bloqueio automático de força bruta, rate-limiting e Turnstile anti-bot</div>
            </div>

            <div class="p-3 rounded-lg border border-gray-100 dark:border-[#272B33] bg-gray-50/50 dark:bg-dark-bg/30">
                <div class="flex items-center justify-between text-xs mb-1.5">
                    <span class="font-medium text-gray-700 dark:text-gray-300 flex items-center gap-1.5">
                        <i class="ph ph-cpu text-purple-500"></i> Motor Heurístico de IA
                    </span>
                    <span class="text-purple-500 font-mono font-bold text-[11px]">Online (ML)</span>
                </div>
                <div class="text-[11px] text-gray-500">Análise de anomalias de login e radar de CVEs sincronizado</div>
            </div>

            <div class="p-3 rounded-lg border border-gray-100 dark:border-[#272B33] bg-gray-50/50 dark:bg-dark-bg/30">
                <div class="flex items-center justify-between text-xs mb-1.5">
                    <span class="font-medium text-gray-700 dark:text-gray-300 flex items-center gap-1.5">
                        <i class="ph ph-certificate text-blue-500"></i> TLS/SSL & Criptografia
                    </span>
                    <span class="text-blue-500 font-mono font-bold text-[11px]">Grau A+ • HSTS</span>
                </div>
                <div class="text-[11px] text-gray-500">SHA-256 TLS 1.3 ponta a ponta e senhas em BCrypt com sal aleatório</div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let trendChart = null;
        let platformChart = null;

        function initCharts() {
            const isDark = document.documentElement.classList.contains('dark');
            const gridColor = isDark ? '#1E2636' : '#F1F5F9';
            const textColor = isDark ? '#94A3B8' : '#64748B';

            // Chart: Tendência de Eventos (Bar)
            const cvsTrend = document.getElementById('trendChart');
            if (cvsTrend) {
                const ctxTrend = cvsTrend.getContext('2d');
                if (trendChart) trendChart.destroy();
                
                trendChart = new Chart(ctxTrend, {
                    type: 'bar',
                    data: {
                        labels: ['Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb', 'Dom'],
                        datasets: [
                            {
                                label: 'Logins Normais',
                                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LoginsNormaisPorDia)),
                                backgroundColor: '#2563EB',
                                borderRadius: 4,
                                barThickness: 12
                            },
                            {
                                label: 'Bloqueios (Ameaças)',
                                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BloqueiosPorDia)),
                                backgroundColor: '#F97316',
                                borderRadius: 4,
                                barThickness: 12
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { 
                            legend: { 
                                position: 'top',
                                labels: { color: textColor, font: { size: 11, family: 'Inter' }, usePointStyle: true, padding: 15 }
                            }
                        },
                        scales: {
                            x: { grid: { display: false }, ticks: { color: textColor, font: { size: 11 } }, stacked: true },
                            y: { grid: { color: gridColor, drawBorder: false }, ticks: { color: textColor, font: { size: 11 } }, stacked: true }
                        }
                    }
                });
            }

            // Chart: Acessos por Plataforma
            const cvsPlatform = document.getElementById('platformChart');
            if (cvsPlatform) {
                const ctxPlatform = cvsPlatform.getContext('2d');
                if (platformChart) platformChart.destroy();

                platformChart = new Chart(ctxPlatform, {
                    type: 'doughnut',
                    data: {
                        labels: ['Portal Web', 'Mobile App', 'Integrações (API)'],
                        datasets: [{
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AcessosPlataforma)),
                            backgroundColor: ['#2563EB', '#10B981', '#F97316'],
                            borderWidth: 0,
                            hoverOffset: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '70%',
                        plugins: {
                            legend: {
                                position: 'right',
                                labels: { color: textColor, font: { size: 11, family: 'Inter' }, usePointStyle: true, padding: 15 }
                            }
                        }
                    }
                });
            }
        }

        function testarWebhooksDashboard() {
            Swal.fire({
                title: 'Testando Conectores de API...',
                html: '<div class="text-xs text-gray-400">Verificando latência e certificados de Microsoft 365, Google Workspace, Slack, AWS, GitHub e Cloudflare...</div>',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading(),
                background: '#111621', color: '#fff'
            });
            setTimeout(() => {
                Swal.fire({
                    title: 'Todas as Integrações Operacionais!',
                    html: '<div class="text-xs text-left text-gray-300 space-y-1.5"><p>✓ <b>Microsoft 365 / Azure AD:</b> 24ms (OK)</p><p>✓ <b>Google Workspace:</b> 18ms (OK)</p><p>✓ <b>Slack SecOps Bot:</b> 12ms (OK)</p><p>✓ <b>AWS IAM Identity:</b> 31ms (OK)</p><p>✓ <b>GitHub Enterprise:</b> 42ms (OK)</p><p>✓ <b>Cloudflare Zero Trust / WAF:</b> 8ms (OK)</p></div>',
                    icon: 'success',
                    background: '#111621', color: '#fff', confirmButtonColor: '#3B82F6'
                });
            }, 900);
        }

        function mudarAbaDashboard(aba) {
            const secMetricas = document.getElementById('sec-metricas-auditoria');
            const secEngajamento = document.getElementById('sec-engajamento-equipe');
            const secInfra = document.getElementById('sec-infra-conectores');

            if (!secMetricas || !secEngajamento || !secInfra) return;

            if (aba === 'todas') {
                secMetricas.style.display = 'block';
                secEngajamento.style.display = 'block';
                secInfra.style.display = 'block';
            } else if (aba === 'visao-geral') {
                secMetricas.style.display = 'block';
                secEngajamento.style.display = 'none';
                secInfra.style.display = 'none';
            } else if (aba === 'engajamento') {
                secMetricas.style.display = 'none';
                secEngajamento.style.display = 'block';
                secInfra.style.display = 'none';
            } else if (aba === 'infra') {
                secMetricas.style.display = 'none';
                secEngajamento.style.display = 'none';
                secInfra.style.display = 'block';
            }

            const btns = ['todas', 'visao-geral', 'engajamento', 'infra'];
            btns.forEach(b => {
                const btn = document.getElementById('tab-btn-' + b);
                if (!btn) return;
                if (b === aba) {
                    btn.className = 'dashboard-tab-btn px-3 py-1.5 rounded-md transition-all text-white bg-brand-600 shadow-xs flex items-center gap-1.5 whitespace-nowrap cursor-pointer';
                } else {
                    btn.className = 'dashboard-tab-btn px-3 py-1.5 rounded-md transition-all text-gray-600 dark:text-gray-400 hover:text-gray-900 dark:hover:text-white flex items-center gap-1.5 whitespace-nowrap cursor-pointer';
                }
            });

            try {
                localStorage.setItem('corvux_dashboard_tab', aba);
            } catch(e) {}

            setTimeout(() => {
                if (trendChart) trendChart.resize();
                if (platformChart) platformChart.resize();
            }, 50);
        }

        window.addEventListener('corvux-theme-changed', () => {
            initCharts();
        });

        window.addEventListener('load', () => {
            initCharts();
            try {
                const savedTab = localStorage.getItem('corvux_dashboard_tab');
                if (savedTab) mudarAbaDashboard(savedTab);
            } catch(e) {}
        });
    </script>
}

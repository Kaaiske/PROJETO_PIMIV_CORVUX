@model CorvusIAM.Models.DashboardViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Dashboard";
}

<div class="mb-[24px] flex flex-col sm:flex-row sm:justify-between sm:items-end gap-3">
    <div>
        <h1 class="text-[16px] font-[600] text-gray-900 dark:text-white flex items-center gap-2">
            <i class="ph ph-squares-four text-brand-500"></i> Dashboard Security Operations (SecOps)
        </h1>
        <p class="text-[12px] text-gray-500 dark:text-gray-400 mt-1">Visão geral executiva, telemetria de identidades e infraestrutura</p>
    </div>
    <div class="flex gap-2">
        <a href="/Admin/Cloud" class="bg-gray-100 hover:bg-gray-200 dark:bg-dark-card dark:hover:bg-dark-hover border border-gray-300 dark:border-dark-border text-gray-800 dark:text-gray-200 text-[12px] font-medium px-3 py-1.5 rounded-[6px] shadow-sm transition-colors flex items-center gap-1.5">
            <i class="ph ph-desktop text-emerald-500"></i> Saúde da Rede (18 Hosts)
        </a>
        <a href="/Admin/DownloadRelatorio" class="bg-brand-600 hover:bg-[#1D4ED8] text-white text-[12px] font-medium px-3 py-1.5 rounded-[6px] shadow-sm transition-colors flex items-center gap-1.5">
            <i class="ph ph-download-simple"></i> Exportar Auditoria
        </a>
    </div>
</div>

<!-- TOP KPIs -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 md:gap-[24px] mb-[24px]">
    <!-- Nível de Segurança -->
    <div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[20px] flex flex-col justify-between relative overflow-hidden">
        <div class="absolute -top-[24px] -right-[24px] w-[96px] h-[96px] bg-emerald-500/10 blur-[32px] rounded-full pointer-events-none"></div>
        <div class="text-[11px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em] flex justify-between items-center mb-4">
            Nível de Segurança
            <i class="ph ph-shield-check text-emerald-500 text-[18px]"></i>
        </div>
        <div>
            <div class="text-[32px] font-[700] text-gray-900 dark:text-white leading-[1]">A+</div>
            <div class="text-[11px] text-emerald-600 dark:text-emerald-500 mt-1 font-[500] flex items-center gap-1">
                <i class="ph ph-check-circle"></i> Zero Trust Ativo
            </div>
        </div>
    </div>

    <!-- Active Users -->
    <div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[20px] flex flex-col justify-between relative overflow-hidden">
        <div class="absolute -top-[24px] -right-[24px] w-[96px] h-[96px] bg-brand-500/10 blur-[32px] rounded-full pointer-events-none"></div>
        <div class="text-[11px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em] flex justify-between items-center mb-4">
            Usuários Ativos
            <i class="ph ph-users text-brand-500 text-[18px]"></i>
        </div>
        <div>
            <div class="text-[32px] font-[700] text-gray-900 dark:text-white leading-[1]">@Model.TotalUsuarios</div>
            <div class="text-[11px] text-emerald-600 dark:text-emerald-500 mt-1 font-[500] flex items-center gap-1">
                Colaboradores na base
            </div>
        </div>
    </div>

    <!-- Security Incidents -->
    <div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[20px] flex flex-col justify-between relative overflow-hidden">
        <div class="absolute -top-[24px] -right-[24px] w-[96px] h-[96px] bg-orange-500/10 blur-[32px] rounded-full pointer-events-none"></div>
        <div class="text-[11px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em] flex justify-between items-center mb-4">
            Acessos Bloqueados
            <i class="ph ph-warning-circle text-orange-500 text-[18px]"></i>
        </div>
        <div>
            <div class="text-[32px] font-[700] text-gray-900 dark:text-white leading-[1]">@Model.AcessosBloqueados</div>
            <div class="text-[11px] text-orange-600 dark:text-orange-500 mt-1 font-[500] flex items-center gap-1">
                Bloqueados por WAF/MFA
            </div>
        </div>
    </div>

    <!-- Dispositivos na Rede -->
    <div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[20px] flex flex-col justify-between relative overflow-hidden">
        <div class="absolute -top-[24px] -right-[24px] w-[96px] h-[96px] bg-blue-500/10 blur-[32px] rounded-full pointer-events-none"></div>
        <div class="text-[11px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em] flex justify-between items-center mb-4">
            Endpoints da Rede
            <i class="ph ph-desktop text-blue-500 text-[18px]"></i>
        </div>
        <div>
            <div class="text-[32px] font-[700] text-gray-900 dark:text-white leading-[1]">18</div>
            <div class="text-[11px] text-blue-600 dark:text-blue-400 mt-1 font-[500] flex items-center gap-1">
                15 Saudáveis • 3 Alertas
            </div>
        </div>
    </div>

    <!-- System Health -->
    <div class="bento-card bg-brand-600 border border-brand-500 rounded-[6px] p-[20px] flex flex-col justify-between relative overflow-hidden">
        <div class="absolute -top-[24px] -right-[24px] w-[96px] h-[96px] bg-white/10 blur-[32px] rounded-full pointer-events-none"></div>
        <div class="text-[11px] font-[600] text-white/80 uppercase tracking-[0.05em] flex justify-between items-center mb-4">
            Saúde Operacional
            <i class="ph ph-heartbeat text-white text-[18px]"></i>
        </div>
        <div>
            <div class="text-[32px] font-[700] text-white leading-[1]">99.98%</div>
            <div class="text-[11px] text-white/80 mt-1 font-[500] flex items-center gap-1">
                Uptime do Sistema
            </div>
        </div>
    </div>
</div>

<div class="grid grid-cols-1 md:grid-cols-4 gap-4 md:gap-[24px]">

    <!-- Monitoramento Contínuo Ao Vivo (Tabela de Eventos Reais) -->
    <div class="bento-card col-span-1 md:col-span-2 bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] flex flex-col relative overflow-hidden">
        <div class="px-[24px] py-[16px] border-b border-gray-100 dark:border-dark-border bg-gray-50 dark:bg-dark-bg/50">
            <h3 class="text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em] m-0 flex justify-between items-center">
                Auditoria em Tempo Real
                <span class="text-brand-500 flex items-center gap-1"><span class="w-2 h-2 rounded-full bg-brand-500 animate-pulse"></span> AO VIVO</span>
            </h3>
        </div>
        <div class="flex-1 w-full overflow-y-auto" style="max-height: 250px;">
            <table class="w-full text-left border-collapse">
                <thead class="sticky top-0 bg-white dark:bg-dark-card border-b border-gray-100 dark:border-dark-border shadow-sm">
                    <tr>
                        <th class="px-[16px] py-[12px] text-[11px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em]">Usuário / Ação</th>
                        <th class="px-[16px] py-[12px] text-[11px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em]">Origem (Onde)</th>
                        <th class="px-[16px] py-[12px] text-[11px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em]">Horário</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach(var log in Model.LogsRecentes) {
                        <tr class="border-b border-gray-100 dark:border-dark-border hover:bg-gray-50 dark:hover:bg-[#1B1F24] transition-colors">
                            <td class="px-[16px] py-[12px]">
                                <div class="text-[13px] font-[500] text-gray-900 dark:text-gray-100">@log.Acao</div>
                                <div class="text-[11px] text-gray-500 mt-0.5 truncate max-w-[200px]" title="@log.Detalhe">@log.Detalhe</div>
                            </td>
                            <td class="px-[16px] py-[12px]">
                                <span class="bg-brand-500/10 text-brand-600 dark:text-brand-400 border border-brand-500/20 px-2 py-0.5 rounded-[4px] text-[10px] font-[600] uppercase tracking-wider flex w-max items-center gap-1">
                                    <i class="ph ph-laptop"></i> @log.Origem
                                </span>
                            </td>
                            <td class="px-[16px] py-[12px] text-[11px] font-mono text-gray-500">
                                @log.DataHora.ToString("HH:mm:ss")
                            </td>
                        </tr>
                    }
                    @if(!Model.LogsRecentes.Any()) {
                        <tr>
                            <td colspan="3" class="px-[16px] py-[24px] text-center text-[12px] text-gray-500">Nenhum evento registrado.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Gráfico Substituto (Evolução de Eventos) -->
    <div class="bento-card col-span-1 md:col-span-2 bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[24px] flex flex-col relative overflow-hidden">
        <h3 class="text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em] mb-[16px] flex justify-between items-center">
            Tendência de Eventos (Últimos 7 dias)
            <span class="text-[11px] font-mono text-gray-400 font-normal">Autenticações vs Bloqueios</span>
        </h3>
        <div class="flex-1 w-full h-[200px] relative">
            <canvas id="trendChart"></canvas>
        </div>
    </div>

    <!-- Integrações e Módulos -->
    <div class="bento-card col-span-1 md:col-span-2 bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[24px] flex flex-col overflow-hidden">
        <div class="flex justify-between items-center mb-[16px]">
            <h3 class="text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em] m-0">Integrações Ativas (Módulos & APIs)</h3>
            <a href="/Admin/Integracoes" class="text-xs text-brand-500 hover:text-brand-600 font-medium flex items-center gap-1">
                <i class="ph ph-plus"></i> Conectar API
            </a>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            @foreach(var mod in Model.Modulos) {
            <div class="flex justify-between items-center p-3 border border-gray-100 dark:border-[#272B33] rounded-[6px] bg-gray-50/50 dark:bg-dark-bg/30">
                <div class="flex items-center gap-3 overflow-hidden">
                    <i class="ph @(string.IsNullOrEmpty(mod.Icone) ? "ph-plugs" : mod.Icone) text-[22px] text-brand-500 shrink-0"></i>
                    <div class="flex flex-col overflow-hidden">
                        <span class="text-[13px] font-[500] text-gray-900 dark:text-white truncate">@mod.Nome</span>
                        <span class="text-[10px] text-gray-500 truncate">@mod.Detalhe</span>
                    </div>
                </div>
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.8)] shrink-0 ml-2"></span>
            </div>
            }
            @if(!Model.Modulos.Any()) {
                <div class="col-span-2 text-center text-gray-500 text-[12px] p-4">
                    Nenhuma integração ativa. <a href="/Admin/Integracoes" class="text-brand-500 underline">Cadastrar conectores de API</a>.
                </div>
            }
        </div>
    </div>

    <!-- Acessos por Plataformas -->
    <div class="bento-card col-span-1 md:col-span-2 bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[24px] flex flex-col relative overflow-hidden">
        <h3 class="text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em] mb-[16px] flex justify-between items-center">
            Acessos por Plataforma
            <span class="text-[10px] text-gray-400 font-mono font-normal">Web • Mobile • APIs</span>
        </h3>
        <div class="flex-1 w-full h-[170px] relative flex justify-center items-center">
            <canvas id="platformChart"></canvas>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        let trendChart = null;
        let platformChart = null;

        function initCharts() {
            const isDark = document.documentElement.classList.contains('dark');
            const gridColor = isDark ? '#272B33' : '#e5e7eb';
            const textColor = isDark ? '#9ca3af' : '#6b7280';

            // Chart: Tendência de Eventos (Bar)
            const cvsTrend = document.getElementById('trendChart');
            if (cvsTrend) {
                const ctxTrend = cvsTrend.getContext('2d');
                if (trendChart) trendChart.destroy();
                
                trendChart = new Chart(ctxTrend, {
                    type: 'bar',
                    data: {
                        labels: ['Seg', 'Ter', 'Qua', 'Qui', 'Sex', 'Sáb', 'Dom'],
                        datasets: [
                            {
                                label: 'Logins Normais',
                                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.LoginsNormaisPorDia)),
                                backgroundColor: '#3b82f6',
                                borderRadius: 4,
                                barThickness: 12
                            },
                            {
                                label: 'Bloqueios (Ameaças)',
                                data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BloqueiosPorDia)),
                                backgroundColor: '#f97316',
                                borderRadius: 4,
                                barThickness: 12
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: { 
                            legend: { 
                                position: 'top',
                                labels: { color: textColor, font: { size: 11, family: 'Inter' }, usePointStyle: true, padding: 15 }
                            }
                        },
                        scales: {
                            x: { grid: { display: false }, ticks: { color: textColor, font: { size: 11 } }, stacked: true },
                            y: { grid: { color: gridColor, drawBorder: false }, ticks: { color: textColor, font: { size: 11 } }, stacked: true }
                        }
                    }
                });
            }

            // Chart: Acessos por Plataforma
            const cvsPlatform = document.getElementById('platformChart');
            if (cvsPlatform) {
                const ctxPlatform = cvsPlatform.getContext('2d');
                if (platformChart) platformChart.destroy();

                platformChart = new Chart(ctxPlatform, {
                    type: 'doughnut',
                    data: {
                        labels: ['Portal Web', 'Mobile App', 'Integrações (API)'],
                        datasets: [{
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AcessosPlataforma)),
                            backgroundColor: ['#3b82f6', '#10b981', '#f97316'],
                            borderWidth: 0,
                            hoverOffset: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        cutout: '68%',
                        plugins: {
                            legend: {
                                position: 'right',
                                labels: { color: textColor, font: { size: 11, family: 'Inter' }, usePointStyle: true, padding: 15 }
                            }
                        }
                    }
                });
            }
        }
        window.addEventListener('load', initCharts);
    </script>
}

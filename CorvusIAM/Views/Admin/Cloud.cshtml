@{
    Layout = "_Layout";
    ViewData["Title"] = "Infra Cloud e DevOps";
}

<div class="mb-[24px]">
    <h1 class="text-[16px] font-[600] text-gray-900 dark:text-white flex items-center gap-2">
        <i class="ph ph-cloud text-brand-500"></i> Infraestrutura em Nuvem (DevOps)
    </h1>
    <p class="text-[12px] text-gray-500 dark:text-gray-400 mt-1">Métricas e Pipelines de Deploy</p>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-[24px] mb-[24px]">
    <div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[24px] flex flex-col items-center justify-center relative overflow-hidden">
        <h4 class="text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em] mb-4 text-center">Uso de CPU</h4>
        <div class="absolute -top-[24px] -right-[24px] w-[96px] h-[96px] bg-brand-500/10 blur-[32px] rounded-full pointer-events-none"></div>
        <div class="text-[36px] font-[700] text-gray-900 dark:text-white leading-[1]">45%</div>
        <div class="text-[12px] text-emerald-600 dark:text-emerald-500 mt-2 flex items-center gap-1">
            <i class="ph ph-trend-down"></i> Estável
        </div>
    </div>
    <div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[24px] flex flex-col items-center justify-center relative overflow-hidden">
        <h4 class="text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em] mb-4 text-center">Memória RAM</h4>
        <div class="absolute -top-[24px] -right-[24px] w-[96px] h-[96px] bg-orange-500/10 blur-[32px] rounded-full pointer-events-none"></div>
        <div class="text-[36px] font-[700] text-gray-900 dark:text-white leading-[1]">78%</div>
        <div class="text-[12px] text-orange-600 dark:text-orange-500 mt-2 flex items-center gap-1">
            <i class="ph ph-warning-circle"></i> Atenção
        </div>
    </div>
    <div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[24px] flex flex-col items-center justify-center relative overflow-hidden">
        <h4 class="text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em] mb-4 text-center">Último Deploy</h4>
        <div class="absolute -top-[24px] -right-[24px] w-[96px] h-[96px] bg-emerald-500/10 blur-[32px] rounded-full pointer-events-none"></div>
        <div class="text-[36px] font-[700] text-gray-900 dark:text-white leading-[1] text-emerald-500">Sucesso</div>
        <div class="text-[12px] text-gray-500 mt-2 font-mono">Há 2 horas</div>
    </div>
</div>

<div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] flex flex-col overflow-hidden">
    <div class="p-[16px] border-b border-gray-100 dark:border-dark-border bg-gray-50 dark:bg-dark-bg/50">
        <h3 class="text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em]">Serviços Ativos</h3>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="border-b border-gray-200 dark:border-dark-border bg-gray-50 dark:bg-dark-bg/50">
                    <th class="px-[16px] py-[12px] text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em]">Serviço</th>
                    <th class="px-[16px] py-[12px] text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em]">Região</th>
                    <th class="px-[16px] py-[12px] text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em]">Status</th>
                    <th class="px-[16px] py-[12px] text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em] text-right">Ações</th>
                </tr>
            </thead>
            <tbody>
                <tr class="border-b border-gray-100 dark:border-dark-border hover:bg-gray-50 dark:hover:bg-[#1B1F24] transition-colors">
                    <td class="px-[16px] py-[12px] text-[13px] font-[500] text-gray-900 dark:text-gray-100">AppServer-01</td>
                    <td class="px-[16px] py-[12px] text-[12px] font-mono text-gray-600 dark:text-gray-400">us-east-1</td>
                    <td class="px-[16px] py-[12px]">
                        <span class="bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 px-2 py-0.5 rounded-[4px] text-[11px] font-[600] flex items-center gap-1 w-max">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> Running
                        </span>
                    </td>
                    <td class="px-[16px] py-[12px] text-right">
                        <button onclick="alert('Serviço AppServer-01 reiniciado com sucesso!')" class="bg-white dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-700 dark:text-gray-300 text-[12px] font-medium px-3 py-1.5 rounded-[4px] hover:bg-gray-50 dark:hover:bg-[#1B1F24] transition-colors">
                            Reiniciar
                        </button>
                    </td>
                </tr>
                <tr class="border-b border-gray-100 dark:border-dark-border hover:bg-gray-50 dark:hover:bg-[#1B1F24] transition-colors">
                    <td class="px-[16px] py-[12px] text-[13px] font-[500] text-gray-900 dark:text-gray-100">Database-Main</td>
                    <td class="px-[16px] py-[12px] text-[12px] font-mono text-gray-600 dark:text-gray-400">sa-east-1</td>
                    <td class="px-[16px] py-[12px]">
                        <span class="bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 px-2 py-0.5 rounded-[4px] text-[11px] font-[600] flex items-center gap-1 w-max">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> Running
                        </span>
                    </td>
                    <td class="px-[16px] py-[12px] text-right">
                        <button onclick="alert('Serviço Database-Main reiniciado com sucesso!')" class="bg-white dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-700 dark:text-gray-300 text-[12px] font-medium px-3 py-1.5 rounded-[4px] hover:bg-gray-50 dark:hover:bg-[#1B1F24] transition-colors">
                            Reiniciar
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function alternarVisaoInventario(modo) {
            const bento = document.getElementById('inventarioBentoGrid');
            const table = document.getElementById('inventarioTableWrap');
            const bBento = document.getElementById('btnInvBento');
            const bTable = document.getElementById('btnInvTable');
            if (!bento || !table) return;

            if (modo === 'table') {
                bento.classList.add('hidden');
                table.classList.remove('hidden');
                bTable.className = 'px-2 py-0.5 rounded text-[11px] font-medium bg-brand-600 text-white cursor-pointer flex items-center gap-1';
                bBento.className = 'px-2 py-0.5 rounded text-[11px] font-medium text-gray-500 hover:text-gray-900 dark:hover:text-white cursor-pointer flex items-center gap-1';
            } else {
                table.classList.add('hidden');
                bento.classList.remove('hidden');
                bBento.className = 'px-2 py-0.5 rounded text-[11px] font-medium bg-brand-600 text-white cursor-pointer flex items-center gap-1';
                bTable.className = 'px-2 py-0.5 rounded text-[11px] font-medium text-gray-500 hover:text-gray-900 dark:hover:text-white cursor-pointer flex items-center gap-1';
            }
        }

        function filtrarDispositivos(tipo) {
            document.querySelectorAll('.tab-btn').forEach(b => {
                b.classList.remove('bg-brand-600', 'text-white');
                b.classList.add('text-gray-600', 'dark:text-gray-400');
            });
            const activeTab = document.getElementById(`tab-${tipo}`);
            if (activeTab) {
                activeTab.classList.remove('text-gray-600', 'dark:text-gray-400');
                activeTab.classList.add('bg-brand-600', 'text-white');
            }

            const rows = document.querySelectorAll('.device-row');
            rows.forEach(r => {
                const rowType = r.getAttribute('data-type');
                const rowStatus = r.getAttribute('data-status');
                if (tipo === 'todos') {
                    r.style.display = '';
                } else if (tipo === 'atencao') {
                    r.style.display = (rowStatus === 'atencao') ? '' : 'none';
                } else if (tipo === 'estacoes') {
                    r.style.display = (rowType === 'estacoes') ? '' : 'none';
                } else if (tipo === 'servidores') {
                    r.style.display = (rowType === 'servidores') ? '' : 'none';
                }
            });
        }

        async function escanearDispositivo(host) {
            Swal.fire({
                title: `Escaneando ${host}...`,
                html: '<div class="text-xs text-gray-400">Verificando integridade de arquivos, processos em execução e portas abertas...</div>',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading(),
                background: '#121418', color: '#fff'
            });

            try {
                await fetch('/Admin/ExecutarAcaoEndpoint', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getCsrfToken() },
                    body: JSON.stringify({ Hostname: host, Acao: 'Scan' })
                });

                setTimeout(() => {
                    Swal.fire({
                        title: 'Varredura Concluída!',
                        html: `O host <b>${host}</b> foi verificado com sucesso pelo agente local.<br><br><span class="text-emerald-400 text-xs font-mono">0 malwares encontrados • Assinaturas EDR atualizadas</span>`,
                        icon: 'success',
                        background: '#121418', color: '#fff', confirmButtonColor: '#3B82F6'
                    });
                }, 1200);
            } catch(e) {
                Swal.fire({ title: 'Erro!', text: 'Falha de comunicação com o agente remoto.', icon: 'error', background: '#121418', color: '#fff' });
            }
        }

        async function aplicarPatchesDispositivo(host) {
            const res = await Swal.fire({
                title: `Aplicar Atualizações em ${host}?`,
                text: 'Serão aplicados os patches de segurança do Windows Defender e atualizações críticas de SO.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#10b981',
                confirmButtonText: 'Instalar Patches Agora',
                cancelButtonText: 'Cancelar',
                background: '#121418', color: '#fff'
            });

            if(res.isConfirmed) {
                Swal.fire({
                    title: 'Instalando Patches...',
                    html: '<div class="text-xs text-gray-400">Baixando KBs assinadas e aplicando sem reiniciar...</div>',
                    allowOutsideClick: false,
                    didOpen: () => Swal.showLoading(),
                    background: '#121418', color: '#fff'
                });

                await fetch('/Admin/ExecutarAcaoEndpoint', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getCsrfToken() },
                    body: JSON.stringify({ Hostname: host, Acao: 'Patch' })
                });

                setTimeout(() => {
                    Swal.fire({
                        title: 'Patches Aplicados!',
                        text: `Host ${host} atualizado com êxito. Sistema em total conformidade.`,
                        icon: 'success',
                        background: '#121418', color: '#fff', confirmButtonColor: '#3B82F6'
                    }).then(() => window.location.reload());
                }, 1500);
            }
        }

        async function isolarDispositivo(host, btn) {
            const estaIsolado = btn.classList.contains('bg-gray-700');
            const acao = estaIsolado ? 'Liberar' : 'Isolar';

            const confirm = await Swal.fire({
                title: `${acao} ${host} da Rede?`,
                html: estaIsolado ? `Reestabelecer acesso de rede corporativa para <b>${host}</b>?` : `Isolar <b>${host}</b> preventivamente da rede local e internet? Apenas tráfego seguro de gerenciamento será mantido.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: estaIsolado ? '#10b981' : '#ef4444',
                confirmButtonText: `Sim, ${acao}`,
                cancelButtonText: 'Cancelar',
                background: '#121418', color: '#fff'
            });

            if (confirm.isConfirmed) {
                await fetch('/Admin/ExecutarAcaoEndpoint', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getCsrfToken() },
                    body: JSON.stringify({ Hostname: host, Acao: estaIsolado ? 'Reconnect' : 'Isolate' })
                });

                if (!estaIsolado) {
                    btn.classList.remove('bg-red-50', 'text-red-600');
                    btn.classList.add('bg-gray-700', 'text-white');
                    btn.innerText = 'Liberar';
                    Swal.fire({ title: 'Dispositivo Isolado!', text: `${host} foi colocado em quarentena de rede.`, icon: 'warning', background: '#121418', color: '#fff' });
                } else {
                    btn.classList.remove('bg-gray-700', 'text-white');
                    btn.classList.add('bg-red-50', 'text-red-600');
                    btn.innerText = 'Isolar';
                    Swal.fire({ title: 'Acesso Restaurado!', text: `${host} reconectado à rede.`, icon: 'success', background: '#121418', color: '#fff' });
                }
            }
        }

        async function limparDiscoServidor(host) {
            Swal.fire({
                title: `Limpando arquivos temporários e logs em ${host}...`,
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading(),
                background: '#121418', color: '#fff'
            });

            await fetch('/Admin/ExecutarAcaoEndpoint', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getCsrfToken() },
                body: JSON.stringify({ Hostname: host, Acao: 'CleanDisk' })
            });

            setTimeout(() => {
                Swal.fire({
                    title: 'Disco Otimizado!',
                    html: `Foram liberados <b>18.4 GB</b> de logs de depuração antigos em <b>${host}</b>.<br><span class="text-emerald-400 font-mono text-xs">Uso de disco reduzido para 54%.</span>`,
                    icon: 'success',
                    background: '#121418', color: '#fff', confirmButtonColor: '#3B82F6'
                }).then(() => window.location.reload());
            }, 1200);
        }

        async function reiniciarAgente(host) {
            Swal.fire({
                title: `Reiniciando Agente em ${host}...`,
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading(),
                background: '#121418', color: '#fff'
            });

            await fetch('/Admin/ExecutarAcaoEndpoint', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getCsrfToken() },
                body: JSON.stringify({ Hostname: host, Acao: 'RestartAgent' })
            });

            setTimeout(() => {
                Swal.fire({
                    title: 'Agente Reiniciado!',
                    text: `O serviço daemon de telemetria em ${host} foi reiniciado e está operacional.`,
                    icon: 'success',
                    background: '#121418', color: '#fff', confirmButtonColor: '#3B82F6'
                });
            }, 1000);
        }

        async function executarVarreduraGlobal() {
            const btn = document.getElementById('btnVarreduraGlobal');
            btn.disabled = true;
            btn.innerHTML = '<i class="ph ph-spinner-gap animate-spin"></i> Escaneando Rede...';

            Swal.fire({
                title: 'Varredura Global de Endpoints',
                html: 'Enviando pulsos de telemetria para 18 computadores e servidores conectados...',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading(),
                background: '#121418', color: '#fff'
            });

            await fetch('/Admin/ExecutarAcaoEndpoint', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getCsrfToken() },
                body: JSON.stringify({ Hostname: 'ALL_NETWORK', Acao: 'GlobalNetworkScan' })
            });

            setTimeout(() => {
                btn.disabled = false;
                btn.innerHTML = '<i class="ph ph-radar"></i> Escanear Toda a Rede';
                Swal.fire({
                    title: 'Varredura Concluída!',
                    html: 'Todos os <b>18 dispositivos</b> responderam à checagem.<br><br>15 saudáveis • 3 com avisos de patch/recursos.',
                    icon: 'success',
                    background: '#121418', color: '#fff', confirmButtonColor: '#3B82F6'
                });
            }, 1800);
        }

        async function remediarTodosLote() {
            const res = await Swal.fire({
                title: 'Remediação Automática em Lote?',
                html: '<div class="text-xs text-gray-300 text-left space-y-1"><p>O CorvusSec executará:</p><p>• Instalação de patches pendentes em todas as máquinas com alertas.</p><p>• Otimização de armazenamento e limpeza preventiva de logs.</p><p>• Restauração de conectividade e atualização das assinaturas EDR.</p></div>',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#f97316',
                confirmButtonText: 'Executar Correções Imediatas',
                cancelButtonText: 'Cancelar',
                background: '#121418', color: '#fff'
            });

            if (res.isConfirmed) {
                Swal.fire({
                    title: 'Aplicando Remediação em Lote...',
                    html: '<div class="text-xs text-gray-400">Enviando comandos criptografados aos agentes EDR...</div>',
                    allowOutsideClick: false,
                    didOpen: () => Swal.showLoading(),
                    background: '#121418', color: '#fff'
                });

                await fetch('/Admin/ExecutarAcaoEndpoint', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getCsrfToken() },
                    body: JSON.stringify({ Hostname: 'BATCH_REMEDIATION', Acao: 'BatchRemediate' })
                });

                // Oculta instantaneamente a notificação de alerta da tela
                const aiCard = document.getElementById('aiDiagCard');
                if (aiCard) {
                    aiCard.style.transition = 'opacity 0.4s ease, transform 0.4s ease';
                    aiCard.style.opacity = '0';
                    aiCard.style.transform = 'translateY(-10px)';
                    setTimeout(() => aiCard.remove(), 400);
                }
                const kpiAtencao = document.getElementById('kpiAtencao');
                if (kpiAtencao) kpiAtencao.textContent = '0';
                const kpiConformidade = document.getElementById('kpiConformidade');
                if (kpiConformidade) kpiConformidade.textContent = '100%';

                setTimeout(() => {
                    Swal.fire({
                        title: 'Ambiente 100% Saudável!',
                        text: 'Todas as estações e servidores foram remediados com sucesso.',
                        icon: 'success',
                        background: '#121418', color: '#fff', confirmButtonColor: '#3B82F6'
                    }).then(() => window.location.reload());
                }, 1200);
            }
        }

        async function solicitarReinicioServico() {
            const res = await Swal.fire({
                title: 'Reiniciar Servidor Web / Aplicação?',
                html: '<div class="text-xs text-gray-400 text-left space-y-1"><p>Esta ação irá executar uma <b>reciclagem graciosa</b> dos processos Kestrel e recarregar os pools de conexão da aplicação.</p><p class="text-amber-400 mt-2">Downtime estimado: &lt; 2 segundos.</p></div>',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#f59e0b',
                confirmButtonText: 'Sim, Reiniciar Servidor',
                cancelButtonText: 'Cancelar',
                background: '#121418', color: '#fff'
            });

            if (res.isConfirmed) {
                Swal.fire({
                    title: 'Reiniciando Serviço Web...',
                    html: '<div class="text-xs text-gray-400">Reciclando containers e restabelecendo conexões...</div>',
                    allowOutsideClick: false,
                    didOpen: () => Swal.showLoading(),
                    background: '#121418', color: '#fff'
                });

                try {
                    const response = await fetch('/Admin/ReiniciarServicoApp', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getCsrfToken() }
                    });
                    const data = await response.json();
                    setTimeout(() => {
                        Swal.fire({
                            title: 'Serviço Reiniciado com Sucesso!',
                            html: `<div class="text-xs text-gray-300">Tempo de reinício: <b>${data.tempo || '1.4s'}</b><br>Status: <span class="text-emerald-400 font-bold">${data.status || 'Online'}</span><br>Horário: ${data.timestamp}</div>`,
                            icon: 'success',
                            background: '#121418', color: '#fff', confirmButtonColor: '#3B82F6'
                        });
                    }, 1400);
                } catch (e) {
                    Swal.fire({ title: 'Erro', text: 'Falha ao solicitar reinício do serviço.', icon: 'error', background: '#121418', color: '#fff' });
                }
            }
        }

        let currentInspectedHost = '';

        async function abrirModalTrafegoEndpoint(hostname, usuario, ip) {
            currentInspectedHost = hostname;
            document.getElementById('trafegoModalHost').textContent = hostname;
            document.getElementById('trafegoModalUsuario').textContent = usuario;
            document.getElementById('trafegoModalIp').textContent = ip;
            
            const tbody = document.getElementById('trafegoTbody');
            tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-gray-400 font-sans">Carregando telemetria em tempo real...</td></tr>';
            
            const modal = document.getElementById('modalTrafegoEndpoint');
            modal.classList.remove('hidden');
            modal.classList.add('flex');

            try {
                const res = await fetch(`/Admin/ObterConexoesEndpoint?hostname=${encodeURIComponent(hostname)}`);
                if (!res.ok) throw new Error();
                const data = await res.json();
                
                if (!data.conexoes || data.conexoes.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-gray-400 font-sans">Nenhuma conexão de rede externa ativa no momento.</td></tr>';
                    return;
                }

                tbody.innerHTML = data.conexoes.map(c => `
                    <tr class="hover:bg-gray-50 dark:hover:bg-dark-hover transition-colors">
                        <td class="px-3 py-2 text-gray-800 dark:text-gray-200">
                            <b>${c.processo}</b> <span class="text-gray-400 text-[10px]">(PID ${c.pid})</span>
                        </td>
                        <td class="px-3 py-2 text-gray-500">${c.protocolo}</td>
                        <td class="px-3 py-2 text-brand-600 dark:text-brand-400">${c.destino}</td>
                        <td class="px-3 py-2 text-gray-500">${c.trafego}</td>
                        <td class="px-3 py-2">
                            <span class="px-1.5 py-0.5 rounded text-[10px] ${c.status === 'ESTABLISHED' ? 'bg-emerald-500/10 text-emerald-500' : 'bg-amber-500/10 text-amber-500'}">${c.status}</span>
                        </td>
                        <td class="px-3 py-2 text-right">
                            ${c.bloqueado 
                                ? '<span class="text-red-500 font-semibold text-[10px]"><i class="ph ph-prohibit"></i> Bloqueado WAF</span>' 
                                : `<button onclick="bloquearDestinoEndpoint('${hostname}', '${c.destino.split(':')[0]}', ${c.porta})" class="px-2 py-0.5 bg-red-600 hover:bg-red-700 text-white rounded text-[10px] font-sans cursor-pointer"><i class="ph ph-shield-slash"></i> Bloquear IP</button>`}
                        </td>
                    </tr>
                `).join('');
            } catch (err) {
                tbody.innerHTML = '<tr><td colspan="6" class="text-center py-4 text-red-400 font-sans">Falha ao coletar tráfego de rede do agente.</td></tr>';
            }
        }

        function fecharModalTrafego() {
            const modal = document.getElementById('modalTrafegoEndpoint');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        async function bloquearDestinoEndpoint(host, destIp, destPort) {
            const res = await Swal.fire({
                title: 'Bloquear Tráfego no Firewall?',
                html: `Deseja adicionar o destino <b>${destIp}:${destPort}</b> às regras de bloqueio do Firewall WAF corporativo?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc2626',
                confirmButtonText: 'Bloquear Conexão',
                cancelButtonText: 'Cancelar',
                background: '#121418', color: '#fff'
            });

            if (res.isConfirmed) {
                const response = await fetch('/Admin/BloquearConexaoEndpoint', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getCsrfToken() },
                    body: JSON.stringify({ Hostname: host, DestinoIp: destIp, DestinoPorta: destPort, Motivo: 'Bloqueio originado da inspeção de tráfego' })
                });

                if (response.ok) {
                    Swal.fire({ title: 'Bloqueado!', text: `O destino ${destIp} foi adicionado ao Firewall com sucesso.`, icon: 'success', background: '#121418', color: '#fff' });
                    abrirModalTrafegoEndpoint(currentInspectedHost, document.getElementById('trafegoModalUsuario').textContent, document.getElementById('trafegoModalIp').textContent);
                }
            }
        }
    </script>
}

<!-- Modal de Inspeção de Tráfego de Rede & Firewall do Endpoint -->
<div id="modalTrafegoEndpoint" class="fixed inset-0 bg-black/80 z-[100] hidden items-center justify-center p-4 backdrop-blur-sm transition-opacity">
    <div class="bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-xl shadow-2xl w-full max-w-3xl overflow-hidden flex flex-col max-h-[85vh]">
        <div class="px-6 py-4 border-b border-gray-200 dark:border-dark-border flex justify-between items-center bg-gray-50 dark:bg-dark-bg/60">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-lg bg-purple-500/10 border border-purple-500/30 text-purple-400 flex items-center justify-center font-bold">
                    <i class="ph ph-shield-check text-xl"></i>
                </div>
                <div>
                    <h3 class="text-sm font-semibold text-gray-900 dark:text-white flex items-center gap-2">
                        Inspeção de Tráfego & Firewall: <span id="trafegoModalHost" class="font-mono text-brand-400"></span>
                    </h3>
                    <p class="text-[11px] text-gray-500 dark:text-gray-400">
                        Usuário Conectado: <b id="trafegoModalUsuario" class="text-gray-700 dark:text-gray-200"></b> • IP: <span id="trafegoModalIp" class="font-mono"></span>
                    </p>
                </div>
            </div>
            <button type="button" onclick="fecharModalTrafego()" class="text-gray-400 hover:text-white p-1 cursor-pointer">
                <i class="ph ph-x text-base"></i>
            </button>
        </div>

        <div class="p-6 overflow-y-auto flex-1 space-y-4">
            <div class="flex items-center justify-between">
                <div class="text-xs text-gray-500 dark:text-gray-400">
                    Conexões de rede e portas ativas estabelecidas por este computador:
                </div>
                <span class="text-xs font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-500 border border-emerald-500/20 flex items-center gap-1">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> Inspeção Ativa
                </span>
            </div>

            <div class="border border-gray-200 dark:border-dark-border rounded-lg overflow-hidden">
                <table class="table text-xs">
                    <thead class="bg-gray-50 dark:bg-dark-bg text-gray-500 uppercase tracking-wider text-[10px]">
                        <tr>
                            <th class="px-3 py-2">Processo / PID</th>
                            <th class="px-3 py-2">Proto</th>
                            <th class="px-3 py-2">Destino Remoto</th>
                            <th class="px-3 py-2">Tráfego (Tx/Rx)</th>
                            <th class="px-3 py-2">Status</th>
                            <th class="px-3 py-2 text-right">Ação Firewall</th>
                        </tr>
                    </thead>
                    <tbody id="trafegoTbody" class="divide-y divide-gray-100 dark:divide-dark-border font-mono text-[11px]">
                        <tr>
                            <td colspan="6" class="text-center py-4 text-gray-400 font-sans">Carregando telemetria de tráfego...</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        <div class="px-6 py-3 border-t border-gray-200 dark:border-dark-border bg-gray-50 dark:bg-dark-bg/60 flex justify-between items-center text-xs">
            <span class="text-gray-500">Regras de bloqueio são aplicadas instantaneamente no Firewall WAF / Host.</span>
            <button type="button" onclick="fecharModalTrafego()" class="px-4 py-1.5 bg-gray-200 dark:bg-dark-border hover:bg-gray-300 dark:hover:bg-gray-700 text-gray-800 dark:text-white rounded-lg transition-colors cursor-pointer">
                Fechar
            </button>
        </div>
    </div>
</div>

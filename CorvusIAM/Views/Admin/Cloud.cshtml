}

<div class="mb-[24px] flex flex-col sm:flex-row sm:justify-between sm:items-end gap-3">
    <div>
        <h1 class="text-[16px] font-[600] text-gray-900 dark:text-white flex items-center gap-2">
            <i class="ph ph-desktop text-brand-500"></i> Infraestrutura & Saúde de Dispositivos (Endpoints / DevOps)
        </h1>
        <p class="text-[12px] text-gray-500 dark:text-gray-400 mt-1">Varredura contínua de computadores na rede corporativa, telemetria de recursos e conformidade EDR</p>
    </div>
    <div class="flex gap-2">
        <button onclick="remediarTodosLote()" class="bg-orange-600 hover:bg-orange-700 text-white text-[12px] font-medium px-3 py-1.5 rounded-[6px] shadow-sm transition-colors flex items-center gap-1.5 cursor-pointer">

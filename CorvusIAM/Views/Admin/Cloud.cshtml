@model IEnumerable<CorvusIAM.Entities.DispositivoRede>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Saúde de Dispositivos & Infraestrutura";
    var dispositivos = Model?.ToList() ?? new List<CorvusIAM.Entities.DispositivoRede>();
    var total = dispositivos.Count;
    var estacoes = dispositivos.Count(d => d.Tipo == "estacoes");
    var servidores = dispositivos.Count(d => d.Tipo == "servidores");
    var saudaveis = dispositivos.Count(d => d.Status == "Saudavel" && !d.IsoladoRede);
    var atencao = dispositivos.Count(d => d.Status != "Saudavel" || d.IsoladoRede);
}

<div class="mb-[24px] flex flex-col sm:flex-row sm:justify-between sm:items-end gap-3">
    <div>
        <h1 class="text-[16px] font-[600] text-gray-900 dark:text-white flex items-center gap-2">
            <i class="ph ph-desktop text-brand-500"></i> Infraestrutura & Saúde de Dispositivos (Endpoints / DevOps)
        </h1>
        <p class="text-[12px] text-gray-500 dark:text-gray-400 mt-1">Varredura contínua de computadores na rede corporativa, telemetria de recursos e conformidade EDR</p>
    </div>
    <div class="flex gap-2">
        <button onclick="remediarTodosLote()" class="bg-orange-600 hover:bg-orange-700 text-white text-[12px] font-medium px-3 py-1.5 rounded-[6px] shadow-sm transition-colors flex items-center gap-1.5 cursor-pointer">
            <i class="ph ph-wrench"></i> Corrigir Alertas em Lote
        </button>
        <button onclick="executarVarreduraGlobal()" id="btnVarreduraGlobal" class="bg-brand-600 hover:bg-[#1D4ED8] text-white text-[12px] font-medium px-3 py-1.5 rounded-[6px] shadow-sm transition-colors flex items-center gap-1.5 cursor-pointer">
            <i class="ph ph-radar"></i> Escanear Toda a Rede
        </button>
    </div>
</div>

<!-- KPI Cards -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-[24px] mb-[24px]">
    <div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[20px] flex flex-col justify-between relative overflow-hidden">
        <div class="absolute -top-[24px] -right-[24px] w-[96px] h-[96px] bg-brand-500/10 blur-[32px] rounded-full pointer-events-none"></div>
        <div class="text-[11px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em] flex justify-between items-center mb-3">
            Computadores na Rede
            <i class="ph ph-devices text-brand-500 text-[18px]"></i>
        </div>
        <div>
            <div class="text-[28px] font-[700] text-gray-900 dark:text-white leading-[1]" id="kpiTotalDevices">@total</div>
            <div class="text-[11px] text-gray-500 mt-1">@estacoes Estações • @servidores Servidores</div>
        </div>
    </div>

    <div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[20px] flex flex-col justify-between relative overflow-hidden">
        <div class="absolute -top-[24px] -right-[24px] w-[96px] h-[96px] bg-emerald-500/10 blur-[32px] rounded-full pointer-events-none"></div>
        <div class="text-[11px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em] flex justify-between items-center mb-3">
            100% Saudáveis
            <i class="ph ph-check-circle text-emerald-500 text-[18px]"></i>
        </div>
        <div>
            <div class="text-[28px] font-[700] text-emerald-500 leading-[1]" id="kpiHealthyDevices">@saudaveis</div>
            <div class="text-[11px] text-emerald-600 dark:text-emerald-400 mt-1 font-medium">Sem vulnerabilidades ativas</div>
        </div>
    </div>

    <div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[20px] flex flex-col justify-between relative overflow-hidden">
        <div class="absolute -top-[24px] -right-[24px] w-[96px] h-[96px] bg-orange-500/10 blur-[32px] rounded-full pointer-events-none"></div>
        <div class="text-[11px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em] flex justify-between items-center mb-3">
            Requerem Atenção
            <i class="ph ph-warning text-orange-500 text-[18px]"></i>
        </div>
        <div>
            <div class="text-[28px] font-[700] text-orange-500 leading-[1]" id="kpiWarningDevices">@atencao</div>
            <div class="text-[11px] text-orange-600 dark:text-orange-400 mt-1 font-medium">Patches ou recursos críticos</div>
        </div>
    </div>

    <div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[20px] flex flex-col justify-between relative overflow-hidden">
        <div class="absolute -top-[24px] -right-[24px] w-[96px] h-[96px] bg-blue-500/10 blur-[32px] rounded-full pointer-events-none"></div>
        <div class="text-[11px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em] flex justify-between items-center mb-3">
            Latência de Rede
            <i class="ph ph-wifi-high text-blue-500 text-[18px]"></i>
        </div>
        <div>
            <div class="text-[28px] font-[700] text-gray-900 dark:text-white leading-[1]">3.8 ms</div>
            <div class="text-[11px] text-blue-600 dark:text-blue-400 mt-1 font-medium">VLAN Corporativa 1 Gbps</div>
        </div>
    </div>
</div>

<!-- Painel de Análise do Agente & Diagnóstico -->
<div class="bento-card bg-amber-500/5 border border-amber-500/20 rounded-[6px] p-[20px] mb-[24px]">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div class="flex items-start gap-3">
            <div class="p-2 rounded bg-amber-500/10 text-amber-500">
                <i class="ph ph-robot text-[24px]"></i>
            </div>
            <div>
                <h3 class="text-[13px] font-[600] text-gray-900 dark:text-white m-0">Diagnóstico Preditivo do Agente CorvusSec</h3>
                <p class="text-[12px] text-gray-600 dark:text-gray-400 mt-0.5" id="aiDiagText">
                    @if (atencao > 0)
                    {
                        <span>Identificados <b>@atencao computadores requerendo atenção</b> na rede corporativa. Recomenda-se aplicar patches e otimizar discos.</span>
                    }
                    else
                    {
                        <span class="text-emerald-500 font-semibold">Excelente! Todos os 18 dispositivos da rede corporativa estão 100% saudáveis e em total conformidade.</span>
                    }
                </p>
            </div>
        </div>
        <button onclick="remediarTodosLote()" class="whitespace-nowrap px-3 py-1.5 bg-amber-600 hover:bg-amber-700 text-white rounded text-[11px] font-medium transition-colors cursor-pointer self-start sm:self-auto">
            Aplicar Correções
        </button>
    </div>
</div>

<!-- Tabela de Máquinas e Telemetria -->
<div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] flex flex-col overflow-hidden">
    <div class="p-[16px] border-b border-gray-100 dark:border-dark-border bg-gray-50 dark:bg-dark-bg/50 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
        <div>
            <h3 class="text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em] m-0">Inventário de Dispositivos e Telemetria em Tempo Real</h3>
        </div>
        <div class="flex gap-1.5" id="filterTabs">
            <button onclick="filtrarDispositivos('todos')" id="tab-todos" class="tab-btn px-2.5 py-1 text-[11px] font-medium rounded bg-brand-600 text-white transition-colors cursor-pointer">Todos (@total)</button>
            <button onclick="filtrarDispositivos('atencao')" id="tab-atencao" class="tab-btn px-2.5 py-1 text-[11px] font-medium rounded text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-dark-border transition-colors cursor-pointer">Requer Atenção (@atencao)</button>
            <button onclick="filtrarDispositivos('estacoes')" id="tab-estacoes" class="tab-btn px-2.5 py-1 text-[11px] font-medium rounded text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-dark-border transition-colors cursor-pointer">Estações (@estacoes)</button>
            <button onclick="filtrarDispositivos('servidores')" id="tab-servidores" class="tab-btn px-2.5 py-1 text-[11px] font-medium rounded text-gray-600 dark:text-gray-400 hover:bg-gray-100 dark:hover:bg-dark-border transition-colors cursor-pointer">Servidores (@servidores)</button>
        </div>
    </div>
    
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse" id="tabelaEndpoints">
            <thead>
                <tr class="border-b border-gray-200 dark:border-dark-border bg-gray-50 dark:bg-dark-bg/50 text-[11px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                    <th class="px-4 py-3">Dispositivo / Host</th>
                    <th class="px-4 py-3">IP & Rede</th>
                    <th class="px-4 py-3">Sistema Operacional</th>
                    <th class="px-4 py-3">Consumo de Recursos</th>
                    <th class="px-4 py-3">EDR / Antivírus</th>
                    <th class="px-4 py-3">Patches & Segurança</th>
                    <th class="px-4 py-3">Status</th>
                    <th class="px-4 py-3 text-right">Ações Rápidas</th>
                </tr>
            </thead>
            <tbody id="endpointTbody">
                @foreach (var dev in dispositivos)
                {
                    var statusFilter = (dev.Status != "Saudavel" || dev.IsoladoRede) ? "atencao" : "saudavel";
                    var iconClass = dev.Tipo == "servidores" ? "ph-hard-drives text-brand-500" : "ph-laptop text-brand-500";
                    var maxUsage = Math.Max(dev.CpuUsoPercentual, Math.Max(dev.RamUsoPercentual, dev.DiscoUsoPercentual));
                    var barColor = maxUsage > 85 ? "bg-orange-500" : "bg-emerald-500";
                    <tr class="device-row border-b border-gray-100 dark:border-dark-border hover:bg-gray-50 dark:hover:bg-[#1B1F24] transition-colors" data-type="@dev.Tipo" data-status="@statusFilter" id="row-@dev.Hostname">
                        <td class="px-4 py-3">
                            <div class="font-[600] text-[13px] text-gray-900 dark:text-gray-100 flex items-center gap-1.5">
                                <i class="ph @iconClass"></i> @dev.Hostname
                            </div>
                            <div class="text-[11px] text-gray-400">Usuário: @(dev.UsuarioResponsavel ?? "Automático")</div>
                        </td>
                        <td class="px-4 py-3 text-[12px] font-mono text-gray-600 dark:text-gray-400">
                            @dev.Ip <br><span class="text-[10px] text-gray-400">@(dev.Vlan ?? "VLAN Corporativa")</span>
                        </td>
                        <td class="px-4 py-3 text-[12px] text-gray-700 dark:text-gray-300">
                            @(dev.SistemaOperacional ?? "Linux / Windows")
                        </td>
                        <td class="px-4 py-3 text-[11px]">
                            <div class="flex items-center justify-between text-gray-500 mb-1">
                                <span>CPU: @dev.CpuUsoPercentual%</span> 
                                <span class="@(dev.RamUsoPercentual > 85 ? "text-orange-500 font-bold" : "")">RAM: @dev.RamUsoPercentual%</span> 
                                <span class="@(dev.DiscoUsoPercentual > 85 ? "text-red-500 font-bold" : "")">Disco: @dev.DiscoUsoPercentual%</span>
                            </div>
                            <div class="w-28 h-1.5 bg-gray-200 dark:bg-dark-bg rounded-full overflow-hidden">
                                <div class="w-[@dev.RamUsoPercentual%] h-full @barColor"></div>
                            </div>
                        </td>
                        <td class="px-4 py-3">
                            @if (dev.EdrAtivo && dev.EdrStatus != "Assinatura Antiga")
                            {
                                <span class="inline-flex items-center gap-1 text-[11px] font-medium text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">
                                    <i class="ph ph-shield-check"></i> @(dev.EdrStatus ?? "EDR Ativo")
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1 text-[11px] font-medium text-orange-600 dark:text-orange-400 bg-orange-500/10 px-2 py-0.5 rounded border border-orange-500/20">
                                    <i class="ph ph-warning-circle"></i> @(dev.EdrStatus ?? "Assinatura Antiga")
                                </span>
                            }
                        </td>
                        <td class="px-4 py-3">
                            @if (dev.PatchesPendentes > 0)
                            {
                                <span class="inline-flex items-center gap-1 text-[11px] font-medium text-orange-600 dark:text-orange-400 bg-orange-500/10 px-2 py-0.5 rounded border border-orange-500/20">
                                    <i class="ph ph-warning"></i> @dev.PatchesPendentes Patches Pendentes
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1 text-[11px] font-medium text-emerald-600 dark:text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">
                                    <i class="ph ph-check"></i> Atualizado
                                </span>
                            }
                        </td>
                        <td class="px-4 py-3">
                            @if (dev.IsoladoRede)
                            {
                                <span class="inline-flex items-center gap-1 text-[11px] font-bold text-red-500 bg-red-500/10 px-2 py-0.5 rounded">
                                    <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span> Isolado
                                </span>
                            }
                            else if (dev.Status == "Critico")
                            {
                                <span class="inline-flex items-center gap-1 text-[11px] font-bold text-red-500 bg-red-500/10 px-2 py-0.5 rounded">
                                    <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span> Crítico
                                </span>
                            }
                            else if (dev.Status == "Alerta")
                            {
                                <span class="inline-flex items-center gap-1 text-[11px] font-bold text-orange-500 bg-orange-500/10 px-2 py-0.5 rounded">
                                    <span class="w-1.5 h-1.5 rounded-full bg-orange-500 animate-pulse"></span> Alerta
                                </span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1 text-[11px] font-bold text-emerald-500 bg-emerald-500/10 px-2 py-0.5 rounded">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span> Saudável
                                </span>
                            }
                        </td>
                        <td class="px-4 py-3 text-right">
                            <div class="flex justify-end gap-1">
                                <button onclick="escanearDispositivo('@dev.Hostname')" class="px-2 py-1 bg-brand-50 hover:bg-brand-100 dark:bg-brand-900/20 dark:hover:bg-brand-900/30 text-brand-600 dark:text-brand-400 text-xs rounded transition-colors cursor-pointer" title="Escanear">Escanear</button>
                                @if (dev.PatchesPendentes > 0)
                                {
                                    <button onclick="aplicarPatchesDispositivo('@dev.Hostname')" class="px-2 py-1 bg-emerald-50 hover:bg-emerald-100 dark:bg-emerald-900/20 dark:hover:bg-emerald-900/30 text-emerald-600 dark:text-emerald-400 text-xs rounded transition-colors cursor-pointer" title="Aplicar Patches">Atualizar</button>
                                }
                                @if (dev.Tipo == "servidores" && dev.DiscoUsoPercentual > 70)
                                {
                                    <button onclick="limparDiscoServidor('@dev.Hostname')" class="px-2 py-1 bg-amber-50 hover:bg-amber-100 dark:bg-amber-900/20 dark:hover:bg-amber-900/30 text-amber-600 dark:text-amber-400 text-xs rounded transition-colors cursor-pointer" title="Limpar Logs">Limpar</button>
                                }
                                <button onclick="isolarDispositivo('@dev.Hostname', this)" class="px-2 py-1 @(dev.IsoladoRede ? "bg-gray-700 text-white" : "bg-red-50 hover:bg-red-100 dark:bg-red-900/20 dark:hover:bg-red-900/30 text-red-600 dark:text-red-400") text-xs rounded transition-colors cursor-pointer" title="@(dev.IsoladoRede ? "Liberar da Quarentena" : "Isolar da Rede")">@(dev.IsoladoRede ? "Liberar" : "Isolar")</button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        function filtrarDispositivos(tipo) {
            document.querySelectorAll('.tab-btn').forEach(b => {
                b.classList.remove('bg-brand-600', 'text-white');
                b.classList.add('text-gray-600', 'dark:text-gray-400');
            });
            const activeTab = document.getElementById(`tab-${tipo}`);
            if (activeTab) {
                activeTab.classList.remove('text-gray-600', 'dark:text-gray-400');
                activeTab.classList.add('bg-brand-600', 'text-white');
            }

            const rows = document.querySelectorAll('.device-row');
            rows.forEach(r => {
                const rowType = r.getAttribute('data-type');
                const rowStatus = r.getAttribute('data-status');
                if (tipo === 'todos') {
                    r.style.display = '';
                } else if (tipo === 'atencao') {
                    r.style.display = (rowStatus === 'atencao') ? '' : 'none';
                } else if (tipo === 'estacoes') {
                    r.style.display = (rowType === 'estacoes') ? '' : 'none';
                } else if (tipo === 'servidores') {
                    r.style.display = (rowType === 'servidores') ? '' : 'none';
                }
            });
        }

        async function escanearDispositivo(host) {
            Swal.fire({
                title: `Escaneando ${host}...`,
                html: '<div class="text-xs text-gray-400">Verificando integridade de arquivos, processos em execução e portas abertas...</div>',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading(),
                background: '#121418', color: '#fff'
            });

            try {
                await fetch('/Admin/ExecutarAcaoEndpoint', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getCsrfToken() },
                    body: JSON.stringify({ Hostname: host, Acao: 'Scan' })
                });

                setTimeout(() => {
                    Swal.fire({
                        title: 'Varredura Concluída!',
                        html: `O host <b>${host}</b> foi verificado com sucesso pelo agente local.<br><br><span class="text-emerald-400 text-xs font-mono">0 malwares encontrados • Assinaturas EDR atualizadas</span>`,
                        icon: 'success',
                        background: '#121418', color: '#fff', confirmButtonColor: '#3B82F6'
                    });
                }, 1200);
            } catch(e) {
                Swal.fire({ title: 'Erro!', text: 'Falha de comunicação com o agente remoto.', icon: 'error', background: '#121418', color: '#fff' });
            }
        }

        async function aplicarPatchesDispositivo(host) {
            const res = await Swal.fire({
                title: `Aplicar Atualizações em ${host}?`,
                text: 'Serão aplicados os patches de segurança do Windows Defender e atualizações críticas de SO.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#10b981',
                confirmButtonText: 'Instalar Patches Agora',
                cancelButtonText: 'Cancelar',
                background: '#121418', color: '#fff'
            });

            if(res.isConfirmed) {
                Swal.fire({
                    title: 'Instalando Patches...',
                    html: '<div class="text-xs text-gray-400">Baixando KBs assinadas e aplicando sem reiniciar...</div>',
                    allowOutsideClick: false,
                    didOpen: () => Swal.showLoading(),
                    background: '#121418', color: '#fff'
                });

                await fetch('/Admin/ExecutarAcaoEndpoint', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getCsrfToken() },
                    body: JSON.stringify({ Hostname: host, Acao: 'Patch' })
                });

                setTimeout(() => {
                    Swal.fire({
                        title: 'Patches Aplicados!',
                        text: `Host ${host} atualizado com êxito. Sistema em total conformidade.`,
                        icon: 'success',
                        background: '#121418', color: '#fff', confirmButtonColor: '#3B82F6'
                    }).then(() => window.location.reload());
                }, 1500);
            }
        }

        async function isolarDispositivo(host, btn) {
            const estaIsolado = btn.classList.contains('bg-gray-700');
            const acao = estaIsolado ? 'Liberar' : 'Isolar';

            const confirm = await Swal.fire({
                title: `${acao} ${host} da Rede?`,
                html: estaIsolado ? `Reestabelecer acesso de rede corporativa para <b>${host}</b>?` : `Isolar <b>${host}</b> preventivamente da rede local e internet? Apenas tráfego seguro de gerenciamento será mantido.`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: estaIsolado ? '#10b981' : '#ef4444',
                confirmButtonText: `Sim, ${acao}`,
                cancelButtonText: 'Cancelar',
                background: '#121418', color: '#fff'
            });

            if (confirm.isConfirmed) {
                await fetch('/Admin/ExecutarAcaoEndpoint', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getCsrfToken() },
                    body: JSON.stringify({ Hostname: host, Acao: estaIsolado ? 'Reconnect' : 'Isolate' })
                });

                if (!estaIsolado) {
                    btn.classList.remove('bg-red-50', 'text-red-600');
                    btn.classList.add('bg-gray-700', 'text-white');
                    btn.innerText = 'Liberar';
                    Swal.fire({ title: 'Dispositivo Isolado!', text: `${host} foi colocado em quarentena de rede.`, icon: 'warning', background: '#121418', color: '#fff' });
                } else {
                    btn.classList.remove('bg-gray-700', 'text-white');
                    btn.classList.add('bg-red-50', 'text-red-600');
                    btn.innerText = 'Isolar';
                    Swal.fire({ title: 'Acesso Restaurado!', text: `${host} reconectado à rede.`, icon: 'success', background: '#121418', color: '#fff' });
                }
            }
        }

        async function limparDiscoServidor(host) {
            Swal.fire({
                title: `Limpando arquivos temporários e logs em ${host}...`,
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading(),
                background: '#121418', color: '#fff'
            });

            await fetch('/Admin/ExecutarAcaoEndpoint', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getCsrfToken() },
                body: JSON.stringify({ Hostname: host, Acao: 'CleanDisk' })
            });

            setTimeout(() => {
                Swal.fire({
                    title: 'Disco Otimizado!',
                    html: `Foram liberados <b>18.4 GB</b> de logs de depuração antigos em <b>${host}</b>.<br><span class="text-emerald-400 font-mono text-xs">Uso de disco reduzido para 54%.</span>`,
                    icon: 'success',
                    background: '#121418', color: '#fff', confirmButtonColor: '#3B82F6'
                }).then(() => window.location.reload());
            }, 1200);
        }

        async function reiniciarAgente(host) {
            Swal.fire({
                title: `Reiniciando Agente em ${host}...`,
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading(),
                background: '#121418', color: '#fff'
            });

            await fetch('/Admin/ExecutarAcaoEndpoint', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getCsrfToken() },
                body: JSON.stringify({ Hostname: host, Acao: 'RestartAgent' })
            });

            setTimeout(() => {
                Swal.fire({
                    title: 'Agente Reiniciado!',
                    text: `O serviço daemon de telemetria em ${host} foi reiniciado e está operacional.`,
                    icon: 'success',
                    background: '#121418', color: '#fff', confirmButtonColor: '#3B82F6'
                });
            }, 1000);
        }

        async function executarVarreduraGlobal() {
            const btn = document.getElementById('btnVarreduraGlobal');
            btn.disabled = true;
            btn.innerHTML = '<i class="ph ph-spinner-gap animate-spin"></i> Escaneando Rede...';

            Swal.fire({
                title: 'Varredura Global de Endpoints',
                html: 'Enviando pulsos de telemetria para 18 computadores e servidores conectados...',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading(),
                background: '#121418', color: '#fff'
            });

            await fetch('/Admin/ExecutarAcaoEndpoint', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getCsrfToken() },
                body: JSON.stringify({ Hostname: 'ALL_NETWORK', Acao: 'GlobalNetworkScan' })
            });

            setTimeout(() => {
                btn.disabled = false;
                btn.innerHTML = '<i class="ph ph-radar"></i> Escanear Toda a Rede';
                Swal.fire({
                    title: 'Varredura Concluída!',
                    html: 'Todos os <b>18 dispositivos</b> responderam à checagem.<br><br>15 saudáveis • 3 com avisos de patch/recursos.',
                    icon: 'success',
                    background: '#121418', color: '#fff', confirmButtonColor: '#3B82F6'
                });
            }, 1800);
        }

        async function remediarTodosLote() {
            const res = await Swal.fire({
                title: 'Remediação Automática em Lote?',
                html: 'O CorvusSec irá:<br>1. Instalar patches pendentes nas máquinas de alerta.<br>2. Purgar logs acumulados no servidor de API.<br>3. Atualizar as definições de antivírus da WS-RH-01.',
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#f97316',
                confirmButtonText: 'Executar Correções',
                cancelButtonText: 'Cancelar',
                background: '#121418', color: '#fff'
            });

            if (res.isConfirmed) {
                Swal.fire({
                    title: 'Remediando em Lote...',
                    html: '<div class="text-xs text-gray-400">Aplicando correções remotas...</div>',
                    allowOutsideClick: false,
                    didOpen: () => Swal.showLoading(),
                    background: '#121418', color: '#fff'
                });

                await fetch('/Admin/ExecutarAcaoEndpoint', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getCsrfToken() },
                    body: JSON.stringify({ Hostname: 'BATCH_REMEDIATION', Acao: 'BatchRemediate' })
                });

                setTimeout(() => {
                    Swal.fire({
                        title: 'Tudo Otimizado!',
                        text: 'Todas as 3 máquinas foram atualizadas e o ambiente está 100% verde!',
                        icon: 'success',
                        background: '#121418', color: '#fff', confirmButtonColor: '#3B82F6'
                    }).then(() => window.location.reload());
                }, 2000);
            }
        }
    </script>
}

@model IEnumerable<CorvusIAM.Entities.PoliticaAcesso>
@{
    Layout = "_Layout";
    ViewData["Title"] = "Políticas de Acesso";
}

<div class="mb-[24px] flex justify-between items-end">
    <div>
        <h1 class="text-[16px] font-[600] text-gray-900 dark:text-white flex items-center gap-2">
            <i class="ph ph-shield-check text-brand-500"></i> Políticas de Acesso (IAM)
        </h1>
        <p class="text-[12px] text-gray-500 dark:text-gray-400 mt-1">Configurações de segurança e regras do Single Sign-On</p>
    </div>
    <button onclick="openModal('newPolModal')" class="bg-brand-600 hover:bg-[#1D4ED8] text-white text-[12px] font-medium px-3 py-1.5 rounded-[6px] shadow-sm transition-colors flex items-center gap-1.5">
        <i class="ph ph-plus"></i> Nova Política
    </button>
</div>

<div class="grid grid-cols-1 md:grid-cols-3 gap-4 md:gap-[24px]">
    @if(!Model.Any()) {
        <div class="col-span-3 text-[13px] text-gray-500 dark:text-gray-400 p-[24px] bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px]">
            Nenhuma política cadastrada.
        </div>
    }
    @foreach(var p in Model) {
        <div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[24px] flex flex-col hover:-translate-y-0.5 transition-transform">
            <div class="flex justify-between items-start mb-4">
                <h3 class="text-[14px] font-[600] text-gray-900 dark:text-white flex items-center gap-2 m-0">
                    <i class="ph ph-shield text-brand-500 text-[18px]"></i> @p.Nome
                </h3>
                @if(p.Ativa) {
                    <span class="bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border border-emerald-500/20 px-2 py-0.5 rounded-[4px] text-[10px] font-[600] tracking-wider uppercase">
                        Ativa
                    </span>
                } else {
                    <span class="bg-gray-500/10 text-gray-600 dark:text-gray-400 border border-gray-500/20 px-2 py-0.5 rounded-[4px] text-[10px] font-[600] tracking-wider uppercase">
                        Inativa
                    </span>
                }
            </div>
            <p class="text-[12px] text-gray-600 dark:text-gray-400 leading-relaxed m-0 flex-1">@p.Descricao</p>
        </div>
    }
</div>

<!-- Modal Overlay -->
<div id="modalOverlay" class="fixed inset-0 bg-black/80 z-[100] hidden items-center justify-center p-4 backdrop-blur-sm transition-opacity">
    <div id="newPolModal" class="hidden bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] shadow-2xl w-full max-w-lg overflow-hidden flex-col">
        <div class="px-6 py-4 border-b border-gray-200 dark:border-dark-border flex justify-between items-center bg-gray-50 dark:bg-dark-bg/50">
            <h3 class="text-[14px] font-[600] text-gray-900 dark:text-white flex items-center gap-2 m-0">
                <i class="ph ph-shield-check text-brand-500"></i> Nova Política
            </h3>
            <div class="flex items-center gap-3">
                <button type="button" onclick="sugerirIA()" class="text-[11px] px-2 py-1 bg-brand-500/10 text-brand-600 dark:text-brand-400 border border-brand-500/30 rounded-[4px] hover:bg-brand-500/20 transition-colors flex items-center gap-1">
                    <i class="ph ph-robot"></i> Gerar com IA
                </button>
                <button onclick="closeModal()" class="text-gray-500 hover:text-gray-900 dark:hover:text-white transition-colors">
                    <i class="ph ph-x text-[16px]"></i>
                </button>
            </div>
        </div>
        <div class="p-6">
            <form onsubmit="adicionarPol(event)" class="space-y-4">
                <input type="text" id="pnome" placeholder="Nome da Regra (ex: Bloqueio Geográfico)" required class="w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[13px] rounded-[6px] px-3 py-2 outline-none focus:border-brand-500" />
                <textarea id="pdesc" placeholder="Descrição completa..." required class="w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[13px] rounded-[6px] px-3 py-2 h-24 resize-none outline-none focus:border-brand-500"></textarea>
                
                <div class="flex justify-end gap-3 pt-4 border-t border-gray-200 dark:border-dark-border mt-4">
                    <button type="button" onclick="closeModal()" class="px-4 py-2 text-[12px] font-medium text-gray-700 dark:text-gray-300 border border-gray-300 dark:border-dark-border rounded-[6px] hover:bg-gray-50 dark:hover:bg-[#1B1F24] transition-colors">Cancelar</button>
                    <button type="submit" class="px-4 py-2 text-[12px] font-medium text-white bg-brand-600 rounded-[6px] hover:bg-[#1D4ED8] transition-colors">Salvar Regra</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function openModal(id) { 
            const overlay = document.getElementById('modalOverlay');
            overlay.classList.remove('hidden');
            overlay.classList.add('flex');
            
            document.getElementById('newPolModal').classList.add('hidden');
            
            const modal = document.getElementById(id);
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }
        
        function closeModal() { 
            const overlay = document.getElementById('modalOverlay');
            overlay.classList.add('hidden');
            overlay.classList.remove('flex');
        }

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeModal();
        });

        async function adicionarPol(e) {
            e.preventDefault();
            const payload = { Nome: document.getElementById('pnome').value, Descricao: document.getElementById('pdesc').value };
            const res = await fetch('/Admin/AdicionarPolitica', { 
                method: 'POST', 
                headers: { 
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                }, 
                body: JSON.stringify(payload) 
            });
            if(res.ok) {
                window.location.reload();
            } else {
                Swal.fire({ title: 'Erro!', text: 'Falha ao salvar política.', icon: 'error', background: '#121418', color: '#fff', confirmButtonColor: '#3B82F6' });
            }
        }

        function sugerirIA() {
            const politicas = [
                { nome: "Zero Trust Interno", desc: "Acesso a sistemas sensíveis exige re-autenticação MFA mesmo dentro da rede local." },
                { nome: "Sessão Ociosa (ERP)", desc: "Força logoff automático após 15 minutos sem interação nos módulos financeiros." },
                { nome: "Alerta de Invasão", desc: "Bloqueia o IP e notifica o administrador via SMS após 3 falhas de login consecutivas." }
            ];
            const pol = politicas[Math.floor(Math.random() * politicas.length)];
            
            const nomeInput = document.getElementById('pnome');
            const descInput = document.getElementById('pdesc');
            
            // Add a little visual feedback
            nomeInput.classList.add('ring-2', 'ring-brand-500', 'transition-all');
            descInput.classList.add('ring-2', 'ring-brand-500', 'transition-all');
            
            nomeInput.value = pol.nome;
            descInput.value = pol.desc;
            
            setTimeout(() => {
                nomeInput.classList.remove('ring-2', 'ring-brand-500');
                descInput.classList.remove('ring-2', 'ring-brand-500');
            }, 500);
        }
    </script>
}

@{
    Layout = "_Layout";
    ViewData["Title"] = "Contabilidade & Financeiro";
}

<div class="mb-[24px]">
    <h1 class="text-[16px] font-[600] text-gray-900 dark:text-white flex items-center gap-2">
        <i class="ph ph-calculator text-brand-500"></i> Contabilidade & Financeiro
    </h1>
    <p class="text-[12px] text-gray-500 dark:text-gray-400 mt-1">Balanços, NFs e Fluxo de Caixa</p>
</div>

<div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[24px]">
    <h3 class="text-[14px] font-[600] text-gray-900 dark:text-white mb-2 m-0">Painel Contábil</h3>
    <p class="text-[13px] text-gray-600 dark:text-gray-400 mb-6 m-0">Acesso restrito a relatórios financeiros e aprovação de pagamentos.</p>
    
    <div class="flex gap-3">
        <button class="bg-brand-600 hover:bg-[#1D4ED8] text-white text-[12px] font-medium px-4 py-2 rounded-[6px] shadow-sm transition-colors">
            Emitir NF
        </button>
        <button class="bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-700 dark:text-gray-300 text-[12px] font-medium px-4 py-2 rounded-[6px] hover:bg-gray-100 dark:hover:bg-[#1B1F24] transition-colors">
            Fechamento Mensal
        </button>
    </div>
</div>

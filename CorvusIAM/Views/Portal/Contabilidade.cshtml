@model CorvusIAM.Models.ContabilidadeViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Contabilidade & Financeiro";
}

<div class="mb-[24px] flex flex-col sm:flex-row sm:justify-between sm:items-end gap-3">
    <div>
        <h1 class="text-[16px] font-[600] text-gray-900 dark:text-white flex items-center gap-2">
            <i class="ph ph-calculator text-brand-500"></i> Contabilidade & Gestão Financeira
        </h1>
        <p class="text-[12px] text-gray-500 dark:text-gray-400 mt-1">Emissão de notas fiscais, fechamento contábil e conciliação bancária</p>
    </div>
    <div class="flex gap-2">
        <button onclick="abrirModalEmitirNF()" class="bg-brand-600 hover:bg-[#1D4ED8] text-white text-[12px] font-medium px-4 py-2 rounded-[6px] shadow-sm transition-colors flex items-center gap-1.5 cursor-pointer">
            <i class="ph ph-receipt"></i> Emitir Nova NF
        </button>
        <button onclick="executarFechamentoMensal()" class="bg-emerald-600 hover:bg-emerald-700 text-white text-[12px] font-medium px-4 py-2 rounded-[6px] shadow-sm transition-colors flex items-center gap-1.5 cursor-pointer">
            <i class="ph ph-calendar-check"></i> Fechamento Mensal
        </button>
    </div>
</div>

<!-- KPIs Financeiros & Cotações em Tempo Real (AwesomeAPI) -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-[24px] mb-[24px]">
    <div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[20px]">
        <div class="text-[11px] font-[600] text-gray-500 uppercase tracking-wider mb-2">Faturamento Consolidado</div>
        <div class="text-[26px] font-[700] text-gray-900 dark:text-white">R$ @((Model?.TotalFaturamento ?? 0).ToString("N2"))</div>
        <div class="text-[11px] text-emerald-500 mt-1 flex items-center gap-1"><i class="ph ph-trend-up"></i> Base de dados fiscal ativa</div>
    </div>
    <div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[20px]">
        <div class="text-[11px] font-[600] text-gray-500 uppercase tracking-wider mb-2">Notas Fiscais Emitidas</div>
        <div class="text-[26px] font-[700] text-gray-900 dark:text-white">@(Model?.TotalNotasEmitidas ?? 0) NFs</div>
        <div class="text-[11px] text-gray-400 mt-1">Transmitidas à SEFAZ</div>
    </div>
    <div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[20px]">
        <div class="text-[11px] font-[600] text-gray-500 uppercase tracking-wider mb-2">Cotação Dólar (USD)</div>
        <div class="text-[26px] font-[700] text-brand-500 font-mono" id="usdPrice">R$ 5.68</div>
        <div class="text-[11px] text-emerald-500 mt-1 flex items-center gap-1" id="usdChange">
            <i class="ph ph-currency-dollar"></i> AwesomeAPI / BACEN (+0.26%)
        </div>
    </div>
    <div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[20px]">
        <div class="text-[11px] font-[600] text-gray-500 uppercase tracking-wider mb-2">Cotação Euro (EUR)</div>
        <div class="text-[26px] font-[700] text-purple-500 font-mono" id="eurPrice">R$ 6.14</div>
        <div class="text-[11px] text-purple-400 mt-1 flex items-center gap-1" id="eurChange">
            <i class="ph ph-currency-eur"></i> AwesomeAPI / BACEN (-0.13%)
        </div>
    </div>
</div>

<div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[24px] mb-[24px]">
    <h3 class="text-[14px] font-[600] text-gray-900 dark:text-white mb-2 m-0">Painel Operacional Contábil</h3>
    <p class="text-[13px] text-gray-600 dark:text-gray-400 mb-6 m-0">Acesso restrito para auditoria fiscal, aprovação de despesas e geração de guias DAS/SPED.</p>
    
    <div class="flex flex-wrap gap-3">
        <button onclick="abrirModalEmitirNF()" class="bg-brand-600 hover:bg-[#1D4ED8] text-white text-[12px] font-medium px-4 py-2 rounded-[6px] shadow-sm transition-colors flex items-center gap-1.5 cursor-pointer">
            <i class="ph ph-receipt"></i> Emitir NF de Serviço
        </button>
        <button onclick="executarFechamentoMensal()" class="bg-gray-100 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-800 dark:text-gray-200 text-[12px] font-medium px-4 py-2 rounded-[6px] hover:bg-gray-200 dark:hover:bg-[#1B1F24] transition-colors flex items-center gap-1.5 cursor-pointer">
            <i class="ph ph-file-text"></i> Executar Fechamento Mensal
        </button>
        <a href="/Portal/ExportarSpedFiscal" class="bg-gray-100 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-800 dark:text-gray-200 text-[12px] font-medium px-4 py-2 rounded-[6px] hover:bg-gray-200 dark:hover:bg-[#1B1F24] transition-colors flex items-center gap-1.5 cursor-pointer no-underline">
            <i class="ph ph-download-simple"></i> Exportar SPED Fiscal (.txt)
        </a>
    </div>
</div>

<!-- Tabela de Notas Fiscais Emitidas -->
<div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] flex flex-col overflow-hidden mb-[24px]">
    <div class="p-[16px] border-b border-gray-100 dark:border-dark-border bg-gray-50 dark:bg-dark-bg/50">
        <h3 class="text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em] m-0">Histórico de Notas Fiscais (NFS-e)</h3>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="border-b border-gray-200 dark:border-dark-border bg-gray-50 dark:bg-dark-bg/50 text-[11px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                    <th class="px-4 py-3">Número</th>
                    <th class="px-4 py-3">Tomador / Cliente</th>
                    <th class="px-4 py-3">CNPJ</th>
                    <th class="px-4 py-3">Valor</th>
                    <th class="px-4 py-3">Data Emissão</th>
                    <th class="px-4 py-3">Protocolo SEFAZ</th>
                    <th class="px-4 py-3">Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model?.NotasFiscais != null && Model.NotasFiscais.Any())
                {
                    @foreach (var nf in Model.NotasFiscais)
                    {
                        <tr class="border-b border-gray-100 dark:border-dark-border hover:bg-gray-50 dark:hover:bg-[#1B1F24] text-[12px]">
                            <td class="px-4 py-3 font-mono font-bold text-gray-900 dark:text-white">NFS-e #@nf.Numero</td>
                            <td class="px-4 py-3 font-medium text-gray-800 dark:text-gray-200">@nf.TomadorNome</td>
                            <td class="px-4 py-3 font-mono text-gray-500">@nf.TomadorCnpj</td>
                            <td class="px-4 py-3 font-bold text-emerald-600 dark:text-emerald-400">R$ @nf.Valor.ToString("N2")</td>
                            <td class="px-4 py-3 text-gray-500">@nf.DataEmissao.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="px-4 py-3 font-mono text-[11px] text-gray-400">@nf.ProtocoloSefaz</td>
                            <td class="px-4 py-3">
                                <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-500 text-[10px] font-semibold border border-emerald-500/20">
                                    @nf.Status
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="px-4 py-4 text-center text-gray-500 text-xs">Nenhuma nota fiscal emitida ainda.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        async function consultarCnpjModal() {
            const cnpjInput = document.getElementById('nfCnpj');
            const tomadorInput = document.getElementById('nfTomador');
            const statusDiv = document.getElementById('cnpjStatusBadge');
            const clean = (cnpjInput.value || '').replace(/\D/g, '');
            if (clean.length !== 14) {
                statusDiv.innerHTML = '<span class="text-orange-400">Digite os 14 dígitos do CNPJ para pesquisar.</span>';
                return;
            }
            statusDiv.innerHTML = '<span class="text-brand-400"><i class="ph ph-spinner-gap animate-spin"></i> Consultando BrasilAPI / Receita...</span>';
            try {
                const res = await fetch(`/api/public/cnpj/${clean}`);
                if (res.ok) {
                    const data = await res.json();
                    tomadorInput.value = data.razao_social || data.nome_fantasia || '';
                    statusDiv.innerHTML = `<span class="text-emerald-400">✓ Localizado: <b>${data.municipio || 'SP'}/${data.uf || 'SP'}</b> • Simples: ${data.opcao_pelo_simples ? 'Optante' : 'Não'}</span>`;
                } else {
                    statusDiv.innerHTML = '<span class="text-red-400">CNPJ não encontrado na base pública.</span>';
                }
            } catch(e) {
                statusDiv.innerHTML = '<span class="text-yellow-400">Falha ao conectar com a API pública.</span>';
            }
        }

        async function carregarCotacoesAoVivo() {
            try {
                const res = await fetch('/api/public/cotacoes');
                if (res.ok) {
                    const data = await res.json();
                    if (data.USDBRL) {
                        document.getElementById('usdPrice').innerText = 'R$ ' + parseFloat(data.USDBRL.bid).toFixed(2);
                        const pct = parseFloat(data.USDBRL.pctChange);
                        document.getElementById('usdChange').innerHTML = `<i class="ph ph-currency-dollar"></i> AwesomeAPI / BACEN (${pct >= 0 ? '+' : ''}${pct.toFixed(2)}%)`;
                    }
                    if (data.EURBRL) {
                        document.getElementById('eurPrice').innerText = 'R$ ' + parseFloat(data.EURBRL.bid).toFixed(2);
                        const pctE = parseFloat(data.EURBRL.pctChange);
                        document.getElementById('eurChange').innerHTML = `<i class="ph ph-currency-eur"></i> AwesomeAPI / BACEN (${pctE >= 0 ? '+' : ''}${pctE.toFixed(2)}%)`;
                    }
                }
            } catch(e) {}
        }
        window.addEventListener('DOMContentLoaded', carregarCotacoesAoVivo);

        async function abrirModalEmitirNF() {
            const { value: formValues } = await Swal.fire({
                title: 'Emissão de Nota Fiscal de Serviço (NFS-e)',
                html: `
                    <div class="text-left space-y-3">
                        <div>
                            <label class="text-xs text-gray-400 block mb-1">CNPJ do Tomador (com consulta automática)</label>
                            <div class="flex gap-2">
                                <input id="nfCnpj" placeholder="00.000.000/0001-00" maxlength="18" class="swal2-input !m-0 !w-full bg-gray-900 text-white text-xs">
                                <button type="button" onclick="consultarCnpjModal()" class="px-3 bg-brand-600 hover:bg-brand-700 text-white text-xs rounded font-medium whitespace-nowrap cursor-pointer">
                                    <i class="ph ph-magnifying-glass"></i> Buscar CNPJ
                                </button>
                            </div>
                            <div id="cnpjStatusBadge" class="text-[11px] mt-1 font-mono"></div>
                        </div>
                        <div>
                            <label class="text-xs text-gray-400 block mb-1">Razão Social / Tomador</label>
                            <input id="nfTomador" placeholder="Preenchido automaticamente ou manual" class="swal2-input !m-0 !w-full bg-gray-900 text-white text-xs">
                        </div>
                        <div>
                            <label class="text-xs text-gray-400 block mb-1">Valor dos Serviços (R$)</label>
                            <input id="nfValor" type="number" placeholder="5500.00" class="swal2-input !m-0 !w-full bg-gray-900 text-white text-xs">
                        </div>
                        <div>
                            <label class="text-xs text-gray-400 block mb-1">Discriminação dos Serviços</label>
                            <textarea id="nfDesc" placeholder="Prestação de serviços de segurança da informação e gestão de identidades IAM..." class="swal2-textarea !m-0 !w-full bg-gray-900 text-white text-xs h-16"></textarea>
                        </div>
                    </div>
                `,
                showCancelButton: true,
                confirmButtonColor: '#3B82F6',
                confirmButtonText: 'Autorizar e Transmitir à SEFAZ',
                cancelButtonText: 'Cancelar',
                background: '#121418', color: '#fff',
                didOpen: () => {
                    const cnpjEl = document.getElementById('nfCnpj');
                    cnpjEl.addEventListener('input', (e) => {
                        let v = e.target.value.replace(/\D/g,"");
                        v = v.replace(/^(\d{2})(\d)/,"$1.$2");
                        v = v.replace(/^(\d{2})\.(\d{3})(\d)/,"$1.$2.$3");
                        v = v.replace(/\.(\d{3})(\d)/,".$1/$2");
                        v = v.replace(/(\d{4})(\d)/,"$1-$2");
                        e.target.value = v;
                        if (v.replace(/\D/g, '').length === 14) {
                            consultarCnpjModal();
                        }
                    });
                },
                preConfirm: () => {
                    const tomador = document.getElementById('nfTomador').value;
                    const cnpj = document.getElementById('nfCnpj').value;
                    const valor = document.getElementById('nfValor').value;
                    const desc = document.getElementById('nfDesc').value;
                    if (!tomador || !valor || parseFloat(valor) <= 0) {
                        Swal.showValidationMessage('Preencha ao menos o Tomador e um Valor válido.');
                    }
                    return { TomadorNome: tomador, TomadorCnpj: cnpj, Valor: parseFloat(valor), Descricao: desc };
                }
            });

            if (formValues) {
                Swal.fire({
                    title: 'Transmitindo Nota Fiscal...',
                    html: '<div class="text-xs text-gray-400">Assinando digitalmente com certificado A1 e comunicando com a Prefeitura...</div>',
                    allowOutsideClick: false,
                    didOpen: () => Swal.showLoading(),
                    background: '#121418', color: '#fff'
                });

                try {
                    const res = await fetch('/Portal/EmitirNotaFiscal', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getCsrfToken() },
                        body: JSON.stringify(formValues)
                    });
                    const data = await res.json();
                    if (res.ok) {
                        Swal.fire({
                            title: 'Nota Fiscal Autorizada!',
                            html: `NFS-e Nº <b>${data.numero}</b> emitida com sucesso para <b>${data.tomador}</b>.<br><br><span class="text-emerald-400 text-xs font-mono">Protocolo SEFAZ: ${data.protocolo}<br>Valor: R$ ${parseFloat(data.valor).toFixed(2)}</span>`,
                            icon: 'success',
                            background: '#121418', color: '#fff', confirmButtonColor: '#3B82F6'
                        }).then(() => window.location.reload());
                    } else {
                        Swal.fire({ title: 'Erro!', text: data.message || 'Falha ao emitir NF.', icon: 'error', background: '#121418', color: '#fff' });
                    }
                } catch (e) {
                    Swal.fire({ title: 'Erro de Conexão', text: 'Não foi possível contatar o servidor.', icon: 'error', background: '#121418', color: '#fff' });
                }
            }
        }

        async function executarFechamentoMensal() {
            const confirm = await Swal.fire({
                title: 'Executar Fechamento Mensal?',
                text: 'Será gerado o resumo consolidado de DRE, balanço patrimonial e apuração de tributos salvos no banco.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#10b981',
                confirmButtonText: 'Iniciar Fechamento',
                cancelButtonText: 'Cancelar',
                background: '#121418', color: '#fff'
            });

            if (confirm.isConfirmed) {
                Swal.fire({
                    title: 'Consolidando Lançamentos no Banco...',
                    allowOutsideClick: false,
                    didOpen: () => Swal.showLoading(),
                    background: '#121418', color: '#fff'
                });

                try {
                    const res = await fetch('/Portal/ExecutarFechamentoMensal', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getCsrfToken() }
                    });
                    const data = await res.json();
                    if (res.ok) {
                        Swal.fire({
                            title: 'Fechamento Realizado!',
                            html: `Mês fiscal <b>${data.mes}</b> consolidado com sucesso.<br><br><b>Receita Bruta:</b> R$ ${parseFloat(data.receita).toFixed(2)}<br><b>Despesas Operacionais:</b> R$ ${parseFloat(data.despesas).toFixed(2)}<br><b>Lucro Líquido:</b> <span class="text-emerald-400 font-bold">R$ ${parseFloat(data.lucro).toFixed(2)}</span>`,
                            icon: 'success',
                            background: '#121418', color: '#fff', confirmButtonColor: '#3B82F6'
                        }).then(() => window.location.reload());
                    } else {
                        Swal.fire({ title: 'Erro!', text: data.message || 'Falha ao processar fechamento.', icon: 'error', background: '#121418', color: '#fff' });
                    }
                } catch (e) {
                    Swal.fire({ title: 'Erro de Conexão', text: 'Não foi possível contatar o servidor.', icon: 'error', background: '#121418', color: '#fff' });
                }
            }
        }
    </script>
}

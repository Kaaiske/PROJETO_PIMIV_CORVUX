@{
    Layout = "_Layout";
    ViewData["Title"] = "Central Help Desk (TI)";
}

<div class="mb-[24px]">
    <h1 class="text-[16px] font-[600] text-gray-900 dark:text-white flex items-center gap-2">
        <i class="ph ph-headset text-brand-500"></i> Central Help Desk (TI)
    </h1>
    <p class="text-[12px] text-gray-500 dark:text-gray-400 mt-1">Fila de chamados e suporte aos colaboradores</p>
</div>

<div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] flex flex-col overflow-hidden">
    <div class="p-[16px] border-b border-gray-100 dark:border-dark-border bg-gray-50 dark:bg-dark-bg/50 flex justify-between items-center">
        <h3 class="text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em] m-0">Fila de Tickets</h3>
        <button class="bg-brand-600 hover:bg-[#1D4ED8] text-white text-[12px] font-medium px-3 py-1.5 rounded-[6px] shadow-sm transition-colors flex items-center gap-1.5">
            <i class="ph ph-plus"></i> Novo Ticket
        </button>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="bg-gray-50 dark:bg-dark-bg/50 border-b border-gray-200 dark:border-dark-border">
                    <th class="px-[16px] py-[12px] text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em]">Ticket #</th>
                    <th class="px-[16px] py-[12px] text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em]">Assunto</th>
                    <th class="px-[16px] py-[12px] text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em]">Status</th>
                    <th class="px-[16px] py-[12px] text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em] text-right">Ações</th>
                </tr>
            </thead>
            <tbody>
                <tr class="group border-b border-gray-100 dark:border-dark-border hover:bg-gray-50 dark:hover:bg-[#1B1F24] transition-colors">
                    <td class="px-[16px] py-[12px] text-[13px] text-brand-500 font-mono">#1029</td>
                    <td class="px-[16px] py-[12px] text-[13px] font-[500] text-gray-900 dark:text-gray-100">Problema de Acesso VPN</td>
                    <td class="px-[16px] py-[12px]">
                        <span class="bg-orange-500/10 text-orange-600 dark:text-orange-400 border border-orange-500/20 px-2 py-0.5 rounded-[4px] text-[11px] font-[600] uppercase tracking-wider">Aberto</span>
                    </td>
                    <td class="px-[16px] py-[12px] text-right">
                        <button onclick="abrirModalChamado(1029, 'Problema de Acesso VPN', 'Aberto')" class="bg-white dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-700 dark:text-gray-300 text-[12px] font-medium px-3 py-1.5 rounded-[4px] hover:bg-gray-50 dark:hover:bg-[#1B1F24] transition-colors">
                            Atender
                        </button>
                    </td>
                </tr>
                <tr class="group border-b border-gray-100 dark:border-dark-border hover:bg-gray-50 dark:hover:bg-[#1B1F24] transition-colors">
                    <td class="px-[16px] py-[12px] text-[13px] text-brand-500 font-mono">#1030</td>
                    <td class="px-[16px] py-[12px] text-[13px] font-[500] text-gray-900 dark:text-gray-100">Lentidão no Sistema ERP</td>
                    <td class="px-[16px] py-[12px]">
                        <span class="bg-brand-500/10 text-brand-600 dark:text-brand-400 border border-brand-500/20 px-2 py-0.5 rounded-[4px] text-[11px] font-[600] uppercase tracking-wider">Em Andamento</span>
                    </td>
                    <td class="px-[16px] py-[12px] text-right">
                        <button onclick="abrirModalChamado(1030, 'Lentidão no Sistema ERP', 'Em Andamento')" class="bg-white dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-700 dark:text-gray-300 text-[12px] font-medium px-3 py-1.5 rounded-[4px] hover:bg-gray-50 dark:hover:bg-[#1B1F24] transition-colors">
                            Atender
                        </button>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<!-- Modal Overlay -->
<div id="modalOverlay" class="fixed inset-0 bg-black/80 z-[100] hidden items-center justify-center p-4 backdrop-blur-sm transition-opacity">
    <div id="ticketModal" class="hidden bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] shadow-2xl w-full max-w-lg overflow-hidden flex-col">
        <div class="px-6 py-4 border-b border-gray-200 dark:border-dark-border flex justify-between items-center bg-gray-50 dark:bg-dark-bg/50">
            <h3 class="text-[14px] font-[600] text-gray-900 dark:text-white flex items-center gap-2 m-0">
                <i class="ph ph-headset text-brand-500"></i> Atendimento <span id="ticketNumberDisplay" class="text-brand-500 font-mono ml-1"></span>
            </h3>
            <button onclick="closeModal()" class="text-gray-500 hover:text-gray-900 dark:hover:text-white transition-colors">
                <i class="ph ph-x text-[16px]"></i>
            </button>
        </div>
        <div class="p-6">
            <p id="ticketSubjectDisplay" class="text-[14px] font-[600] text-gray-900 dark:text-white mb-4"></p>
            <form onsubmit="salvarChamado(event)" class="space-y-4">
                <input type="hidden" id="ticketId" />
                <div>
                    <label class="block text-[11px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em] mb-2">Status</label>
                    <select id="ticketStatus" class="w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[13px] rounded-[6px] px-3 py-2 outline-none focus:border-brand-500">
                        <option value="Aberto">Aberto</option>
                        <option value="Em Andamento">Em Andamento</option>
                        <option value="Fechado">Fechado</option>
                    </select>
                </div>
                <div>
                    <label class="block text-[11px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em] mb-2">Resposta / Atualização</label>
                    <textarea id="ticketReply" rows="4" placeholder="Digite a resposta ou atualização para o usuário..." class="w-full bg-gray-50 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-900 dark:text-gray-100 text-[13px] rounded-[6px] px-3 py-2 resize-none outline-none focus:border-brand-500"></textarea>
                </div>
                
                <div class="flex justify-end gap-3 pt-4 border-t border-gray-200 dark:border-dark-border mt-4">
                    <button type="button" onclick="closeModal()" class="px-4 py-2 text-[12px] font-medium text-gray-700 dark:text-gray-300 border border-gray-300 dark:border-dark-border rounded-[6px] hover:bg-gray-50 dark:hover:bg-[#1B1F24] transition-colors">Cancelar</button>
                    <button type="submit" class="px-4 py-2 text-[12px] font-medium text-white bg-brand-600 rounded-[6px] hover:bg-[#1D4ED8] transition-colors">Salvar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        function abrirModalChamado(id, subject, status) {
            document.getElementById('ticketId').value = id;
            document.getElementById('ticketNumberDisplay').innerText = '#' + id;
            document.getElementById('ticketSubjectDisplay').innerText = subject;
            document.getElementById('ticketStatus').value = status;
            document.getElementById('ticketReply').value = '';
            
            const overlay = document.getElementById('modalOverlay');
            overlay.classList.remove('hidden');
            overlay.classList.add('flex');
            
            const modal = document.getElementById('ticketModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }
        
        function closeModal() { 
            const overlay = document.getElementById('modalOverlay');
            overlay.classList.add('hidden');
            overlay.classList.remove('flex');
        }
        
        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape') closeModal();
        });

        function salvarChamado(e) {
            e.preventDefault();
            Swal.fire({ title: 'Salvo!', text: 'Chamado atualizado com sucesso (Mock)', icon: 'success', background: '#121418', color: '#fff', confirmButtonColor: '#3B82F6' });
            closeModal();
        }
    </script>
}

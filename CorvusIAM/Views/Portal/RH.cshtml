@model CorvusIAM.Models.RHViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Portal de Recursos Humanos";
}

<div class="mb-[24px] flex flex-col sm:flex-row sm:justify-between sm:items-end gap-3">
    <div>
        <h1 class="text-[16px] font-[600] text-gray-900 dark:text-white flex items-center gap-2">
            <i class="ph ph-users-three text-brand-500"></i> Portal de Recursos Humanos (RH)
        </h1>
        <p class="text-[12px] text-gray-500 dark:text-gray-400 mt-1">Gestão de folha de pagamento, controle de férias, benefícios e admissões</p>
    </div>
    <div class="flex gap-2">
        <button onclick="gerarFolhaPagamentoModal()" class="bg-brand-600 hover:bg-[#1D4ED8] text-white text-[12px] font-medium px-4 py-2 rounded-[6px] shadow-sm transition-colors flex items-center gap-1.5 cursor-pointer">
            <i class="ph ph-money"></i> Processar Folha Mensal
        </button>
        <button onclick="solicitarFeriasModal()" class="bg-emerald-600 hover:bg-emerald-700 text-white text-[12px] font-medium px-4 py-2 rounded-[6px] shadow-sm transition-colors flex items-center gap-1.5 cursor-pointer">
            <i class="ph ph-sun"></i> Autorizar Férias
        </button>
    </div>
</div>

<!-- KPIs RH -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-[24px] mb-[24px]">
    <div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[20px]">
        <div class="text-[11px] font-[600] text-gray-500 uppercase tracking-wider mb-2">Quadro de Colaboradores</div>
        <div class="text-[26px] font-[700] text-gray-900 dark:text-white">@(Model?.TotalColaboradoresAtivos ?? 0) Ativos</div>
        <div class="text-[11px] text-emerald-500 mt-1"><i class="ph ph-user-check"></i> 100% integrados no IAM</div>
    </div>
    <div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[20px]">
        <div class="text-[11px] font-[600] text-gray-500 uppercase tracking-wider mb-2">Total Folha Salarial</div>
        <div class="text-[26px] font-[700] text-gray-900 dark:text-white">R$ @((Model?.TotalFolhaSalarial ?? 0).ToString("N2"))</div>
        <div class="text-[11px] text-gray-400 mt-1">Líquido consolidado atual</div>
    </div>
    <div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[20px]">
        <div class="text-[11px] font-[600] text-gray-500 uppercase tracking-wider mb-2">Férias Programadas</div>
        <div class="text-[26px] font-[700] text-orange-500">@(Model?.FeriasAVencerAlertas ?? 0) Agendadas</div>
        <div class="text-[11px] text-gray-400 mt-1">Escalas ativas no DP</div>
    </div>
    <div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[20px]">
        <div class="text-[11px] font-[600] text-gray-500 uppercase tracking-wider mb-2">Controle de Ponto</div>
        <div class="text-[26px] font-[700] text-emerald-500">@(Model?.StatusControlePonto ?? "100% Regular")</div>
        <div class="text-[11px] text-gray-400 mt-1">Conformidade Portaria 671 MTE</div>
    </div>
</div>

<div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[24px] mb-[24px]">
    <h3 class="text-[14px] font-[600] text-gray-900 dark:text-white mb-2 m-0">Atividades e Rotinas do RH</h3>
    <p class="text-[13px] text-gray-600 dark:text-gray-400 mb-6 m-0">Gerencie holerites, espelhos de ponto, benefícios corporativos e informe de rendimentos dos colaboradores.</p>
    
    <div class="flex flex-wrap gap-3">
        <button onclick="gerarFolhaPagamentoModal()" class="bg-brand-600 hover:bg-[#1D4ED8] text-white text-[12px] font-medium px-4 py-2 rounded-[6px] shadow-sm transition-colors flex items-center gap-1.5 cursor-pointer">
            <i class="ph ph-money"></i> Processar Folha Mensal
        </button>
        <button onclick="solicitarFeriasModal()" class="bg-gray-100 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-800 dark:text-gray-200 text-[12px] font-medium px-4 py-2 rounded-[6px] hover:bg-gray-200 dark:hover:bg-[#1B1F24] transition-colors flex items-center gap-1.5 cursor-pointer">
            <i class="ph ph-calendar"></i> Escala de Férias
        </button>
        <a href="/Portal/ExportarEspelhoPonto" class="bg-gray-100 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-800 dark:text-gray-200 text-[12px] font-medium px-4 py-2 rounded-[6px] hover:bg-gray-200 dark:hover:bg-[#1B1F24] transition-colors flex items-center gap-1.5 cursor-pointer no-underline">
            <i class="ph ph-clock"></i> Exportar Espelho de Ponto (AFD)
        </a>
    </div>
</div>

<!-- Tabela de Férias Concedidas -->
<div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] flex flex-col overflow-hidden mb-[24px]">
    <div class="p-[16px] border-b border-gray-100 dark:border-dark-border bg-gray-50 dark:bg-dark-bg/50">
        <h3 class="text-[12px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-[0.05em] m-0">Escala de Férias dos Colaboradores</h3>
    </div>
    <div class="overflow-x-auto">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="border-b border-gray-200 dark:border-dark-border bg-gray-50 dark:bg-dark-bg/50 text-[11px] font-[600] text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                    <th class="px-4 py-3">Colaborador</th>
                    <th class="px-4 py-3">Início das Férias</th>
                    <th class="px-4 py-3">Término</th>
                    <th class="px-4 py-3">Dias Concedidos</th>
                    <th class="px-4 py-3">Data Aprovação</th>
                    <th class="px-4 py-3">Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model?.Ferias != null && Model.Ferias.Any())
                {
                    @foreach (var fer in Model.Ferias)
                    {
                        <tr class="border-b border-gray-100 dark:border-dark-border hover:bg-gray-50 dark:hover:bg-[#1B1F24] text-[12px]">
                            <td class="px-4 py-3 font-medium text-gray-900 dark:text-white">@fer.ColaboradorNome</td>
                            <td class="px-4 py-3 text-gray-600 dark:text-gray-400">@fer.DataInicio.ToString("dd/MM/yyyy")</td>
                            <td class="px-4 py-3 text-gray-600 dark:text-gray-400">@fer.DataFim.ToString("dd/MM/yyyy")</td>
                            <td class="px-4 py-3 font-bold text-gray-800 dark:text-gray-200">@fer.Dias dias</td>
                            <td class="px-4 py-3 text-gray-500">@fer.DataAprovacao.ToString("dd/MM/yyyy HH:mm")</td>
                            <td class="px-4 py-3">
                                <span class="px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-500 text-[10px] font-semibold border border-emerald-500/20">
                                    @fer.Status
                                </span>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="px-4 py-4 text-center text-gray-500 text-xs">Nenhum registro de férias cadastrado.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script>
        async function gerarFolhaPagamentoModal() {
            const confirm = await Swal.fire({
                title: 'Processar Folha de Pagamento?',
                text: 'Serão apurados proventos, horas extras, descontos legais de INSS e IRRF de todos os colaboradores ativos e persistidos no banco.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3B82F6',
                confirmButtonText: 'Calcular e Fechar Folha',
                cancelButtonText: 'Cancelar',
                background: '#121418', color: '#fff'
            });

            if (confirm.isConfirmed) {
                Swal.fire({
                    title: 'Calculando Encargos Trabalhistas...',
                    html: '<div class="text-xs text-gray-400">Processando e-Social, FGTS Digital e registrando no banco de dados...</div>',
                    allowOutsideClick: false,
                    didOpen: () => Swal.showLoading(),
                    background: '#121418', color: '#fff'
                });

                try {
                    const res = await fetch('/Portal/ProcessarFolhaPagamento', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getCsrfToken() }
                    });
                    const data = await res.json();
                    if (res.ok) {
                        Swal.fire({
                            title: 'Folha de Pagamento Fechada!',
                            html: `Folha de <b>${data.mes}</b> processada com êxito.<br><br><b>Colaboradores:</b> ${data.colaboradores}<br><b>Salários Líquidos:</b> R$ ${parseFloat(data.liquido).toFixed(2)}<br><b>FGTS a recolher:</b> R$ ${parseFloat(data.fgts).toFixed(2)}<br><b>INSS patronal:</b> R$ ${parseFloat(data.inss).toFixed(2)}<br><br><span class="text-emerald-400 text-xs">Dados persistidos com sucesso!</span>`,
                            icon: 'success',
                            background: '#121418', color: '#fff', confirmButtonColor: '#3B82F6'
                        }).then(() => window.location.reload());
                    } else {
                        Swal.fire({ title: 'Erro!', text: data.message || 'Falha ao processar folha.', icon: 'error', background: '#121418', color: '#fff' });
                    }
                } catch(e) {
                    Swal.fire({ title: 'Erro de Conexão', text: 'Não foi possível contatar o servidor.', icon: 'error', background: '#121418', color: '#fff' });
                }
            }
        }

        async function solicitarFeriasModal() {
            const { value: formValues } = await Swal.fire({
                title: 'Programação de Férias',
                html: `
                    <div class="text-left space-y-3">
                        <div>
                            <label class="text-xs text-gray-400 block mb-1">Colaborador</label>
                            <input id="ferColab" placeholder="Ex: Amanda Lima ou Gabriel Ferreira" class="swal2-input !m-0 !w-full bg-gray-900 text-white text-xs">
                        </div>
                        <div>
                            <label class="text-xs text-gray-400 block mb-1">Início das Férias</label>
                            <input id="ferInicio" type="date" class="swal2-input !m-0 !w-full bg-gray-900 text-white text-xs">
                        </div>
                        <div>
                            <label class="text-xs text-gray-400 block mb-1">Dias Concedidos</label>
                            <select id="ferDias" class="swal2-input !m-0 !w-full bg-gray-900 text-white text-xs">
                                <option value="30">30 dias (Integral)</option>
                                <option value="20">20 dias + Abono Pecuniário (10 dias)</option>
                                <option value="15">15 dias (1º período)</option>
                            </select>
                        </div>
                    </div>
                `,
                showCancelButton: true,
                confirmButtonColor: '#10b981',
                confirmButtonText: 'Autorizar Férias',
                cancelButtonText: 'Cancelar',
                background: '#121418', color: '#fff',
                preConfirm: () => {
                    const colab = document.getElementById('ferColab').value;
                    const inicio = document.getElementById('ferInicio').value;
                    if (!colab || !inicio) {
                        Swal.showValidationMessage('Preencha o colaborador e a data de início.');
                    }
                    return { ColaboradorNome: colab, DataInicio: inicio, Dias: parseInt(document.getElementById('ferDias').value) };
                }
            });

            if (formValues) {
                try {
                    const res = await fetch('/Portal/SolicitarFerias', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json', 'RequestVerificationToken': getCsrfToken() },
                        body: JSON.stringify(formValues)
                    });
                    const data = await res.json();
                    if (res.ok) {
                        Swal.fire({
                            title: 'Férias Autorizadas!',
                            html: `Período de <b>${data.dias} dias</b> agendado para <b>${data.colaborador}</b> com início em <b>${data.inicio}</b>.<br><br><span class="text-emerald-400 text-xs">Registro gravado no banco de dados e notificação emitida.</span>`,
                            icon: 'success',
                            background: '#121418', color: '#fff', confirmButtonColor: '#3B82F6'
                        }).then(() => window.location.reload());
                    } else {
                        Swal.fire({ title: 'Erro!', text: data.message || 'Falha ao autorizar férias.', icon: 'error', background: '#121418', color: '#fff' });
                    }
                } catch(e) {
                    Swal.fire({ title: 'Erro de Conexão', text: 'Não foi possível contatar o servidor.', icon: 'error', background: '#121418', color: '#fff' });
                }
            }
        }
    </script>
}

@{
    Layout = "_Layout";
    ViewData["Title"] = "Portal de Recursos Humanos";
}

<div class="mb-[24px] flex flex-col sm:flex-row sm:justify-between sm:items-end gap-3">
    <div>
        <h1 class="text-[16px] font-[600] text-gray-900 dark:text-white flex items-center gap-2">
            <i class="ph ph-users-three text-brand-500"></i> Portal de Recursos Humanos (RH)
        </h1>
        <p class="text-[12px] text-gray-500 dark:text-gray-400 mt-1">Gestão de folha de pagamento, controle de férias, benefícios e admissões</p>
    </div>
    <div class="flex gap-2">
        <button onclick="gerarFolhaPagamentoModal()" class="bg-brand-600 hover:bg-[#1D4ED8] text-white text-[12px] font-medium px-4 py-2 rounded-[6px] shadow-sm transition-colors flex items-center gap-1.5 cursor-pointer">
            <i class="ph ph-money"></i> Gerar Folha de Pagamento
        </button>
        <button onclick="solicitarFeriasModal()" class="bg-emerald-600 hover:bg-emerald-700 text-white text-[12px] font-medium px-4 py-2 rounded-[6px] shadow-sm transition-colors flex items-center gap-1.5 cursor-pointer">
            <i class="ph ph-sun"></i> Autorizar Férias
        </button>
    </div>
</div>

<!-- KPIs RH -->
<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-[24px] mb-[24px]">
    <div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[20px]">
        <div class="text-[11px] font-[600] text-gray-500 uppercase tracking-wider mb-2">Quadro de Colaboradores</div>
        <div class="text-[26px] font-[700] text-gray-900 dark:text-white">18 Ativos</div>
        <div class="text-[11px] text-emerald-500 mt-1"><i class="ph ph-user-plus"></i> 2 admissões este mês</div>
    </div>
    <div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[20px]">
        <div class="text-[11px] font-[600] text-gray-500 uppercase tracking-wider mb-2">Total Folha Salarial</div>
        <div class="text-[26px] font-[700] text-gray-900 dark:text-white">R$ 84.200,00</div>
        <div class="text-[11px] text-gray-400 mt-1">Lançamento previsto para dia 05</div>
    </div>
    <div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[20px]">
        <div class="text-[11px] font-[600] text-gray-500 uppercase tracking-wider mb-2">Férias a Vencer</div>
        <div class="text-[26px] font-[700] text-orange-500">2 Alertas</div>
        <div class="text-[11px] text-gray-400 mt-1">Período concessivo próximo</div>
    </div>
    <div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[20px]">
        <div class="text-[11px] font-[600] text-gray-500 uppercase tracking-wider mb-2">Controle de Ponto</div>
        <div class="text-[26px] font-[700] text-emerald-500">100% Regular</div>
        <div class="text-[11px] text-gray-400 mt-1">Sem inconsistências hoje</div>
    </div>
</div>

<div class="bento-card bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[6px] p-[24px]">
    <h3 class="text-[14px] font-[600] text-gray-900 dark:text-white mb-2 m-0">Atividades e Rotinas do RH</h3>
    <p class="text-[13px] text-gray-600 dark:text-gray-400 mb-6 m-0">Gerencie holerites, espelhos de ponto, benefícios corporativos e informe de rendimentos dos colaboradores.</p>
    
    <div class="flex flex-wrap gap-3">
        <button onclick="gerarFolhaPagamentoModal()" class="bg-brand-600 hover:bg-[#1D4ED8] text-white text-[12px] font-medium px-4 py-2 rounded-[6px] shadow-sm transition-colors flex items-center gap-1.5 cursor-pointer">
            <i class="ph ph-money"></i> Processar Folha Mensal
        </button>
        <button onclick="solicitarFeriasModal()" class="bg-gray-100 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-800 dark:text-gray-200 text-[12px] font-medium px-4 py-2 rounded-[6px] hover:bg-gray-200 dark:hover:bg-[#1B1F24] transition-colors flex items-center gap-1.5 cursor-pointer">
            <i class="ph ph-calendar"></i> Escala de Férias
        </button>
        <button onclick="exportarEspelhoPonto()" class="bg-gray-100 dark:bg-dark-bg border border-gray-200 dark:border-dark-border text-gray-800 dark:text-gray-200 text-[12px] font-medium px-4 py-2 rounded-[6px] hover:bg-gray-200 dark:hover:bg-[#1B1F24] transition-colors flex items-center gap-1.5 cursor-pointer">
            <i class="ph ph-clock"></i> Exportar Espelho de Ponto
        </button>
    </div>
</div>

@section Scripts {
    <script>
        async function gerarFolhaPagamentoModal() {
            const confirm = await Swal.fire({
                title: 'Processar Folha de Pagamento?',
                text: 'Serão apurados proventos, horas extras, descontos legais de INSS e IRRF de todos os 18 colaboradores.',
                icon: 'question',
                showCancelButton: true,
                confirmButtonColor: '#3B82F6',
                confirmButtonText: 'Calcular e Fechar Folha',
                cancelButtonText: 'Cancelar',
                background: '#121418', color: '#fff'
            });

            if (confirm.isConfirmed) {
                Swal.fire({
                    title: 'Calculando Encargos Trabalhistas...',
                    html: '<div class="text-xs text-gray-400">Processando e-Social, FGTS Digital e gerando holerites em PDF...</div>',
                    allowOutsideClick: false,
                    didOpen: () => Swal.showLoading(),
                    background: '#121418', color: '#fff'
                });

                setTimeout(() => {
                    Swal.fire({
                        title: 'Folha de Pagamento Fechada!',
                        html: 'A folha do mês foi processada com êxito.<br><br><b>Salários Líquidos:</b> R$ 84.200,00<br><b>FGTS a recolher:</b> R$ 6.736,00<br><b>INSS patronal:</b> R$ 9.260,00<br><br><span class="text-emerald-400 text-xs">Holerites disponibilizados no portal dos colaboradores.</span>',
                        icon: 'success',
                        background: '#121418', color: '#fff', confirmButtonColor: '#3B82F6'
                    });
                }, 1500);
            }
        }

        async function solicitarFeriasModal() {
            const { value: formValues } = await Swal.fire({
                title: 'Programação de Férias',
                html: `
                    <div class="text-left space-y-3">
                        <div>
                            <label class="text-xs text-gray-400 block mb-1">Colaborador</label>
                            <input id="ferColab" placeholder="Ex: Lucas Ferreira ou Amanda Lima" class="swal2-input !m-0 !w-full bg-gray-900 text-white text-xs">
                        </div>
                        <div>
                            <label class="text-xs text-gray-400 block mb-1">Início das Férias</label>
                            <input id="ferInicio" type="date" class="swal2-input !m-0 !w-full bg-gray-900 text-white text-xs">
                        </div>
                        <div>
                            <label class="text-xs text-gray-400 block mb-1">Dias Concedidos</label>
                            <select id="ferDias" class="swal2-input !m-0 !w-full bg-gray-900 text-white text-xs">
                                <option value="30">30 dias (Integral)</option>
                                <option value="20">20 dias + Abono Pecuniário (10 dias)</option>
                                <option value="15">15 dias (1º período)</option>
                            </select>
                        </div>
                    </div>
                `,
                showCancelButton: true,
                confirmButtonColor: '#10b981',
                confirmButtonText: 'Autorizar Férias',
                cancelButtonText: 'Cancelar',
                background: '#121418', color: '#fff',
                preConfirm: () => {
                    const colab = document.getElementById('ferColab').value;
                    const inicio = document.getElementById('ferInicio').value;
                    if (!colab || !inicio) {
                        Swal.showValidationMessage('Preencha o colaborador e a data de início.');
                    }
                    return { colab, inicio, dias: document.getElementById('ferDias').value };
                }
            });

            if (formValues) {
                Swal.fire({
                    title: 'Férias Autorizadas!',
                    html: `Período de <b>${formValues.dias} dias</b> agendado para <b>${formValues.colab}</b> com início em <b>${formValues.inicio}</b>.<br><br><span class="text-emerald-400 text-xs">Aviso de férias enviado para assinatura eletrônica do colaborador.</span>`,
                    icon: 'success',
                    background: '#121418', color: '#fff', confirmButtonColor: '#3B82F6'
                });
            }
        }

        function exportarEspelhoPonto() {
            Swal.fire({
                title: 'Exportando Espelho de Ponto',
                text: 'Relatório do ponto eletrônico com marcações biométricas exportado em formato PDF/AFD.',
                icon: 'success',
                timer: 2000,
                showConfirmButton: false,
                background: '#121418', color: '#fff'
            });
        }
    </script>
}

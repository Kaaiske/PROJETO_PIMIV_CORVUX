<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Corvux Security</title>
    
    <!-- PWA & Mobile Web App Meta -->
    <link rel="manifest" href="/manifest.json?v=20261018">
    <meta name="theme-color" content="#070709">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="default">
    <!-- Favicon & Icons Oficiais Corvux Security -->
    <link rel="icon" type="image/png" sizes="64x64" href="/favicon.png?v=20261018">
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png?v=20261018">
    <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16x16.png?v=20261018">
    <link rel="icon" type="image/png" sizes="192x192" href="/icons/corvux-icon-192.png?v=20261018">
    <link rel="apple-touch-icon" sizes="180x180" href="/icons/corvux-icon-192.png?v=20261018">
    <link rel="shortcut icon" href="/favicon.ico?v=20261018" type="image/x-icon">
    
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            darkMode: 'class',
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#eff6ff', 100: '#dbeafe', 400: '#60a5fa', 500: '#3b82f6', 600: '#2563eb', 900: '#1e3a8a',
                        },
                        dark: {
                            bg: '#070709', card: '#0E0E12', border: '#22222A', hover: '#16161C'
                        }
                    }
                }
            }
        }
    </script>
    
    <!-- Phosphor Icons -->
    <script src="https://unpkg.com/@@phosphor-icons/web"></script>
    
    <!-- Chart.js & SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // Tema Principal Branco (Light Mode por padrão); ativa Dark Mode apenas quando escolhido pelo usuário
        if (localStorage.getItem('corvux-theme') === 'dark') {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>

    <style>
        ::-webkit-scrollbar { width: 5px; height: 5px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #94a3b8; border-radius: 3px; }
        .dark ::-webkit-scrollbar-thumb { background: #22222A; }
        
        body { transition: background-color 0.2s ease, color 0.2s ease; }

        /* Paleta Clara Suave (Soft Alabaster Slate) - Sem brilho excessivo no modo claro */
        html:not(.dark) body,
        html:not(.dark) main {
            background-color: #E4EBF3 !important;
            color: #1E293B !important;
        }
        html:not(.dark) #appSidebar {
            background-color: #EEF2F7 !important;
            border-color: #CBD5E1 !important;
        }
        html:not(.dark) header {
            background-color: rgba(238, 242, 247, 0.90) !important;
            border-color: #CBD5E1 !important;
        }
        html:not(.dark) .bg-white:not(#appSidebar) {
            background-color: #F5F7FA !important;
        }
        html:not(.dark) .bg-gray-50,
        html:not(.dark) .bg-slate-50 {
            background-color: #EBF0F6 !important;
        }
        html:not(.dark) .border-gray-200,
        html:not(.dark) .border-slate-200 {
            border-color: #CBD5E1 !important;
        }
        html:not(.dark) .border-gray-100,
        html:not(.dark) .border-slate-100 {
            border-color: #D8E0EA !important;
        }
        
        /* Traços finos (Hairline 1px) e elevação sutil */
        .bento-card {
            border-width: 1px;
            border-color: #CBD5E1;
            background-color: #F5F7FA;
            box-shadow: 0 2px 5px rgba(15, 23, 42, 0.04);
            transition: border-color 180ms ease, box-shadow 180ms ease, background-color 180ms ease;
        }
        .bento-card:hover {
            border-color: #94A3B8;
            box-shadow: 0 6px 16px rgba(15, 23, 42, 0.07);
        }
        .dark .bento-card {
            background-color: #0E0E12;
            border-color: #22222A;
            box-shadow: 0 1px 4px rgba(0, 0, 0, 0.45);
        }
        .dark .bento-card:hover {
            border-color: #3F3F46;
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.6);
        }
        
        .table { width: 100%; text-align: left; border-collapse: collapse; }
        .table th, .table td { padding: 10px 12px; border-bottom: 1px solid #D8E0EA; }
        .dark .table th, .dark .table td { border-bottom: 1px solid #22222A; color: #D4D4D8; }
        .form-control { width: 100%; padding: 7px 11px; border: 1px solid #CBD5E1; border-radius: 6px; background: #EDF2F7; color: #0F172A; transition: border-color 0.15s ease, background-color 0.15s ease; }
        .form-control:focus { outline: none; border-color: #2563EB; background: #F8FAFC; }
        .dark .form-control { border-color: #22222A; background-color: #09090C; color: #FAFAFA; }
        .dark .form-control:focus { border-color: #3B82F6; background-color: #09090C; }

        /* Suporte completo a Dark Mode para Selects e Dropdowns Nativos */
        html.dark, html.dark body {
            color-scheme: dark !important;
        }

        .dark select, 
        .dark select.form-control,
        select.dark-select {
            color-scheme: dark !important;
            background-color: #09090C !important;
            color: #FAFAFA !important;
            border-color: #22222A !important;
            appearance: none !important;
            -webkit-appearance: none !important;
            -moz-appearance: none !important;
            background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23a1a1aa' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e") !important;
            background-repeat: no-repeat !important;
            background-position: calc(100% - 12px) center !important;
            background-size: 14px 14px !important;
            padding-right: 2.5rem !important;
            cursor: pointer;
        }

        .dark select option, 
        .dark select optgroup,
        select.dark-select option {
            background-color: #0E0E12 !important;
            color: #FAFAFA !important;
            padding: 8px 12px !important;
        }

        html:not(.dark) select, 
        html:not(.dark) select.form-control {
            color-scheme: light !important;
            background-color: #EDF2F7 !important;
            color: #0f172a !important;
            border-color: #CBD5E1 !important;
            appearance: none !important;
            -webkit-appearance: none !important;
            -moz-appearance: none !important;
            background-image: url("data:image/svg+xml;charset=UTF-8,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23475569' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'%3e%3cpolyline points='6 9 12 15 18 9'%3e%3c/polyline%3e%3c/svg%3e") !important;
            background-repeat: no-repeat !important;
            background-position: calc(100% - 12px) center !important;
            background-size: 14px 14px !important;
            padding-right: 2.5rem !important;
            cursor: pointer;
        }

        html:not(.dark) select option {
            background-color: #F5F7FA !important;
            color: #0f172a !important;
        }

        html:not(.dark) input[type="text"],
        html:not(.dark) input[type="email"],
        html:not(.dark) input[type="password"],
        html:not(.dark) input[type="number"],
        html:not(.dark) input[type="search"],
        html:not(.dark) textarea {
            background-color: #EDF2F7 !important;
            color: #0F172A !important;
            border-color: #CBD5E1 !important;
        }

        .dark input[type="text"],
        .dark input[type="email"],
        .dark input[type="password"],
        .dark input[type="number"],
        .dark input[type="search"],
        .dark textarea {
            background-color: #0B0E14 !important;
            color: #F1F5F9 !important;
            border-color: #1E2636 !important;
        }

        /* Acessibilidade WCAG 2.2 / Alto Contraste */
        .high-contrast { filter: contrast(140%) !important; }

        /* Bloqueio absoluto do banner PWA em telas Desktop */
        @@media (min-width: 900px) {
            #pwaInstallBanner {
                display: none !important;
                visibility: hidden !important;
                opacity: 0 !important;
                pointer-events: none !important;
            }
        }
        .high-contrast body { background-color: #000000 !important; color: #ffffff !important; }
        .high-contrast .bento-card { border-color: #ffffff !important; background-color: #0a0a0a !important; }
        .high-contrast a, .high-contrast button { text-decoration: underline; }
    </style>
    @RenderSection("Styles", required: false)
</head>

<body class="bg-[#E4EBF3] text-slate-800 dark:bg-dark-bg dark:text-slate-200 h-screen flex overflow-hidden antialiased text-[13px]">

    <!-- Hidden Anti-Forgery Form para todas as requisições AJAX do sistema -->
    <form id="__afForm" style="display:none">@Html.AntiForgeryToken()</form>

    <!-- Backdrop para Mobile -->
    <div id="mobileBackdrop" onclick="fecharMobileMenu()" class="fixed inset-0 bg-slate-900/60 z-40 hidden md:hidden backdrop-blur-sm transition-opacity"></div>

    <aside id="appSidebar" class="fixed inset-y-0 left-0 z-50 w-64 bg-[#EEF2F7] dark:bg-dark-card border-r border-slate-300/80 dark:border-dark-border flex flex-col justify-between transition-all duration-300 transform -translate-x-full md:translate-x-0 md:static md:w-16 md:hover:w-64 md:flex-shrink-0 group overflow-hidden">
        <div class="flex flex-col h-full w-64">
            <!-- Logo & Botão Fechar Mobile -->
            <div class="h-14 flex items-center justify-between px-4 border-b border-slate-300/80 dark:border-dark-border">
                <a href="/Admin/Index" class="flex items-center gap-3 p-1 rounded-md cursor-pointer">
                    <img src="/icons/corvus-logo-light.png?v=20261017" alt="Corvux Logo" class="w-8 h-8 rounded-lg flex-shrink-0 object-contain border border-slate-300/80 block dark:hidden">
                    <img src="/icons/corvus-logo-dark.png?v=20261017" alt="Corvux Logo" class="w-8 h-8 rounded-lg flex-shrink-0 object-contain border border-dark-border hidden dark:block">
                    <span class="font-semibold text-slate-900 dark:text-white tracking-tight md:opacity-0 md:group-hover:opacity-100 transition-opacity whitespace-nowrap">Corvux Security</span>
                </a>
                <button type="button" onclick="fecharMobileMenu()" class="md:hidden text-slate-500 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white p-1 rounded-[6px] transition-colors" title="Fechar Menu">
                    <i class="ph ph-x text-[18px]"></i>
                </button>
            </div>

            <!-- Navegação -->
            <nav class="flex-1 py-3.5 px-3 space-y-1 overflow-y-auto">
                <div class="text-[10px] font-semibold text-slate-500 dark:text-slate-500 uppercase tracking-[0.06em] px-2 mb-1 md:opacity-0 md:group-hover:opacity-100 transition-opacity">Dashboard</div>
                @if(User.IsInRole("Admin")) { 
                <a id="nav-visao-geral" href="/Admin/Index" onclick="if(window.innerWidth < 768) fecharMobileMenu()" class="flex items-center gap-3 px-2 py-1.5 rounded-md transition-colors group/item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" && ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" ? "bg-brand-600/10 dark:bg-dark-hover text-brand-600 dark:text-white font-medium border border-brand-500/25 dark:border-dark-border" : "text-slate-600 dark:text-slate-400 hover:bg-slate-200/60 dark:hover:bg-dark-hover hover:text-slate-900 dark:hover:text-white")">
                    <i class="ph ph-squares-four text-[17px] flex-shrink-0 @(ViewContext.RouteData.Values["Action"]?.ToString() == "Index" ? "text-brand-600 dark:text-brand-400" : "")"></i>
                    <span class="md:opacity-0 md:group-hover:opacity-100 transition-opacity whitespace-nowrap">Visão Geral</span>
                </a> }
                @if(User.IsInRole("Recursos Humanos") && !User.IsInRole("Admin")) {
                <a id="nav-portal-rh" href="/Portal/RH" onclick="if(window.innerWidth < 768) fecharMobileMenu()" class="flex items-center gap-3 px-2 py-1.5 rounded-md transition-colors group/item @(ViewContext.RouteData.Values["Action"]?.ToString() == "RH" ? "bg-brand-600/10 dark:bg-dark-hover text-brand-600 dark:text-white font-medium border border-brand-500/25 dark:border-dark-border" : "text-slate-600 dark:text-slate-400 hover:bg-slate-200/60 dark:hover:bg-dark-hover hover:text-slate-900 dark:hover:text-white")">
                    <i class="ph ph-briefcase text-[17px] flex-shrink-0 @(ViewContext.RouteData.Values["Action"]?.ToString() == "RH" ? "text-brand-600 dark:text-brand-400" : "")"></i>
                    <span class="md:opacity-0 md:group-hover:opacity-100 transition-opacity whitespace-nowrap">Portal RH & Admissão</span>
                </a> }
                @if(User.IsInRole("Contabilidade") && !User.IsInRole("Admin")) {
                <a id="nav-portal-contabil" href="/Portal/Contabilidade" onclick="if(window.innerWidth < 768) fecharMobileMenu()" class="flex items-center gap-3 px-2 py-1.5 rounded-md transition-colors group/item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Contabilidade" ? "bg-brand-600/10 dark:bg-dark-hover text-brand-600 dark:text-white font-medium border border-brand-500/25 dark:border-dark-border" : "text-slate-600 dark:text-slate-400 hover:bg-slate-200/60 dark:hover:bg-dark-hover hover:text-slate-900 dark:hover:text-white")">
                    <i class="ph ph-calculator text-[17px] flex-shrink-0 @(ViewContext.RouteData.Values["Action"]?.ToString() == "Contabilidade" ? "text-brand-600 dark:text-brand-400" : "")"></i>
                    <span class="md:opacity-0 md:group-hover:opacity-100 transition-opacity whitespace-nowrap">Portal Contábil & Fiscal</span>
                </a> }
                @if(!User.IsInRole("Admin")) {
                <a id="nav-portal-colab" href="/Portal/MinhaConta" onclick="if(window.innerWidth < 768) fecharMobileMenu()" class="flex items-center gap-3 px-2 py-1.5 rounded-md transition-colors group/item @(ViewContext.RouteData.Values["Action"]?.ToString() == "MinhaConta" ? "bg-brand-600/10 dark:bg-dark-hover text-brand-600 dark:text-white font-medium border border-brand-500/25 dark:border-dark-border" : "text-slate-600 dark:text-slate-400 hover:bg-slate-200/60 dark:hover:bg-dark-hover hover:text-slate-900 dark:hover:text-white")">
                    <i class="ph ph-user-circle text-[17px] flex-shrink-0 @(ViewContext.RouteData.Values["Action"]?.ToString() == "MinhaConta" ? "text-brand-600 dark:text-brand-400" : "")"></i>
                    <span class="md:opacity-0 md:group-hover:opacity-100 transition-opacity whitespace-nowrap">Minha Conta</span>
                </a> }
                
                <div class="text-[10px] font-semibold text-slate-500 dark:text-slate-500 uppercase tracking-[0.06em] px-2 mb-1 mt-2.5 md:opacity-0 md:group-hover:opacity-100 transition-opacity">Gerenciamento</div>
                @if(User.IsInRole("Admin") || User.IsInRole("Recursos Humanos")) { 
                <a id="nav-usuarios" href="/Admin/Usuarios" onclick="if(window.innerWidth < 768) fecharMobileMenu()" class="flex items-center gap-3 px-2 py-1.5 rounded-md transition-colors group/item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Usuarios" ? "bg-brand-600/10 dark:bg-dark-hover text-brand-600 dark:text-white font-medium border border-brand-500/25 dark:border-dark-border" : "text-slate-600 dark:text-slate-400 hover:bg-slate-200/60 dark:hover:bg-dark-hover hover:text-slate-900 dark:hover:text-white")">
                    <i class="ph ph-users text-[17px] flex-shrink-0 @(ViewContext.RouteData.Values["Action"]?.ToString() == "Usuarios" ? "text-brand-600 dark:text-brand-400" : "")"></i>
                    <span class="md:opacity-0 md:group-hover:opacity-100 transition-opacity whitespace-nowrap">Diretório de Usuários</span>
                </a> }
                @if(User.IsInRole("Admin")) { 
                <a id="nav-politicas" href="/Admin/Politicas" onclick="if(window.innerWidth < 768) fecharMobileMenu()" class="flex items-center gap-3 px-2 py-1.5 rounded-md transition-colors group/item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Politicas" ? "bg-brand-600/10 dark:bg-dark-hover text-brand-600 dark:text-white font-medium border border-brand-500/25 dark:border-dark-border" : "text-slate-600 dark:text-slate-400 hover:bg-slate-200/60 dark:hover:bg-dark-hover hover:text-slate-900 dark:hover:text-white")">
                    <i class="ph ph-shield-check text-[17px] flex-shrink-0 @(ViewContext.RouteData.Values["Action"]?.ToString() == "Politicas" ? "text-brand-600 dark:text-brand-400" : "")"></i>
                    <span class="md:opacity-0 md:group-hover:opacity-100 transition-opacity whitespace-nowrap">Políticas de Acesso</span>
                </a> 
                <a id="nav-perfis" href="/Admin/Perfis" onclick="if(window.innerWidth < 768) fecharMobileMenu()" class="flex items-center gap-3 px-2 py-1.5 rounded-md transition-colors group/item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Perfis" ? "bg-brand-600/10 dark:bg-dark-hover text-brand-600 dark:text-white font-medium border border-brand-500/25 dark:border-dark-border" : "text-slate-600 dark:text-slate-400 hover:bg-slate-200/60 dark:hover:bg-dark-hover hover:text-slate-900 dark:hover:text-white")">
                    <i class="ph ph-identification-card text-[17px] flex-shrink-0 @(ViewContext.RouteData.Values["Action"]?.ToString() == "Perfis" ? "text-brand-600 dark:text-brand-400" : "")"></i>
                    <span class="md:opacity-0 md:group-hover:opacity-100 transition-opacity whitespace-nowrap">Perfis & Permissões</span>
                </a> }
                
                <div class="text-[10px] font-semibold text-slate-500 dark:text-slate-500 uppercase tracking-[0.06em] px-2 mb-1 mt-2.5 md:opacity-0 md:group-hover:opacity-100 transition-opacity">Operações</div>
                @if(User.IsInRole("Admin") || User.IsInRole("Help Desk")) { 
                <a id="nav-chamados" href="/Admin/Chamados" onclick="if(window.innerWidth < 768) fecharMobileMenu()" class="flex items-center gap-3 px-2 py-1.5 rounded-md transition-colors group/item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Chamados" ? "bg-brand-600/10 dark:bg-dark-hover text-brand-600 dark:text-white font-medium border border-brand-500/25 dark:border-dark-border" : "text-slate-600 dark:text-slate-400 hover:bg-slate-200/60 dark:hover:bg-dark-hover hover:text-slate-900 dark:hover:text-white")">
                    <div class="relative flex-shrink-0">
                        <i class="ph ph-headset text-[17px] @(ViewContext.RouteData.Values["Action"]?.ToString() == "Chamados" ? "text-brand-600 dark:text-brand-400" : "")"></i>
                        <div class="absolute -top-0.5 -right-0.5 w-1.5 h-1.5 bg-brand-500 rounded-full"></div>
                    </div>
                    <span class="md:opacity-0 md:group-hover:opacity-100 transition-opacity whitespace-nowrap">Fila de Chamados</span>
                </a> }
                @if(User.IsInRole("Admin")) { 
                <a id="nav-cloud" href="/Admin/Cloud" onclick="if(window.innerWidth < 768) fecharMobileMenu()" class="flex items-center gap-3 px-2 py-1.5 rounded-md transition-colors group/item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Cloud" ? "bg-brand-600/10 dark:bg-dark-hover text-brand-600 dark:text-white font-medium border border-brand-500/25 dark:border-dark-border" : "text-slate-600 dark:text-slate-400 hover:bg-slate-200/60 dark:hover:bg-dark-hover hover:text-slate-900 dark:hover:text-white")">
                    <i class="ph ph-desktop text-[17px] flex-shrink-0 @(ViewContext.RouteData.Values["Action"]?.ToString() == "Cloud" ? "text-brand-600 dark:text-brand-400" : "")"></i>
                    <span class="md:opacity-0 md:group-hover:opacity-100 transition-opacity whitespace-nowrap">Infraestrutura & Endpoints</span>
                </a> 
                <a id="nav-integracoes" href="/Admin/Integracoes" onclick="if(window.innerWidth < 768) fecharMobileMenu()" class="flex items-center gap-3 px-2 py-1.5 rounded-md transition-colors group/item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Integracoes" ? "bg-brand-600/10 dark:bg-dark-hover text-brand-600 dark:text-white font-medium border border-brand-500/25 dark:border-dark-border" : "text-slate-600 dark:text-slate-400 hover:bg-slate-200/60 dark:hover:bg-dark-hover hover:text-slate-900 dark:hover:text-white")">
                    <i class="ph ph-plugs-connected text-[17px] flex-shrink-0 @(ViewContext.RouteData.Values["Action"]?.ToString() == "Integracoes" ? "text-brand-600 dark:text-brand-400" : "")"></i>
                    <span class="md:opacity-0 md:group-hover:opacity-100 transition-opacity whitespace-nowrap">Módulos & APIs</span>
                </a> }
                
                <div class="text-[10px] font-semibold text-slate-500 dark:text-slate-500 uppercase tracking-[0.06em] px-2 mb-1 mt-2.5 md:opacity-0 md:group-hover:opacity-100 transition-opacity">Sistema</div>
                @if(User.IsInRole("Admin")) { 
                <a id="nav-logs" href="/Admin/Logs" onclick="if(window.innerWidth < 768) fecharMobileMenu()" class="flex items-center gap-3 px-2 py-1.5 rounded-md transition-colors group/item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Logs" ? "bg-brand-600/10 dark:bg-dark-hover text-brand-600 dark:text-white font-medium border border-brand-500/25 dark:border-dark-border" : "text-slate-600 dark:text-slate-400 hover:bg-slate-200/60 dark:hover:bg-dark-hover hover:text-slate-900 dark:hover:text-white")">
                    <i class="ph ph-list-magnifying-glass text-[17px] flex-shrink-0 @(ViewContext.RouteData.Values["Action"]?.ToString() == "Logs" ? "text-brand-600 dark:text-brand-400" : "")"></i>
                    <span class="md:opacity-0 md:group-hover:opacity-100 transition-opacity whitespace-nowrap">Audit Logs</span>
                </a> 
                <a id="nav-secops" href="/Admin/Inteligencia" onclick="if(window.innerWidth < 768) fecharMobileMenu()" class="flex items-center gap-3 px-2 py-1.5 rounded-md transition-colors group/item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Inteligencia" ? "bg-brand-600/10 dark:bg-dark-hover text-brand-600 dark:text-white font-medium border border-brand-500/25 dark:border-dark-border" : "text-slate-600 dark:text-slate-400 hover:bg-slate-200/60 dark:hover:bg-dark-hover hover:text-slate-900 dark:hover:text-white")">
                    <i class="ph ph-shield-warning text-[17px] flex-shrink-0 text-brand-600 dark:text-brand-400"></i>
                    <span class="md:opacity-0 md:group-hover:opacity-100 transition-opacity whitespace-nowrap text-brand-600 dark:text-brand-400 font-medium">SecOps AI & Defesa</span>
                </a> 
                <a id="nav-configuracoes" href="/Admin/Configuracoes" onclick="if(window.innerWidth < 768) fecharMobileMenu()" class="flex items-center gap-3 px-2 py-1.5 rounded-md transition-colors group/item @(ViewContext.RouteData.Values["Action"]?.ToString() == "Configuracoes" ? "bg-brand-600/10 dark:bg-dark-hover text-brand-600 dark:text-white font-medium border border-brand-500/25 dark:border-dark-border" : "text-slate-600 dark:text-slate-400 hover:bg-slate-200/60 dark:hover:bg-dark-hover hover:text-slate-900 dark:hover:text-white")">
                    <i class="ph ph-gear text-[17px] flex-shrink-0 @(ViewContext.RouteData.Values["Action"]?.ToString() == "Configuracoes" ? "text-brand-600 dark:text-brand-400" : "")"></i>
                    <span class="md:opacity-0 md:group-hover:opacity-100 transition-opacity whitespace-nowrap">Configurações</span>
                </a> }
            </nav>

            <!-- Bottom Actions -->
            <div class="p-3 border-t border-slate-300/80 dark:border-dark-border flex flex-col gap-1">
                <a href="/Portal/MinhaConta" onclick="if(window.innerWidth < 768) fecharMobileMenu()" class="flex items-center gap-3 px-2 py-1.5 rounded-md text-slate-600 dark:text-slate-400 hover:bg-slate-200/60 dark:hover:bg-dark-hover hover:text-slate-900 dark:hover:text-white transition-colors" title="Meu Perfil">
                    <div class="w-7 h-7 rounded-md bg-brand-600 flex-shrink-0 flex items-center justify-center text-white font-semibold text-[11px]">AD</div>
                    <div class="flex-1 overflow-hidden md:opacity-0 md:group-hover:opacity-100 transition-opacity">
                        <p class="text-[12px] font-medium text-slate-900 dark:text-white truncate">@(User.Identity?.Name ?? Context.Request.Cookies["LoggedUser"] ?? "Administrador")</p>
                        <p class="text-[10px] text-slate-500 dark:text-slate-400">Minha Conta Zero Trust</p>
                    </div>
                </a>
                <a href="/Auth/Logout" class="flex items-center gap-3 px-2 py-1.5 rounded-md text-red-600 dark:text-red-400 hover:bg-red-500/10 transition-colors" title="Sair do Sistema">
                    <i class="ph ph-sign-out text-[17px] flex-shrink-0"></i>
                    <span class="md:opacity-0 md:group-hover:opacity-100 transition-opacity whitespace-nowrap text-[12px] font-medium">Encerrar Sessão</span>
                </a>
            </div>
        </div>
    </aside>

    <main class="flex-1 flex flex-col min-w-0 bg-[#E4EBF3] dark:bg-dark-bg w-full transition-all">
        
        <!-- Header Responsivo -->
        <header class="h-14 bg-[#EEF2F7]/90 dark:bg-dark-card/85 backdrop-blur-md border-b border-slate-300/80 dark:border-dark-border flex items-center justify-between px-3 sm:px-6 flex-shrink-0 sticky top-0 z-20">
            <div class="flex items-center gap-2 sm:gap-3.5 min-w-0">
                <!-- Botão Menu Hambúrguer (Mobile) -->
                <button type="button" onclick="abrirMobileMenu()" class="md:hidden p-1.5 -ml-1 text-slate-600 dark:text-slate-300 hover:bg-slate-200/70 dark:hover:bg-dark-hover rounded-[6px] transition-colors cursor-pointer" aria-label="Abrir Menu">
                    <i class="ph ph-list text-[20px]"></i>
                </button>
                <div class="md:hidden flex-shrink-0">
                    <img src="/icons/corvus-logo-light.png?v=20261018" alt="Corvux Logo" class="w-7 h-7 rounded-md object-contain border border-slate-300 block dark:hidden">
                    <img src="/icons/corvus-logo-dark.png?v=20261018" alt="Corvux Logo" class="w-7 h-7 rounded-md object-contain border border-dark-border hidden dark:block">
                </div>
                <h1 class="font-semibold text-slate-900 dark:text-white text-[14px] sm:text-[15px] tracking-tight truncate">@ViewData["Title"]</h1>
                <div class="hidden sm:block h-3.5 w-px bg-slate-300 dark:bg-dark-border"></div>
                <span class="hidden sm:flex text-[11px] font-medium text-emerald-700 dark:text-emerald-400 items-center gap-1.5 uppercase tracking-wider">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span> Zero Trust Ativo
                </span>
            </div>

            <div class="flex items-center gap-1.5 sm:gap-2.5 flex-shrink-0">
                <!-- Barra de Busca Global / Command Palette Funcional -->
                <div class="relative hidden lg:block w-72 h-8">
                    <i class="ph ph-magnifying-glass absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-500 text-xs"></i>
                    <input type="text" id="globalSearchInput" autocomplete="off" placeholder="Ir para módulo, IP ou usuário (Ctrl+K)..." class="w-full h-full bg-[#E4EBF3] dark:bg-dark-bg border border-slate-300 dark:border-dark-border text-slate-900 dark:text-slate-100 text-[12px] rounded-[6px] pl-8 pr-3 focus:outline-none focus:border-brand-500 focus:bg-[#F5F7FA] transition-all">
                    <!-- Quick Jump Command Dropdown -->
                    <div id="globalCommandDropdown" class="hidden absolute left-0 right-0 top-9 bg-[#F5F7FA] dark:bg-dark-card border border-slate-300 dark:border-dark-border rounded-lg shadow-xl z-50 py-1.5 max-h-72 overflow-y-auto text-[12px]"></div>
                </div>
                
                <!-- Controles de Acessibilidade (WCAG 2.2 / Etapa 3 PIM IV) -->
                <div class="hidden sm:flex items-center gap-0.5 bg-[#E4EBF3] dark:bg-dark-bg border border-slate-300 dark:border-dark-border rounded-[6px] p-0.5" title="Acessibilidade & Inclusão (WCAG 2.2)">
                    <button type="button" onclick="alterarTamanhoFonte(1)" class="w-7 h-7 flex items-center justify-center rounded text-slate-700 dark:text-slate-300 hover:bg-slate-300/60 dark:hover:bg-dark-hover text-xs font-semibold transition-colors cursor-pointer" title="Aumentar Fonte (A+)">A+</button>
                    <button type="button" onclick="alterarTamanhoFonte(-1)" class="w-7 h-7 flex items-center justify-center rounded text-slate-700 dark:text-slate-300 hover:bg-slate-300/60 dark:hover:bg-dark-hover text-xs font-semibold transition-colors cursor-pointer" title="Diminuir Fonte (A-)">A-</button>
                    <button type="button" onclick="alternarAltoContraste()" class="w-7 h-7 flex items-center justify-center rounded text-slate-700 dark:text-slate-300 hover:bg-slate-300/60 dark:hover:bg-dark-hover text-xs transition-colors cursor-pointer" title="Alternar Modo Alto Contraste">
                        <i class="ph ph-circle-half text-[15px]"></i>
                    </button>
                </div>
                
                <!-- Botão Alternador de Tema -->
                <button id="theme-toggle" class="w-8 h-8 flex items-center justify-center rounded-[6px] border border-slate-300 dark:border-dark-border bg-[#E4EBF3] dark:bg-dark-bg text-slate-700 hover:text-slate-900 dark:text-slate-400 dark:hover:text-white transition-colors cursor-pointer" title="Alternar Tema Claro/Escuro">
                    <i id="theme-toggle-dark-icon" class="ph ph-moon text-[15px] hidden"></i>
                    <i id="theme-toggle-light-icon" class="ph ph-sun text-[15px] hidden"></i>
                </button>

                <!-- Botão Guia do Sistema / Tour Interativo -->
                <button type="button" onclick="iniciarTourInterativo()" class="border border-brand-500/30 bg-brand-500/10 hover:bg-brand-500/20 text-brand-700 dark:text-brand-400 text-[12px] font-medium px-2.5 sm:px-3 py-1.5 rounded-[6px] transition-colors flex items-center gap-1.5 cursor-pointer" title="Guia Passo a Passo do Sistema CorvuxIAM">
                    <i class="ph ph-compass text-sm"></i> <span class="hidden sm:inline">Guia do Sistema</span>
                </button>
                
                <!-- Botão + Nova Issue / Chamado Totalmente Funcional -->
                <button type="button" onclick="abrirModalNovaIssue()" class="bg-brand-600 hover:bg-brand-500 text-white text-[12px] font-medium px-2.5 sm:px-3.5 py-1.5 rounded-[6px] shadow-sm transition-colors flex items-center gap-1.5 cursor-pointer">
                    <i class="ph ph-plus"></i> <span class="hidden sm:inline">Nova Issue</span>
                </button>
            </div>
        </header>

        <div class="flex-1 overflow-y-auto overflow-x-hidden p-3 sm:p-5 md:p-[28px] pb-28 relative">
            <div class="max-w-[1400px] mx-auto min-h-full flex flex-col pb-16">
                @RenderBody()
            </div>
        </div>
    </main>

    <!-- Modal Global: Nova Issue / Abertura de Chamado -->
    <div id="modalNovaIssue" class="fixed inset-0 bg-black/80 z-[100] hidden items-center justify-center p-4 backdrop-blur-sm transition-opacity">
        <div class="bg-white dark:bg-dark-card border border-gray-200 dark:border-dark-border rounded-[8px] shadow-2xl w-full max-w-lg overflow-hidden flex flex-col">
            <div class="px-6 py-4 border-b border-gray-200 dark:border-dark-border flex justify-between items-center bg-gray-50 dark:bg-dark-bg/50">
                <h3 class="text-[14px] font-[600] text-gray-900 dark:text-white flex items-center gap-2">
                    <i class="ph ph-ticket text-brand-500"></i> Registrar Nova Solicitação / Issue
                </h3>
                <button type="button" onclick="fecharModalNovaIssue()" class="text-gray-400 hover:text-white transition-colors">
                    <i class="ph ph-x text-[16px]"></i>
                </button>
            </div>
            <form onsubmit="salvarNovaIssueGlobal(event)" class="p-6 space-y-4">
                <div>
                    <label class="block text-[11px] font-[600] text-gray-500 uppercase tracking-wider mb-1.5">Assunto da Issue</label>
                    <input type="text" id="issueAssunto" required placeholder="Ex: Solicitação de Acesso VPN ou Falha de Login" class="form-control text-[13px]" />
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-[11px] font-[600] text-gray-500 uppercase tracking-wider mb-1.5">Categoria</label>
                        <select id="issueCategoria" class="form-control text-[13px]">
                            <option value="Acesso">Acesso / Permissões</option>
                            <option value="Infraestrutura">Infraestrutura / Cloud</option>
                            <option value="Segurança">Incidente de Segurança</option>
                            <option value="Bug">Falha / Erro no Sistema</option>
                            <option value="Outros">Outros Chamados</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-[11px] font-[600] text-gray-500 uppercase tracking-wider mb-1.5">Prioridade</label>
                        <select id="issuePrioridade" class="form-control text-[13px]">
                            <option value="Baixa">Baixa</option>
                            <option value="Normal" selected>Normal</option>
                            <option value="Alta">Alta</option>
                            <option value="Critica">Crítica (SLA 2h)</option>
                        </select>
                    </div>
                </div>
                <div>
                    <label class="block text-[11px] font-[600] text-gray-500 uppercase tracking-wider mb-1.5">Descrição Detalhada</label>
                    <textarea id="issueDescricao" required placeholder="Descreva o motivo da solicitação ou problema identificado..." class="form-control text-[13px] h-24 resize-none"></textarea>
                </div>
                <div class="flex justify-end gap-3 pt-4 border-t border-gray-200 dark:border-dark-border">
                    <button type="button" onclick="fecharModalNovaIssue()" class="px-4 py-2 text-[12px] font-medium text-gray-700 dark:text-gray-300 border border-gray-300 dark:border-dark-border rounded-[6px] hover:bg-gray-50 dark:hover:bg-[#1B1F24] transition-colors">Cancelar</button>
                    <button type="submit" id="btnSalvarIssue" class="px-4 py-2 text-[12px] font-medium text-white bg-brand-600 rounded-[6px] hover:bg-[#1D4ED8] transition-colors flex items-center gap-1.5">
                        <i class="ph ph-paper-plane-tilt"></i> Registrar Chamado
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        // Helper global para obter CSRF Token sem erros em qualquer página
        function getCsrfToken() {
            return document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
        }

        // Funções da Nova Issue
        function abrirModalNovaIssue() {
            const modal = document.getElementById('modalNovaIssue');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            document.getElementById('issueAssunto')?.focus();
        }

        function fecharModalNovaIssue() {
            const modal = document.getElementById('modalNovaIssue');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        async function salvarNovaIssueGlobal(e) {
            e.preventDefault();
            const btn = document.getElementById('btnSalvarIssue');
            btn.disabled = true;
            btn.innerHTML = '<i class="ph ph-spinner-gap animate-spin"></i> Registrando...';

            const payload = {
                Assunto: document.getElementById('issueAssunto').value,
                Categoria: document.getElementById('issueCategoria').value,
                Prioridade: document.getElementById('issuePrioridade').value,
                Descricao: document.getElementById('issueDescricao').value
            };

            try {
                const res = await fetch('/api/Chamados', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': getCsrfToken()
                    },
                    body: JSON.stringify(payload)
                });

                if (res.ok) {
                    fecharModalNovaIssue();
                    Swal.fire({
                        title: 'Issue Criada com Sucesso!',
                        text: 'Sua solicitação foi registrada na fila de suporte de TI e um analista fará a triagem.',
                        icon: 'success',
                        background: '#121418',
                        color: '#fff',
                        confirmButtonColor: '#3B82F6'
                    }).then(() => {
                        if (window.location.pathname.includes('/Chamados')) {
                            window.location.reload();
                        }
                    });
                } else {
                    const err = await res.json().catch(() => ({}));
                    Swal.fire({
                        title: 'Erro ao Registrar',
                        text: err.detail || err.message || 'Não foi possível salvar o chamado.',
                        icon: 'error',
                        background: '#121418',
                        color: '#fff',
                        confirmButtonColor: '#3B82F6'
                    });
                }
            } catch (ex) {
                Swal.fire({ title: 'Erro de Conexão', text: ex.message, icon: 'error', background: '#121418', color: '#fff' });
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="ph ph-paper-plane-tilt"></i> Registrar Chamado';
            }
        }

        // Listener da Barra de Busca Global / Command Palette (Ctrl+K)
        const globalSearch = document.getElementById('globalSearchInput');
        const globalDropdown = document.getElementById('globalCommandDropdown');
        const QUICK_COMMANDS = [
            { title: 'Visão Geral & Dashboard', desc: 'Telemetria, tráfego e KPIs Zero Trust', url: '/Admin/Index', icon: 'ph-squares-four' },
            { title: 'Diretório de Usuários & RBAC', desc: 'Cadastrar colaboradores, MFA e permissões', url: '/Admin/Usuarios', icon: 'ph-users' },
            { title: 'Políticas de Acesso & LGPD', desc: 'Regras de senha e proteção contra força bruta', url: '/Admin/Politicas', icon: 'ph-shield-check' },
            { title: 'Perfis & Permissões', desc: 'Matriz de controle de acesso baseado em papéis', url: '/Admin/Perfis', icon: 'ph-identification-card' },
            { title: 'Fila de Chamados (ITSM)', desc: 'Triagem de tickets de suporte e SLA', url: '/Admin/Chamados', icon: 'ph-headset' },
            { title: 'Infraestrutura Cloud & Endpoints', desc: 'Monitoramento de rede, portas e firewall', url: '/Admin/Cloud', icon: 'ph-desktop' },
            { title: 'Módulos & APIs', desc: 'Conectores Active Directory, SIEM e Webhooks', url: '/Admin/Integracoes', icon: 'ph-plugs-connected' },
            { title: 'Audit Logs (SIEM)', desc: 'Trilha de auditoria imutável de eventos', url: '/Admin/Logs', icon: 'ph-list-magnifying-glass' },
            { title: 'SecOps AI & Defesa (IDS)', desc: 'Mitigação em tempo real e CyberSec Copilot', url: '/Admin/Inteligencia', icon: 'ph-shield-warning' },
            { title: 'Configurações Globais', desc: 'Cloudflare Turnstile, SMTP e parâmetros IAM', url: '/Admin/Configuracoes', icon: 'ph-gear' }
        ];

        function renderCommandDropdown(query) {
            if (!globalDropdown) return;
            const q = (query || '').trim().toLowerCase();
            const matches = QUICK_COMMANDS.filter(c =>
                !q || c.title.toLowerCase().includes(q) || c.desc.toLowerCase().includes(q)
            ).slice(0, 8);

            let html = `<div class="px-3 py-1 text-[10px] font-semibold uppercase tracking-wider text-slate-400">Navegação Rápida</div>`;
            matches.forEach(m => {
                html += `
                    <a href="${m.url}" class="flex items-center gap-2.5 px-3 py-1.5 hover:bg-slate-100 dark:hover:bg-dark-hover text-slate-700 dark:text-slate-200 transition-colors">
                        <i class="ph ${m.icon} text-brand-500 text-sm flex-shrink-0"></i>
                        <div class="min-w-0 flex-1">
                            <div class="font-medium text-[12px] truncate">${m.title}</div>
                            <div class="text-[10px] text-slate-400 truncate">${m.desc}</div>
                        </div>
                        <i class="ph ph-arrow-up-right text-[11px] text-slate-400"></i>
                    </a>
                `;
            });
            if (q) {
                html += `
                    <div class="border-t border-slate-100 dark:border-dark-border mt-1 pt-1">
                        <a href="/Admin/Usuarios?termo=${encodeURIComponent(query.trim())}" class="flex items-center gap-2 px-3 py-1.5 hover:bg-brand-50 dark:hover:bg-brand-500/10 text-brand-600 dark:text-brand-400 font-medium transition-colors">
                            <i class="ph ph-magnifying-glass text-sm"></i>
                            <span>Pesquisar "${query.trim()}" no Diretório de Usuários</span>
                        </a>
                    </div>
                `;
            }
            globalDropdown.innerHTML = html;
            globalDropdown.classList.remove('hidden');
        }

        if (globalSearch) {
            globalSearch.addEventListener('focus', function() {
                renderCommandDropdown(this.value);
            });
            globalSearch.addEventListener('input', function() {
                renderCommandDropdown(this.value);
                const localSearch = document.getElementById('searchInput');
                if (localSearch) {
                    localSearch.value = this.value.trim();
                    localSearch.dispatchEvent(new Event('input'));
                }
            });
            globalSearch.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && globalDropdown) {
                    globalDropdown.classList.add('hidden');
                    this.blur();
                } else if (e.key === 'Enter') {
                    const termo = this.value.trim();
                    const q = termo.toLowerCase();
                    const firstCmd = QUICK_COMMANDS.find(c => c.title.toLowerCase().includes(q));
                    if (termo && firstCmd && q.length >= 3 && !document.getElementById('searchInput')) {
                        window.location.href = firstCmd.url;
                        return;
                    }
                    const localSearch = document.getElementById('searchInput');
                    if (localSearch) {
                        localSearch.value = termo;
                        localSearch.dispatchEvent(new Event('input'));
                        if (globalDropdown) globalDropdown.classList.add('hidden');
                        return;
                    }
                    if (termo) {
                        window.location.href = `/Admin/Usuarios?termo=${encodeURIComponent(termo)}`;
                    }
                }
            });
            document.addEventListener('click', function(e) {
                if (globalDropdown && !globalSearch.contains(e.target) && !globalDropdown.contains(e.target)) {
                    globalDropdown.classList.add('hidden');
                }
            });
            document.addEventListener('keydown', function(e) {
                if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
                    e.preventDefault();
                    globalSearch.focus();
                    globalSearch.select();
                }
            });
        }

        // Dark / Light Theme Toggle (Padrão: White / Light)
        const themeToggleBtn = document.getElementById('theme-toggle');
        const darkIcon = document.getElementById('theme-toggle-dark-icon');
        const lightIcon = document.getElementById('theme-toggle-light-icon');

        function updateThemeIcons() {
            if (document.documentElement.classList.contains('dark')) {
                lightIcon.classList.remove('hidden');
                darkIcon.classList.add('hidden');
            } else {
                darkIcon.classList.remove('hidden');
                lightIcon.classList.add('hidden');
            }
        }
        updateThemeIcons();

        if (themeToggleBtn) {
            themeToggleBtn.addEventListener('click', function() {
                const isDark = document.documentElement.classList.toggle('dark');
                localStorage.setItem('corvux-theme', isDark ? 'dark' : 'light');
                updateThemeIcons();
                window.dispatchEvent(new CustomEvent('corvux-theme-changed', { detail: { isDark } }));
            });
        }

        // Recursos de Acessibilidade (WCAG 2.2 / Etapa 3 PIM IV)
        // Normaliza para o tamanho padrão original (0) sem distorções ou zoom excessivo
        let rawStoredScale = parseInt(localStorage.getItem('font-scale') || '0');
        let fontScale = (rawStoredScale > 2 || rawStoredScale < -1) ? 0 : rawStoredScale;
        if (fontScale === 0) {
            localStorage.setItem('font-scale', '0');
        }

        function aplicarFonte() {
            // Remove qualquer propriedade zoom residual para evitar quebra de layout
            const mainEl = document.querySelector('main');
            if (mainEl && mainEl.style.zoom) {
                mainEl.style.zoom = '';
            }

            const styleTag = document.getElementById('a11y-font-scale-style');
            if (fontScale === 0) {
                document.documentElement.style.fontSize = '';
                document.body.style.fontSize = '';
                if (styleTag) styleTag.remove();
                return;
            }

            // Escala suave de 3% por nível sem afetar grids nem causar sobreposição
            const percent = 100 + (fontScale * 3);
            document.documentElement.style.fontSize = percent + '%';
            document.body.style.fontSize = (13 + fontScale) + 'px';
        }

        function alterarTamanhoFonte(delta) {
            fontScale = Math.max(-1, Math.min(2, fontScale + delta));
            localStorage.setItem('font-scale', fontScale);
            aplicarFonte();
        }

        function alternarAltoContraste() {
            document.documentElement.classList.toggle('high-contrast');
            const ativo = document.documentElement.classList.contains('high-contrast');
            localStorage.setItem('high-contrast', ativo ? 'true' : 'false');
        }
        if (localStorage.getItem('high-contrast') === 'true') {
            document.documentElement.classList.add('high-contrast');
        }
        aplicarFonte();

        // Controle do Menu Mobile (Off-Canvas Drawer)
        function abrirMobileMenu() {
            const sidebar = document.getElementById('appSidebar');
            const backdrop = document.getElementById('mobileBackdrop');
            if (sidebar) {
                sidebar.classList.remove('-translate-x-full');
                sidebar.classList.add('translate-x-0');
            }
            if (backdrop) backdrop.classList.remove('hidden');
        }

        function fecharMobileMenu() {
            const sidebar = document.getElementById('appSidebar');
            const backdrop = document.getElementById('mobileBackdrop');
            if (sidebar) {
                sidebar.classList.add('-translate-x-full');
                sidebar.classList.remove('translate-x-0');
            }
            if (backdrop) backdrop.classList.add('hidden');
        }

        // PWA Service Worker & Notificação de Instalação Exclusiva para Dispositivos Móveis
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('/sw.js').catch(err => console.warn('PWA SW Registro:', err));
        }

        function checkIsMobileDevice() {
            // 1. Client Hints se suportado pelo navegador
            if (navigator.userAgentData && typeof navigator.userAgentData.mobile === 'boolean') {
                return navigator.userAgentData.mobile;
            }
            const ua = navigator.userAgent || '';
            const isMobileUA = /Android|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(ua);
            const hasTouch = ('ontouchstart' in window) || (navigator.maxTouchPoints > 0);

            // Se for sistema operacional desktop típico sem toque, não é mobile
            if (/Windows NT|Macintosh|Linux x86_64/i.test(ua) && !isMobileUA) {
                return false;
            }

            // Em smartphones, a largura de viewport CSS em modo retrato é <= 768px
            return isMobileUA || (hasTouch && window.innerWidth <= 768);
        }

        let deferredPrompt = null;
        const isStandalone = window.matchMedia('(display-mode: standalone)').matches || window.navigator.standalone === true;

        window.addEventListener('beforeinstallprompt', (e) => {
            e.preventDefault();
            deferredPrompt = e;
            // Exibe a notificação de instalação EXCLUSIVAMENTE em smartphones e dispositivos móveis
            if (checkIsMobileDevice() && !sessionStorage.getItem('pwaDismissed') && !isStandalone) {
                mostrarPwaBanner();
            }
        });

        function mostrarPwaBanner() {
            if (!checkIsMobileDevice()) return; // Bloqueio estrito em desktop
            const banner = document.getElementById('pwaInstallBanner');
            if (banner) {
                banner.classList.remove('hidden');
                setTimeout(() => {
                    banner.classList.remove('translate-y-4', 'opacity-0');
                    banner.classList.add('translate-y-0', 'opacity-100');
                }, 50);
            }
        }

        function fecharPwaBanner() {
            const banner = document.getElementById('pwaInstallBanner');
            if (banner) {
                banner.classList.add('translate-y-4', 'opacity-0');
                setTimeout(() => banner.classList.add('hidden'), 300);
            }
            sessionStorage.setItem('pwaDismissed', 'true');
        }

        async function instalarPwaApp() {
            if (deferredPrompt) {
                deferredPrompt.prompt();
                const { outcome } = await deferredPrompt.userChoice;
                deferredPrompt = null;
                fecharPwaBanner();
            } else {
                const isIos = /iPhone|iPad|iPod/.test(navigator.userAgent);
                if (isIos) {
                    Swal.fire({
                        title: 'Instalar no iOS (Apple)',
                        html: '<div class="text-left text-xs space-y-2 text-gray-300"><p>1. Toque no botão de <b>Compartilhar</b> <i class="ph ph-export text-brand-400"></i> na barra do Safari.</p><p>2. Role para baixo e selecione <b>Adicionar à Tela de Início</b> <i class="ph ph-plus-square text-brand-400"></i>.</p><p>3. Toque em <b>Adicionar</b> no canto superior direito.</p></div>',
                        icon: 'info',
                        background: '#111621', color: '#fff', confirmButtonColor: '#3B82F6'
                    });
                } else {
                    fecharPwaBanner();
                }
            }
        }

        // Se for dispositivo móvel e ainda não estiver instalado, exibe o aviso após 3s
        if (checkIsMobileDevice() && !isStandalone && !sessionStorage.getItem('pwaDismissed')) {
            setTimeout(() => {
                const banner = document.getElementById('pwaInstallBanner');
                if (banner && banner.classList.contains('hidden')) {
                    mostrarPwaBanner();
                }
            }, 3000);
        }
    </script>


    <script>
        // Gestão de Consentimento de Cookies LGPD
        function verificarCookiesLGPD() {
            if (!localStorage.getItem('corvus_cookies_consent')) {
                setTimeout(() => {
                    const b = document.getElementById('cookieConsentBanner');
                    if (b) b.classList.remove('hidden');
                }, 1000);
            }
        }
        function aceitarTodosCookies() {
            localStorage.setItem('corvus_cookies_consent', 'all');
            const b = document.getElementById('cookieConsentBanner');
            if (b) b.classList.add('hidden');
        }
        function aceitarApenasEssenciais() {
            localStorage.setItem('corvus_cookies_consent', 'essential');
            const b = document.getElementById('cookieConsentBanner');
            if (b) b.classList.add('hidden');
        }
        verificarCookiesLGPD();

        // ==========================================
        // USER ONBOARDING JAVASCRIPT ENGINE
        // ==========================================
        const ONBOARDING_TASKS = [
            { id: 'dashboard', label: 'Explorar Métricas no Dashboard', desc: 'Visualizar telemetria e integridade Zero Trust', url: '/Admin/Index', pageMatch: '/Admin/Index' },
            { id: 'usuarios', label: 'Cadastrar Colaborador & RBAC', desc: 'Gerenciar usuários e permissões de acesso', url: '/Admin/Usuarios', pageMatch: '/Admin/Usuarios' },
            { id: 'politicas', label: 'Configurar Políticas de Acesso', desc: 'Definir regras de senha e bloqueio anti-brute force', url: '/Admin/Politicas', pageMatch: '/Admin/Politicas' },
            { id: 'cloud', label: 'Inspecionar Endpoints de Rede', desc: 'Monitorar conexões ativas e portas abertas', url: '/Admin/Cloud', pageMatch: '/Admin/Cloud' },
            { id: 'secops', label: 'Validar Inteligência SecOps & IDS', desc: 'Testar detecção e mitigação de intrusões', url: '/Admin/Inteligencia', pageMatch: '/Admin/Inteligencia' }
        ];

        function carregarChecklistTasks() {
            let saved = {};
            try {
                saved = JSON.parse(localStorage.getItem('corvux_checklist_v2') || '{}');
            } catch(e) { saved = {}; }

            // Auto-marca a tarefa se o usuário já estiver na página correspondente
            const currentPath = window.location.pathname;
            ONBOARDING_TASKS.forEach(t => {
                if (currentPath.includes(t.pageMatch)) {
                    saved[t.id] = true;
                }
            });
            localStorage.setItem('corvux_checklist_v2', JSON.stringify(saved));

            const container = document.getElementById('checklistTasksList');
            if (!container) return;

            let completedCount = 0;
            container.innerHTML = '';

            ONBOARDING_TASKS.forEach(t => {
                const isDone = !!saved[t.id];
                if (isDone) completedCount++;

                const item = document.createElement('div');
                item.className = 'flex items-center justify-between p-2 rounded-lg transition-colors border ' + 
                    (isDone ? 'bg-gray-50/60 dark:bg-dark-bg/40 border-gray-100 dark:border-dark-border opacity-70' : 'bg-gray-50 dark:bg-dark-bg border-gray-200 dark:border-dark-border');

                item.innerHTML = `
                    <div class="flex items-center gap-2.5 min-w-0">
                        <input type="checkbox" ${isDone ? 'checked' : ''} onchange="toggleTaskCheck('${t.id}', this.checked)" class="w-4 h-4 rounded text-brand-600 focus:ring-brand-500 cursor-pointer">
                        <div class="min-w-0">
                            <div class="text-[11px] font-semibold ${isDone ? 'line-through text-gray-400' : 'text-gray-900 dark:text-white'} truncate">${t.label}</div>
                            <div class="text-[9px] text-gray-500 dark:text-gray-400 truncate">${t.desc}</div>
                        </div>
                    </div>
                    <a href="${t.url}" class="text-[10px] font-medium px-2 py-0.5 rounded text-brand-600 dark:text-brand-400 hover:bg-brand-500/10 transition-colors whitespace-nowrap border border-brand-500/20">
                        ${isDone ? 'Rever' : 'Acessar'}
                    </a>
                `;
                container.appendChild(item);
            });

            const percent = Math.round((completedCount / ONBOARDING_TASKS.length) * 100);
            const progressText = `${completedCount} de ${ONBOARDING_TASKS.length} concluídos (${percent}%)`;
            
            const txtEl = document.getElementById('checklistProgressText');
            if (txtEl) txtEl.textContent = progressText;

            const barEl = document.getElementById('checklistProgressBar');
            if (barEl) barEl.style.width = percent + '%';

            const pillBarEl = document.getElementById('pillProgressBar');
            if (pillBarEl) pillBarEl.style.width = percent + '%';

            const pillCountEl = document.getElementById('pillTasksCompleted');
            if (pillCountEl) pillCountEl.textContent = `${completedCount}/${ONBOARDING_TASKS.length}`;
        }

        function toggleTaskCheck(taskId, isChecked) {
            let saved = {};
            try {
                saved = JSON.parse(localStorage.getItem('corvux_checklist_v2') || '{}');
            } catch(e) { saved = {}; }
            saved[taskId] = isChecked;
            localStorage.setItem('corvux_checklist_v2', JSON.stringify(saved));
            carregarChecklistTasks();
        }

        function toggleChecklistWidget(expand) {
            const card = document.getElementById('corvuxChecklistCard');
            const pill = document.getElementById('corvuxChecklistPill');
            if (!card || !pill) return;

            if (expand) {
                card.classList.remove('hidden');
                pill.classList.add('hidden');
                localStorage.setItem('corvux_checklist_minimized', 'false');
            } else {
                card.classList.add('hidden');
                pill.classList.remove('hidden');
                localStorage.setItem('corvux_checklist_minimized', 'true');
            }
        }

        function fecharChecklistWidget() {
            const widget = document.getElementById('corvuxGetStartedWidget');
            if (widget) widget.classList.add('hidden');
            localStorage.setItem('corvux_checklist_closed', 'true');
        }

        // Welcome Modal
        function fecharWelcomeModal(marcarVisto) {
            const m = document.getElementById('corvuxWelcomeModal');
            if (m) {
                m.classList.add('hidden');
                m.classList.remove('flex');
            }
            if (marcarVisto) {
                localStorage.setItem('corvux_welcome_v2_dismissed', 'true');
            }
        }

        function iniciarTourPeloWelcome() {
            fecharWelcomeModal(true);
            iniciarSpotlightTour();
        }

        // ==========================================
        // SPOTLIGHT CALLOUT TOUR IMPLEMENTATION
        // ==========================================
        const SPOTLIGHT_STEPS = [
            {
                targetId: 'nav-visao-geral',
                title: 'Visão Geral & Dashboard',
                desc: 'Acompanhe métricas de autenticação, conformidade Zero Trust e telemetria de tráfego em tempo real.'
            },
            {
                targetId: 'nav-usuarios',
                title: 'Diretório de Usuários & RBAC',
                desc: 'Gestão de colaboradores: cadastre usuários, defina papéis, ative MFA e bloqueie acessos suspeitos.'
            },
            {
                targetId: 'nav-politicas',
                title: 'Políticas de Acesso & LGPD',
                desc: 'Configure exigências de senha, bloqueios contra força bruta e parâmetros de conformidade com a LGPD.'
            },
            {
                targetId: 'nav-cloud',
                title: 'Infraestrutura Cloud & Endpoints',
                desc: 'Inspecione computadores e conexões ativas na rede interna com acionamento do firewall em 1 clique.'
            },
            {
                targetId: 'nav-secops',
                title: 'CyberSec Copilot & IDS',
                desc: 'Detecção contínua de invasões (SQL Injection, XSS, Path Traversal) e bloqueio edge em tempo real.'
            },
            {
                targetId: 'nav-configuracoes',
                title: 'Configurações Globais & Cloudflare',
                desc: 'Personalize a segurança corporativa, chaves de API, webhooks e o widget Cloudflare Turnstile anti-robô.'
            }
        ];

        let currentSpotlightIndex = 0;

        function iniciarSpotlightTour() {
            currentSpotlightIndex = 0;
            const sidebar = document.getElementById('appSidebar');
            if (sidebar && window.innerWidth >= 768) {
                sidebar.classList.add('md:!w-64');
            } else if (window.innerWidth < 768) {
                abrirMobileMenu();
            }

            const overlay = document.getElementById('corvuxSpotlightOverlay');
            const popover = document.getElementById('corvuxSpotlightPopover');
            if (overlay) overlay.classList.remove('hidden');
            if (popover) popover.classList.remove('hidden');

            renderizarPassoSpotlight();
        }

        function encerrarSpotlightTour() {
            const overlay = document.getElementById('corvuxSpotlightOverlay');
            const popover = document.getElementById('corvuxSpotlightPopover');
            if (overlay) overlay.classList.add('hidden');
            if (popover) popover.classList.add('hidden');

            const sidebar = document.getElementById('appSidebar');
            if (sidebar) sidebar.classList.remove('md:!w-64');
            if (window.innerWidth < 768) fecharMobileMenu();

            localStorage.setItem('corvux_tour_v2_completed', 'true');
        }

        function renderizarPassoSpotlight() {
            const step = SPOTLIGHT_STEPS[currentSpotlightIndex];
            const targetEl = document.getElementById(step.targetId);

            document.getElementById('spotlightStepBadge').textContent = `Passo ${currentSpotlightIndex + 1} de ${SPOTLIGHT_STEPS.length}`;
            document.getElementById('spotlightTitle').textContent = step.title;
            document.getElementById('spotlightDesc').textContent = step.desc;

            const btnPrev = document.getElementById('spotlightBtnPrev');
            if (btnPrev) btnPrev.style.visibility = currentSpotlightIndex === 0 ? 'hidden' : 'visible';

            const btnNext = document.getElementById('spotlightBtnNext');
            if (btnNext) {
                btnNext.innerHTML = currentSpotlightIndex === SPOTLIGHT_STEPS.length - 1 ? 
                    'Concluir <i class="ph ph-check font-bold"></i>' : 
                    'Próximo <i class="ph ph-arrow-right text-[10px]"></i>';
            }

            if (targetEl) {
                targetEl.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                posicionarSpotlight(targetEl);
            }
        }

        function posicionarSpotlight(el) {
            const rect = el.getBoundingClientRect();
            const hole = document.getElementById('corvuxSpotlightHole');
            const popover = document.getElementById('corvuxSpotlightPopover');
            if (!hole || !popover) return;

            const pad = 6;
            hole.style.top = (rect.top - pad) + 'px';
            hole.style.left = (rect.left - pad) + 'px';
            hole.style.width = (rect.width + (pad * 2)) + 'px';
            hole.style.height = (rect.height + (pad * 2)) + 'px';

            const popWidth = 320;
            const popHeight = 160;
            let top = rect.top;
            let left = rect.right + 14;

            if (window.innerWidth < 768) {
                // Em telas mobile posiciona no centro inferior
                left = Math.max(12, (window.innerWidth - popWidth) / 2);
                top = Math.min(window.innerHeight - popHeight - 20, rect.bottom + 12);
            } else {
                if (left + popWidth > window.innerWidth) {
                    left = Math.max(16, rect.left - popWidth - 14);
                }
                if (top + popHeight > window.innerHeight) {
                    top = Math.max(16, window.innerHeight - popHeight - 20);
                }
            }

            popover.style.top = top + 'px';
            popover.style.left = left + 'px';
        }

        function mudarPassoSpotlight(delta) {
            currentSpotlightIndex += delta;
            if (currentSpotlightIndex >= SPOTLIGHT_STEPS.length) {
                encerrarSpotlightTour();
                return;
            }
            if (currentSpotlightIndex < 0) currentSpotlightIndex = 0;
            renderizarPassoSpotlight();
        }

        window.addEventListener('resize', () => {
            const overlay = document.getElementById('corvuxSpotlightOverlay');
            if (overlay && !overlay.classList.contains('hidden')) {
                const step = SPOTLIGHT_STEPS[currentSpotlightIndex];
                const targetEl = document.getElementById(step.targetId);
                if (targetEl) posicionarSpotlight(targetEl);
            }
        });

        // Chamado pelo botão "Guia do Sistema" no topo
        function iniciarTourInterativo() {
            iniciarSpotlightTour();
        }

        // Inicialização do User Onboarding na carga da página
        window.addEventListener('DOMContentLoaded', () => {
            carregarChecklistTasks();

            // Gerencia visibilidade do widget Checklist
            if (localStorage.getItem('corvux_checklist_closed') === 'true') {
                const widget = document.getElementById('corvuxGetStartedWidget');
                if (widget) widget.classList.add('hidden');
            } else if (localStorage.getItem('corvux_checklist_minimized') === 'true') {
                toggleChecklistWidget(false);
            }

            // Exibe Welcome Modal se for primeira visita no Dashboard
            if (!localStorage.getItem('corvux_welcome_v2_dismissed') && window.location.pathname.includes('/Admin/Index')) {
                setTimeout(() => {
                    const m = document.getElementById('corvuxWelcomeModal');
                    if (m) {
                        m.classList.remove('hidden');
                        m.classList.add('flex');
                    }
                }, 1200);
            }
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
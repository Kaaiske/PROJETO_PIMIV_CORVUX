@model ErrorViewModel
@{
    Layout = null;
    ViewData["Title"] = "Instabilidade no Processamento — CorvuxIAM";
}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Instabilidade Operacional — CorvuxIAM</title>
    <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32x32.png">
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css">
    <script>
        if (localStorage.getItem('corvux-theme') === 'dark') {
            document.documentElement.classList.add('dark');
        } else {
            document.documentElement.classList.remove('dark');
        }
    </script>
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        :root {
            --bg-body: #F1F5F9;
            --bg-card: #FFFFFF;
            --bg-card-subtle: #F8FAFC;
            --text-main: #0F172A;
            --text-secondary: #475569;
            --text-muted: #64748B;
            --border-color: #E2E8F0;
            --accent-color: #2563EB;
            --accent-hover: #1D4ED8;
            --danger-bg: #FEF2F2;
            --danger-border: #FCA5A5;
            --danger-text: #DC2626;
            --shadow-bento: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -2px rgba(0, 0, 0, 0.05);
        }

        html.dark {
            --bg-body: #070709;
            --bg-card: #0E0E12;
            --bg-card-subtle: #14141B;
            --text-main: #F8FAFC;
            --text-secondary: #94A3B8;
            --text-muted: #64748B;
            --border-color: #1F2430;
            --accent-color: #3B82F6;
            --accent-hover: #2563EB;
            --danger-bg: rgba(239, 68, 68, 0.1);
            --danger-border: rgba(239, 68, 68, 0.3);
            --danger-text: #F87171;
            --shadow-bento: 0 4px 12px rgba(0, 0, 0, 0.4);
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background-color: var(--bg-body);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
        }

        .error-container {
            width: 100%;
            max-width: 640px;
            background: var(--bg-card);
            border: 1px solid var(--border-color);
            border-radius: 16px;
            box-shadow: var(--shadow-bento);
            overflow: hidden;
        }

        .error-header {
            padding: 32px 32px 24px 32px;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            align-items: center;
            gap: 16px;
        }

        .error-icon-box {
            width: 52px;
            height: 52px;
            border-radius: 12px;
            background: var(--danger-bg);
            border: 1px solid var(--danger-border);
            color: var(--danger-text);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 24px;
            flex-shrink: 0;
        }

        .error-title-box h1 {
            font-size: 1.25rem;
            font-weight: 700;
            letter-spacing: -0.02em;
            color: var(--text-main);
        }

        .error-title-box p {
            font-size: 0.875rem;
            color: var(--text-secondary);
            margin-top: 4px;
        }

        .error-content {
            padding: 32px;
            display: flex;
            flex-direction: column;
            gap: 20px;
        }

        .bento-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        @@media (max-width: 540px) {
            .bento-grid {
                grid-template-columns: 1fr;
            }
        }

        .bento-card {
            background: var(--bg-card-subtle);
            border: 1px solid var(--border-color);
            border-radius: 12px;
            padding: 16px;
        }

        .bento-card-title {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            font-weight: 600;
            color: var(--text-muted);
            margin-bottom: 6px;
        }

        .bento-card-value {
            font-size: 0.875rem;
            color: var(--text-main);
            font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
            word-break: break-all;
        }

        .bento-card-desc {
            font-size: 0.8125rem;
            color: var(--text-secondary);
            line-height: 1.4;
        }

        .btn-row {
            display: flex;
            gap: 12px;
            margin-top: 8px;
        }

        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px 18px;
            border-radius: 8px;
            font-size: 0.875rem;
            font-weight: 500;
            text-decoration: none;
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .btn-primary {
            background: var(--accent-color);
            color: #ffffff;
            border: 1px solid transparent;
        }

        .btn-primary:hover {
            background: var(--accent-hover);
        }

        .btn-outline {
            background: transparent;
            color: var(--text-secondary);
            border: 1px solid var(--border-color);
        }

        .btn-outline:hover {
            background: var(--bg-card-subtle);
            color: var(--text-main);
        }

        .error-footer {
            padding: 16px 32px;
            background: var(--bg-card-subtle);
            border-top: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 0.75rem;
            color: var(--text-muted);
        }
    </style>
</head>
<body>
    <main class="error-container" role="main" aria-labelledby="error-heading">
        <header class="error-header">
            <div class="error-icon-box" aria-hidden="true">
                <i class="bi bi-shield-exclamation"></i>
            </div>
            <div class="error-title-box">
                <h1 id="error-heading">Instabilidade no Processamento</h1>
                <p>A solicitação encontrou uma condição inesperada ao ser executada pelo cluster CorvuxIAM.</p>
            </div>
        </header>

        <section class="error-content">
            <div class="bento-grid">
                <div class="bento-card">
                    <p class="bento-card-title">Padrão RFC 9110</p>
                    <p class="bento-card-desc">Protocolo de resposta tratada conforme as especificações formais de HTTP Semantics e isolamento defensivo Zero-Trust.</p>
                </div>
                <div class="bento-card">
                    <p class="bento-card-title">Identificador de Rastreio (Trace ID)</p>
                    <p class="bento-card-value">
                        @(Model?.ShowRequestId == true ? Model.RequestId : System.Diagnostics.Activity.Current?.Id ?? "N/A")
                    </p>
                </div>
            </div>

            <div class="bento-card">
                <p class="bento-card-title">Ação Recomendada</p>
                <p class="bento-card-desc">
                    O evento foi catalogado no registro de telemetria e auditoria de segurança da plataforma. Se o problema persistir, forneça o Trace ID acima à equipe de Operações e SecOps.
                </p>
            </div>

            <nav class="btn-row" aria-label="Ações de recuperação">
                <a href="/" class="btn btn-primary">
                    <i class="bi bi-house"></i> Retornar ao Início
                </a>
                <a href="https://corvuxiam.tech" class="btn btn-outline">
                    <i class="bi bi-globe"></i> Portal CorvuxIAM
                </a>
            </nav>
        </section>

        <footer class="error-footer">
            <span>CorvuxIAM Enterprise &bull; Segurança & IAM</span>
            <span>Zero-Trust Architecture</span>
        </footer>
    </main>
</body>
</html>
